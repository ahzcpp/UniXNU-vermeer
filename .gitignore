# Build outputs and caches (re-derivable; nothing important lives here)
/build/
/Build/
/Conf/
/out/
/.cache/
/refer/
/.local*/
/Mu_Basecore/

# Local development files
*.log
*.terminal
*.swp
*.swo
*~
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc
*.dSYM/

# Inputs, images and products that never belong in Git
*.ipsw
*.dmg
*.im4p
*.img
*.dbr
*.macho
*.o
*.a
*.dylib
*.efi
*.dtb
*.bc
*.spv
*.metallib
*.bin
*.mbn
*.fw
*.pem
*.key
.env
local.toml

# The device tree is a compiled artifact, but this one is a qualification input of the
# board (scripts/check-vermeer.py checks MemoryMapLib against its reservations, and the
# boot image appends it), so it belongs in the repository.
!scripts/data/*.dtb
