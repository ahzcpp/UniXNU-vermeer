@@ -0,0 +1,101 @@
+"""Instrument the pinned supplicant2.12 actual decisions, without changing them.
+This public-source-only module is called by the component's existing preparer.
+All insertion sites are exact/unique; unexpected upstream changes fail closed.
+"""
+def instrument_events330(s):
+    def rep(a,b,count=1):
+        nonlocal s
+        if s.count(a)!=count: raise ValueError(('selection330 context',a[:100],s.count(a),count))
+        s=s.replace(a,b)
+    rep('#include "nan_supplicant.h"','#include "nan_supplicant.h"\n#include "nw_selection330.h"')
+    signature='''static int _wpa_supplicant_event_scan_results(struct wpa_supplicant *wpa_s,
+\t\t\t\t\t      union wpa_event_data *data,
+\t\t\t\t\t      int own_request, int update_only)
+'''
+    declaration='''static int nw330_scan_results_impl(struct wpa_supplicant *wpa_s,
+ union wpa_event_data *data,int own_request,int update_only);
+'''
+    wrapper=declaration+signature+'''{
+ int observe330=wpa_s && wpa_s->driver && !os_strcmp(wpa_s->driver->name,"sheng");
+ int started330=observe330 ? nw330_selection_begin(wpa_s->disconnected,
+   data ? data->scan_info.aborted : 0,own_request,update_only) : 0;
+ int result330=nw330_scan_results_impl(wpa_s,data,own_request,update_only);
+ /* result2 can remove the interface. Never dereference wpa_s after the call. */
+ if(started330)nw330_selection_end(result330);
+ return result330;
+}
+static int nw330_scan_results_impl(struct wpa_supplicant *wpa_s,
+ union wpa_event_data *data,int own_request,int update_only)
+'''
+    rep(signature,wrapper)
+    rep('''\tif (scan_res == NULL) {
+\t\tif (wpa_s->conf->ap_scan''','''\tif (scan_res) nw330_selection_fetched(scan_res->num);
+\tif (scan_res == NULL) {
+\t\tif (wpa_s->conf->ap_scan''')
+    rep('''\tif (data && data->scan_info.aborted) {
+\t\twpa_dbg''','''\tif (data && data->scan_info.aborted) {
+        nw330_selection_note(NW330_ABORTED_GATE);
+\t\twpa_dbg''')
+    rep('''\tif (wpa_s->disconnected) {
+\t\twpa_supplicant_set_state(wpa_s, WPA_DISCONNECTED);''','''\tif (wpa_s->disconnected) {
+        nw330_selection_note(NW330_DISCONNECTED_GATE);
+\t\twpa_supplicant_set_state(wpa_s, WPA_DISCONNECTED);''')
+    rep('''\tselected = wpa_supplicant_pick_network(wpa_s, &ssid, new_scan);''','''\tselected = wpa_supplicant_pick_network(wpa_s, &ssid, new_scan);
+    if(selected)nw330_selection_note(NW330_SELECTED);''')
+    # Notes are placed inside the existing true branch, before debug_print.
+    # Both legacy WPA and RSN paths share corresponding rejection semantics.
+    for condition,reason,count in [
+      ('if (wpa_parse_wpa_ie(rsn_ie, 2 + rsn_ie[1], &ie)) {','NW330_RSN_PARSE',1),
+      ('if (wpa_parse_wpa_ie(wpa_ie, 2 + wpa_ie[1], &ie)) {','NW330_RSN_PARSE',1),
+      ('if (!(ie.proto & ssid->proto)) {','NW330_PROTO',2),
+      ('if (!(ie.pairwise_cipher & ssid->pairwise_cipher)) {','NW330_PAIRWISE',2),
+      ('if (!(ie.group_cipher & ssid->group_cipher)) {','NW330_GROUP',2),
+      ('if (!(ie.key_mgmt & ssid->key_mgmt)) {','NW330_AKM',2),
+      ('if (!rate_match(wpa_s, ssid, bss, debug_print)) {','NW330_RATES',1),
+      ('if (!wpa_supplicant_match_privacy(bss, ssid)) {','NW330_PRIVACY',1),
+      ('if (!freq_allowed(ssid->freq_list, bss->freq)) {','NW330_FREQ',1),
+    ]:rep(condition,condition+'\n        nw330_selection_note('+reason+');',count)
+    rep('''\tif (wpas_network_disabled(wpa_s, ssid)) {
+\t\tif (debug_print)''','''\tif (wpas_network_disabled(wpa_s, ssid)) {
+        nw330_selection_note(NW330_DISABLED);
+\t\tif (debug_print)''')
+    rep('''!(ssid->key_mgmt & WPA_KEY_MGMT_IEEE8021X_NO_WPA)) {
+\t\tif (debug_print)''','''!(ssid->key_mgmt & WPA_KEY_MGMT_IEEE8021X_NO_WPA)) {
+        nw330_selection_note(NW330_NO_PROTO);
+\t\tif (debug_print)''')
+    # Restrict this insertion to wpa_scan_res_ok, not every temp-disabled query.
+    start=s.index('static bool wpa_scan_res_ok(struct wpa_supplicant *wpa_s, struct wpa_ssid *ssid,\n')
+    part=s[start:]
+    old='''\tif (res > 0) {
+\t\tif (debug_print)'''
+    if part.count(old)!=1:raise ValueError('temp disabled context')
+    s=s[:start]+part.replace(old,old.replace('\n\t\tif','\n        nw330_selection_note(NW330_TEMP_DISABLED);\n\t\tif'),1)
+    rep('''os_memcmp(match_ssid, ssid->ssid, match_ssid_len) != 0)) {
+\t\tif (debug_print)''','''os_memcmp(match_ssid, ssid->ssid, match_ssid_len) != 0)) {
+        nw330_selection_note(NW330_NAME_MISMATCH);
+\t\tif (debug_print)''')
+    rep('''\tif (!link && ssid->bssid_set &&
+\t    !ether_addr_equal(bss->bssid, ssid->bssid)) {''','''    if(check_ssid)nw330_selection_note(NW330_NAME_MATCH);
+\tif (!link && ssid->bssid_set &&
+\t    !ether_addr_equal(bss->bssid, ssid->bssid)) {
+        nw330_selection_note(NW330_BSSID_FILTER);''')
+    # PMF decisions retain their exact conditions/returns; instrument by unique
+    # debug-message branch context independent of the runtime debug level.
+    for text in ['   skip RSN IE - no mgmt frame protection',
+                 '   skip RSN IE - no mgmt frame protection enabled but AP requires it']:
+        marker='"'+text+'"'
+        at=s.find(marker)
+        if at<0:raise ValueError(('PMF marker',text))
+        debug=s.rfind('if (debug_print)',0,at)
+        if debug<0 or at-debug>180:raise ValueError('PMF branch')
+        branch=s.rfind('\n',0,debug)
+        s=s[:branch]+'\n        nw330_selection_note(NW330_PMF);'+s[branch:]
+    rep('''\t\t\t\t"   selected based on RSN IE");
+\t\treturn 1;''','''\t\t\t\t"   selected based on RSN IE");
+        nw330_selection_note(NW330_SECURITY_OK);
+\t\treturn 1;''')
+    rep("\t\tif (!ie.has_group)\n\t\t\tie.group_cipher = wpa_default_rsn_cipher(bss->freq);",
+        "\t\tif (!ie.has_group)\n\t\t\tie.group_cipher = wpa_default_rsn_cipher(bss->freq);\n"
+        "        if(ie.pairwise_cipher & WPA_CIPHER_TKIP)nw330_selection_note(NW330_OFFER_PAIR_TKIP);\n"
+        "        if(ie.group_cipher & WPA_CIPHER_TKIP)nw330_selection_note(NW330_OFFER_GROUP_TKIP);")
+    return s
