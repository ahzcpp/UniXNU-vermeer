+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ * Private en0 diagnostic, not a new protocol or authentication implementation.
+ * Fixed numeric fields only. No string, MAC, credential, identity hash, profile
+ * identifier or untrusted format enters any emitted record. */
+#ifndef NW_SELECTION330_H
+#define NW_SELECTION330_H
+enum nw330_reason {
+ NW330_NAME_MATCH, NW330_NAME_MISMATCH, NW330_DISABLED, NW330_TEMP_DISABLED,
+ NW330_BSSID_FILTER, NW330_RSN_PARSE, NW330_PROTO, NW330_PAIRWISE, NW330_GROUP,
+ NW330_AKM, NW330_PMF, NW330_RATES, NW330_NO_PROTO, NW330_SECURITY_OK,
+ NW330_DISCONNECTED_GATE, NW330_ABORTED_GATE, NW330_SELECTED, NW330_PRIVACY,
+ NW330_FREQ, NW330_OFFER_PAIR_TKIP, NW330_OFFER_GROUP_TKIP, NW330_REASON_COUNT
+};
+static struct {
+ unsigned active, passes, frontend_rows, disconnected, aborted, own, update, fetched;
+ unsigned counts[NW330_REASON_COUNT];
+} nw330_selection;
+static inline int nw330_selection_begin(unsigned disconnected,unsigned aborted,unsigned own,unsigned update) {
+ if(nw330_selection.active || nw330_selection.passes>=32) return 0;
+ nw330_selection.active=1;nw330_selection.passes++;
+ nw330_selection.disconnected=!!disconnected;nw330_selection.aborted=!!aborted;
+ nw330_selection.own=!!own;nw330_selection.update=!!update;nw330_selection.fetched=0;
+ for(unsigned i=0;i<NW330_REASON_COUNT;i++)nw330_selection.counts[i]=0;
+ return 1;
+}
+static inline void nw330_selection_note(unsigned reason) {
+ if(nw330_selection.active && reason<NW330_REASON_COUNT && nw330_selection.counts[reason]<65535)
+  nw330_selection.counts[reason]++;
+}
+static inline void nw330_selection_fetched(unsigned n) {
+ if(nw330_selection.active)nw330_selection.fetched=n<65535?n:65535;
+}
+static inline void nw330_selection_end(int rc) {
+ if(!nw330_selection.active)return;
+ const unsigned *c=nw330_selection.counts;
+ wpa_printf(MSG_WARNING,"wifi330: WPA pass=%u rc=%d disconnected=%u aborted=%u own=%u update=%u fetched=%u name_match=%u name_mismatch=%u selected=%u",
+  nw330_selection.passes,rc,nw330_selection.disconnected,nw330_selection.aborted,
+  nw330_selection.own,nw330_selection.update,nw330_selection.fetched,
+  c[NW330_NAME_MATCH],c[NW330_NAME_MISMATCH],c[NW330_SELECTED]);
+ wpa_printf(MSG_WARNING,"wifi330: WPA reject rsn_parse=%u proto=%u pairwise=%u group=%u akm=%u pmf=%u rates=%u non_wpa=%u rsn_ok=%u privacy=%u freq=%u",
+  c[NW330_RSN_PARSE],c[NW330_PROTO],c[NW330_PAIRWISE],c[NW330_GROUP],c[NW330_AKM],
+  c[NW330_PMF],c[NW330_RATES],c[NW330_NO_PROTO],c[NW330_SECURITY_OK],c[NW330_PRIVACY],c[NW330_FREQ]);
+ wpa_printf(MSG_WARNING,"wifi330: WPA gates disabled=%u temp_disabled=%u bssid_filter=%u disconnected=%u aborted=%u",
+  c[NW330_DISABLED],c[NW330_TEMP_DISABLED],c[NW330_BSSID_FILTER],c[NW330_DISCONNECTED_GATE],c[NW330_ABORTED_GATE]);
+ wpa_printf(MSG_WARNING,"wifi330: WPA tkip offer_pair=%u offer_group=%u",
+  c[NW330_OFFER_PAIR_TKIP],c[NW330_OFFER_GROUP_TKIP]);
+ nw330_selection.active=0;
+}
+static inline void nw330_frontend(unsigned op,unsigned before,unsigned after,int rc) {
+ if(nw330_selection.frontend_rows>=32)return;
+ nw330_selection.frontend_rows++;
+ wpa_printf(MSG_WARNING,"wifi330: WPA frontend op=%u before_disconnected=%u after_disconnected=%u rc=%d",
+  op,!!before,!!after,rc);
+}
+#endif
