--- /dev/null
+++ b/userspace/nw_numeric337.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ * Own numeric rows only; never accepts a format, label or identity string.
+ * Failure is deliberately isolated from authentication/control state. */
+#ifndef NW_NUMERIC337_H
+#define NW_NUMERIC337_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <sys/file.h>
+#include <errno.h>
+enum nw337_row {NW337_PASS,NW337_REJECT,NW337_GATES,NW337_OFFER,NW337_FRONTEND,NW337_INFO,NW337_INSTALL,NW337_ROWS};
+#ifdef NW337_HOST_TEST
+#ifndef NW337_TEST_PATH
+#error Host test requires explicit synthetic file path
+#endif
+#define NW337_PATH NW337_TEST_PATH
+#else
+#define NW337_PATH "/dev/console"
+#endif
+#define NW337_CAP 65536
+#if defined(NW337_HOST_TEST) && defined(NW337_TEST_STAT)
+#define NW337_FSTAT NW337_TEST_STAT
+#else
+#define NW337_FSTAT fstat
+#endif
+static inline void nw337_numeric_impl(enum nw337_row row,const int64_t *values,size_t count) {
+ static const struct {const char *name;unsigned n;const char *fields[11];} schema[NW337_ROWS]={
+  {"pass",10,{"pass","rc","disconnected","aborted","own","update","fetched","name_match","name_mismatch","selected"}},
+  {"reject",11,{"rsn_parse","proto","pairwise","group","akm","pmf","rates","non_wpa","rsn_ok","privacy","freq"}},
+  {"gates",5,{"disabled","temp_disabled","bssid_filter","disconnected","aborted"}},
+  {"offer",2,{"pair_tkip","group_tkip"}},
+  {"frontend",4,{"op","before_disconnected","after_disconnected","rc"}},
+  {"info",1,{"cap_tkip"}},
+  {"install",3,{"pairwise","bytes","rc"}}
+ };
+ static unsigned attempts;
+ if((unsigned)row>=NW337_ROWS || !values || count!=schema[row].n)return;
+ unsigned seen=__atomic_load_n(&attempts,__ATOMIC_RELAXED);
+ do {if(seen>=256)return;}while(!__atomic_compare_exchange_n(&attempts,&seen,seen+1,0,__ATOMIC_RELAXED,__ATOMIC_RELAXED));
+ char line[768];int used=snprintf(line,sizeof(line),"wifi417: %s",schema[row].name);
+ if(used<0 || (size_t)used>=sizeof(line))return;
+ for(size_t i=0;i<count;i++) {
+  int n=snprintf(line+used,sizeof(line)-(size_t)used," %s=%lld",schema[row].fields[i],(long long)values[i]);
+  if(n<0 || (size_t)n>=sizeof(line)-(size_t)used)return;
+  used+=n;
+ }
+ if((size_t)used+1>=sizeof(line))return;line[used++]='\n';
+ /* Numeric metadata only. A failed or busy console never delays SME. */
+ static unsigned budget_used;
+ unsigned consumed=__atomic_load_n(&budget_used,__ATOMIC_RELAXED);
+ do {if(consumed>NW337_CAP-(unsigned)used)return;}
+ while(!__atomic_compare_exchange_n(&budget_used,&consumed,consumed+(unsigned)used,0,__ATOMIC_RELAXED,__ATOMIC_RELAXED));
+ int fd=open(NW337_PATH,O_WRONLY|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK);
+ if(fd<0)return;
+ struct stat st;
+ if(NW337_FSTAT(fd,&st) || !S_ISCHR(st.st_mode)) {close(fd);return;}
+ /* One write, no retry, no fsync, no file creation, no generic log mirror. */
+ (void)write(fd,line,(size_t)used);
+ close(fd);
+}
+static inline void nw337_numeric(enum nw337_row row,const int64_t *values,size_t count) {
+ int saved_errno=errno;
+ nw337_numeric_impl(row,values,count);
+ errno=saved_errno;
+}
+#define NW337_RECORD(row,...) do {const int64_t nw337_values[]={__VA_ARGS__}; \
+ nw337_numeric((row),nw337_values,sizeof(nw337_values)/sizeof(nw337_values[0]));}while(0)
+#endif
