+void nw_supplicant_generation_reset422(void *context, unsigned operation, uint64_t generation_delta,
+                                       unsigned drops, unsigned scan_done_drops)
+{
+  struct wpa_supplicant *supplicant = context;
+  const int work = supplicant->scan_work != NULL;
+  const int started = work && supplicant->scan_work->started;
+  const int scanning_before = supplicant->scanning;
+  const int state_before = supplicant->wpa_state;
+  /* The native side published this generation only after dev_close/dev_open of the
+   * interface, and every completion tagged with an older generation is discarded
+   * (kernel and client). A scan begun before it can never report results, so end it
+   * through upstream's own lifecycle: drop a pending scan request, then let
+   * radio_remove_works() call wpas_trigger_scan_cb(deinit) (scanning 0, scan-done
+   * failure notification, scan_work NULL) before freeing it. No result is invented;
+   * the following frontend request starts a fresh scan in the new generation. */
+  wpa_supplicant_cancel_scan(supplicant);
+  radio_remove_works(supplicant, "scan", 0);
+  NW337_RECORD(NW337_HANDOVER422, (int64_t)operation, (int64_t)(generation_delta > INT32_MAX ? INT32_MAX : generation_delta),
+               work, started, scanning_before, supplicant->scanning, state_before, supplicant->wpa_state,
+               supplicant->scan_work != NULL, (int64_t)drops, (int64_t)scan_done_drops);
+}
