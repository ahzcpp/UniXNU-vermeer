<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>org.unixnu.wifi.supplicant</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/unixnu-wpa_supplicant</string>
		<string>-Dsheng</string>
		<string>-ien0</string>
		<string>-c/private/var/ngpu/etc/wifi/wpa_supplicant.conf</string>
		<string>-q</string>
		<string>-s</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>3</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>UserName</key>
	<string>root</string>
</dict>
</plist>
