+  Reset(); Region(K70_HEAP_BASE, K70_HEAP_END-K70_HEAP_BASE, 7);
+  Check(1, Good, 0x08000000); assert(Requests == 1);
+  // Adjacent conventional descriptors are one run, even with shuffled order.
+  Reset(); Region(0xC2000000, K70_HEAP_END-0xC2000000, 7);
+  Region(K70_HEAP_BASE, 0xC2000000-K70_HEAP_BASE, 7);
