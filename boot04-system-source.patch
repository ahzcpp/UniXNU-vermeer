+#!/usr/bin/env python3
+"""Write a small public offline record after the exact boot04 artifact passes."""
+import hashlib
+import json
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+DELIVERY = HERE.parent
+SOURCE = DELIVERY / 'device-source'
+OUT = DELIVERY / 'artifacts/boot-chain-04'
+boot = json.loads((OUT / 'verification.json').read_text())
+audit = json.loads((HERE / 'fd-audit.json').read_text())
+build = json.loads((HERE / 'build-result.json').read_text())
+patch = json.loads((SOURCE / 'boot04-system-source.manifest.json').read_text())
+if not audit['success'] or build['exit_code'] != 0 or build['source_changed_during_build']:
+    raise SystemExit('Final build/audit incomplete')
+image = OUT / 'boot.img'
+if hashlib.sha256(image.read_bytes()).hexdigest() != boot['boot_image_sha256']:
+    raise SystemExit('Packaged boot image changed')
+record = {
+    'experiment': 'K70 boot04 heap128', 'hardware_tested': False,
+    'phone_written_this_iteration': False, 'usb_detection_enabled': False,
+    'contains_os_root': False, 'firmware_build_exit_code': build['exit_code'],
+    'runtime_source_snapshot_unchanged': True,
+    'fd_structural_audit_passed': True,
+    'fd_audit_sha256': hashlib.sha256((HERE / 'fd-audit.json').read_bytes()).hexdigest(),
+    'source_patch_sha256': patch['patch_sha256'], 'source_patch_files': patch['file_count'],
+    **{k: boot[k] for k in ['boot_image_sha256', 'boot_image_bytes', 'firmware_sha256',
+                           'kernel_sha256', 'adt_sha256', 'requested_window_bytes',
+                           'allowed_kernel_window', 'menu_title', 'limitation']},
+    'host_checks': ['actual allocator and RunEnd with ASan/UBSan and 163840 reference cases',
+                    'actual HOB/FDT/initrd guard with bundled libfdt and ASan/UBSan',
+                    'AArch64 COFF policy compile', 'complete AArch64 EDK build',
+                    'complete driver compile with actual EDK parameters/headers (LTO and AArch64 COFF)',
+                    'FD modules and compiled MemoryMap data bound to final SEC',
+                    'complete Android boot unpack and byte comparison',
+                    'new-source patch clean apply and all-file readback'],
+    'scope': 'Offline entry experiment; no XNU entry, root mount, userland or desktop claimed.',
+}
+docs = SOURCE / 'docs'
+(docs / 'boot04-verification-2026-11-04.json').write_text(json.dumps(record, indent=2) + '\n')
+text = f'''# K70 boot04：继续内核入口定位
+
+用户要求暂停 USB 检测后，继续从已知 trace02 启动路径排查。本轮没有
+刷写手机。当前 boot_b 仍是前一轮 USB 诊断构建，其屏幕状态未确认；
+原厂 vendor_boot_b 保持此前恢复后的内容。
+
+boot04 只使用原厂 DXE Heap `0xBAB00000..0xC7CC0000`，将四个未经本机
+确认的 gap/high bank 保留，移除动态添加内存的驱动。专用 DarwinBoot
+使用显式 128 MiB 窗口，保持 256 MiB 默认值，不回落其他物理地址。
+读取负载前核对真实 HOB/FDT/initrd，发现与堆冲突或未保留输入即拒绝。
+这不能证明更早的 UEFI 内存分配已安全，也不提供完整系统内存预算。
+
+实际 trace02 Mach-O 字节复核确认：入口 `0xfffffff00741e488` 的
+`1400001e` 正确跳到 `0xfffffff00741e500`，固定蓝条探针的 44 字节
+均有可执行 segment 文件字节支持，随后跳到 `_start_first_cpu`
+`0xfffffff00742005c`。没有发现文件/VM 偏移错误。内核入口仍未获真机证明。
+
+| 离线产物 | 结果 |
+| --- | --- |
+| 完整 Android boot | {boot['boot_image_bytes']:,} 字节，header v0，SM8550 v2 原厂 DTB |
+| boot SHA-256 | `{boot['boot_image_sha256']}` |
+| 3 MiB FD SHA-256 | `{boot['firmware_sha256']}` |
+| 内核 | trace02 原字节，`{boot['kernel_sha256']}` |
+| 菜单标题 | `{boot['menu_title']}` |
+| 系统根卷 / userdata 操作 | 不包含 / 未写入 |
+
+真实分配器及输入检查通过 ASan/UBSan，包含 163,840 个边界参考用例和
+bundled libfdt 测试。完整 EDK 构建 exit 0，运行时源快照未变；FD 审计
+核对了模块唯一性、PE/TE 来源及 MemoryMap 源数据到最终 SEC 的绑定。
+完整 boot 已独立解包，对比 FD、FAT、内核和 ADT。详见
+[验证摘要](boot04-verification-2026-11-04.json)。这些都是离线证据。
+
+源码见仓库根的 `boot04-system-source.patch` 和对应 manifest。补丁只
+创建 `research/boot-chain-04` 与 `research/system-build`，不包含 Apple
+或 OEM 二进制；已在空仓库完成 apply/check 及全部文件逐字节读回。
+应用后阅读各目录 README；脚本依赖固定的现有构建工作区，不是通用
+一键构建器，基线工作流不会自动采用此实验。
+
+下一轮真机需确认新菜单标题和输入检查结果，然后区分加载器色条、
+XNU 入口蓝条与真实内核输出。128 MiB 仅定位入口。原生 UFS、Data 种子、
+SystemOS union、根策略及驱动适配仍需独立完成，不能以双卷镜像封装
+或编译成功宣称已进入 iPadOS。
+'''
+(docs / 'boot04-2026-11-04.md').write_text(text, encoding='utf-8')
+print(json.dumps({'public_record': 'docs/boot04-2026-11-04.md',
+                  'boot_image_sha256': boot['boot_image_sha256']}, indent=2))
diff --git a/research/boot-chain-04/package.py b/research/boot-chain-04/package.py
