+            found=inventory.get(g,[]); record={'name':name,'guid':g,'ffs_count':len(found)}; requiredchecks.append(record)
+            if len(found)!=1: err('required diagnostic module not present exactly once',name=name,count=len(found))
+            elif found[0]['ui']!=[name] or found[0]['type']!=7: err('required diagnostic FFS identity/type mismatch',name=name,ui=found[0]['ui'],type=found[0]['type'])
+            if not any(c['guid']==g and c.get('pe',{}).get('equal') for c in sourcechecks): err('required diagnostic source OUTPUT PE comparison did not pass',name=name)
+        report['required_diagnostic_modules']=requiredchecks
+        # No file can silently change while this report is assembled.
+        if sha(args.fd.read_bytes())!=report['fd_sha256']: err('FD changed before audit completion')
+        if sha(args.oem_manifest.read_bytes())!=OEM_SHA: err('OEM manifest changed during audit')
+        report['success']=not report['errors']
+    except Exception as exc:
+        err('audit exception',exception_type=type(exc).__name__,detail=str(exc))
+        report['success']=False
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    args.output.write_text(json.dumps(report,indent=2,ensure_ascii=False)+'\n',encoding='utf-8')
+    print(json.dumps({'success':report['success'],'errors':report['errors'],'fd_sha256':report['fd_sha256'],'fd_bytes':report['fd_bytes'],'hardware_tested':False,'output':str(args.output)},ensure_ascii=False))
+    return 0 if report['success'] else 1
+if __name__=='__main__': raise SystemExit(main())
