+++ b/research/boot-chain-04/darwinboot/Test/export-boot04-source.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""Export the isolated source against the pinned DarwinBoot git HEAD."""
+import difflib
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+root=Path(__file__).resolve().parents[1]
+original=Path('/root/k70-clean-20261104/UniXNU/drivers/DarwinBoot')
+pin=subprocess.check_output(['git','-C',str(original),'rev-parse','HEAD'],text=True).strip()
+patch=[]; sources={}; originals={}
+for p in sorted(root.rglob('*')):
+    if not p.is_file() or p.suffix in ('.json','.patch','.obj','.o') or '__pycache__' in p.parts:
+        continue
+    relative=p.relative_to(root).as_posix(); data=p.read_bytes()
+    sources[relative]=hashlib.sha256(data).hexdigest()
+    result=subprocess.run(['git','-C',str(original),'show',f'HEAD:{relative}'],capture_output=True)
+    old=result.stdout.decode() if result.returncode==0 else ''
+    if result.returncode==0:
+        originals[relative]=result.stdout
+    new=data.decode()
+    if old==new:
+        continue
+    patch.append(f'diff --git a/{relative} b/{relative}\n')
+    if result.returncode:
+        patch.append('new file mode 100644\n')
+    patch.extend(difflib.unified_diff(old.splitlines(keepends=True),new.splitlines(keepends=True),
+                  fromfile=f'a/{relative}' if result.returncode==0 else '/dev/null',
+                  tofile=f'b/{relative}'))
+out=root/'Test/boot04-source.patch'; out.write_text(''.join(patch))
+with tempfile.TemporaryDirectory(prefix='k70-boot04-apply-') as tmp:
+    check=Path(tmp)
+    for relative,data in originals.items():
+        target=check/relative; target.parent.mkdir(parents=True,exist_ok=True); target.write_bytes(data)
+    subprocess.run(['git','apply','--check',str(out)],cwd=check,check=True)
+    subprocess.run(['git','apply',str(out)],cwd=check,check=True)
+    for relative,digest in sources.items():
+        assert hashlib.sha256((check/relative).read_bytes()).hexdigest()==digest,relative
+report={'base_darwinboot_revision':pin,'patch_sha256':hashlib.sha256(out.read_bytes()).hexdigest(),
+        'patch_apply_and_all_source_hashes_verified':True,
+        'source_files':sources,'source_change_scope':'isolated K70 boot04 copy only; original WSL checkout unchanged',
+        'host_allocator_sanitizers':'PASS address,undefined; real AllocateWindow/RunEnd + 163840 reference cases',
+        'host_input_guard_sanitizers':'PASS address,undefined; real guard + pinned bundled libfdt',
+        'aarch64_coff_policy_compile':'PASS',
+        'header_integration_fix':'PiDxe.h added after first full EDK rejected undeclared PI HOB/resource types; runtime logic unchanged',
+        'complete_driver_real_edk_headers_compile':json.loads((root/'Test/real-edk-compile.json').read_text()),
+        'full_edk_build':'second root EDK build pending; first compile failed before PiDxe.h fix',
+        'device_result':'unverified'}
+(root/'Test/boot04-source-manifest.json').write_text(json.dumps(report,indent=2)+'\n')
+print(json.dumps({'base':pin,'patch_bytes':out.stat().st_size,'patch_sha256':report['patch_sha256'],
+                  'source_files':len(sources)},indent=2))
diff --git a/research/boot-chain-04/darwinboot/Test/make-fixtures.py b/research/boot-chain-04/darwinboot/Test/make-fixtures.py
new file mode 100644
index 0000000..3841612
--- /dev/null
+++ b/research/boot-chain-04/darwinboot/Test/make-fixtures.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Generate freely redistributable Mach-O/ADT fixtures; no Apple binaries."""
+import argparse
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+
+BASE = 0xfffffff007004000
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('output', type=Path)
+    parser.add_argument('--memory-size', type=lambda value: int(value, 0), choices=[0x10000000, 0x20000000])
+    parser.add_argument('--gop', action='store_true')
+    args = parser.parse_args()
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    tools = {name: shutil.which(name) for name in ('clang', 'ld.lld', 'llvm-objcopy')}
+    if not all(tools.values()):
+        parser.error('LLVM and lld are required on PATH')
+    subprocess.run([tools['clang'], '--target=aarch64-none-elf', '-c',
+                    f'-DFIXTURE_WINDOW_SIZE={args.memory_size or 0x10000000}',
+                    f'-DFIXTURE_GOP={int(args.gop)}',
+                    f'-DFIXTURE_ADT_EXTRA={44 if args.memory_size else 0}',
+                    str(Path(__file__).with_name('Kernel.S')), '-o', str(output / 'kernel.o')], check=True)
+    subprocess.run([tools['ld.lld'], f'-Ttext={BASE + 0x1000:#x}', '-e', '_start',
+                    str(output / 'kernel.o'), '-o', str(output / 'kernel.elf')], check=True)
+    subprocess.run([tools['llvm-objcopy'], '-O', 'binary', str(output / 'kernel.elf'),
+                    str(output / 'kernel-code.bin')], check=True)
+    code = (output / 'kernel-code.bin').read_bytes()
+    if len(code) > 0x1000:
+        raise SystemExit('Fixture exceeds the synthetic TEXT segment')
+
+    def segment(name, address, size, offset, length, protection):
+        return struct.pack('<II16sQQQQiiII', 0x19, 72, name, address, size, offset, length,
+                           protection, protection, 0, 0)
+
+    state = bytearray(272)
+    struct.pack_into('<Q', state, 256, BASE + 0x1000)
+    commands = (segment(b'__TEXT', BASE, 0x2000, 0, 0x2000, 5)
+                + segment(b'__DATA', BASE + 0x4000, 0x1000, 0, 0, 3)
+                + struct.pack('<IIII', 5, 288, 6, 68) + state)
+    image = bytearray(0x2000)
+    image[:32] = struct.pack('<8I', 0xfeedfacf, 0x100000c, 0, 2, 3, len(commands), 0, 0)
+    image[32:32 + len(commands)] = commands
+    image[0x1000:0x1000 + len(code)] = code
+    tree = struct.pack('<II32sI12s', 1, 0, b'name', 12, b'device-tree\0')
+    def node(name, properties=(), children=()):
+        props = [('name', name.encode() + b'\0'), *properties]
+        data = struct.pack('<II', len(props), len(children))
+        for key, value in props:
+            data += struct.pack('<32sI', key.encode(), len(value)) + value + bytes(-len(value) % 4)
+        return data + b''.join(children)
+
+    def ramdisk_tree(value, duplicate=False):
+        memory = node('memory-map', [('RAMDisk', value)])
+        return node('device-tree', children=[node('chosen', children=[memory] * (2 if duplicate else 1))])
+
+    def trust_tree(value, duplicate=False):
+        memory = node('memory-map', [('TrustCache', value)])
+        return node('device-tree', children=[node('chosen', children=[memory] * (2 if duplicate else 1))])
+
+    empty_tree = tree
+    tree = node('device-tree', children=[node('chosen',
+        [('darwinboot-memory-size', struct.pack('<Q', args.memory_size))] if args.memory_size else [], children=[
+        node('memory-map', [('RAMDisk', bytes(16)), ('TrustCache', bytes(16))])])])
+    extra_trees = {'missing-ramdisk-adt': empty_tree,
+                   'stale-ramdisk-adt': ramdisk_tree(struct.pack('<QQ', 0x1000, 0x1000)),
+                   'bad-ramdisk-size': ramdisk_tree(bytes(8)),
+                   'duplicate-ramdisk': ramdisk_tree(bytes(16), duplicate=True),
+                   'missing-trustcache': trust_tree(bytes(16)),
+                   'orphan-trustcache': empty_tree,
+                   'stale-trustcache': trust_tree(struct.pack('<QQ', 0x1000, 56)),
+                   'duplicate-trustcache': trust_tree(bytes(16), duplicate=True),
+                   **{name: trust_tree(bytes(16)) for name in
+                      ('bad-trustcache-version', 'bad-trustcache-count',
+                       'bad-trustcache-offset', 'bad-trustcache-order')}}
+    for name, properties in {
+            'bad-memory-size': [('darwinboot-memory-size', bytes(4))],
+            'unavailable-memory-window': [('darwinboot-memory-size', struct.pack('<Q', 0x40000000))],
+            'small-memory-window': [('darwinboot-memory-size', struct.pack('<Q', 0))],
+            'unaligned-memory-window': [('darwinboot-memory-size', struct.pack('<Q', 0x10001000))],
+            'large-memory-window': [('darwinboot-memory-size', struct.pack('<Q', 0x200200000))],
+            'duplicate-memory-window': [('darwinboot-memory-size', struct.pack('<Q', 0x20000000))] * 2,
+            'misplaced-memory-window': [('darwinboot-memory-size', struct.pack('<Q', 0x20000000))]}.items():
+        extra_trees[name] = (node('device-tree', properties, [node('chosen')]) if name == 'misplaced-memory-window'
+                             else node('device-tree', children=[node('chosen', properties)]))
+    module = struct.pack('<I16sI', 2, bytes(range(16)), 1) + bytes([0x11]) * 20 + bytes([2, 0, 0, 0])
+    trustcache = struct.pack('<2I', 1, 8) + module
+    trust_variants = {name: trustcache for name in ('kernel', 'orphan-trustcache', 'stale-trustcache',
+                      'duplicate-trustcache', 'bad-trustcache-version', 'bad-trustcache-count', 'bad-trustcache-offset')}
+    for name, offset, value in [('bad-trustcache-version', 8, 3), ('bad-trustcache-count', 28, 0xffffffff),
+                               ('bad-trustcache-offset', 4, 0xfffffff0)]:
+        modified = bytearray(trustcache)
+        struct.pack_into('<I', modified, offset, value)
+        trust_variants[name] = modified
+    unordered = bytearray(trustcache + bytes([0x10]) * 20 + bytes([2, 0, 0, 0]))
+    struct.pack_into('<I', unordered, 28, 2)
+    trust_variants['bad-trustcache-order'] = unordered
+    (output / 'ramdisk.bin').write_bytes(b'DRAMDISK' + bytes(4088) + b'\xa5')
+    variants = {'kernel': bytes(image), 'bad-adt': bytes(image), 'missing-adt': bytes(image),
+                **{name: bytes(image) for name in extra_trees}}
+    for name, offset, fmt, value in [('bad-subtype', 8, '<I', 3),
+                                     ('bad-command', 20, '<I', len(image)),
+                                     ('bad-overlap', 32 + 72 + 24, '<Q', BASE + 0x1000),
+                                     ('bad-entry', 32 + 144 + 272, '<Q', BASE + 0x3000)]:
+        modified = bytearray(image)
+        struct.pack_into(fmt, modified, offset, value)
+        variants[name] = bytes(modified)
+    for name, data in variants.items():
+        path = output / f'{name}.macho'
+        path.write_bytes(data)
+        adt = path.with_suffix('.macho.adt')
+        adt.unlink(missing_ok=True)
+        sidecar = path.with_suffix('.macho.trustcache')
+        sidecar.unlink(missing_ok=True)
+        if name in trust_variants:
+            sidecar.write_bytes(trust_variants[name])
+        if name != 'missing-adt':
+            adt.write_bytes(b'\xff' * 8 if name == 'bad-adt' else extra_trees.get(name, tree))
+    print('Synthetic Mach-O/ADT fixtures generated')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/research/boot-chain-04/darwinboot/Test/packed_ramdisk.py b/research/boot-chain-04/darwinboot/Test/packed_ramdisk.py
new file mode 100644
index 0000000..87501ab
--- /dev/null
+++ b/research/boot-chain-04/darwinboot/Test/packed_ramdisk.py
@@ -0,0 +1,160 @@
+#!/usr/bin/env python3
+"""Lossless zero-page packing for the DarwinBoot DBRDISK1 input format."""
+import argparse
+import hashlib
+from pathlib import Path
+import struct
+
+PAGE = 4096
+MAX_INPUT = 256 * 1024**2
+MAX_LOGICAL = 1024**4
+ZERO = bytes(1024**2)
+
+
+def regions(blob):
+    if len(blob) < 32 or len(blob) > MAX_INPUT:
+        raise ValueError('Packed input size out of bounds')
+    magic, version, page, logical, count = struct.unpack_from('<8sIIQQ', blob)
+    if (magic != b'DBRDISK1' or version != 1 or page != PAGE or
+            not 0 < logical <= MAX_LOGICAL or logical % PAGE or
+            count > 65536 or count > (len(blob) - 32) // 16):
+        raise ValueError('Invalid packed RAM disk header')
+    cursor = 32 + 16 * count
+    end = 0
+    result = []
+    for index in range(count):
+        offset, length = struct.unpack_from('<QQ', blob, 32 + 16 * index)
+        if (not length or (offset | length) % PAGE or offset < end or
+                offset > logical or length > logical - offset or length > len(blob) - cursor):
+            raise ValueError('Invalid packed RAM disk extent')
+        result.append((offset, memoryview(blob)[cursor:cursor + length]))
+        end = offset + length
+        cursor += length
+    if cursor != len(blob):
+        raise ValueError('Trailing packed RAM disk bytes')
+    return logical, result
+
+
+PLAIN_HASH_LIMIT = 2 * 1024**3
+
+
+def logical_hash(logical, extents):
+    if logical > PLAIN_HASH_LIMIT:
+        return seed_identity(logical, extents)
+    digest = hashlib.sha256()
+    end = 0
+    for offset, data in [*extents, (logical, b'')]:
+        while end < offset:
+            count = min(len(ZERO), offset - end)
+            digest.update(memoryview(ZERO)[:count])
+            end += count
+        digest.update(data)
+        end += len(data)
+    return digest.hexdigest()
+
+
+def seed_identity(logical, extents):
+    """Identity of a disk above 2 GiB, as the native block driver computes it (drivers/RamBlock/SeedDisk.h seedIdentity): the size and
+    the nonzero pages with their indexes, so hashing a mostly empty disk of hundreds of GiB takes no longer than its content."""
+    digest = hashlib.sha256()
+    digest.update(b'SHNGSEED2' + struct.pack('<Q', logical))
+    for offset, data in extents:
+        for at in range(0, len(data), PAGE):
+            page = bytes(data[at:at + PAGE])
+            if any(page):
+                digest.update(struct.pack('<Q', (offset + at) // PAGE) + page)
+    return digest.hexdigest()
+
+
+def inspect(path):
+    size = path.stat().st_size
+    if not 0 < size <= MAX_INPUT:
+        raise ValueError('Encoded RAM disk exceeds 256 MiB input bound')
+    blob = path.read_bytes()
+    encoded_hash = hashlib.sha256(blob).hexdigest()
+    if blob[:8] == b'DBRDISK1':
+        logical, extents = regions(blob)
+        header = bytes(PAGE)
+        if extents and extents[0][0] == 0:
+            header = bytes(extents[0][1][:PAGE])
+        return dict(bytes=logical, sha256=logical_hash(logical, extents),
+                    encoded_bytes=size, encoded_sha256=encoded_hash, packed=True), header
+    if size % PAGE:
+        raise ValueError('Raw RAM disk must be page aligned')
+    return dict(bytes=size, sha256=encoded_hash, packed=False), blob[:PAGE]
+
+
+def data_ranges(stream, logical):
+    """(start, end) of the regions of the file that hold data, skipping holes (a sparse raw image of a large disk is mostly holes)."""
+    import os
+    fd = stream.fileno()
+    position = 0
+    while position < logical:
+        try:
+            start = os.lseek(fd, position, os.SEEK_DATA)
+        except OSError:
+            return
+        end = min(os.lseek(fd, start, os.SEEK_HOLE), logical)
+        yield start, end
+        position = end
+
+
+def pack(source, destination):
+    logical = source.stat().st_size
+    if not 0 < logical <= MAX_LOGICAL or logical % PAGE:
+        raise ValueError('Raw input must be page aligned and at most 1 TiB')
+    extents = []
+    digest = hashlib.sha256()
+    total = 32
+    large = logical > PLAIN_HASH_LIMIT
+    with source.open('rb') as stream:
+        # Above 2 GiB only the data regions are read; the identity (seed_identity) is computed from the result below.
+        def chunk_bases():
+            for start, end in data_ranges(stream, logical):
+                first = (start // len(ZERO)) * len(ZERO)
+                for chunk_start in range(first, end, len(ZERO)):
+                    yield chunk_start
+        bases = chunk_bases() if large else range(0, logical, len(ZERO))
+        last = -1
+        for base in bases:
+            if base <= last:
+                continue
+            last = base
+            stream.seek(base)
+            chunk = stream.read(min(len(ZERO), logical - base))
+            if len(chunk) != min(len(ZERO), logical - base):
+                raise ValueError('Raw input changed during packing')
+            if not large:
+                digest.update(chunk)
+            for at in range(0, len(chunk), PAGE):
+                page = chunk[at:at + PAGE]
+                if not any(page):
+                    continue
+                offset = base + at
+                if extents and extents[-1][0] + len(extents[-1][1]) == offset:
+                    extents[-1][1].extend(page)
+                else:
+                    extents.append((offset, bytearray(page)))
+                    total += 16
+                total += PAGE
+                if total > MAX_INPUT or len(extents) > 65536:
+                    raise ValueError('Nonzero input exceeds packed format bound')
+    with destination.open('xb') as output:
+        output.write(struct.pack('<8sIIQQ', b'DBRDISK1', 1, PAGE, logical, len(extents)))
+        for offset, data in extents:
+            output.write(struct.pack('<QQ', offset, len(data)))
+        for _, data in extents:
+            output.write(data)
+    metadata, _ = inspect(destination)
+    if not large and metadata['sha256'] != digest.hexdigest():
+        raise ValueError('Packed reconstruction differs from complete raw input hash')
+    return metadata
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('source', type=Path)
+    parser.add_argument('destination', type=Path)
+    args = parser.parse_args()
+    import json
+    print(json.dumps(pack(args.source, args.destination), indent=2))
