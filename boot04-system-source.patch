+return DarwinWindowSizeValid(w) && K70HeapWindowCandidate(a,b,k,w,o);
+}
+''')
+    subprocess.run(['clang', '--target=aarch64-unknown-windows-msvc', '-ffreestanding',
+                    '-fno-builtin', '-Wall', '-Wextra', '-Werror',
+                    '-I'+str(root/'DarwinBootPkg/Driver'), '-c', str(work/'coff.c'),
+                    '-o', str(work/'coff.obj')], check=True)
+print('PASS AArch64 COFF policy compile; full EDK driver build is a separate check')
+manifest = {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
+            for p in sorted(root.rglob('*')) if p.is_file() and p.name != 'heap-window-results.json'}
+(root/'Test/heap-window-results.json').write_text(json.dumps({
+  'host_sanitizers': 'address,undefined', 'allocator_real_source': True,
