@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Export only reviewed experiment/tool source as new files in a git patch."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+DELIVERY = HERE.parent
+OUT = DELIVERY / 'device-source'
+mapping = {}
+extensions = {'.py', '.c', '.h', '.S', '.inf', '.dsc', '.fdf', '.inc', '.md'}
+for base, prefix in [(HERE, 'research/boot-chain-04'),
+                     (DELIVERY / 'system-build', 'research/system-build')]:
+    for source in sorted(base.rglob('*')):
+        if not source.is_file() or any(x in {'__pycache__', 'Build', '.git'} for x in source.parts):
+            continue
+        if source.suffix not in extensions and source.name not in {'LICENSE', 'interrupted-build.json'}:
+            continue
+        text = source.read_text(encoding='utf-8-sig').replace('\r\n', '\n')
+        if '\0' in text:
+            raise SystemExit('Binary source rejected: ' + str(source))
+        mapping[prefix + '/' + source.relative_to(base).as_posix()] = text.encode('utf-8')
+manifest = {}
+with tempfile.TemporaryDirectory(prefix='k70-boot04-source-') as name:
+    repo = Path(name)
+    subprocess.run(['git', 'init', '-q', str(repo)], check=True)
+    for target, data in mapping.items():
+        path = repo / target
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(data)
+        manifest[target] = {'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}
+    subprocess.run(['git', '-C', str(repo), 'add', '--all'], check=True)
+    patch = subprocess.check_output(['git', '-C', str(repo), 'diff', '--cached', '--binary', '--no-ext-diff'])
+with tempfile.TemporaryDirectory(prefix='k70-boot04-apply-') as name:
+    repo = Path(name)
+    subprocess.run(['git', 'init', '-q', str(repo)], check=True)
+    candidate = repo / 'source.patch'
+    candidate.write_bytes(patch)
+    subprocess.run(['git', '-C', str(repo), 'apply', '--check', str(candidate)], check=True)
+    subprocess.run(['git', '-C', str(repo), 'apply', str(candidate)], check=True)
+    for target, data in mapping.items():
+        if (repo / target).read_bytes() != data:
+            raise SystemExit('Patch roundtrip mismatch: ' + target)
+patch_path = OUT / 'boot04-system-source.patch'
+patch_path.write_bytes(patch)
+result = {'format': 'new-source-files-git-patch', 'files': manifest,
+          'file_count': len(mapping), 'patch_bytes': len(patch),
+          'patch_sha256': hashlib.sha256(patch).hexdigest(),
+          'clean_repository_apply_and_exact_readback': True,
+          'contains_apple_or_oem_binaries': False}
+(OUT / 'boot04-system-source.manifest.json').write_text(json.dumps(result, indent=2) + '\n')
+print(json.dumps({key: value for key, value in result.items() if key != 'files'}, indent=2))
