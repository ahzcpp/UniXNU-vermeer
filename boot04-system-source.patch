@@ -0,0 +1,160 @@
+#!/usr/bin/env python3
+"""Build an OFFLINE two-window SHNGROOT candidate; never accesses a device.
+
+This deliberately uses only a measured partition capacity. It does not invent
+GPT LBAs, configure a UFS driver, create a Data seed, or promise a bootable OS.
+"""
+import argparse
+import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import sys
+
+MIB = 1 << 20
+CAPACITY = 0x3886BBB000
+CORE_REVISION = 'c1ecc5b74c9dc4ced13bcfbd81a2c3998025a5e5'
+INPUTS = (
+    ('OS', '044-76040-038.dmg', 5157406069, 6077580800,
+     '3f99b859c9728379110b66657c7b15285bcb1925ad8b5726542e2cdcf8b1028d'),
+    ('SystemOS', '044-76034-038.dmg', 3303014400, 3303014400,
+     'b4908cde41d23e6bc05e6af51a2c9eeb00cf0f863a6a18b1600c96a3fd70414f'),
+)
+
+
+def require(value, message):
+    if not value:
+        raise RuntimeError(message)
+
+
+def digest(path):
+    result = hashlib.sha256()
+    with path.open('rb') as stream:
+        for chunk in iter(lambda: stream.read(8 * MIB), b''):
+            result.update(chunk)
+    return result.hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--core', type=Path, required=True)
+    parser.add_argument('--inputs', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--toolchain', type=Path, required=True)
+    args = parser.parse_args()
+    revision = subprocess.check_output(
+        ['git', '-C', str(args.core), 'rev-parse', 'HEAD'], text=True).strip()
+    require(revision == CORE_REVISION, 'unexpected UniXNU source revision')
+    os.environ['UNIXNU_TOOLCHAIN'] = str(args.toolchain.resolve())
+    sys.path.insert(0, str(args.core / 'scripts'))
+    from unixnu.udif import Image
+    from unixnu.udif import RAW, ZERO_FILL, IGNORE
+
+    def bounded_image(path):
+        decoded = Image(path)
+        if decoded.chunks is not None:
+            chunks = []
+            for start, length, kind, offset, stored in decoded.chunks:
+                if kind in (ZERO_FILL, IGNORE, RAW):
+                    if kind == RAW:
+                        require(stored == length, 'raw UDIF chunk length mismatch')
+                    done = 0
+                    while done < length:
+                        size = min(8 * MIB, length - done)
+                        chunks.append((start + done, size, kind,
+                                       offset + done if kind == RAW else offset,
+                                       size if kind == RAW else stored))
+                        done += size
+                else:
+                    require(length <= 64 * MIB and stored <= 64 * MIB,
+                            'unexpected compressed decoder allocation size')
+                    chunks.append((start, length, kind, offset, stored))
+            decoded.chunks = chunks
+        return decoded
+
+    args.out.mkdir(parents=True, exist_ok=True)
+    image = args.out / 'ipados-17.7.11-two-window-candidate.img'
+    partial = image.with_suffix('.img.partial')
+    report = image.with_suffix('.json')
+    require(not any(p.exists() for p in (image, partial, report)),
+            'output already exists; choose a fresh --out directory')
+    records = []
+    cursor = MIB
+    for name, filename, stored, raw, pin in INPUTS:
+        path = args.inputs / filename
+        require(path.is_file() and path.stat().st_size == stored,
+                'missing or wrong-sized input: ' + filename)
+        actual = digest(path)
+        require(actual == pin, 'input SHA-256 mismatch: ' + filename)
+        decoded = bounded_image(path)
+        require(decoded.size == raw, 'raw disk size mismatch: ' + filename)
+        records.append(dict(name=name, input_path=str(path.resolve()),
+                            input_bytes=stored, input_sha256=actual,
+                            offset=cursor, size=raw, block_size=512, flags=1,
+                            udif=decoded.chunks is not None))
+        cursor += (raw + MIB - 1) // MIB * MIB
+    require(cursor <= CAPACITY and cursor % 4096 == 0, 'capacity/alignment check failed')
+    require(shutil.disk_usage(args.out).free >= cursor + 512 * MIB,
+            'insufficient free space for complete candidate')
+    print(json.dumps(dict(stage='inputs-verified', image_bytes=cursor,
+                          capacity_bytes=CAPACITY), indent=2), flush=True)
+    try:
+        with partial.open('xb') as target:
+            target.truncate(cursor)
+            for row in records:
+                target.seek(row['offset'])
+                sha, count = hashlib.sha256(), 0
+                for block in bounded_image(Path(row['input_path'])).blocks():
+                    require(len(block) <= row['size'] - count, 'decoder exceeded input size')
+                    target.write(block)
+                    sha.update(block)
+                    count += len(block)
+                require(count == row['size'], 'short decoded window')
+                row['sha256'] = sha.hexdigest()
+                print(json.dumps(dict(stage='window-written', **row)), flush=True)
+            header = bytearray(4096)
+            header[:8] = b'SHNGROOT'
+            struct.pack_into('<IIQ', header, 8, 1, len(records), cursor)
+            for index, row in enumerate(records):
+                struct.pack_into('<32sQQII32s40s', header, 24 + index * 128,
+                                 row['name'].encode('ascii'), row['offset'], row['size'],
+                                 512, 1, bytes.fromhex(row['sha256']), bytes(40))
+            header[4064:] = hashlib.sha256(header[:4064]).digest()
+            target.seek(0)
+            target.write(header)
+            target.flush()
+            os.fsync(target.fileno())
+        partial.rename(image)
+        result = dict(
+            created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
+            status='offline_candidate_not_device_verified',
+            version='17.7.11', build='21H461', product='iPad7,1',
+            image_path=str(image.resolve()), image_bytes=cursor, image_sha256=digest(image),
+            manifest_version=1, manifest_sha256=hashlib.sha256(header).hexdigest(),
+            windows=records, measured_userdata_capacity_bytes=CAPACITY,
+            userdata_first_lba=None, userdata_last_lba=None, hardware_tested=False,
+            phone_written=False, contains_data_seed=False, desktop_boot_verified=False,
+            limitations=[
+                'Only OS and SystemOS windows; no writable Data seed, policies or GPU addon.',
+                'Current clean kernel disables native UFS/root publication and owner Data.',
+                'Actual GPT geometry and working storage/boot chain remain unverified.',
+                'This file is not advertised as a ready-to-flash operating system.'
+            ],
+            core_revision=revision,
+            decoder_source_sha256=digest(args.core / 'scripts/unixnu/udif.py'),
+            builder_source_sha256=digest(Path(__file__)),
+        )
+        report.write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
+        print(json.dumps(dict(stage='candidate-complete', image=str(image),
+                              sha256=result['image_sha256']), indent=2), flush=True)
+    except BaseException:
+        # A partial file is retained for diagnosis; it has no success report.
+        raise
+
+
+if __name__ == '__main__':
+    main()
