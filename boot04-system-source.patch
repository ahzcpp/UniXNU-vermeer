+#!/usr/bin/env python3
+"""Export a path/phone-identifier-free summary after independent verification."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+REVISION = 'c1ecc5b74c9dc4ced13bcfbd81a2c3998025a5e5'
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--core', type=Path, required=True)
+    parser.add_argument('--candidate-dir', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+    construction = json.loads((args.candidate_dir / 'ipados-17.7.11-two-window-candidate.json').read_text())
+    verification = json.loads((args.candidate_dir / 'verification.json').read_text())
+    if construction['image_sha256'] != verification['image_sha256']:
+        raise RuntimeError('construction and independent verification differ')
+    sources = []
+    for relative in ('scripts/unixnu/udif.py', 'scripts/unixnu/util.py', 'scripts/unixnu/userdata.py'):
+        actual = (args.core / relative).read_bytes()
+        pinned = subprocess.check_output(['git', '-C', str(args.core), 'show', REVISION + ':' + relative])
+        if actual != pinned:
+            raise RuntimeError('actual source differs byte-for-byte from pinned source: ' + relative)
+        sources.append(dict(path=relative, sha256=sha(actual), byte_identical_to_pinned_commit=True))
+    if sources[0]['sha256'] != construction['decoder_source_sha256']:
+        raise RuntimeError('decoder changed after construction')
+    script_dir = Path(__file__).resolve().parent
+    if sha((script_dir / 'build-root-candidate.py').read_bytes()) != construction['builder_source_sha256']:
+        raise RuntimeError('builder changed after construction')
+    if sha((script_dir / 'verify-root-candidate.py').read_bytes()) != verification['verifier_sha256']:
+        raise RuntimeError('verifier changed after verification')
+    result = dict(
+        created_utc=construction['created_utc'],
+        status='offline_two_window_candidate_verified',
+        product=construction['product'], version=construction['version'], build=construction['build'],
+        image_bytes=construction['image_bytes'], image_sha256=construction['image_sha256'],
+        manifest_version=construction['manifest_version'], manifest_sha256=construction['manifest_sha256'],
+        measured_userdata_capacity_bytes=construction['measured_userdata_capacity_bytes'],
+        userdata_absolute_lbas_known=False, core_revision=REVISION, source_files=sources,
+        tools=[dict(name=name, sha256=sha((script_dir / name).read_bytes())) for name in
+               ('build-root-candidate.py', 'verify-root-candidate.py', 'export-evidence.py')],
+        decoder_change='No upstream changes. Local builder splits RAW/zero/ignore extents into <=8MiB pieces; compressed extents are <=64MiB.',
+        inputs=[dict(member=Path(row['input_path']).name, stored_bytes=row['input_bytes'],
+                     stored_sha256=row['input_sha256']) for row in construction['windows']],
+        windows=verification['windows'],
+        phone_written=False, hardware_tested=False, contains_data_seed=False,
+        desktop_boot_verified=False,
+        independent_readback_verified=True,
+        limitations=[
+            'Only OS/SystemOS windows; no Data seed, root policies or GPU addon.',
+            'Clean kernel currently disables native UFS/root publication and owner Data.',
+            'This is not a ready-to-flash OS; real storage, root mounting and userland remain unverified.'
+        ],
+    )
+    args.out.write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
+    print(json.dumps(dict(summary=str(args.out), sha256=sha(args.out.read_bytes())), indent=2))
+
+
+if __name__ == '__main__':
+    main()
