+common = r'''
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <assert.h>
+typedef uint8_t UINT8; typedef uint64_t UINT64; typedef size_t UINTN; typedef int EFI_STATUS;
+typedef uint64_t EFI_PHYSICAL_ADDRESS; typedef unsigned short CHAR16;
+typedef int BOOLEAN;
+#define STATIC static
+#define VOID void
+#define TRUE 1
+#define FALSE 0
+#define EFI_SUCCESS 0
+#define EFI_OUT_OF_RESOURCES 9
+#define EFI_ERROR(x) ((x) != 0)
+#define MAX_UINT64 UINT64_MAX
+#define EFI_PAGE_SIZE 4096ULL
+#define EFI_PAGES_TO_SIZE(n) ((n) * EFI_PAGE_SIZE)
+#define EFI_SIZE_TO_PAGES(n) (((n) + 4095) / 4096)
+#define EfiConventionalMemory 7
+#define EfiLoaderCode 1
+#define AllocateAddress 2
+#define MIN(a,b) ((a)<(b)?(a):(b))
+#define MAX(a,b) ((a)>(b)?(a):(b))
+#define BLOCK_SIZE 0x200000ULL
+typedef struct { UINT64 PhysicalStart, NumberOfPages; unsigned Type; } EFI_MEMORY_DESCRIPTOR;
+typedef struct { UINT64 Base; } KERNEL;
+#include "HeapWindow.h"
+#include "WindowSize.h"
+static EFI_MEMORY_DESCRIPTOR Inputs[8];
+static size_t InputCount, Requests;
+static int Deny;
+static EFI_STATUS GetMap(EFI_MEMORY_DESCRIPTOR **Map, UINTN *Capacity, UINTN *Size, UINTN *Key, UINTN *Stride) {
+  *Capacity = *Size = InputCount * sizeof(**Map);
+  *Key = 1; *Stride = sizeof(**Map);
+  *Map = malloc(*Size);
+  if (!*Map) abort();
+  memcpy(*Map, Inputs, *Size); return 0;
+}
