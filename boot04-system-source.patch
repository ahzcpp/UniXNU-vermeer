@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""Independently parse/re-hash SHNGROOT, GPT/APFS metadata; no core imports."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+import uuid
+import zlib
+
+MIB = 1 << 20
+CAPACITY = 0x3886BBB000
+
+
+def require(value, message):
+    if not value:
+        raise RuntimeError(message)
+
+
+def hash_range(stream, offset, size):
+    stream.seek(offset)
+    sha = hashlib.sha256()
+    while size:
+        data = stream.read(min(size, 8 * MIB))
+        require(data, 'short file during SHA-256')
+        sha.update(data)
+        size -= len(data)
+    return sha.hexdigest()
+
+
+def read_at(stream, offset, size):
+    stream.seek(offset)
+    data = stream.read(size)
+    require(len(data) == size, 'short metadata read')
+    return data
+
+
+def apfs_container(stream, start, size):
+    block = read_at(stream, start, 4096)
+    require(block[32:36] == b'NXSB', 'APFS NXSB magic missing')
+    block_size = struct.unpack_from('<I', block, 36)[0]
+    blocks = struct.unpack_from('<Q', block, 40)[0]
+    require(block_size == 4096 and 0 < blocks <= size // block_size,
+            'APFS container geometry outside disk window')
+    # APFS object checksum is a Fletcher-64 checksum over all bytes after it.
+    data = read_at(stream, start, block_size)
+    mod, s1, s2 = 0xffffffff, 0, 0
+    for (word,) in struct.iter_unpack('<I', data[8:]):
+        s1 = (s1 + word) % mod
+        s2 = (s2 + s1) % mod
+    lo = (mod - (s1 + s2) % mod) % mod
+    hi = (mod - (s1 + lo) % mod) % mod
+    expected = struct.pack('<II', lo, hi)
+    require(expected == data[:8], 'APFS container object checksum mismatch')
+    return dict(magic='NXSB', block_size=block_size, blocks=blocks,
+                container_uuid=str(uuid.UUID(bytes=data[72:88])).upper(),
+                superblock_checksum_valid=True)
+
+
+def inspect_disk(stream, offset, size):
+    first = read_at(stream, offset, min(size, 4096))
+    if first[32:36] == b'NXSB':
+        return dict(layout='raw-apfs', apfs=apfs_container(stream, offset, size))
+    header = read_at(stream, offset + 512, 512)
+    require(header[:8] == b'EFI PART', 'window is neither raw APFS nor a 512-byte GPT disk')
+    revision, length, crc = struct.unpack_from('<III', header, 8)
+    require(revision == 0x10000 and 92 <= length <= 512, 'GPT header revision/length invalid')
+    check = bytearray(header[:length])
+    check[16:20] = bytes(4)
+    require(zlib.crc32(check) & 0xffffffff == crc, 'GPT primary header CRC mismatch')
+    current, backup, first_usable, last_usable = struct.unpack_from('<QQQQ', header, 24)
+    table_lba, count, entry_size, entries_crc = struct.unpack_from('<QIII', header, 72)
+    require(current == 1 and backup < size // 512 and first_usable <= last_usable < backup,
+            'GPT disk geometry invalid')
+    require(0 < count <= 4096 and 128 <= entry_size <= 4096 and entry_size % 8 == 0,
+            'GPT entry geometry invalid')
+    require(table_lba >= 2 and table_lba * 512 + count * entry_size <= first_usable * 512,
+            'GPT table outside metadata area')
+    table = read_at(stream, offset + table_lba * 512, count * entry_size)
+    require(zlib.crc32(table) & 0xffffffff == entries_crc, 'GPT entries CRC mismatch')
+    backup_header = read_at(stream, offset + backup * 512, 512)
+    require(backup_header[:8] == b'EFI PART', 'GPT backup header absent')
+    backup_length, backup_crc = struct.unpack_from('<II', backup_header, 12)
+    require(92 <= backup_length <= 512, 'GPT backup header length invalid')
+    check = bytearray(backup_header[:backup_length])
+    check[16:20] = bytes(4)
+    require(zlib.crc32(check) & 0xffffffff == backup_crc, 'GPT backup header CRC mismatch')
+    require(struct.unpack_from('<QQ', backup_header, 24) == (backup, 1),
+            'GPT backup LBA relationship invalid')
+    require(backup_header[40:72] == header[40:72] and backup_header[80:92] == header[80:92],
+            'GPT backup disk facts differ')
+    backup_table_lba = struct.unpack_from('<Q', backup_header, 72)[0]
+    require(last_usable * 512 < backup_table_lba * 512 and
+            backup_table_lba * 512 + len(table) <= backup * 512,
+            'GPT backup table bounds invalid')
+    require(read_at(stream, offset + backup_table_lba * 512, len(table)) == table,
+            'GPT backup entries differ')
+    partitions = []
+    for index in range(count):
+        row = table[index * entry_size:(index + 1) * entry_size]
+        if row[:16] == bytes(16):
+            continue
+        first_lba, last_lba = struct.unpack_from('<QQ', row, 32)
+        require(first_usable <= first_lba <= last_lba <= last_usable,
+                'GPT partition out of usable range')
+        require(all(last_lba < p['first_lba'] or first_lba > p['last_lba'] for p in partitions),
+                'GPT partitions overlap')
+        part = dict(index=index, type_uuid=str(uuid.UUID(bytes_le=row[:16])).upper(),
+                    first_lba=first_lba, last_lba=last_lba,
+                    name=row[56:128].decode('utf-16-le').split('\0', 1)[0])
+        marker = read_at(stream, offset + first_lba * 512 + 32, 4)
+        if marker == b'NXSB':
+            part['apfs'] = apfs_container(stream, offset + first_lba * 512,
+                                         (last_lba - first_lba + 1) * 512)
+        partitions.append(part)
+    require(any('apfs' in part for part in partitions), 'GPT disk has no APFS container')
+    return dict(layout='gpt-512', primary_header_crc_valid=True,
+                backup_header_crc_valid=True, entries_crc_valid=True,
+                backup_entries_match=True, partitions=partitions)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('image', type=Path)
+    parser.add_argument('--report', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args()
+    require(not args.out.exists(), 'verification output already exists')
+    report = json.loads(args.report.read_text(encoding='utf-8'))
+    file_size = args.image.stat().st_size
+    require(file_size == report['image_bytes'] and file_size <= CAPACITY and file_size % 4096 == 0,
+            'file size/capacity/alignment mismatch')
+    result = dict(status='offline_candidate_verified', hardware_tested=False,
+                  phone_written=False, contains_data_seed=False, desktop_boot_verified=False,
+                  capacity_only=True, absolute_userdata_lbas_known=False, windows=[])
+    with args.image.open('rb') as stream:
+        header = read_at(stream, 0, 4096)
+        require(header[:8] == b'SHNGROOT', 'manifest magic mismatch')
+        version, count, image_size = struct.unpack_from('<IIQ', header, 8)
+        require((version, count, image_size) == (1, 2, file_size), 'manifest facts mismatch')
+        require(hashlib.sha256(header[:4064]).digest() == header[4064:], 'manifest content hash mismatch')
+        require(hashlib.sha256(header).hexdigest() == report['manifest_sha256'], 'manifest report hash mismatch')
+        prior_end = MIB
+        for index, expected_name in enumerate(('OS', 'SystemOS')):
+            name_raw, offset, size, block_size, flags, sha, reserved = struct.unpack_from(
+                '<32sQQII32s40s', header, 24 + index * 128)
+            name = name_raw.split(b'\0', 1)[0].decode('ascii')
+            require(name == expected_name and name_raw == name.encode().ljust(32, b'\0'),
+                    'manifest name mismatch')
+            require(offset == prior_end and offset % MIB == 0 and size > 0 and size % 512 == 0,
+                    'manifest offset/size/alignment mismatch')
+            require(size <= file_size - offset and block_size == 512 and flags == 1 and reserved == bytes(40),
+                    'manifest window bounds/attributes mismatch')
+            end = offset + size
+            next_start = (end + MIB - 1) // MIB * MIB
+            require(read_at(stream, end, next_start - end) == bytes(next_start - end),
+                    'nonzero inter-window padding')
+            actual_sha = hash_range(stream, offset, size)
+            require(actual_sha == sha.hex(), 'window SHA-256 mismatch: ' + name)
+            expected = report['windows'][index]
+            require((name, offset, size, actual_sha) ==
+                    (expected['name'], expected['offset'], expected['size'], expected['sha256']),
+                    'window disagrees with construction report')
+            result['windows'].append(dict(name=name, offset=offset, size=size,
+                                          sha256=actual_sha, disk=inspect_disk(stream, offset, size)))
+            prior_end = next_start
+            print(json.dumps(dict(stage='window-verified', name=name, sha256=actual_sha)), flush=True)
+        require(prior_end == file_size, 'unaccounted tail')
+        require(header[24 + count * 128:4064] == bytes(4064 - 24 - count * 128),
+                'nonzero unused manifest bytes')
+        require(read_at(stream, 4096, MIB - 4096) == bytes(MIB - 4096),
+                'nonzero manifest-area padding')
+        actual = hash_range(stream, 0, file_size)
+        require(actual == report['image_sha256'], 'complete image SHA-256 mismatch')
+        result.update(image_bytes=file_size, image_sha256=actual,
+                      manifest_sha256=hashlib.sha256(header).hexdigest(),
+                      verifier_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest())
+    args.out.write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
+    print(json.dumps(dict(stage='verification-complete', sha256=actual)), flush=True)
+
+
+if __name__ == '__main__':
+    main()
