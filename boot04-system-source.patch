diff --git a/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/Entry.S b/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/Entry.S
new file mode 100644
index 0000000..8c6c0a4
--- /dev/null
+++ b/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/Entry.S
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include <AsmMacroLib.h>
+
+ASM_FUNC(DarwinCurrentEl)
+  mrs x0, CurrentEL
+  ret
+
+// x0=boot_args PA, x1=entry PA, x2=owned PA, x3=owned size, x4=frame buffer
+// PA (0 for none), x5=its size in bytes. EL1 only.
+// Diagnostic-only bands at the bottom; x0 (boot_args) and x1 (entry)
+// remain untouched. The normal XNU entry probes use the top bands.
+.macro HANDOFF_BAND band, lo, hi
+  cbz x14, 9f
+  lsr x13, x15, #4
+  bic x13, x13, #7
+  cbz x13, 9f
+  mov x17, #\band
+  mul x12, x13, x17
+  add x12, x14, x12
+  movz w16, #\lo
+  movk w16, #\hi, lsl #16
+8:
+  stp w16, w16, [x12], #8
+  subs x13, x13, #8
+  b.hi 8b
+  dsb sy
+9:
+.endm
+
+ASM_FUNC(DarwinEnter)
+  mov x14, x4
+  mov x15, x5
+  msr daifset, #15
+  // Paint the top 1/16 of the framebuffer green (BGRA 0xFF00FF00)
+  // before cache maintenance, MMU shutdown and the branch to the kernel.
+  cbz x4, 2f
+  lsr x9, x5, #4
+  bic x9, x9, #7
+  mov w10, #0xFF00
+  movk w10, #0xFF00, lsl #16
+  mov x11, x4
+3:
+  stp w10, w10, [x11], #8
+  subs x9, x9, #8
+  b.hi 3b
+  dsb sy
+2:
+  add x5, x2, x3
+  mrs x6, ctr_el0
+  ubfx x6, x6, #16, #4
+  mov x7, #4
+  lsl x6, x7, x6
+  sub x7, x6, #1
+  bic x4, x2, x7
+  dsb sy
+1:
+  dc civac, x4
+  add x4, x4, x6
+  cmp x4, x5
+  b.lo 1b
+  dsb sy
+  ic iallu
+  dsb sy
+  isb
+  // Yellow: owned-window cache maintenance completed.
+  HANDOFF_BAND 13, 0xFF00, 0xFFFF
+  mrs x4, sctlr_el1
+  bic x4, x4, #1
+  bic x4, x4, #4
+  bic x4, x4, #0x1000
+  msr sctlr_el1, x4
+  isb
+  tlbi vmalle1
+  dsb sy
+  isb
+  // Cyan: MMU disabled and TLB invalidation completed.
+  HANDOFF_BAND 14, 0xFFFF, 0xFF00
+  br x1
diff --git a/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/HeapWindow.h b/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/HeapWindow.h
new file mode 100644
index 0000000..cd7ff3e
--- /dev/null
+++ b/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/HeapWindow.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef K70_BOOT04_HEAP_WINDOW_H
+#define K70_BOOT04_HEAP_WINDOW_H
+
+// This experiment is restricted to the matching stock vermeer DXE Heap.
+// These bounds are not a measurement of the rest of the handset's DRAM.
+#define K70_HEAP_BASE  0xBAB00000ULL
+#define K70_HEAP_END   0xC7CC0000ULL
+#define K70_BLOCK_MASK 0x001FFFFFULL
+
+static inline int
+K70InputOutsideHeap (unsigned long long Base, unsigned long long Bytes)
+{
+  if (Base == 0 || Bytes == 0 || Bytes > ~0ULL - Base) {
+    return 0;
+  }
+  return Base >= K70_HEAP_END || Base + Bytes <= K70_HEAP_BASE;
+}
+
+// RunStart..RunEnd is a single, already verified conventional-memory run.
+// Preserve XNU's 2 MiB physical/virtual phase; never bridge a reserved hole.
+static inline int
+K70HeapWindowCandidate (
+  unsigned long long RunStart,
+  unsigned long long RunEnd,
+  unsigned long long KernelBase,
+  unsigned long long WindowSize,
+  unsigned long long *Candidate
+  )
+{
+  unsigned long long Start, End, Address;
+  if (Candidate == 0 || RunStart >= RunEnd || WindowSize == 0 ||
+      (WindowSize & 0xFFFULL) != 0) {
+    return 0;
+  }
+  Start = RunStart < K70_HEAP_BASE ? K70_HEAP_BASE : RunStart;
+  End = RunEnd > K70_HEAP_END ? K70_HEAP_END : RunEnd;
+  if (Start >= End) {
+    return 0;
+  }
+  Address = (Start & ~K70_BLOCK_MASK) | (KernelBase & K70_BLOCK_MASK);
+  if (Address < Start) {
+    Address += K70_BLOCK_MASK + 1;
+  }
+  if (Address >= End || WindowSize > End - Address) {
+    return 0;
+  }
+  *Candidate = Address;
+  return 1;
+}
+
+static inline int
+K70HeapLayoutFits (unsigned long long Address, unsigned long long WindowSize,
+                   unsigned long long Used)
+{
+  return Address >= K70_HEAP_BASE && Address < K70_HEAP_END &&
+         WindowSize >= 0x200000ULL && WindowSize <= K70_HEAP_END - Address &&
+         Used <= WindowSize - 0x200000ULL;
+}
+#endif
diff --git a/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/PackedRamdisk.h b/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/PackedRamdisk.h
new file mode 100644
index 0000000..f34485a
--- /dev/null
+++ b/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/PackedRamdisk.h
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Little-endian DBRDISK1: version, page size, expanded bytes, extent count;
+// then sorted (destination offset, byte count) pairs and concatenated bytes.
+// Omitted ranges are real zeroed RAM, not virtual/simulated disk storage.
+#ifndef DARWIN_BOOT_PACKED_RAMDISK_H
+#define DARWIN_BOOT_PACKED_RAMDISK_H
+
+// A packed disk handed to the native sparse block driver keeps only its nonzero pages (KeepPacked), so its logical size is bounded by the
+// disk format, not by memory; a dense expansion still has to fit the window, which the caller checks.
+#define SIZE_MAX_LOGICAL  (1ULL << 40)
+
+STATIC
+BOOLEAN
+RamdiskLayout (CONST VOID *Input, UINTN InputSize, UINTN *Expanded, BOOLEAN *Packed)
+{
+  CONST UINT8 *Bytes = Input;
+  UINT64 Logical, Count, Table, Cursor, End, Index, Offset, Length;
+  *Expanded = InputSize;
+  *Packed = FALSE;
+  if ((InputSize > SIZE_256MB) || ((Input == NULL) != (InputSize == 0))) { return FALSE; }
+  if ((InputSize < 8) || (CompareMem (Input, "DBRDISK1", 8) != 0)) { return TRUE; }
+  if ((InputSize < 32) || (ReadUnaligned32 ((CONST UINT32 *)(Bytes + 8)) != 1) ||
+      (ReadUnaligned32 ((CONST UINT32 *)(Bytes + 12)) != EFI_PAGE_SIZE)) { return FALSE; }
+  Logical = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 16));
+  Count = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 24));
+  if ((Logical == 0) || (Logical > SIZE_MAX_LOGICAL) || (Logical & (EFI_PAGE_SIZE - 1)) ||
+      (Count > 65536) || (Count > (InputSize - 32) / 16)) { return FALSE; }
+  Table = 32 + Count * 16;
+  Cursor = Table;
+  End = 0;
+  for (Index = 0; Index < Count; Index++) {
+    Offset = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 32 + Index * 16));
+    Length = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 40 + Index * 16));
+    if (!Length || ((Offset | Length) & (EFI_PAGE_SIZE - 1)) || (Offset < End) ||
+        (Offset > Logical) || (Length > Logical - Offset) || (Length > InputSize - Cursor)) { return FALSE; }
+    End = Offset + Length;
+    Cursor += Length;
+  }
+  if (Cursor != InputSize) { return FALSE; }
+  *Expanded = (UINTN)Logical;
+  *Packed = TRUE;
+  return TRUE;
+}
+
+STATIC
+VOID
+CopyRamdisk (VOID *Destination, CONST VOID *Input, UINTN InputSize, BOOLEAN Packed)
+{
+  CONST UINT8 *Bytes = Input;
+  UINT64 Count, Cursor, Index, Offset, Length;
+  // Caller has validated every range and zeroed the entire expanded allocation.
+  if (!Packed) { CopyMem (Destination, Input, InputSize); return; }
+  Count = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 24));
+  Cursor = 32 + Count * 16;
+  for (Index = 0; Index < Count; Index++) {
+    Offset = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 32 + Index * 16));
+    Length = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 40 + Index * 16));
+    CopyMem ((UINT8 *)Destination + Offset, Bytes + Cursor, (UINTN)Length);
+    Cursor += Length;
+  }
+}
+#endif
diff --git a/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/WindowSize.h b/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/WindowSize.h
new file mode 100644
index 0000000..2d878e8
--- /dev/null
+++ b/research/boot-chain-04/darwinboot/DarwinBootPkg/Driver/WindowSize.h
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef DARWINBOOT_WINDOW_SIZE_H
+#define DARWINBOOT_WINDOW_SIZE_H
+// Allocation still requires one real conventional-memory run. This is a
+// parser bound, never a declaration of available RAM or an allocation fallback.
+static inline int DarwinWindowSizeValid(unsigned long long size) {
+  // K70 boot04 only: allow an explicit 128 MiB ADT request. The default in
+  // DarwinBoot.c stays 256 MiB; this does not invent or fall back to RAM.
+  return size >= 0x08000000ULL && size <= 0x200000000ULL && !(size & 0x1fffffULL);
+}
+#endif
