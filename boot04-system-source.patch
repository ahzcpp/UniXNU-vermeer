+  Region(0xE671D000, 0x190E3000, 7);
+  Check(0, 0, 0x08000000); assert(Requests == 0);
+  // A map spanning the heap is clamped, not a permit to extend its bounds.
+  Reset(); Region(0x80000000, 0x80000000, 7);
+  Check(1, Good, 0x08000000); assert(Requests == 1);
+  Reset(); Region(K70_HEAP_BASE, K70_HEAP_END-K70_HEAP_BASE, 7); Deny = 1;
+  Check(0, 0, 0x08000000); assert(Requests == 1);
+  // Default 256 MiB cannot fit and must be refused rather than silently shrunk.
+  Reset(); Region(K70_HEAP_BASE, K70_HEAP_END-K70_HEAP_BASE, 7);
+  Check(0, 0, 0x10000000); assert(Requests == 0);
+  assert(DarwinWindowSizeValid(0x08000000));
+  assert(DarwinWindowSizeValid(0x10000000));
+  assert(!DarwinWindowSizeValid(0x07E00000));
+  assert(!DarwinWindowSizeValid(0x08001000));
+  assert(K70HeapLayoutFits(Good, 0x08000000, 0x07E00000));
+  assert(!K70HeapLayoutFits(Good, 0x08000000, 0x07E00001));
+  assert(!K70HeapLayoutFits(Good, UINT64_MAX, 0));
+  assert(!K70HeapLayoutFits(K70_HEAP_BASE-4096, 0x08000000, 1));
+  assert(!K70HeapLayoutFits(K70_HEAP_END, 0x08000000, 1));
+  assert(K70InputOutsideHeap(K70_HEAP_BASE-4096, 4096));
+  assert(K70InputOutsideHeap(K70_HEAP_END, 4096));
+  assert(!K70InputOutsideHeap(K70_HEAP_BASE-4096, 4097));
+  assert(!K70InputOutsideHeap(K70_HEAP_END-4096, 8192));
+  assert(!K70InputOutsideHeap(0, 4096));
+  assert(!K70InputOutsideHeap(1, UINT64_MAX));
+  // All 512 possible 4 KiB-aligned 2 MiB phases against boundary/map cases.
+  UINT64 Starts[] = {0, K70_HEAP_BASE-4096, K70_HEAP_BASE, K70_HEAP_BASE+4096,
+                    0xBF000000, K70_HEAP_END-4096, K70_HEAP_END, UINT64_MAX-4096};
+  UINT64 Ends[] = {0, K70_HEAP_BASE, K70_HEAP_BASE+4096, 0xBF000000,
+                  K70_HEAP_END-4096, K70_HEAP_END, K70_HEAP_END+4096, UINT64_MAX};
+  UINT64 Windows[] = {0, 4096, 0x08000000, 0x10000000, UINT64_MAX};
+  for (UINT64 Phase = 0; Phase < 0x200000; Phase += 4096) {
+    for (size_t I=0; I<sizeof(Starts)/sizeof(*Starts); I++)
+      for (size_t J=0; J<sizeof(Ends)/sizeof(*Ends); J++)
+        for (size_t K=0; K<sizeof(Windows)/sizeof(*Windows); K++) {
+          unsigned long long Actual = 0x55; UINT64 Expected = 0;
+          int A=K70HeapWindowCandidate(Starts[I], Ends[J], Phase, Windows[K], &Actual);
+          int E=Oracle(Starts[I], Ends[J], Phase, Windows[K], &Expected);
+          assert(A == E); if(A) assert(Actual == Expected);
+          else assert(Actual == 0x55);
+        }
+  }
+  puts("PASS boot04 real allocator: OEM bounds, holes, adjacency, refusals, layout and 163840 reference cases");
+  return 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix='k70-heap04-') as tmp:
+    work = Path(tmp)
+    c = work / 'test.c'
+    c.write_text(common + run_end + allocator + tests)
+    exe = work / 'test'
+    subprocess.run(['clang', '-g', '-O1', '-Wall', '-Wextra', '-Werror',
+                    '-Wno-unused-variable', '-Wno-unused-but-set-variable',
+                    '-fsanitize=address,undefined', '-fno-omit-frame-pointer',
+                    '-I'+str(root/'DarwinBootPkg/Driver'), str(c), '-o', str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
+    (work/'coff.c').write_text('''#include "HeapWindow.h"
+#include "WindowSize.h"
+int check(unsigned long long a,unsigned long long b,unsigned long long k,
