+#!/usr/bin/env python3
+"""Resume only final hashing/report creation; does not rewrite any image bytes.
+
+Run only after host IO is available. The existing complete SHNGROOT header must
+match both windows recorded before interruption. This does not replace the
+separate verify-root-candidate.py run and never claims independent verification.
+"""
+import argparse
+import datetime
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import subprocess
+
+
+def require(value, message):
+    if not value:
+        raise RuntimeError(message)
+
+
+def digest(path):
+    result = hashlib.sha256()
+    with path.open('rb') as stream:
+        for data in iter(lambda: stream.read(8 << 20), b''):
+            result.update(data)
+    return result.hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--candidate-dir', type=Path, required=True)
+    parser.add_argument('--core', type=Path, required=True)
+    args = parser.parse_args()
+    tools = Path(__file__).resolve().parent
+    interrupted = json.loads((tools / 'interrupted-build.json').read_text())
+    spec = importlib.util.spec_from_file_location('root_candidate_builder', tools / 'build-root-candidate.py')
+    builder = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(builder)
+    for relative in ('scripts/unixnu/udif.py', 'scripts/unixnu/util.py'):
+        pinned = subprocess.check_output(['git', '-C', str(args.core), 'show', builder.CORE_REVISION + ':' + relative])
+        require((args.core / relative).read_bytes() == pinned, 'core source differs byte-for-byte from pin')
+    image = args.candidate_dir / 'ipados-17.7.11-two-window-candidate.img'
+    partial = image.with_suffix('.img.partial')
+    report = image.with_suffix('.json')
+    require(not report.exists(), 'report exists; preserve it and inspect rather than overwrite')
+    candidates = [path for path in (image, partial) if path.is_file()]
+    require(len(candidates) == 1, 'require exactly one existing complete candidate/partial file')
+    existing = candidates[0]
+    require(existing.stat().st_size == interrupted['image_bytes'], 'candidate size mismatch')
+    with existing.open('rb') as stream:
+        header = stream.read(4096)
+    require(header[:8] == b'SHNGROOT', 'manifest not committed; do not reconstruct it automatically')
+    require(struct.unpack_from('<IIQ', header, 8) == (1, 2, interrupted['image_bytes']),
+            'manifest facts mismatch')
+    require(hashlib.sha256(header[:4064]).digest() == header[4064:], 'manifest hash mismatch')
+    rows = []
+    for index, expected in enumerate(interrupted['windows_written_by_builder']):
+        name, offset, size, block, flags, sha, reserved = struct.unpack_from('<32sQQII32s40s', header, 24 + index * 128)
+        require(name == expected['name'].encode().ljust(32, b'\0') and
+                (offset, size, block, flags, sha.hex(), reserved) ==
+                (expected['offset'], expected['size'], 512, 1, expected['sha256'], bytes(40)),
+                'existing window differs from interrupted build record')
+        rows.append(dict(name=expected['name'], input_path=expected['member'],
+                         input_bytes=expected['input_bytes'], input_sha256=expected['input_sha256'],
+                         offset=offset, size=size, block_size=block, flags=flags, sha256=sha.hex()))
+    print('Hashing existing image sequentially; no image bytes will be rewritten.', flush=True)
+    actual = digest(existing)
+    if existing == partial:
+        existing.rename(image)
+    result = dict(
+        created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
+        status='resumed_candidate_awaiting_independent_verification',
+        version='17.7.11', build='21H461', product='iPad7,1',
+        image_path=str(image.resolve()), image_bytes=image.stat().st_size, image_sha256=actual,
+        manifest_version=1, manifest_sha256=hashlib.sha256(header).hexdigest(), windows=rows,
+        measured_userdata_capacity_bytes=builder.CAPACITY, userdata_first_lba=None, userdata_last_lba=None,
+        hardware_tested=False, phone_written=False, contains_data_seed=False, desktop_boot_verified=False,
+        limitations=['Only OS/SystemOS windows; no Data seed, root policies or GPU addon.',
+                     'Clean kernel currently disables native UFS/root publication and owner Data.',
+                     'Independent read-back verification still required; this is not ready-to-flash OS.'],
+        core_revision=builder.CORE_REVISION,
+        decoder_source_sha256=digest(args.core / 'scripts/unixnu/udif.py'),
+        builder_source_sha256=digest(tools / 'build-root-candidate.py'),
+        resumed_after_interruption=True, resumer_sha256=digest(Path(__file__)),
+    )
+    report.write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
+    print(json.dumps(dict(report=str(report), image_sha256=actual,
+                          independent_verification_completed=False)), flush=True)
+
+
+if __name__ == '__main__':
+    main()
