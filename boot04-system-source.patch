+  // A reserved 4 KiB hole may not be bridged to fabricate 128 MiB.
+  Reset(); Region(K70_HEAP_BASE, 0xC0000000-K70_HEAP_BASE, 7);
+  Region(0xC0000000, 4096, 4);
+  Region(0xC0001000, K70_HEAP_END-0xC0001000, 7);
