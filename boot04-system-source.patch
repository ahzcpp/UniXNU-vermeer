+#!/usr/bin/env python3
+"""Generate the isolated, non-USB K70 boot-04 profile without editing its inputs.
+
+Run under WSL. Build with boot-chain-04/package before the baseline package in
+PACKAGES_PATH. DarwinBootPkg is intentionally resolved separately, allowing the
+boot-04 loader copy to be selected without replacing the shared loader source.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+
+
+PINS = {
+    "vermeer.dsc": "88f18b45b275a42170432f7258d8aa7a2b1f24ef4120b841413d6ba5179ea7ef",
+    "vermeer.fdf": "d3833cf1a3e3d23306a24ebeda96aef685e66073076b65475fbd612ba107c01b",
+    "Include/DXE.inc": "991920badf04c6ae3b9e82e886eea0c1bff11a0f7ac9f4bdaf8616d3ac8cd89d",
+    "Include/APRIORI.inc": "3a67f56a3cc713116ac6cbfcdd014b63adec46c129497ad01668354dab040fac",
+    "Library/MemoryMapLib/MemoryMapLib.c": "0767d8ac01dd5e86f67413014dc9106ffbc2543a50b929eec6b068a0a9d2cf60",
+    "Library/MemoryMapLib/MemoryMapLib.inf": "159424f05f845ecb993029636bd30ac167784697855a654bf95c7a202a3378ae",
+}
+RAMDISK_PINS = {
+    "UniXNURamDiskDxe.c": "f7d9c60937487e8e6c2a2fb665563664a56179834abce6611e95cd68c23611b0",
+    "UniXNURamDiskDxe.inf": "28491c49992134008d55fc0efe7e0792814d517d323ebfb7b70adc27c725e94a",
+}
+POLICY = {
+    "DRAM gap 0xC7CC0000": (0xC7CC0000, 0x05040000),
+    "DRAM gap 0xCCF80000": (0xCCF80000, 0x07D80000),
+    "DRAM gap 0xE671D000": (0xE671D000, 0x190E3000),
+    "DRAM bank 1 low": (0x880000000, 0x3B300000),
+}
+PKG = "K70Boot04Pkg"
+RAMDISK = "UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.inf"
+OLD_MEMORY = "vermeerPkg/Drivers/VermeerBootMemoryDxe/VermeerBootMemoryDxe.inf"
+
+
+def require(ok, message):
+    if not ok:
+        raise SystemExit(message)
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def checked_read(path, expected):
+    data = path.read_bytes()
+    require(sha(data) == expected, f"Pinned baseline input differs: {path}")
+    return data.decode("utf-8")
+
+
+def replace_once(text, before, after):
+    require(text.count(before) == 1, f"Expected unique replacement: {before}")
+    return text.replace(before, after)
+
+
+def active_lines(text):
+    """Resolve only the exact board condition grammar found in the two incs."""
+    values = {"VERMEER_VENDOR_HW": 0, "USE_CUSTOM_DISPLAY_DRIVER": 0,
+              "VERMEER_CHINESE_UI": 1}
+    stack, cond, result = [True], [], []
+    for line in text.splitlines():
+        token = line.strip()
+        if token.startswith("!if "):
+            m = re.fullmatch(r"!if \$\((\w+)\) == ([01])", token)
+            require(m is not None and m[1] in values, f"Unknown board condition: {token}")
+            value = values[m[1]] == int(m[2])
+            cond.append(value)
+            stack.append(stack[-1] and value)
+        elif token == "!else":
+            require(len(stack) > 1, "Unbalanced !else")
+            stack[-1] = stack[-2] and not cond[-1]
+        elif token == "!endif":
+            require(len(stack) > 1, "Unbalanced !endif")
+            stack.pop()
+            cond.pop()
+        elif stack[-1]:
+            result.append(line)
+    require(len(stack) == 1, "Unclosed conditional")
+    return "\n".join(result) + "\n"
+
+
+def regions(memory):
+    rows = []
+    for line in memory.splitlines():
+        m = re.fullmatch(r'\s*\{"([^"]+)",\s*(0x[0-9A-Fa-f]+),\s*(0x[0-9A-Fa-f]+),\s*(\w+),\s*(\w+),\s*(\w+),\s*(\w+),\s*(\w+)\},?', line)
+        if m:
+            rows.append(dict(name=m[1], base=int(m[2], 16), size=int(m[3], 16),
+                             hob=m[4], resource=m[5], capabilities=m[6],
+                             memory_type=m[7], cache=m[8]))
+    require(len(rows) > 60 and len(rows) < 256, "Memory descriptor parse/count failed")
+    return rows
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--uefi", type=Path, default=Path("/root/k70-clean-20261104/uefi"))
+    ap.add_argument("--tree", type=Path, default=Path("/root/k70-clean-20261104/UniXNU"))
+    args = ap.parse_args()
+    root = Path(__file__).resolve().parent
+    base = args.uefi / "Platforms/Xiaomi/vermeerPkg"
+    src = {name: checked_read(base / name, pin) for name, pin in PINS.items()}
+    rdir = args.tree / "package/UniXNUPkg/Driver/UniXNURamDiskDxe"
+    ram = {name: checked_read(rdir / name, pin) for name, pin in RAMDISK_PINS.items()}
+    require("return EFI_WRITE_PROTECTED;" in ram["UniXNURamDiskDxe.c"], "Ramdisk is not read-only")
+    require(not any(word in ram["UniXNURamDiskDxe.c"] for word in (
+        "AddMemorySpace", "SetMemorySpaceAttributes", "AllocatePages", "RamBlockErase")),
+        "Ramdisk driver changes allocation policy")
+
+    dsc = src["vermeer.dsc"]
+    dsc = replace_once(dsc, "PLATFORM_NAME                  = Vermeer", "PLATFORM_NAME                  = VermeerBoot04")
+    dsc = replace_once(dsc, "E2DF0557-79F9-4EB2-90B0-FA34DC941EEC", "46098569-8492-4ed7-9efc-7bd68c222340")
+    dsc = replace_once(dsc, "Build/vermeerPkg", "Build/vermeerBoot04")
+    dsc = replace_once(dsc, "vermeerPkg/vermeer.fdf", f"{PKG}/Profiles/vermeer-boot04.fdf")
+    dsc = replace_once(dsc, "MemoryMapLib|vermeerPkg/Library/MemoryMapLib/MemoryMapLib.inf",
+                       f"MemoryMapLib|{PKG}/Library/MemoryMapLib/MemoryMapLib.inf")
+    dsc = replace_once(dsc, OLD_MEMORY, RAMDISK)
+    require("PcdBuildXblHobs|FALSE" in dsc and "PcdBuildXblHobs|TRUE" not in dsc, "XBL HOB policy changed")
+    require(re.search(r"VERMEER_VENDOR_HW\s+= 0", dsc) is not None, "Vendor hardware must remain disabled")
+
+    dxe = replace_once(src["Include/DXE.inc"], OLD_MEMORY, RAMDISK)
+    apriori = src["Include/APRIORI.inc"]
+    fdf = src["vermeer.fdf"]
+    for name in ("APRIORI", "DXE"):
+        fdf = replace_once(fdf, f"!include Include/{name}.inc", f"!include {PKG}/Profiles/Include/{name}.inc")
+    fdf = replace_once(fdf, "!include Include/RAW.inc", "!include Platforms/Xiaomi/vermeerPkg/Include/RAW.inc")
+    active = active_lines(dxe) + active_lines(apriori)
+    require("Binaries/" not in active, "An OEM binary became active")
+    require(OLD_MEMORY not in dsc + dxe + apriori + fdf, "Dynamic RAM publisher remains")
+    require(dsc.count(RAMDISK) == 1 and dxe.count(RAMDISK) == 1, "Read-only initrd must be listed once in each build/FV list")
+    require("DarwinBootPkg/Driver/DarwinBoot.inf" in dsc and
+            "DarwinBootPkg/Driver/DarwinBoot.inf" in active, "Existing DarwinBoot path must remain")
+    require(not any(x in dsc + dxe + apriori + fdf for x in ("K70DiagnosticsPkg", "K70UsbDiag", "K70PlatformPei")), "USB experiment leaked into boot profile")
+
+    memory = src["Library/MemoryMapLib/MemoryMapLib.c"]
+    for name, (address, size) in POLICY.items():
+        old = next(line for line in memory.splitlines() if f'{{"{name}",' in line)
+        require(", Conv, WRITE_BACK_XN}" in old, f"Unexpected original region type: {name}")
+        new = old.replace(", Conv, WRITE_BACK_XN}", ", Reserv, WRITE_BACK_XN}")
+        memory = replace_once(memory, old, new)
+    memory = re.sub(r"  // DRAM between the carveouts above.*?(?=  \{\"DRAM gap)",
+                    "  // Unmeasured gaps cannot supply allocations in boot-04.\n", memory, flags=re.S)
+    memory = re.sub(r"  // Second DRAM bank\..*?(?=  \{\"DRAM bank)",
+                    "  // Inherited sheng bank is reserved until measured on this K70.\n", memory, flags=re.S)
+    table = regions(memory)
+    available = [r for r in table if r["resource"] == "SYS_MEM" and r["memory_type"] == "Conv"]
+    require(len(available) == 1 and available[0]["name"] == "DXE Heap" and
+            (available[0]["base"], available[0]["size"]) == (0xBAB00000, 0xD1C0000),
+            "Only the exact OEM DXE Heap may be conventional system memory")
+    for name, (address, size) in POLICY.items():
+        r = next(r for r in table if r["name"] == name)
+        require((r["base"], r["size"], r["memory_type"]) == (address, size, "Reserv"), f"Policy region differs: {name}")
+    inf = replace_once(src["Library/MemoryMapLib/MemoryMapLib.inf"],
+                       "375C4FF0-1905-4BA7-A5CA-7D40D25F5EF3", "54079ff3-c4cb-4c81-b498-1bd0f7c2de59")
+    output = {
+        "Profiles/vermeer-boot04.dsc": dsc,
+        "Profiles/vermeer-boot04.fdf": fdf,
+        "Profiles/Include/DXE.inc": dxe,
+        "Profiles/Include/APRIORI.inc": apriori,
+        "Library/MemoryMapLib/MemoryMapLib.c": memory,
+        "Library/MemoryMapLib/MemoryMapLib.inf": inf,
+    }
+    pkg = root / "package" / PKG
+    for name, text in output.items():
+        dest = pkg / name
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        data = text.replace("\r\n", "\n").encode("utf-8")
+        # Idempotent generation is allowed; refuse to discard a local modification.
+        if dest.exists():
+            require(dest.read_bytes() == data, f"Generated output was edited; preserve it first: {dest}")
+        else:
+            dest.write_bytes(data)
+    # Verify input bytes after generating, so accidental baseline writes cannot pass.
+    for name, pin in PINS.items():
+        checked_read(base / name, pin)
+    report = {
+        "schema": 1, "experiment": "boot-chain-04", "hardware_tested": False,
+        "baseline_modified": False, "usb_diagnostic_included": False,
+        "dsc": f"{PKG}/Profiles/vermeer-boot04.dsc",
+        "output_directory": "Build/vermeerBoot04",
+        "xbl_hobs": False, "vendor_hw": 0,
+        "dynamic_add_memory_driver_present": False,
+        "ramdisk_driver": {"path": RAMDISK, "read_only": True,
+                           "changes_memory_policy": False, "sha256": RAMDISK_PINS},
+        "conventional_system_regions": available,
+        "reserved_unmeasured_regions": [r for r in table if r["name"] in POLICY],
+        "kernel_carveout_promoted": False,
+        "baseline_inputs_sha256": PINS,
+        "generated_files_sha256": {name: sha((pkg / name).read_bytes()) for name in output},
+        "ramdisk_runtime_limit": "The incoming FDT/initrd still requires hardware observation; no runtime pointer validity is claimed.",
+        "physical_storage_limit": "The vendor-disabled baseline has no active OEM UFS/SDCC provider; generic FAT/disk and host USB modules are unchanged.",
+        "scope": "Profile and memory policy only. The separate DarwinBootPkg copy and 128 MiB window are reviewed independently.",
+    }
+    (root / "profile-audit.json").write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"generated_files": len(output), "dsc": report["dsc"],
+                      "baseline_modified": False, "hardware_tested": False}))
+
+
+if __name__ == "__main__":
+    main()
