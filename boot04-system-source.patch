+
+!if ($(USE_CUSTOM_DISPLAY_DRIVER) == 1) && ($(VERMEER_VENDOR_HW) == 0)
+  !error The stock DisplayDxe chain needs VERMEER_VENDOR_HW = 1
+!endif
+
