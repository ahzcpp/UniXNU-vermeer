+#!/usr/bin/env python3
+"""Build the isolated heap-only XNU entry experiment, without phone I/O."""
+import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import tomllib
+
+ROOT = Path('/root/k70-clean-20261104')
+DELIVERY = Path('/mnt/e/K70-UniXNU-20261104')
+WORK = DELIVERY / 'boot-chain-04'
+UEFI = ROOT / 'uefi'
+EDK = ROOT / 'out-firmware/feeds/mu_basecore-8f10084c'
+TREE = ROOT / 'out-firmware/vermeer/ipados-17.7.11-21H461/vermeer/tree'
+CONF = ROOT / 'out-firmware/vermeer/ipados-17.7.11-21H461/vermeer/edk2-conf'
+TOOLS = EDK / 'BaseTools'
+board = tomllib.loads((DELIVERY / 'device-source/board.toml').read_text())
+fields = {'uefi': str(UEFI), 'edk2': str(EDK), 'tree': str(TREE)}
+packages = [str(WORK / 'package'), str(WORK / 'darwinboot')]
+packages += [p.format(**fields) for p in board['firmware']['packages']]
+profile = 'K70Boot04Pkg/Profiles/vermeer-boot04.dsc'
+if not (WORK / 'package' / profile).is_file():
+    raise SystemExit('Prepared isolated profile is missing')
+if not (WORK / 'darwinboot/DarwinBootPkg/Driver/DarwinBoot.inf').is_file():
+    raise SystemExit('Prepared isolated DarwinBoot source is missing')
+snapshot = {}
+for base in (WORK / 'package', WORK / 'darwinboot/DarwinBootPkg'):
+    for path in sorted(base.rglob('*')):
+        if path.is_file() and not any(p in {'__pycache__', 'Build'} for p in path.parts):
+            snapshot[str(path.relative_to(WORK))] = hashlib.sha256(path.read_bytes()).hexdigest()
+log = WORK / 'build.log'
+command = [
+    'build', '-p', profile, '-a', 'AARCH64', '-b', 'DEBUG', '-t', 'CLANGPDB', '-n', '2',
+    '-D', 'FD_BASE=0xa7100000', '-D', 'FD_SIZE=0x300000', '-D', 'FD_BLOCKS=768',
+    '-D', 'ENABLE_SECUREBOOT=1', '-D', 'DEVICE_MODEL=vermeer',
+    '-D', 'MEMORY_PROTECTION=TRUE', '-D', 'SHIP_MODE=FALSE',
+    '-D', 'BUILDID_STRING=vermeer-boot04-heap128',
+]
+env = dict(os.environ, WORKSPACE=str(UEFI), EDK_TOOLS_PATH=str(TOOLS),
+           CONF_PATH=str(CONF), PACKAGES_PATH=':'.join(packages), PYTHON_COMMAND='python3',
+           CLANG_BIN='/usr/lib/llvm-18/bin/', CLANGPDB_AARCH64_PREFIX='aarch64-linux-gnu-',
+           SOURCE_DATE_EPOCH=subprocess.check_output(
+               ['git', '-C', str(UEFI), 'log', '-1', '--format=%ct'], text=True).strip(),
+           PATH=':'.join((str(TOOLS / 'BinWrappers/PosixLike'),
+                          str(TOOLS / 'Source/C/bin'), os.environ['PATH'])))
+started = datetime.datetime.now(datetime.timezone.utc).isoformat()
+applied = []
+try:
+    for name in board['firmware'].get('patches', []):
+        patch = UEFI / name
+        subprocess.run(['git', '-C', str(EDK), 'apply', '--check', str(patch)], check=True)
+        subprocess.run(['git', '-C', str(EDK), 'apply', str(patch)], check=True)
+        applied.append(patch)
+    with log.open('w') as output:
+        output.write('Command: ' + ' '.join(command) + '\n')
+        output.flush()
+        result = subprocess.run(command, cwd=UEFI, env=env, stdout=output, stderr=subprocess.STDOUT)
+finally:
+    for patch in reversed(applied):
+        subprocess.run(['git', '-C', str(EDK), 'apply', '--reverse', str(patch)], check=True)
+changed = [name for name, sha in snapshot.items()
+           if hashlib.sha256((WORK / name).read_bytes()).hexdigest() != sha]
+report = {'started_utc': started, 'command': command, 'exit_code': result.returncode,
+          'source_sha256': snapshot, 'source_changed_during_build': changed,
+          'hardware_tested': False, 'contains_os_root': False}
+(WORK / 'build-result.json').write_text(json.dumps(report, indent=2) + '\n')
+if changed:
+    raise SystemExit('Source changed during build; artifact rejected')
+print(json.dumps({'exit_code': result.returncode, 'log': str(log), 'source_files': len(snapshot)}))
+raise SystemExit(result.returncode)
