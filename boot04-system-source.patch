+tests = r'''
+static void Reset(void) { InputCount = Requests = 0; Deny = 0; }
+static void Region(UINT64 Base, UINT64 Bytes, unsigned Type) {
+  Inputs[InputCount++] = (EFI_MEMORY_DESCRIPTOR){Base, Bytes/4096, Type};
+}
+static void Check(int Ok, UINT64 Expected, UINT64 Window) {
+  EFI_PHYSICAL_ADDRESS Address = UINT64_MAX; KERNEL Kernel = {0xFFFFFFF00427C000ULL};
+  EFI_STATUS Result = AllocateWindow(&Kernel, Window, &Address);
+  assert((Result == EFI_SUCCESS) == Ok);
+  assert(Address == (Ok ? Expected : 0));
+}
+static int Oracle(UINT64 Start, UINT64 End, UINT64 Kernel, UINT64 Window, UINT64 *Out) {
+  // Reference enumerates every congruent address inside the fixed OEM heap.
+  if (Start >= End || !Window || Window % 4096) return 0;
+  UINT64 Address = (K70_HEAP_BASE & ~K70_BLOCK_MASK) + (Kernel & K70_BLOCK_MASK);
+  for (; Address < K70_HEAP_END; Address += 0x200000) {
+    if (Address >= Start && Address >= K70_HEAP_BASE && Address < End &&
+        Window <= K70_HEAP_END - Address && Window <= End - Address) {
