+#!/usr/bin/env python3
+"""Read-only audit of the exact boot-04 FD and its own completed build outputs.
+
+Uses the reviewed bounded FV parser and relocation-aware PE/SEC transforms as
+libraries. No USB module list, OEM count, fallback artifact or device operation
+is imported. MemoryMap's compiled LLVM table is bound to current source and to
+the linked SEC PE and final TE bytes; this is not an independent firmware build.
+"""
+import argparse
+import collections
+import datetime
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import subprocess
+
+WORK = Path(__file__).resolve().parent
+BASE = WORK.parent
+UEFI = Path('/root/k70-clean-20261104/uefi')
+BUILD = UEFI / 'Build/vermeerBoot04/DEBUG_CLANGPDB'
+HELPER = WORK / 'audit-deps/fd_pe_helpers.py'
+HELPER_SHA = '023cf5439499609d97dd821df0e7374688b4e8511e4f1395eb2734f14d3c1caf'
+PARSER = WORK / 'audit-deps/bounded_fv.py'
+GENFW = Path('/root/k70-clean-20261104/out-firmware/feeds/mu_basecore-8f10084c/BaseTools/Source/C/bin/GenFw')
+LLVM_DIS = Path('/usr/lib/llvm-18/bin/llvm-dis')
+REQUIRED = {
+    '1b64af87-8415-4b57-9b16-680d70913b9f': 'DarwinBoot',
+    '75ca63ad-fbae-4a06-92a0-f937c671251d': 'UniXNURamDiskDxe',
+}
+FORBIDDEN = {
+    '37cf646d-1729-4afd-998f-285df8864211': 'VermeerBootMemoryDxe',
+    '6c561b72-e945-4fcf-8cd9-ab763ceb493c': 'K70UsbDiagDxe',
+    '0a43774a-8887-4b61-8aa1-9cdaef4a3c69': 'K70LogRingDxe',
+}
+# The unchanged baseline Extra.fdf.inc includes this binary-only application.
+# It has no compiler OUTPUT or AutoGen.c. Accept only this exact reviewed INF
+# and PE original, with its original FFS identity/type and fully checked bytes.
+PREBUILT = {
+    '643d4788-63c8-40d2-bd7a-6842e66850d1': {
+        'ui': 'ufpdevicefw', 'type': 9,
+        'inf': 'Silicon/Silicium/SiliciumPkg/Applications/UFP/ufpdevicefw.inf',
+        'inf_sha256': '24e8a29179fd40f48dbf0c02b28dede757cd2c2fe1fd25bc8411dc0010bb337c',
+        'pe': 'Silicon/Silicium/SiliciumPkg/Applications/UFP/ufpdevicefw.efi',
+        'pe_sha256': '72de25543341ba515be3872749b5fe7501468019acb6d8d997ae4a5bb19493fa',
+    },
+}
+LZMA_GUID = 'ee4e5898-3914-4259-9d6e-dc7bd79403cf'
+EXEC_TYPES = {3, 4, 5, 6, 7, 8, 9, 10, 12, 13, 14, 15}
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def load_helper():
+    data = HELPER.read_bytes()
+    require(sha(data) == HELPER_SHA, 'Reviewed FV/PE helper changed')
+    require(b"if __name__=='__main__':" in data, 'Helper has no main guard')
+    spec = importlib.util.spec_from_file_location('k70_reviewed_fd_helpers', HELPER)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def unique_blob_offset(haystack, blob, label):
+    start = haystack.find(blob)
+    require(start >= 0 and haystack.find(blob, start + 1) < 0,
+            label + ' must contain the complete compiled table exactly once')
+    return start
+
+
+def llvm_string(text):
+    out = bytearray()
+    index = 0
+    while index < len(text):
+        if text[index] == '\\':
+            require(index + 2 < len(text) and re.fullmatch(r'[0-9A-Fa-f]{2}', text[index+1:index+3]),
+                    'Unsupported LLVM constant string escape')
+            out.append(int(text[index+1:index+3], 16))
+            index += 3
+        else:
+            out.append(ord(text[index]))
+            index += 1
+    return bytes(out)
+
+
+def source_memory_table(data):
+    # These concrete enum/alias values are the current Silicium/PI AArch64 ABI.
+    # Unknown tokens fail, rather than being treated as conventional memory.
+    values = {
+        'NoHob': 0, 'AddMem': 1, 'AddDev': 2, 'HobOnlyNoCacheSetting': 3,
+        'SYS_MEM': 0, 'MMAP_IO': 1, 'MEM_RES': 5,
+        'SYS_MEM_CAP': 7355399, 'UNCACHEABLE': 1024, 'INITIALIZED': 2,
+        'Reserv': 0, 'BsData': 4, 'RtData': 6, 'Conv': 7, 'MmIO': 11,
+        'UNCACHED_UNBUFFERED_XN': 0, 'WRITE_BACK': 1, 'WRITE_BACK_XN': 1,
+        'WRITE_THROUGH_XN': 5, 'NS_DEVICE': 6,
+    }
+    pattern = re.compile(r'^\s*\{"([^"]+)",\s*(0x[0-9A-Fa-f]+),\s*(0x[0-9A-Fa-f]+),\s*(\w+),\s*(\w+),\s*(\w+),\s*(\w+),\s*(\w+)\},?\s*$', re.M)
+    rows = []
+    for match in pattern.finditer(data.decode('utf-8')):
+        name = match[1].encode('ascii')
+        require(len(name) < 32, 'Memory table name does not fit the ABI')
+        nums = [int(match[2], 16), int(match[3], 16)]
+        try:
+            nums += [values[match[i]] for i in range(4, 9)]
+        except KeyError as exc:
+            raise ValueError('Unreviewed MemoryMap ABI token: ' + str(exc))
+        rows.append((name.ljust(32, b'\0'), *nums))
+    require(60 < len(rows) < 128, 'Source memory table parse/count failed')
+    conventional = [r for r in rows if r[4] == 0 and r[6] == 7]
+    require(len(conventional) == 1 and conventional[0][:3] ==
+            (b'DXE Heap'.ljust(32, b'\0'), 0xBAB00000, 0xD1C0000),
+            'Source policy must expose only the exact OEM DXE heap')
+    for name in ('DRAM gap 0xC7CC0000', 'DRAM gap 0xCCF80000',
+                 'DRAM gap 0xE671D000', 'DRAM bank 1 low', 'Kernel'):
+        matches = [r for r in rows if r[0].split(b'\0', 1)[0].decode() == name]
+        require(len(matches) == 1 and matches[0][6] == 0, 'Required reserved source region changed: ' + name)
+    return rows
+
+
+def verify_memory_binding(args, sec_pe, sec_te, source_snapshot):
+    source = WORK / 'package/K70Boot04Pkg/Library/MemoryMapLib/MemoryMapLib.c'
+    source_data = source.read_bytes()
+    relative = str(source.relative_to(WORK))
+    require(source_snapshot.get(relative) == sha(source_data), 'MemoryMap source differs from completed build snapshot')
+    expected_rows = source_memory_table(source_data)
+    objects = list((args.build_root / 'AARCH64/K70Boot04Pkg/Library/MemoryMapLib').rglob('OUTPUT/MemoryMapLib.obj'))
+    require(len(objects) == 1, 'Isolated MemoryMap compiled object missing or ambiguous')
+    obj = objects[0]
+    require(obj.read_bytes().startswith(b'BC\xc0\xde'), 'Expected CLANGPDB LLVM bitcode object')
+    result = subprocess.run([str(args.llvm_dis), str(obj), '-o', '-'], capture_output=True,
+                            text=True, timeout=45, check=True)
+    ir = result.stdout
+    require(len(ir) < 2 * 1024 * 1024, 'LLVM memory object disassembly exceeds audit bound')
+    require(f'source_filename = "{source}"' in ir, 'MemoryMap object was compiled from another source path')
+    md5 = hashlib.md5(source_data).hexdigest()
+    require(re.search(r'!DIFile\(filename: "' + re.escape(str(source)) +
+                      r'",[^\n]*checksumkind: CSK_MD5, checksum: "' + md5 + r'"', ir) is not None,
+            'Compiled MemoryMap source checksum does not match current source bytes')
+    table = re.search(r'^@gMemoryDescriptor = internal global \[(\d+) x %struct\.EFI_MEMORY_REGION_DESCRIPTOR\] (.*?), align \d+', ir, re.M)
+    require(table is not None, 'MemoryMap bitcode has no complete expected table definition')
+    rowpat = re.compile(r'%struct\.EFI_MEMORY_REGION_DESCRIPTOR \{ \[32 x i8\] c"((?:[^"\\]|\\[0-9A-Fa-f]{2})*)", i64 (-?\d+), i64 (-?\d+), i32 (-?\d+), i32 (-?\d+), i32 (-?\d+), i32 (-?\d+), i32 (-?\d+) \}')
+    rows = [(llvm_string(m[1]), *[int(m[i]) for i in range(2, 9)]) for m in rowpat.finditer(table[2])]
+    require(len(rows) == int(table[1]) and rows == expected_rows,
+            'Compiled descriptor data differs from current source/ABI')
+    function = re.search(r'^define[^\n]*@GetMemoryMap\([^\n]*\).*?^}', ir, re.M | re.S)
+    require(function is not None and 'store ptr @gMemoryDescriptor,' in function[0]
+            and re.search(r'\bstore i8 ' + str(len(rows)) + r',', function[0]) is not None,
+            'Compiled GetMemoryMap does not return this table and exact count')
+    require('%struct.EFI_MEMORY_REGION_DESCRIPTOR = type { [32 x i8], i64, i64, i32, i32, i32, i32, i32 }' in ir,
+            'Compiled descriptor ABI differs')
+    encoded = b''.join(struct.pack('<32sQQIIIII4x', *row) for row in rows)
+    pe_off = unique_blob_offset(sec_pe, encoded, 'Current SEC PE')
+    te_off = unique_blob_offset(sec_te, encoded, 'Final FD SEC TE')
+    sec_out = args.build_root / 'AARCH64/SiliciumPkg/Sec/Sec/OUTPUT'
+    libraries = (sec_out / 'static_library_files.lst').read_text()
+    lib = obj.with_suffix('.lib')
+    require(str(lib) in libraries.splitlines(), 'SEC link input list does not include isolated MemoryMap library')
+    require(lib.is_file(), 'SEC MemoryMap library input is absent')
+    archive_list = subprocess.run(['/usr/lib/llvm-18/bin/llvm-ar', 't', str(lib)], capture_output=True,
+                                  text=True, timeout=30, check=True).stdout.splitlines()
+    members = [name for name in archive_list if Path(name).name == 'MemoryMapLib.obj']
+    require(len(members) == 1, 'MemoryMap library has ambiguous object member')
+    member = subprocess.run(['/usr/lib/llvm-18/bin/llvm-ar', 'p', str(lib), members[0]],
+                            capture_output=True, timeout=30, check=True).stdout
+    require(member == obj.read_bytes(), 'SEC library member differs from audited MemoryMap object')
+    return {
+        'success': True, 'method': 'source snapshot + compiled LLVM constant table + exact SEC PE/final TE table data',
+        'source_path': str(source), 'source_sha256': sha(source_data), 'compiled_source_md5': md5,
+        'object_path': str(obj), 'object_sha256': sha(obj.read_bytes()),
+        'llvm_dis_sha256': sha(args.llvm_dis.read_bytes()),
+        'descriptor_count': len(rows), 'descriptor_bytes': 72, 'table_sha256': sha(encoded),
+        'sec_pe_table_file_offset': hex(pe_off), 'fd_sec_te_table_file_offset': hex(te_off),
+        'link_library_path': str(lib), 'link_library_sha256': sha(lib.read_bytes()),
+        'library_member_equals_object': True,
+        'limitation': 'Not an independent compiler rebuild of all SEC code. Does establish all current descriptor bytes, table-return IR, link input membership, and their exact presence in the source-bound SEC image.',
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--build-root', type=Path, default=BUILD)
+    ap.add_argument('--fd', type=Path, default=BUILD / 'FV/SILICIUM_UEFI.fd')
+    ap.add_argument('--build-result', type=Path, default=WORK / 'build-result.json')
+    ap.add_argument('--genfw', type=Path, default=GENFW)
+    ap.add_argument('--llvm-dis', type=Path, default=LLVM_DIS)
+    ap.add_argument('--output', type=Path, default=WORK / 'fd-audit.json')
+    args = ap.parse_args()
+    report = {'schema': 'k70-boot04-fd-audit/1', 'success': False, 'errors': [],
+              'hardware_tested': False, 'script_sha256': sha(Path(__file__).read_bytes()),
+              'created_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+              'limitations': ['Offline artifact identity/structure only; no XNU execution or iPadOS startup established.']}
+    try:
+        require(args.build_root.resolve() == BUILD.resolve(), 'Only the vermeerBoot04 final build tree is accepted')
+        require(args.fd.resolve() == (args.build_root / 'FV/SILICIUM_UEFI.fd').resolve(), 'FD is not exact named boot04 output')
+        result_bytes = args.build_result.read_bytes()
+        result = json.loads(result_bytes)
+        require(result['exit_code'] == 0 and result['source_changed_during_build'] == [], 'Build is incomplete or sources changed')
+        source_snapshot = result['source_sha256']
+        require(source_snapshot, 'No completed build source snapshot')
+        for name, digest in source_snapshot.items():
+            p = (WORK / name).resolve()
+            require(p.is_relative_to(WORK.resolve()) and p.is_file(), 'Build snapshot source path escapes or is absent')
+            require(sha(p.read_bytes()) == digest, 'Current source differs from completed build snapshot: ' + name)
+        fd_stat = args.fd.stat()
+        started = datetime.datetime.fromisoformat(result['started_utc'])
+        require(started.tzinfo is not None and fd_stat.st_mtime >= started.timestamp(), 'FD predates this completed build')
+        fd = args.fd.read_bytes()
+        require(len(fd) == 0x300000, 'Unexpected complete FD size')
+        report.update(fd_path=str(args.fd), fd_sha256=sha(fd), fd_bytes=len(fd),
+                      build_result_sha256=sha(result_bytes), build_source_files=len(source_snapshot))
+        helper = load_helper()
+        Audit = helper.load_parser(PARSER)
+        audit = Audit()
+        roots = audit.scan(fd, 'FD', [{'input': 'exact boot04 final FD'}])
+        require(not audit.errors and not audit.warnings, 'Bounded parser emitted errors/warnings')
+        root_fvs = [v for v in audit.fvs if re.fullmatch(r'FD/fv-[0-9a-f]{8}', v['path'])]
+        require(roots == 1 and len(root_fvs) == 1 and root_fvs[0]['path'] == 'FD/fv-00000000'
+                and root_fvs[0]['bytes'] == len(fd), 'Unexpected root FV placement/coverage')
+        guided = [s for f in audit.files for s in f['sections'] if s['type'] == 2 and s.get('guid') == LZMA_GUID]
+        require(guided and len(audit.fvs) >= 2, 'Expected bounded LZMA FV was not traversed')
+        inventory = collections.defaultdict(list)
+        executable = [f for f in audit.files if f['type'] in EXEC_TYPES]
+        for f in executable:
+            inventory[f['guid']].append(f)
+        require(all(len(fs) == 1 for fs in inventory.values()), 'Duplicate executable FFS GUID')
+        for guid, label in FORBIDDEN.items():
+            require(guid not in inventory and not any(label in f['ui'] for f in executable), 'Forbidden module present: ' + label)
+        for guid, label in REQUIRED.items():
+            fs = inventory.get(guid, [])
+            require(len(fs) == 1 and fs[0]['ui'] == [label] and fs[0]['type'] == 7, 'Required module identity/count differs: ' + label)
+        outputs = collections.defaultdict(list)
+        for p in (args.build_root / 'AARCH64').rglob('OUTPUT/*.efi'):
+            identity = helper.source_caller_guid(p)
+            outputs[identity['guid']].append((p, identity))
+        pe_checks, te_checks, prebuilt_checks = [], [], []
+        sec_pe, sec_te = None, None
+        for f in executable:
+            candidates = outputs.get(f['guid'], [])
+            pes = [s for s in f['sections'] if s['type'] == 0x10]
+            tes = [s for s in f['sections'] if s['type'] == 0x12]
+            if f['guid'] in PREBUILT:
+                pin = PREBUILT[f['guid']]
+                require(not candidates and f['ui'] == [pin['ui']] and f['type'] == pin['type']
+                        and len(pes) == 1 and not tes, 'Prebuilt application has unexpected identity/sections/source OUTPUT')
+                inf_path, pe_path = UEFI / pin['inf'], UEFI / pin['pe']
+                inf_data, original_pe = inf_path.read_bytes(), pe_path.read_bytes()
+                require(sha(inf_data) == pin['inf_sha256'] and sha(original_pe) == pin['pe_sha256'],
+                        'Exact reviewed prebuilt application INF/PE original changed')
+                defs = helper.source_inf_defines(inf_path)
+                require(defs['FILE_GUID'].lower() == f['guid'] and defs['BASE_NAME'] == pin['ui']
+                        and defs['MODULE_TYPE'] == 'UEFI_APPLICATION'
+                        and re.search(r'^\s*PE32\|ufpdevicefw\.efi\|\*\s*$', inf_data.decode(), re.M),
+                        'Prebuilt INF does not name exact reviewed binary application')
+                actual_pe = audit.memory[pes[0]['payload']['path']]
+                comparison = helper.compare_pe(original_pe, actual_pe)
+                require(comparison['equal'], 'Reviewed binary-only application differs from original without an exact PE explanation')
+                prebuilt_checks.append({'guid': f['guid'], 'ui': f['ui'], 'ffs_type': f['type_name'],
+                    'inf_path': str(inf_path), 'inf_sha256': sha(inf_data), 'pe_path': str(pe_path),
+                    'pe': comparison, 'source_output_absent_expected': True,
+                    'reason': 'Inherited baseline Extra.fdf binary-only UEFI application; not rebuilt from source in this project.'})
+                continue
+            require(len(candidates) == 1, 'Cannot bind exactly one own-build OUTPUT to FFS ' + f['guid'])
+            p, identity = candidates[0]
+            check = {'guid': f['guid'], 'ui': f['ui'], 'output_path': str(p), 'source_identity': identity,
+                     'output_reused_from_prior_incremental_step': p.stat().st_mtime < started.timestamp()}
+            if tes:
+                require(f['type'] == 3 and len(tes) == 1 and not pes, 'Unexpected TE module')
+                actual = audit.memory[tes[0]['payload']['path']]
+                expected, conversion = helper.regenerate_sec_te(args.genfw, p)
+                if actual != expected:
+                    expected, conversion = helper.regenerate_sec_te(args.genfw, p, helper.te_base(actual))
+                require(actual == expected, 'Final SEC TE does not match own-build PE + explained transform')
+                check.update(equal=True, conversion=conversion, fd_te_sha256=sha(actual))
+                te_checks.append(check)
+                sec_pe, sec_te = p.read_bytes(), actual
+            else:
+                require(len(pes) == 1, 'Executable has no unique PE32 section')
+                check['pe'] = helper.compare_pe(p.read_bytes(), audit.memory[pes[0]['payload']['path']])
+                require(check['pe']['equal'], 'Own-build PE differs from final FFS: ' + str(f['ui']))
+                pe_checks.append(check)
+        require(len(te_checks) == 1 and sec_pe is not None, 'Exactly one SEC TE must be code-bound')
+        for guid, label in REQUIRED.items():
+            require(sum(c['guid'] == guid and c['pe']['equal'] for c in pe_checks) == 1,
+                    'Required module lacks exact own-build PE proof: ' + label)
+        darwin_check = next(c for c in pe_checks if c['guid'] == '1b64af87-8415-4b57-9b16-680d70913b9f')
+        darwin_output = Path(darwin_check['output_path'])
+        darwin_sources = [WORK / name for name in source_snapshot
+                          if name.startswith('darwinboot/DarwinBootPkg/Driver/')
+                          and Path(name).suffix.lower() in ('.c', '.h', '.s', '.inf')]
+        require(darwin_sources and all(p.stat().st_mtime <= darwin_output.stat().st_mtime for p in darwin_sources),
+                'DarwinBoot own-build OUTPUT predates current isolated loader source')
+        darwin_check['critical_source_snapshot'] = [
+            {'path': str(p), 'sha256': sha(p.read_bytes())} for p in darwin_sources]
+        report['memory_map_binding'] = verify_memory_binding(args, sec_pe, sec_te, source_snapshot)
+        report.update(fv_count=len(audit.fvs), ffs_count=len(audit.files), lzma_sections=len(guided),
+                      required_modules=REQUIRED, forbidden_modules_absent=FORBIDDEN,
+                      source_pe_checks=pe_checks, source_sec_checks=te_checks,
+                      inherited_binary_only_application_checks=prebuilt_checks,
+                      module_inventory=[{'guid': f['guid'], 'ui': f['ui'], 'type': f['type_name'], 'path': f['path']} for f in audit.files],
+                      reviewed_helper_sha256=HELPER_SHA, bounded_parser_sha256=helper.PARSER_SHA,
+                      genfw_sha256=sha(args.genfw.read_bytes()))
+        require(sha(args.fd.read_bytes()) == report['fd_sha256'], 'FD changed during audit')
+        require(args.build_result.read_bytes() == result_bytes, 'Build result changed during audit')
+        report['success'] = True
+    except Exception as exc:
+        report['errors'].append({'type': type(exc).__name__, 'detail': str(exc)})
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + '\n', encoding='utf-8')
+    print(json.dumps({'success': report['success'], 'errors': report['errors'],
+                      'output': str(args.output), 'fd_sha256': report.get('fd_sha256')}))
+    return 0 if report['success'] else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
