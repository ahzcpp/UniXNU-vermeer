diff --git a/research/boot-chain-04/darwinboot/Test/compile-runtime-from-edk.py b/research/boot-chain-04/darwinboot/Test/compile-runtime-from-edk.py
new file mode 100644
index 0000000..e1080c5
--- /dev/null
+++ b/research/boot-chain-04/darwinboot/Test/compile-runtime-from-edk.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""Compile the complete driver with actual EDK headers/flags into temp outputs.
+
+No build-tree mutation. The second compile overrides LTO to inspect a real
+AArch64 COFF object after the exact-flags compiler integration check.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+uefi = Path('/root/k70-clean-20261104/uefi')
+makefile = uefi/'Build/vermeerBoot04/DEBUG_CLANGPDB/AARCH64/DarwinBootPkg/Driver/DarwinBoot/GNUmakefile'
+text = makefile.read_text()
+variables = dict(os.environ, WORKSPACE=str(uefi))
+for line in re.sub(r'\\\r?\n', ' ', text).splitlines():
+    match = re.match(r'^([A-Za-z_][A-Za-z_0-9]*)\s*=\s*(.*)$', line)
+    if match:
+        variables[match[1]] = match[2]
+
+def expand(value):
+    for unused in range(20):
+        updated = re.sub(r'\$\(([A-Za-z_][A-Za-z_0-9]*)\)', lambda m: variables[m[1]], value)
+        if updated == value:
+            assert '$(' not in updated, updated
+            return updated
+        value = updated
+    raise RuntimeError('Recursive make variable')
+
+compiler = expand(variables['CC'])
+flags = shlex.split(expand(variables['CC_FLAGS']))
+includes = shlex.split(expand(variables['INC']))
+source = root/'DarwinBootPkg/Driver/DarwinBoot.c'
+assert '#include <PiDxe.h>' in source.read_text()
+assert Path(expand(variables['MODULE_DIR'])).resolve() == source.parent.resolve()
+source_hash = hashlib.sha256(source.read_bytes()).hexdigest()
+results = []
+with tempfile.TemporaryDirectory(prefix='k70-boot04-real-edk-cc-') as tmp:
+    work = Path(tmp)
+    for name, extra in [('exact-edk-lto', []), ('aarch64-coff', ['-fno-lto'])]:
+        output = work/(name+'.obj')
+        command = [compiler, *flags, *extra, *includes, '-c', str(source), '-o', str(output)]
+        run = subprocess.run(command, cwd=uefi, capture_output=True, text=True)
+        result = {'id': name, 'command': command, 'exit_code': run.returncode,
+                  'stdout': run.stdout, 'stderr': run.stderr}
+        if run.returncode:
+            print(run.stderr)
+            raise SystemExit(run.returncode)
+        result['output_bytes'] = output.stat().st_size
+        result['output_sha256'] = hashlib.sha256(output.read_bytes()).hexdigest()
+        result['magic'] = output.read_bytes()[:4].hex()
+        if name == 'aarch64-coff':
+            assert output.read_bytes()[:2] == b'\x64\xaa', 'Not AArch64 COFF'
+        results.append(result)
+assert hashlib.sha256(source.read_bytes()).hexdigest() == source_hash
+record = {'driver_source_sha256': source_hash,
+          'actual_edk_makefile_sha256': hashlib.sha256(makefile.read_bytes()).hexdigest(),
+          'real_pi_hob_fdt_headers': True, 'build_outputs_modified': False,
+          'runtime_logic_changed_since_host_tests': False,
+          'header_integration_fix': 'Add PiDxe.h for actual PI HOB/resource type declarations',
+          'full_edk_build': 'separate root build; not established by standalone C compile',
+          'results': results}
+(root/'Test/real-edk-compile.json').write_text(json.dumps(record, indent=2)+'\n')
+print(json.dumps({'driver_source_sha256': source_hash,
+                  'exact_edk_compile': 'PASS', 'complete_driver_aarch64_coff': 'PASS'}, indent=2))
diff --git a/research/boot-chain-04/darwinboot/Test/export-boot04-source.py b/research/boot-chain-04/darwinboot/Test/export-boot04-source.py
