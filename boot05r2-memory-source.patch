+libfiles=['fdt.c','fdt_ro.c','fdt_wip.c','fdt_sw.c','fdt_rw.c','fdt_strerror.c',
+          'fdt_empty_tree.c','fdt_addresses.c','fdt_check.c']
+report={'device_io':False,'sanitizers':['address','undefined'],'results':[]}
+with tempfile.TemporaryDirectory(prefix='k70-r2-tests-') as name:
+    for label,sources,extra in [
+        ('qualified-union',[HERE/'test-qualified-union.c'],[]),
+        ('actual-publisher',[DRIVER/'FdtRamPlan.c',DRIVER/'MeasuredRam.c',HERE/'test-publish-r2.c',
+                             *[LIB/f for f in libfiles]],['-DK70_RAM_PUBLISH_TEST']),
+    ]:
+        binary=Path(name)/label
+        cmd=[*flags,*extra,'-I',str(DRIVER),'-I',str(HERE),'-I',str(LIB),
+             *map(str,sources),'-o',str(binary)]
+        subprocess.run(cmd,check=True,timeout=60)
+        result=subprocess.run([str(binary)],check=True,capture_output=True,text=True,timeout=30)
+        print(result.stdout,end='')
+        report['results'].append({'name':label,'success':True,'stdout':result.stdout,
+                                 'source_sha256':{str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in sources}})
+report['success']=True
+(HERE/'r2-reproduction-tests.json').write_text(json.dumps(report,indent=2)+'\n')
diff --git a/research/memory-next/test-publish-r2.c b/research/memory-next/test-publish-r2.c
new file mode 100644
index 0000000..3c55121
--- /dev/null
+++ b/research/memory-next/test-publish-r2.c
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include "PublishTestShim.h"
+#include "MeasuredRam.h"
+#include <assert.h>
+#include <libfdt.h>
+#include <stdio.h>
+
+static unsigned char Blob[4096] __attribute__((aligned(8)));
+static unsigned Fail, Calls, Adds, Sets, CurrentTpl, Mapped, PublishedMock;
+static K70_RAM_RANGE NewRange;
+static EFI_STATUS Map(UINTN *Count, EFI_GCD_MEMORY_SPACE_DESCRIPTOR **Out) {
+  ++Calls; assert(CurrentTpl==4);
+  *Count=1; *Out=calloc(1,sizeof(**Out)); assert(*Out);
+  (*Out)[0].BaseAddress=0x900000000ULL; (*Out)[0].Length=0x80000000ULL;
+  (*Out)[0].GcdMemoryType=EfiGcdMemoryTypeNonExistent;
+  return EFI_SUCCESS;
+}
+static EFI_STATUS Desc(UINT64 Base,EFI_GCD_MEMORY_SPACE_DESCRIPTOR *Out) {
+  ++Calls; memset(Out,0,sizeof(*Out));
+  if (Base==0xBAB00000) {
+    assert(CurrentTpl==4);
+    Out->BaseAddress=0xBAB00000; Out->Length=0xD1C0000;
+    Out->GcdMemoryType=EfiGcdMemoryTypeSystemMemory;
+    Out->Capabilities=15|EFI_MEMORY_RUNTIME;
+  } else {
+    assert(CurrentTpl==TPL_NOTIFY && Base==0x900000000ULL);
+    Out->BaseAddress=Base; Out->Length=0x80000000ULL;
+    Out->GcdMemoryType=Fail==1?EfiGcdMemoryTypeSystemMemory:EfiGcdMemoryTypeNonExistent;
+  }
+  return EFI_SUCCESS;
+}
+unsigned ArmGetPhysicalAddressBits(void) { return 40; }
+EFI_STATUS ArmSetMemoryAttributes(UINT64 Base,UINT64 Bytes,UINT64 Attr,UINT64 Mask) {
+  assert(CurrentTpl==TPL_NOTIFY && !Adds && !Sets);
+  assert(Base==0x900000000ULL && Bytes==0x40000000 && Attr==EFI_MEMORY_WB && Mask==0);
+  ++Calls; Mapped=1; NewRange=(K70_RAM_RANGE){Base,Base+Bytes};
+  return Fail==2?EFI_DEVICE_ERROR:EFI_SUCCESS;
+}
+static EFI_STATUS Add(unsigned Type,UINT64 Base,UINT64 Bytes,UINT64 Caps) {
+  assert(CurrentTpl==TPL_NOTIFY && Mapped && !Sets);
+  assert(Type==EfiGcdMemoryTypeSystemMemory && Base==NewRange.Base && Base+Bytes==NewRange.End && Caps==15);
+  ++Calls; ++Adds; PublishedMock=1;
+  return Fail==3?EFI_DEVICE_ERROR:EFI_SUCCESS;
+}
+static EFI_STATUS Set(UINT64 Base,UINT64 Bytes,UINT64 Attr) {
+  assert(CurrentTpl==TPL_NOTIFY && Mapped && Adds==1 && PublishedMock);
+  assert(Base==NewRange.Base && Base+Bytes==NewRange.End && Attr==EFI_MEMORY_WB);
+  ++Calls; ++Sets;
+  return Fail==4?EFI_DEVICE_ERROR:EFI_SUCCESS;
+}
+static EFI_TPL Raise(EFI_TPL Tpl) { assert(CurrentTpl==4&&Tpl==TPL_NOTIFY);CurrentTpl=Tpl;return 4; }
+static void Restore(EFI_TPL Tpl) { assert(CurrentTpl==TPL_NOTIFY&&Tpl==4);CurrentTpl=Tpl; }
+static MOCK_DS Ds={Map,Desc,Add,Set}; MOCK_DS *gDS=&Ds;
+static MOCK_BS Bs={Raise,Restore}; MOCK_BS *gBS=&Bs;
+static void Fixture(void) {
+  int N; fdt64_t Reg[2]={cpu_to_fdt64(0x880000000ULL),cpu_to_fdt64(0x180000000ULL)};
+  assert(fdt_create_empty_tree(Blob,sizeof Blob)==0);
+  assert(fdt_setprop_u32(Blob,0,"#address-cells",2)==0);
+  assert(fdt_setprop_u32(Blob,0,"#size-cells",2)==0);
+  N=fdt_add_subnode(Blob,0,"memory@880000000");assert(N>=0);
+  assert(fdt_setprop_string(Blob,N,"device_type","memory")==0);
+  assert(fdt_setprop(Blob,N,"reg",Reg,sizeof Reg)==0);
+}
+static EFI_STATUS Run(K70_RAM_RANGE *Out,const CHAR16 **Reason) {
+  return K70PublishMeasuredRam(Blob,sizeof Blob,(UINT64)(uintptr_t)Blob,0xa9000000,0x4000000,Out,Reason);
+}
+int main(void) {
+  unsigned F, Prior; EFI_STATUS Status; K70_RAM_RANGE Out; const CHAR16 *Reason;
+  Fixture();
+  for(F=0;F<=4;++F) {
+    K70ResetMeasuredRamForTest(); Fail=F; Calls=Adds=Sets=Mapped=PublishedMock=0;CurrentTpl=4;
+    Status=Run(&Out,&Reason);assert(Reason&&CurrentTpl==4);
+    if(F==0) {
+      assert(Status==EFI_SUCCESS && Out.Base==0x900000000ULL && Out.End==0x940000000ULL);
+      Prior=Calls;assert(Run(&Out,&Reason)==EFI_SUCCESS && Calls==Prior && Adds==1);
+    } else {
+      assert(EFI_ERROR(Status)&&Out.Base==0&&Out.End==0);
+      if(F==1) assert(!Mapped&&!Adds&&!Sets);
+      if(F==2) assert(Mapped&&!Adds&&!Sets);
+      if(F==3) assert(Mapped&&Adds==1&&PublishedMock&&!Sets);
+      if(F==4) assert(Mapped&&Adds==1&&PublishedMock&&Sets==1);
+      if(F>=2) { Prior=Calls;assert(EFI_ERROR(Run(&Out,&Reason))&&Calls==Prior); }
+    }
+  }
+  // Production publisher must accept two adjacent 512MiB FDT bank entries
+  // within the SAME current NonExistent GCD descriptor.
+  {
+    fdt64_t R[4]={cpu_to_fdt64(0x900000000ULL),cpu_to_fdt64(0x20000000ULL),
+                 cpu_to_fdt64(0x920000000ULL),cpu_to_fdt64(0x20000000ULL)};
+    Fixture();
+    assert(fdt_setprop(Blob,fdt_path_offset(Blob,"/memory@880000000"),"reg",R,sizeof R)==0);
+    K70ResetMeasuredRamForTest();Fail=0;Calls=Adds=Sets=Mapped=PublishedMock=0;CurrentTpl=4;
+    assert(Run(&Out,&Reason)==EFI_SUCCESS && Out.Base==0x900000000ULL && Out.End==0x940000000ULL && Adds==1);
+  }
+  // Missing bank is rejected before any service or physical bank access.
+  K70ResetMeasuredRamForTest();Calls=0;Fail=0;CurrentTpl=4;
+  assert(fdt_del_node(Blob,fdt_path_offset(Blob,"/memory@880000000"))==0);
+  assert(EFI_ERROR(Run(&Out,&Reason)) && Calls==0);
+  puts("PASS: metadata-only publication model; premap before commit; no retry/unmap after partial failure");
+  return 0;
+}
diff --git a/research/memory-next/test-qualified-union.c b/research/memory-next/test-qualified-union.c
new file mode 100644
index 0000000..94f533e
--- /dev/null
+++ b/research/memory-next/test-qualified-union.c
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include "QualifiedUnion.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static unsigned Seed = 78129;
+static unsigned Next (void) { Seed = Seed * 1664525u + 1013904223u; return Seed; }
+static void Cover (const K70_RAM_RANGE *P, unsigned N, unsigned char Bits[256]) {
+  unsigned I, J;
+  memset(Bits,0,256);
+  for (I=0;I<N;++I) {
+    assert(P[I].Base<P[I].End && !(P[I].Base&4095) && !(P[I].End&4095));
+    for(J=(unsigned)(P[I].Base/4096);J<P[I].End/4096;++J) { assert(J<256);Bits[J]=1; }
+  }
+}
+int main(void) {
+  K70_RAM_RANGE G[3]={{0,64*4096},{64*4096,160*4096},{176*4096,256*4096}};
+  K70_RAM_RANGE P[128], T;
+  unsigned char Before[256],After[256]; unsigned Round,I,J,N,Original;
+  for(Round=0;Round<3000;++Round) {
+    N=0;
+    for(I=0;I<256;) {
+      unsigned End=I+1+Next()%8;
+      if(End>256)End=256;
+      if(Next()%3 && !((I<64&&End>64)||(I<160&&End>160)||(I<176&&End>176)) &&
+         (End<=160||I>=176)) P[N++]=(K70_RAM_RANGE){I*4096,End*4096};
+      I=End;
+    }
+    Original=N;Cover(P,N,Before);
+    for(I=0;I<N;++I){J=Next()%N;T=P[I];P[I]=P[J];P[J]=T;}
+    assert(K70JoinQualified(P,&N,G,3)==K70_RAM_OK);Cover(P,N,After);
+    assert(!memcmp(Before,After,sizeof Before)&&N<=Original);
+    for(I=1;I<N;++I) {
+      assert(P[I-1].End<=P[I].Base);
+      if(P[I-1].End==P[I].Base)
+        assert(P[I].Base==64*4096); // Only the explicit GCD boundary remains.
+    }
+  }
+  // Two 512 MiB FDT banks in one 1 GiB GCD interval become one qualified
+  // window; no memory on either side of an exclusion is ever added.
+  G[0]=(K70_RAM_RANGE){0x900000000ULL,0x940000000ULL};
+  P[0]=(K70_RAM_RANGE){0x920000000ULL,0x940000000ULL};
+  P[1]=(K70_RAM_RANGE){0x900000000ULL,0x920000000ULL};N=2;
+  assert(K70JoinQualified(P,&N,G,1)==K70_RAM_OK&&N==1&&P[0].End-P[0].Base==0x40000000);
+  G[0]=(K70_RAM_RANGE){0x900000000ULL,0x920000000ULL};
+  G[1]=(K70_RAM_RANGE){0x920000000ULL,0x940000000ULL};N=2;
+  P[0]=G[1];P[1]=G[0];assert(K70JoinQualified(P,&N,G,2)==K70_RAM_OK&&N==2);
+  G[0]=(K70_RAM_RANGE){0x900000000ULL,0x940000000ULL};
+  P[0]=(K70_RAM_RANGE){0x900000000ULL,0x91ffff000ULL};
+  P[1]=(K70_RAM_RANGE){0x920000000ULL,0x940000000ULL};N=2;
+  assert(K70JoinQualified(P,&N,G,1)==K70_RAM_OK&&N==2);
+  P[1].Base=P[0].End-4096;N=2;assert(K70JoinQualified(P,&N,G,1)==K70_RAM_BAD_RANGES);
+  puts("PASS: 3000 randomized page-set equality cases; adjacent512MiB join; no GCD boundary, reservation gap or ownership crossing");
+  return 0;
+}
