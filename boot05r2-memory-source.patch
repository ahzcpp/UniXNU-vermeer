+STATIC VOID
+K70RangeFrame (CONST K70_FDT_RAM *Info)
+{
+  EFI_GRAPHICS_OUTPUT_PROTOCOL *Gop;
+  EFI_GCD_MEMORY_SPACE_DESCRIPTOR *Map = NULL, G;
+  UINT64 Video[6], Total[8], Start, End, At, MaxPiece = 0, MaxJoined = 0;
+  UINT64 PlaceholderBase[4] = {0xC7CC0000, 0xCCF80000, 0xE671D000, 0x880000000ULL};
+  UINT64 PlaceholderEnd[4] = {0xCCD00000, 0xD4D00000, 0xFF800000, 0x8BB300000ULL};
+  K70_RAM_RANGE Gaps[256], Plan[K70_RAM_PIECES], Cut[2], Tmp;
+  EFI_MEMORY_DESCRIPTOR *D;
+  union { UINT64 Align; UINT8 Bytes[24576]; } EfiBuffer;
+  UINTN MapCount = 0, I, J, Row = 0, Count = 0, GapsCount = 0, EfiBytes = sizeof (EfiBuffer.Bytes), Key, Stride = 0;
+  UINT32 Version;
+  unsigned Pieces = 0;
+  EFI_STATUS Status, EfiStatus;
+  CHAR16 Line[128];
+  EFI_PEI_HOB_POINTERS Hob;
+  UINTN HobCount, ResourceExact, AllocationExact, OtherOverlap;
+  BOOLEAN EfiReserved;
+  int Result;
+
+  if (EFI_ERROR (gBS->LocateProtocol (&gEfiGraphicsOutputProtocolGuid, NULL, (VOID **)&Gop)) ||
+      EFI_ERROR (DarwinBootVideoFromGop (Gop, Video))) { return; }
+  Status = gDS->GetMemorySpaceMap (&MapCount, &Map);
+  EfiStatus = gBS->GetMemoryMap (&EfiBytes, (EFI_MEMORY_DESCRIPTOR *)EfiBuffer.Bytes, &Key, &Stride, &Version);
+  SetMem32 ((VOID *)(UINTN)Video[0], (UINTN)(Video[2] * Video[4]), 0xFF000000);
+#define FRAME(Column, Text) K70RangeLine (Video, Column, Row++, Text)
+  FRAME (0, L"K70 BOOT05R2 RANGE FRAME - NO WRITE");
+  FRAME (0, L"ALL RANGES [BASE,END), HEX");
+  UnicodeSPrint (Line, sizeof (Line), L"BANKS %u RESV %u GCD %u", Info->BankCount, Info->ReservedCount, (UINT32)MapCount);
+  FRAME (0, Line);
+  UnicodeSPrint (Line, sizeof (Line), L"GCD STATUS %lx EFI %lx", (UINT64)Status, (UINT64)EfiStatus);
+  FRAME (0, Line);
+  FRAME (0, L"N=NONEXIST R=RESV S=SYSTEM M=MMIO");
+  for (I = 0; I < Info->BankCount && I < 16; ++I) {
+    UnicodeSPrint (Line, sizeof (Line), L"B%02u %lx-%lx", (UINT32)I, Info->Banks[I].Base, Info->Banks[I].End);
+    FRAME (0, Line);
+    ZeroMem (Total, sizeof (Total));
+    if (!EFI_ERROR (Status) && Map != NULL) {
+      for (J = 0; J < MapCount; ++J) {
+        if (Map[J].Length == 0 || Map[J].Length > MAX_UINT64 - Map[J].BaseAddress) { continue; }
+        Start = MAX (Info->Banks[I].Base, Map[J].BaseAddress);
+        End = MIN (Info->Banks[I].End, Map[J].BaseAddress + Map[J].Length);
+        if (Start < End && Map[J].GcdMemoryType < ARRAY_SIZE (Total)) { Total[Map[J].GcdMemoryType] += End - Start; }
+      }
+    }
+    UnicodeSPrint (Line, sizeof (Line), L" N%lx R%lx S%lx M%lx", Total[0], Total[1], Total[2], Total[3]);
+    FRAME (0, Line);
+  }
+  if (!EFI_ERROR (Status) && Map != NULL) {
+    for (I = 0; I < MapCount; ++I) {
+      if (Map[I].GcdMemoryType == EfiGcdMemoryTypeNonExistent && Map[I].Length != 0 &&
+          Map[I].Length <= MAX_UINT64 - Map[I].BaseAddress &&
+          Map[I].ImageHandle == NULL && Map[I].DeviceHandle == NULL && GapsCount < ARRAY_SIZE (Gaps)) {
+        Gaps[GapsCount++] = (K70_RAM_RANGE){Map[I].BaseAddress, Map[I].BaseAddress + Map[I].Length};
+      }
+    }
+  }
+  Cut[0] = (K70_RAM_RANGE){(UINTN)mValidatedFdt, (UINTN)mValidatedFdt + mValidatedFdtBytes};
+  Cut[1] = (K70_RAM_RANGE){mValidatedInitrd, mValidatedInitrd + mValidatedInitrdBytes};
+  Result = K70PlanNewRam (Info, Gaps, (unsigned)GapsCount, Cut, 2,
+                         ArmGetPhysicalAddressBits (), Plan, ARRAY_SIZE (Plan), &Pieces);
+  // Sort and calculate physical adjacency for diagnostics only. The actual
+  // publisher and its final single-GCD ownership check are unchanged.
+  for (I = 0; I < Pieces; ++I) {
+    for (J = I + 1; J < Pieces; ++J) {
+      if (Plan[J].Base < Plan[I].Base) { Tmp = Plan[I]; Plan[I] = Plan[J]; Plan[J] = Tmp; }
+    }
+  }
+  for (I = 0; I < Pieces; ++I) { MaxPiece = MAX (MaxPiece, Plan[I].End - Plan[I].Base); }
+  if (Result == K70_RAM_OK) { Result = K70JoinQualified (Plan, &Pieces, Gaps, (unsigned)GapsCount); }
+  for (I = 0; I < Pieces; ++I) {
+    MaxJoined = MAX (MaxJoined, Plan[I].End - Plan[I].Base);
+  }
+  UnicodeSPrint (Line, sizeof (Line), L"STRICT RC %d N %u GAP %u", Result, Pieces, (UINT32)GapsCount);
+  FRAME (0, Line);
+  UnicodeSPrint (Line, sizeof (Line), L"MAX PIECE %lx JOIN %lx", MaxPiece, MaxJoined);
+  FRAME (0, Line);
+  for (I = 0; I < Pieces && I < 8; ++I) {
+    UnicodeSPrint (Line, sizeof (Line), L"P%02u %lx-%lx", (UINT32)I, Plan[I].Base, Plan[I].End);
+    FRAME (0, Line);
+  }
+  if (Pieces > 8) { FRAME (0, L"P DISPLAY FIRST8; MAX USES ALL"); }
+  FRAME (0, L"OWN PLACEHOLDERS: GCD/HOB/EFI");
+  for (I = 0; I < 4; ++I) {
+    UnicodeSPrint (Line, sizeof (Line), L"U%u %lx-%lx", (UINT32)I, PlaceholderBase[I], PlaceholderEnd[I]);
+    FRAME (0, Line);
+    Status = gDS->GetMemorySpaceDescriptor (PlaceholderBase[I], &G);
+    if (EFI_ERROR (Status)) { UnicodeSPrint (Line, sizeof (Line), L" GCD ERROR %lx", (UINT64)Status); }
+    else {
+      UnicodeSPrint (Line, sizeof (Line), L" G%u %lx-%lx I%u D%u", G.GcdMemoryType,
+                     G.BaseAddress, G.BaseAddress + G.Length, G.ImageHandle != NULL, G.DeviceHandle != NULL);
+    }
+    FRAME (0, Line);
+    if (!EFI_ERROR (Status)) {
+      UnicodeSPrint (Line, sizeof (Line), L" CAP%lx ATTR%lx", G.Capabilities, G.Attributes);
+      FRAME (0, Line);
+    }
+    ResourceExact = AllocationExact = OtherOverlap = 0;
+    Hob.Raw = GetHobList ();
+    for (HobCount = 0; HobCount < 1024 && !END_OF_HOB_LIST (Hob); ++HobCount) {
+      if (Hob.Header->HobLength < sizeof (EFI_HOB_GENERIC_HEADER)) { ++OtherOverlap; break; }
+      if (GET_HOB_TYPE (Hob) == EFI_HOB_TYPE_RESOURCE_DESCRIPTOR &&
+          Hob.Header->HobLength >= sizeof (EFI_HOB_RESOURCE_DESCRIPTOR)) {
+        Start = Hob.ResourceDescriptor->PhysicalStart;
+        End = Start + Hob.ResourceDescriptor->ResourceLength;
+        if (Start == PlaceholderBase[I] && End == PlaceholderEnd[I] &&
+            Hob.ResourceDescriptor->ResourceType == EFI_RESOURCE_SYSTEM_MEMORY) { ++ResourceExact; }
+        else if (End > Start && Start < PlaceholderEnd[I] && End > PlaceholderBase[I]) { ++OtherOverlap; }
+      }
+      if (GET_HOB_TYPE (Hob) == EFI_HOB_TYPE_MEMORY_ALLOCATION &&
+          Hob.Header->HobLength >= sizeof (EFI_HOB_MEMORY_ALLOCATION)) {
+        Start = Hob.MemoryAllocation->AllocDescriptor.MemoryBaseAddress;
+        End = Start + Hob.MemoryAllocation->AllocDescriptor.MemoryLength;
+        if (Start == PlaceholderBase[I] && End == PlaceholderEnd[I] &&
+            Hob.MemoryAllocation->AllocDescriptor.MemoryType == EfiReservedMemoryType) { ++AllocationExact; }
+        else if (End > Start && Start < PlaceholderEnd[I] && End > PlaceholderBase[I]) { ++OtherOverlap; }
+      }
+      Hob.Raw = GET_NEXT_HOB (Hob);
+    }
+    EfiReserved = !EFI_ERROR (EfiStatus) && Stride >= sizeof (*D) && EfiBytes <= sizeof (EfiBuffer.Bytes) && EfiBytes % Stride == 0;
+    At = PlaceholderBase[I];
+    for (Count = 0; EfiReserved && At < PlaceholderEnd[I] && Count < 256; ++Count) {
+      End = At;
+      for (J = 0; J < EfiBytes; J += Stride) {
+        D = (EFI_MEMORY_DESCRIPTOR *)(EfiBuffer.Bytes + J);
+        if (D->NumberOfPages > (MAX_UINT64 - D->PhysicalStart) / EFI_PAGE_SIZE) { continue; }
+        Start = D->PhysicalStart;
+        if (Start <= At && At < Start + EFI_PAGES_TO_SIZE (D->NumberOfPages) && D->Type == EfiReservedMemoryType) {
+          End = MIN (PlaceholderEnd[I], Start + EFI_PAGES_TO_SIZE (D->NumberOfPages)); break;
+        }
+      }
+      if (End == At) { EfiReserved = FALSE; break; }
+      At = End;
+    }
+    EfiReserved = EfiReserved && At == PlaceholderEnd[I];
+    UnicodeSPrint (Line, sizeof (Line), L" HOB R%u A%u X%u EFI0%u", (UINT32)ResourceExact,
+                   (UINT32)AllocationExact, (UINT32)OtherOverlap, EfiReserved);
+    FRAME (0, Line);
+  }
+  UnicodeSPrint (Line, sizeof (Line), L"FDT %lx+%lx", (UINT64)(UINTN)mValidatedFdt, (UINT64)mValidatedFdtBytes);
+  FRAME (0, Line);
+  UnicodeSPrint (Line, sizeof (Line), L"INITRD %lx+%lx", mValidatedInitrd, mValidatedInitrdBytes);
+  FRAME (0, Line);
+  FRAME (0, L"READ ONLY; NO RECLASSIFY OR PROBE");
+  FRAME (0, L"RELEASE KEYS; NEW KEY FOR MENU");
+  Row = 0;
+  FRAME (1, L"FDT RESERVATIONS (ALL EXCLUDED)");
+  for (I = 0; I < Info->ReservedCount && I < 68; ++I) {
+    UnicodeSPrint (Line, sizeof (Line), L"R%02u %lx-%lx", (UINT32)I, Info->Reserved[I].Base, Info->Reserved[I].End);
+    FRAME (1, Line);
+  }
+  if (Info->ReservedCount > 68) { FRAME (1, L"RESERVATIONS DISPLAY TRUNCATED"); }
+#undef FRAME
+  if (Map != NULL) { FreePool (Map); }
+}
