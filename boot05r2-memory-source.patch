+#!/usr/bin/env python3
+"""Create an exact source-only delta on the frozen public boot05/r1 bundle."""
+import hashlib
+import json
+import re
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+W=Path(__file__).resolve().parent
+B=W.parent
+OUT=B/'device-source'
+BASE_PATCH=OUT/'boot05-memory-source.patch'
+BASE_SHA='588a60d1f22f45ba53a16596be18d2995a953f0cd0b18e9737a297fca884bb71'
+def sha(data):return hashlib.sha256(data).hexdigest()
+assert sha(BASE_PATCH.read_bytes())==BASE_SHA
+audit=json.loads((W/'fd-audit.json').read_text())
+build=json.loads((W/'build-result.json').read_text())
+verification=json.loads((B/'artifacts/boot-chain-05r2/verification.json').read_text())
+assert audit['success'] and build['exit_code']==0 and not build['source_changed_during_build']
+assert audit['fd_sha256']==verification['firmware_sha256']=='2fdea384c5b94fde539fabd3f9a7370caf3372d9c667a5fbb90fc1a2548677f9'
+for rel,digest in build['source_sha256'].items():assert sha((W/rel).read_bytes())==digest
+mapping={}
+def add(target,source):
+    data=source.read_bytes();text=data.decode('utf-8-sig')
+    assert '\0' not in text and re.search(r'^-----BEGIN [A-Z ]*PRIVATE KEY-----$',text,re.M) is None
+    assert target.startswith(('research/boot-chain-05/','research/memory-next/'))
+    mapping[target]=data
+for name in ['DarwinBoot.c','DarwinBoot.inf','MeasuredRam.c','QualifiedUnion.h']:
+    add('research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/'+name,W/'darwinboot/DarwinBootPkg/Driver'/name)
+for name in ['incremental-ui.py','package-r2.py','R2-README.md','export-r2-source.py']:
+    add('research/boot-chain-05/'+name,W/name)
+for name in ['QualifiedUnion.h','test-qualified-union.c','test-publish-r2.c','run-r2-tests.py',
+             'qualified-union-test.json','publication-r2-test.json']:
+    add('research/memory-next/'+name,B/'memory-next'/name)
+for name in ['build-result.json','fd-audit.json','r2-range-change.json']:
+    add('research/boot-chain-05/r2/'+name,W/name)
+add('research/boot-chain-05/r2/verification.json',B/'artifacts/boot-chain-05r2/verification.json')
+def init(path):
+    subprocess.run(['git','init','-q',str(path)],check=True)
+    subprocess.run(['git','-C',str(path),'config','core.autocrlf','false'],check=True)
+    subprocess.run(['git','-C',str(path),'apply',str(BASE_PATCH)],check=True)
+with tempfile.TemporaryDirectory(prefix='k70-r2-delta-') as name:
+    repo=Path(name);init(repo)
+    subprocess.run(['git','-C',str(repo),'add','--all'],check=True)
+    subprocess.run(['git','-C',str(repo),'-c','user.name=Source Audit','-c','user.email=source-audit@localhost',
+                    'commit','-qm','Frozen public source base'],check=True)
+    before={str(p.relative_to(repo)):p.read_bytes() for p in repo.rglob('*') if p.is_file() and '.git' not in p.parts}
+    for target,data in mapping.items():
+        p=repo/target;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(data)
+    subprocess.run(['git','-C',str(repo),'add','--all'],check=True)
+    patch=subprocess.check_output(['git','-C',str(repo),'diff','--cached','--binary','--no-ext-diff'])
+with tempfile.TemporaryDirectory(prefix='k70-r2-apply-') as name:
+    repo=Path(name);init(repo);p=repo/'r2.patch';p.write_bytes(patch)
+    subprocess.run(['git','-C',str(repo),'apply','--check',str(p)],check=True)
+    subprocess.run(['git','-C',str(repo),'apply',str(p)],check=True)
+    expected={**before,**mapping}
+    for target,data in expected.items():assert (repo/target).read_bytes()==data,'Readback mismatch: '+target
+result={
+    'format':'source-only-git-delta','base_patch_sha256':BASE_SHA,
+    'base_public_commit':'3e544bf6e2e8a76136efe1221d3f7f82cd1510b8',
+    'files':{name:{'bytes':len(data),'sha256':sha(data),'action':'modified' if name in before else 'added'}
+             for name,data in mapping.items()},
+    'file_count':len(mapping),'patch_bytes':len(patch),'patch_sha256':sha(patch),
+    'base_then_delta_clean_apply_and_all_files_exact_readback':True,
+    'contains_apple_or_oem_binaries':False,'contains_private_phone_identifiers':False,
+    'fixed_local_workspace_dependency':True,'r2_hardware_result':'pending',
+    'r1_actual_result':'M05 no measured 514MiB contiguous GCD gap; META0 BANKS8 RESV52 DYN0',
+    'r2_boot_image_sha256':verification['boot_image_sha256'],
+    'r2_fd_sha256':verification['firmware_sha256'],
+}
+(OUT/'boot05r2-memory-source.patch').write_bytes(patch)
+(OUT/'boot05r2-memory-source.manifest.json').write_text(json.dumps(result,indent=2)+'\n')
+shutil.copyfile(W/'R2-README.md',OUT/'docs/boot05r2-memory-2026-11-04.md')
+print(json.dumps({k:v for k,v in result.items() if k!='files'},indent=2))
