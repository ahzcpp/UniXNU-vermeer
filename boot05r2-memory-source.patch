+// Read-only diagnostic. It reads only validated FDT bytes and UEFI-owned
+// metadata; it neither probes candidate RAM nor changes the planner/publication.
+STATIC VOID
+K70RangeLine (CONST UINT64 Video[6], UINTN Column, UINTN Row, CONST CHAR16 *Text)
+{
+  UINTN Scale = 3, Cell = 18, Height = 42, X, Y, I, Gx, Gy, Dx, Dy;
+  UINTN Left = Column * (Video[3] / 2), Limit = (Column + 1) * (Video[3] / 2);
+  UINT32 *Fb = (UINT32 *)(UINTN)Video[0];
+  UINT64 Glyph, Data;
+  CHAR16 Ch;
+  Y = 20 + Row * Height;
+  if (Y + Height > Video[4]) { return; }
+  X = Left;
+  for (I = 0; Text[I] != 0 && X + Cell <= Limit; ++I, X += Cell) {
+    Ch = Text[I];
+    if (Ch < 32 || Ch > 126) { Ch = '?'; }
+    Glyph = mDiagFont[Ch - 32];
+    for (Gy = 0; Gy < 12; ++Gy) {
+      Data = Gy < 6 ? (Glyph >> 32) >> (Gy * 5) : (Glyph & 0xFFFFFFFFULL) >> ((Gy - 6) * 5);
+      for (Gx = 0; Gx < 5; ++Gx) {
+        if (((Data >> Gx) & 1) == 0) { continue; }
+        for (Dy = 0; Dy < Scale; ++Dy) {
+          for (Dx = 0; Dx < Scale; ++Dx) {
+            Fb[(Y + Gy * Scale + Dy) * (Video[2] / 4) + X + Gx * Scale + Dx] = 0xFFFFFFFF;
+          }
+        }
+      }
+    }
+  }
+}
