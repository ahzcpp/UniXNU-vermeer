+                guards=[x for x in guarddir.rglob('*') if x.is_file() and x.suffix.lower() in ('.c','.h','.inf')]
+                check['critical_guard_sources']=[{'path':str(x),'sha256':sha(x.read_bytes()),'mtime_utc':utc(x.stat().st_mtime)} for x in guards]
