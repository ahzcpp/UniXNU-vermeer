+#!/usr/bin/env python3
+"""Read-only bounded Qualcomm FV/FFS/section extractor; never executes firmware.
+
+Run under Python 3.10+ (WSL recommended). All inputs are authenticated by the
+existing source manifest or pinned imagefv digest before parsing. Output is
+confined to --out, and every emitted payload has a SHA-256 in audit.json.
+"""
+import argparse
+import csv
+import gzip
+import hashlib
+import json
+import lzma
+import re
+import struct
+import sys
+import uuid
+import zipfile
+from pathlib import Path
+
+IMAGEFV_SHA = "50367d472a97a4ffa68b8ae1290dca81cd2b4c89dab0dbc5009f1a9581788b41"
+GZIP_GUID = "1d301fe9-be79-4353-91c2-d23bc959ae0c"
+LZMA_GUID = "ee4e5898-3914-4259-9d6e-dc7bd79403cf"
+FFS_NAMES = {1:"RAW",2:"FREEFORM",3:"SECURITY_CORE",4:"PEI_CORE",5:"DXE_CORE",6:"PEIM",7:"DRIVER",8:"COMBINED_PEIM_DRIVER",9:"APPLICATION",10:"SMM",11:"FV_IMAGE",12:"COMBINED_SMM_DXE",13:"SMM_CORE",0xf0:"PAD"}
+SEC_NAMES = {1:"COMPRESSION",2:"GUID_DEFINED",0x10:"PE32",0x11:"PIC",0x12:"TE",0x13:"DXE_DEPEX",0x14:"VERSION",0x15:"UI",0x16:"COMPAT16",0x17:"FV_IMAGE",0x18:"FREEFORM_SUBTYPE_GUID",0x19:"RAW",0x1b:"PEI_DEPEX",0x1c:"SMM_DEPEX"}
+FFS_GUIDS = {"7a9354d9-0468-444a-81ce-0bf617d890df", "8c8ce578-8a3d-4f1c-9935-896185c32dd3", "5473c07a-3dcb-4dca-bd6f-1e9689e7349a", "631008b0-b2d1-410a-8b49-2c5c4d8ecc7e"}
+
+def sha(data): return hashlib.sha256(data).hexdigest()
+def guid(data): return str(uuid.UUID(bytes_le=bytes(data)))
+def u24(data): return int.from_bytes(data, "little")
+def align(n, a): return (n+a-1)&~(a-1)
+def padding(data): return not data or all(x == 0xff for x in data) or all(x == 0 for x in data)
+
+def depex(data):
+    """Decode PI dependency bytecode, preserving all operands (no label guesses)."""
+    result, pos, stack = [], 0, 0
+    pushes = []
+    while pos < len(data):
+        op = data[pos]; pos += 1
+        if op in (0,1,2):
+            if pos+16 > len(data): raise ValueError("truncated DEPEX GUID")
+            value = guid(data[pos:pos+16]); pos += 16
+            result.append({"op":{0:"BEFORE",1:"AFTER",2:"PUSH"}[op], "guid":value})
+            pushes.append(value)
+            if op == 2: stack += 1
+        elif op in (3,4):
+            if stack < 2: raise ValueError("DEPEX binary stack underflow")
+            stack -= 1; result.append({"op":{3:"AND",4:"OR"}[op]})
+        elif op == 5:
+            if stack < 1: raise ValueError("DEPEX NOT stack underflow")
+            result.append({"op":"NOT"})
+        elif op in (6,7):
+            stack += 1; result.append({"op":{6:"TRUE",7:"FALSE"}[op]})
+        elif op == 8:
+            result.append({"op":"END"})
+            if pos != len(data): raise ValueError("bytes after DEPEX END")
+        elif op == 9: result.append({"op":"SOR"})
+        else: raise ValueError("unknown DEPEX opcode %02x" % op)
+    if not result or result[-1]["op"] != "END": raise ValueError("missing DEPEX END")
+    if not any(x["op"] in ("BEFORE","AFTER") for x in result) and stack != 1:
+        raise ValueError("DEPEX final stack is not one")
+    return {"instructions":result, "protocol_guids":pushes}
+
+class Audit:
+    def __init__(self, out):
+        self.out = out.resolve(); self.fvs=[]; self.files=[]; self.blobs=[]; self.errors=[]; self.warnings=[]
+    def emit(self, name, data, kind):
+        dest = self.out / name
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        if dest.exists():
+            if dest.read_bytes() != data:
+                raise ValueError("refuse differing pre-existing output: " + str(dest))
+        else:
+            dest.write_bytes(data)
+        item={"path":str(dest.relative_to(self.out)).replace("\\","/"),"kind":kind,"bytes":len(data),"sha256":sha(data)}
+        self.blobs.append(item)
+        return item
+    def scan(self, data, path, ancestry):
+        """Find non-overlapping validated firmware volumes in this container."""
+        pos=0; count=0
+        while True:
+            sig=data.find(b"_FVH",pos)
+            if sig < 0: break
+            base=sig-40; pos=sig+4
+            if base < 0 or base+56 > len(data): continue
+            length=struct.unpack_from("<Q",data,base+32)[0]
+            hlen=struct.unpack_from("<H",data,base+48)[0]
+            if length<56 or base+length>len(data) or hlen<56 or hlen%2 or hlen>length: continue
+            head=data[base:base+hlen]
+            if sum(struct.unpack("<%dH"%(hlen//2),head))&0xffff: continue
+            fsguid=guid(data[base+16:base+32])
+            if fsguid not in FFS_GUIDS:
+                self.warnings.append({"path":path,"offset":base,"reason":"unknown FV filesystem GUID", "guid":fsguid})
+                continue
+            self.fv(data[base:base+length], f"{path}/fv-{base:08x}", ancestry+[{"container_offset":base}])
+            pos=base+length; count+=1
+        return count
+    def fv(self, data, path, ancestry):
+        hlen=struct.unpack_from("<H",data,48)[0]; ext=struct.unpack_from("<H",data,52)[0]
+        offset=hlen
+        if ext:
+            if ext+20>len(data): raise ValueError("FV extended header out of bounds")
+            extsize=struct.unpack_from("<I",data,ext+16)[0]
+            if ext+extsize>len(data): raise ValueError("FV extended header size out of bounds")
+            # The FV extended header can be carried inside an initial PAD FFS;
+            # retain that FFS in the complete inventory rather than skip it.
+        blocks=[]; p=56
+        while p+8<=hlen:
+            count,size=struct.unpack_from("<II",data,p); p+=8
+            if count==size==0: break
+            blocks.append({"count":count,"block_size":size})
+        blocktotal=sum(b["count"]*b["block_size"] for b in blocks)
+        if blocktotal != len(data): raise ValueError("FV block map length mismatch")
+        record={"path":path,"bytes":len(data),"header_bytes":hlen,"filesystem_guid":guid(data[16:32]),"header_checksum_valid":True,"block_map":blocks,"ancestry":ancestry,"payload":self.emit(path+"/volume.fv",data,"FV"),"files":[]}
+        self.fvs.append(record)
+        offset=align(offset,8)
+        while offset+24<=len(data):
+            if padding(data[offset:offset+24]):
+                if not padding(data[offset:]): self.errors.append({"path":path,"offset":offset,"reason":"non-padding after erased file header"})
+                break
+            header=data[offset:offset+24]; name=guid(header[:16]); typ=header[18]; attrs=header[19]; size=u24(header[20:23]); hsize=24
+            if attrs&1:
+                if size != 0xffffff or offset+32>len(data): raise ValueError("invalid large FFS header")
+                size=struct.unpack_from("<Q",data,offset+24)[0]; hsize=32
+            if size<hsize or offset+size>len(data): raise ValueError(f"FFS size out of bounds {path} {offset:x} {size:x}")
+            fdata=data[offset:offset+size]; body=fdata[hsize:]
+            check=bytearray(fdata[:hsize]); check[17]=check[23]=0
+            headok=sum(check)%256==0
+            bodyok=((sum(body)+fdata[17])%256==0) if attrs&0x40 else fdata[17]==0xaa
+            fpath=f"{path}/file-{offset:08x}-{name}"
+            rec={"path":fpath,"fv_path":path,"offset_in_fv":offset,"guid":name,"type":typ,"type_name":FFS_NAMES.get(typ,"UNKNOWN"),"attributes":attrs,"state":header[23],"bytes":size,"header_bytes":hsize,"header_checksum_valid":headok,"data_checksum_valid":bodyok,"ui":[],"sections":[],"payload":self.emit(fpath+"/file.ffs",fdata,"FFS")}
+            self.files.append(rec); record["files"].append(fpath)
+            if not headok or not bodyok: self.errors.append({"path":fpath,"reason":"FFS checksum invalid","header":headok,"data":bodyok})
+            if typ not in (0xf0,0):
+                if typ==1:
+                    rec["raw_file"]=self.emit(fpath+"/body.raw",body,"RAW_FILE")
+                    self.scan(body,fpath+"/raw",ancestry+[{"ffs_guid":name,"offset_in_fv":offset}])
+                else:
+                    self.sections(body,fpath,rec,ancestry+[{"ffs_guid":name,"offset_in_fv":offset}])
+            offset=align(offset+size,8)
+        record["file_count"]=len(record["files"])
+    def sections(self, data, path, filerec, ancestry):
+        offset=0; index=0
+        while offset+4<=len(data):
+            if padding(data[offset:]): break
+            size=u24(data[offset:offset+3]); typ=data[offset+3]; hs=4
+            if size==0xffffff:
+                if offset+8>len(data): raise ValueError("truncated extended section")
+                size=struct.unpack_from("<I",data,offset+4)[0]; hs=8
+            if size<hs or offset+size>len(data): raise ValueError(f"section size out of bounds {path} {offset:x} {size:x}")
+            sec=data[offset:offset+size]; body=sec[hs:]; name=SEC_NAMES.get(typ,f"UNKNOWN_{typ:02x}")
+            spath=f"{path}/section-{index:02d}-{offset:08x}-{name}"
+            rec={"path":spath,"type":typ,"type_name":name,"offset_in_parent":offset,"bytes":size,"header_bytes":hs,"payload":self.emit(spath+".bin",body,name)}
+            filerec["sections"].append(rec)
+            if typ==0x15:
+                rec["text"]=body.decode("utf-16le").rstrip("\0"); filerec["ui"].append(rec["text"])
+            elif typ in (0x13,0x1b,0x1c): rec["depex"]=depex(body)
+            elif typ in (0x10,0x12):
+                if body[:2]==b"MZ" and len(body)>=64:
+                    peoff=struct.unpack_from("<I",body,0x3c)[0]
+                    if peoff+6>len(body) or body[peoff:peoff+4]!=b"PE\0\0": raise ValueError("invalid PE signature")
+                    rec["machine"]=hex(struct.unpack_from("<H",body,peoff+4)[0]); rec["format"]="PE32/PE32+"
+                elif body[:2]==b"VZ" and len(body)>=40:
+                    rec["machine"]=hex(struct.unpack_from("<H",body,2)[0]); rec["format"]="TE"
+                else: raise ValueError("PE/TE section signature missing")
+            elif typ==0x17:
+                if not self.scan(body,spath,ancestry+[{"section":index,"type":name}]): raise ValueError("FV_IMAGE contains no validated FV")
+            elif typ==2:
+                if len(body)<20: raise ValueError("truncated GUID-defined section")
+                g=guid(body[:16]); doff,attrs=struct.unpack_from("<HH",body,16)
+                if doff<hs+20 or doff>size: raise ValueError("GUID-defined DataOffset out of bounds")
+                content=sec[doff:]; rec.update(guid=g, data_offset=doff, attributes=attrs)
+                if g in (GZIP_GUID,LZMA_GUID):
+                    expanded=gzip.decompress(content) if g==GZIP_GUID else lzma.decompress(content,format=lzma.FORMAT_ALONE)
+                    rec["decompressed"]=self.emit(spath+"/expanded.bin",expanded,"GZIP_EXPANDED" if g==GZIP_GUID else "LZMA_EXPANDED")
+                    self.sections(expanded,spath,filerec,ancestry+[{"section":index,"guid":g,"decompressed":True}])
+                else: self.errors.append({"path":spath,"reason":"unhandled GUID-defined section","guid":g})
+            elif typ==1:
+                if len(body)<5: raise ValueError("truncated compression header")
+                expected,ctype=struct.unpack_from("<IB",body); comp=body[5:]
+                rec.update(compression_type=ctype,uncompressed_bytes=expected)
+                if ctype==0: expanded=comp
+                elif ctype==1:
+                    from uefi_firmware import efi_compressor
+                    expanded=None
+                    for func in (efi_compressor.EfiDecompress, efi_compressor.TianoDecompress):
+                        try: expanded=func(comp,len(comp)); break
+                        except Exception: pass
+                    if expanded is None: raise ValueError("EFI/Tiano decompression failed")
+                else: raise ValueError("unhandled compression type")
+                if len(expanded)!=expected: raise ValueError("compression size mismatch")
+                rec["decompressed"]=self.emit(spath+"/expanded.bin",expanded,"COMPRESSION_EXPANDED")
+                self.sections(expanded,spath,filerec,ancestry+[{"section":index,"decompressed":True}])
+            offset=align(offset+size,4); index+=1
+        if offset<len(data) and not padding(data[offset:]): raise ValueError("non-padding section tail")
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--manifest",type=Path,required=True)
+    ap.add_argument("--out",type=Path,required=True)
+    args=ap.parse_args(); base=args.manifest.resolve().parent
+    source=json.loads(args.manifest.read_text(encoding="utf-8-sig"))
+    # The manifest schema is deliberately inspected before choosing local paths.
+    extracted=source.get("extracted",source.get("extracted_files",[]))
+    if isinstance(extracted,dict): extracted=list(extracted.values())
+    if not extracted:
+        raise ValueError("source manifest extracted entries not found; inspect schema")
+    audit=Audit(args.out); audit.out.mkdir(parents=True,exist_ok=True)
+    inputs=[]
+    for item in extracted:
+        path=Path(item.get("path",item.get("output","")))
+        path=Path(str(path).replace("E:/","/mnt/e/").replace("E:\\","/mnt/e/").replace("\\","/"))
+        if not path.is_absolute(): path=base/path
+        data=path.read_bytes(); expected=item["sha256"]
+        if sha(data)!=expected: raise ValueError("input SHA mismatch: "+str(path))
+        inputs.append({"path":str(path),"bytes":len(data),"sha256":expected,"data":data,"name":path.stem})
+    zentry=source.get("download",source.get("archive",{}))
+    zpath=zentry.get("path",zentry.get("output_path",None))
+    if not zpath:
+        zips=list(base.glob("fw_vermeer*.zip"))
+        if len(zips)!=1: raise ValueError("cannot identify unique verified firmware ZIP")
+        zpath=zips[0]
+    zpath=Path(str(zpath).replace("E:/","/mnt/e/").replace("E:\\","/mnt/e/").replace("\\","/"))
+    zdata=zpath.read_bytes()
+    expected_zip="0ad27e0d0fb0bc38c720663257847e75784d8d7d00cd8e6c693bcacfe948c617"
+    if sha(zdata)!=expected_zip: raise ValueError("firmware ZIP SHA mismatch")
+    with zipfile.ZipFile(zpath) as z:
+        data=z.read("firmware-update/imagefv.img")  # ZipFile verifies CRC.
+    if sha(data)!=IMAGEFV_SHA: raise ValueError("imagefv SHA mismatch")
+    image=audit.emit("inputs/imagefv.img",data,"VERIFIED_ZIP_MEMBER")
+    inputs.append({"path":str(zpath)+"!firmware-update/imagefv.img","bytes":len(data),"sha256":IMAGEFV_SHA,"data":data,"name":"imagefv"})
+    for item in inputs:
+        data=item["data"]; item["validated_fv_count"]=audit.scan(data,item["name"],[{"input":item["name"]}])
+        if data[:4]==b"\x7fELF":
+            item["elf_class"]=data[4]; item["elf_machine"]=struct.unpack_from("<H",data,18)[0]
+        del item["data"]
+    # Short, content-addressed module paths are usable by Windows tools too.
+    for item in audit.files:
