+#!/usr/bin/env python3
+"""Create an isolated boot05 candidate from the verified boot04 runtime snapshot.
+
+No build or device operation. The previous candidate is only read, never edited.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+
+NEXT = Path(__file__).resolve().parent
+BASE = NEXT.parent
+PREVIOUS = BASE / 'boot-chain-04'
+WORK = BASE / 'boot-chain-05'
+cli = argparse.ArgumentParser()
+cli.add_argument('--refresh-owned', action='store_true')
+args = cli.parse_args()
+old_audit = WORK/'preparation-audit.json'
+owned = json.loads(old_audit.read_text()).get('source_sha256', {}) if old_audit.is_file() else {}
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def replace(text, old, new):
+    if text.count(old) != 1:
+        raise ValueError('Expected one source replacement: ' + old)
+    return text.replace(old, new)
+
+
+def put(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if isinstance(data, str):
+        data = data.replace('\r\n', '\n').encode()
+    if path.exists() and path.read_bytes() != data:
+        name = str(path.relative_to(WORK))
+        if not (args.refresh_owned and name in owned and sha(path.read_bytes()) == owned[name]):
+            raise ValueError('Refusing to overwrite a different candidate file: ' + str(path))
+    path.write_bytes(data)
+
+
+build = json.loads((PREVIOUS / 'build-result.json').read_text())
+audit = json.loads((PREVIOUS / 'fd-audit.json').read_text())
+assert build['exit_code'] == 0 and not build['source_changed_during_build']
+assert audit['success'] and audit['fd_sha256'] == 'b79728738c4b284b46813f75703f9b5c071c10bbd976725210ca92c3322d7bc5'
