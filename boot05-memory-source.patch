new file mode 100644
index 0000000..6afafdc
--- /dev/null
+++ b/research/memory-next/PublishTestShim.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Host-only service model; production uses the real EDK headers/ABI.
+#ifndef K70_PUBLISH_TEST_SHIM_H
+#define K70_PUBLISH_TEST_SHIM_H
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+typedef uint64_t UINT64;
+typedef size_t UINTN;
+typedef uint64_t EFI_STATUS;
+typedef unsigned EFI_TPL;
+typedef void VOID;
+typedef wchar_t CHAR16;
+#define CONST const
+#define STATIC static
+#define MAX_UINT64 UINT64_MAX
+#define EFI_SUCCESS 0ULL
+#define EFI_INVALID_PARAMETER (0x8000000000000000ULL|2)
+#define EFI_UNSUPPORTED (0x8000000000000000ULL|3)
+#define EFI_NOT_READY (0x8000000000000000ULL|6)
+#define EFI_DEVICE_ERROR (0x8000000000000000ULL|7)
+#define EFI_OUT_OF_RESOURCES (0x8000000000000000ULL|9)
+#define EFI_ACCESS_DENIED (0x8000000000000000ULL|15)
+#define EFI_COMPROMISED_DATA (0x8000000000000000ULL|33)
+#define EFI_ERROR(X) (((X)&0x8000000000000000ULL)!=0)
+#define EFI_MEMORY_WB 8ULL
+#define EFI_MEMORY_RUNTIME 0x8000000000000000ULL
+#define ARRAY_SIZE(A) (sizeof(A)/sizeof((A)[0]))
+#define MIN(A,B) ((A)<(B)?(A):(B))
+#define TPL_NOTIFY 16U
+#define EfiGcdMemoryTypeNonExistent 0
+#define EfiGcdMemoryTypeSystemMemory 2
+#define ZeroMem(P,N) memset((P),0,(N))
+#define CopyMem(P,Q,N) memcpy((P),(Q),(N))
+#define CompareMem(P,Q,N) memcmp((P),(Q),(N))
+#define FreePool(P) free(P)
+typedef struct {
+  UINT64 BaseAddress, Length, Capabilities, Attributes;
+  unsigned GcdMemoryType;
+  void *ImageHandle, *DeviceHandle;
+} EFI_GCD_MEMORY_SPACE_DESCRIPTOR;
+typedef struct {
+  EFI_STATUS (*GetMemorySpaceMap)(UINTN*,EFI_GCD_MEMORY_SPACE_DESCRIPTOR**);
+  EFI_STATUS (*GetMemorySpaceDescriptor)(UINT64,EFI_GCD_MEMORY_SPACE_DESCRIPTOR*);
+  EFI_STATUS (*AddMemorySpace)(unsigned,UINT64,UINT64,UINT64);
+  EFI_STATUS (*SetMemorySpaceAttributes)(UINT64,UINT64,UINT64);
+} MOCK_DS;
+typedef struct {
+  EFI_TPL (*RaiseTPL)(EFI_TPL);
+  VOID (*RestoreTPL)(EFI_TPL);
+} MOCK_BS;
+extern MOCK_DS *gDS;
+extern MOCK_BS *gBS;
+unsigned ArmGetPhysicalAddressBits(void);
+EFI_STATUS ArmSetMemoryAttributes(UINT64,UINT64,UINT64,UINT64);
+#endif
