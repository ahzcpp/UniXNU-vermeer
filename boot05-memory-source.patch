index 0000000..6941565
--- /dev/null
+++ b/research/memory-next/MeasuredRam.c
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifdef K70_RAM_PUBLISH_TEST
+#include "PublishTestShim.h"
+#else
+#include <PiDxe.h>
+#include <Library/ArmLib.h>
+#include <Library/ArmMmuLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DxeServicesTableLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#endif
+#include "MeasuredRam.h"
+
+#define K70_WINDOW_BYTES  0x20000000ULL
+#define K70_MAX_PUBLISH   0x40000000ULL
+#define K70_PHASE_MARGIN  0x00200000ULL
+#define K70_OEM_HEAP      0xBAB00000ULL
+
+// State 0: no attempt, 1: commit in progress, 2: ready, 3: stopped/quarantined.
+// Failed or partial publication is never retried until a firmware reboot.
+STATIC unsigned mState;
+STATIC K70_RAM_RANGE mPublished;
+STATIC K70_FDT_RAM mSavedInfo;
+STATIC UINT64 mFdtPhysical, mFdtBytes, mInitrdPhysical, mInitrdBytes;
+STATIC EFI_STATUS mStoppedStatus;
+STATIC CONST CHAR16 *mStoppedReason;
+
+STATIC EFI_STATUS
+Stopped (EFI_STATUS Status, CONST CHAR16 *Text, CONST CHAR16 **Reason)
+{
+  mState = 3;
+  mStoppedStatus = Status;
+  mStoppedReason = Text;
+  *Reason = Text;
+  return Status;
+}
+
+EFI_STATUS
+K70PublishMeasuredRam (
+  CONST VOID *Fdt, UINTN FdtBytes, UINT64 FdtPhysical,
+  UINT64 InitrdPhysical, UINT64 InitrdBytes,
+  K70_RAM_RANGE *Published, CONST CHAR16 **Reason)
+{
+  K70_FDT_RAM Info;
+  K70_RAM_RANGE Gaps[256], Exclude[2], Plan[K70_RAM_PIECES], Best = {0, 0};
+  EFI_GCD_MEMORY_SPACE_DESCRIPTOR *Map = NULL, Current, Heap;
+  UINTN MapCount = 0, Index;
+  UINT64 Bytes, Capabilities;
+  unsigned GapCount = 0, Count = 0;
+  EFI_STATUS Status;
+  EFI_TPL PreviousTpl;
+  int Parsed;
+
+  if (Published == NULL || Reason == NULL) { return EFI_INVALID_PARAMETER; }
+  ZeroMem (Published, sizeof (*Published));
+  *Reason = L"M05 invalid input metadata";
+  if (FdtPhysical == 0 || (UINTN)Fdt != FdtPhysical || FdtBytes == 0 ||
+      FdtBytes > MAX_UINT64 - FdtPhysical || InitrdPhysical == 0 || InitrdBytes == 0 ||
+      InitrdBytes > MAX_UINT64 - InitrdPhysical) { return EFI_INVALID_PARAMETER; }
+  if (mState == 3) { *Reason = mStoppedReason; return mStoppedStatus; }
+  if (mState == 1) { *Reason = L"M05 publication already in progress"; return EFI_NOT_READY; }
+
+  Parsed = K70ReadFdtRam (Fdt, FdtBytes, &Info);
+  if (Parsed != K70_RAM_OK) {
+    *Reason = Parsed == K70_RAM_NO_BANK ? L"M05 runtime FDT has no nonzero RAM bank" :
+              Parsed == K70_RAM_DYNAMIC_UNKNOWN ? L"M05 FDT reservation address unknown" :
+              L"M05 runtime FDT RAM metadata rejected";
+    return EFI_COMPROMISED_DATA;
+  }
+  if (mState == 2) {
+    if (FdtPhysical != mFdtPhysical || FdtBytes != mFdtBytes || InitrdPhysical != mInitrdPhysical ||
+        InitrdBytes != mInitrdBytes || CompareMem (&Info, &mSavedInfo, sizeof (Info)) != 0) {
+      *Reason = L"M05 inputs changed after RAM publication";
+      return EFI_COMPROMISED_DATA;
+    }
+    *Published = mPublished;
+    *Reason = L"M05 existing measured RAM retained";
+    return EFI_SUCCESS;
+  }
+
+  Status = gDS->GetMemorySpaceMap (&MapCount, &Map);
+  if (EFI_ERROR (Status) || Map == NULL) {
+    *Reason = L"M05 current GCD map unavailable";
+    if (Map != NULL) { FreePool (Map); }
+    return EFI_ERROR (Status) ? Status : EFI_COMPROMISED_DATA;
+  }
+  for (Index = 0; Index < MapCount; ++Index) {
+    if (Map[Index].GcdMemoryType != EfiGcdMemoryTypeNonExistent) { continue; }
+    if (Map[Index].Length == 0 || Map[Index].Length > MAX_UINT64 - Map[Index].BaseAddress ||
+        GapCount == ARRAY_SIZE (Gaps) || Map[Index].ImageHandle != NULL || Map[Index].DeviceHandle != NULL) {
+      FreePool (Map); *Reason = L"M05 inconsistent nonexistent GCD range";
+      return EFI_COMPROMISED_DATA;
+    }
+    Gaps[GapCount++] = (K70_RAM_RANGE){Map[Index].BaseAddress, Map[Index].BaseAddress + Map[Index].Length};
+  }
+  FreePool (Map);
+  Exclude[0] = (K70_RAM_RANGE){FdtPhysical, FdtPhysical + FdtBytes};
+  Exclude[1] = (K70_RAM_RANGE){InitrdPhysical, InitrdPhysical + InitrdBytes};
+  Parsed = K70PlanNewRam (&Info, Gaps, GapCount, Exclude, ARRAY_SIZE (Exclude),
+                         ArmGetPhysicalAddressBits (), Plan, ARRAY_SIZE (Plan), &Count);
+  if (Parsed != K70_RAM_OK) {
+    *Reason = L"M05 FDT and current GCD plan rejected";
+    return EFI_COMPROMISED_DATA;
+  }
+  for (Index = 0; Index < Count; ++Index) {
+    Bytes = Plan[Index].End - Plan[Index].Base;
+    if (Bytes >= K70_WINDOW_BYTES + K70_PHASE_MARGIN && Bytes > Best.End - Best.Base) { Best = Plan[Index]; }
+  }
+  if (Best.Base == Best.End) {
+    *Reason = L"M05 no measured 514MiB contiguous GCD gap";
+    return EFI_OUT_OF_RESOURCES;
+  }
+  Bytes = MIN (Best.End - Best.Base, K70_MAX_PUBLISH);
+  Best.End = Best.Base + Bytes;
+  Status = gDS->GetMemorySpaceDescriptor (K70_OEM_HEAP, &Heap);
+  if (EFI_ERROR (Status) || Heap.GcdMemoryType != EfiGcdMemoryTypeSystemMemory ||
+      (Heap.Capabilities & EFI_MEMORY_WB) == 0) {
+    *Reason = L"M05 known heap memory capabilities unavailable";
+    return EFI_ERROR (Status) ? Status : EFI_COMPROMISED_DATA;
+  }
+  Capabilities = Heap.Capabilities & ~EFI_MEMORY_RUNTIME;
+
+  // All validation precedes commit. Prevent lower-TPL callbacks between final
+  // ownership check and publication. Synchronous allocations inside GCD remain
+  // possible, so the real WB CPU mapping is installed before AddMemorySpace.
+  PreviousTpl = gBS->RaiseTPL (TPL_NOTIFY);
+  Status = gDS->GetMemorySpaceDescriptor (Best.Base, &Current);
+  if (EFI_ERROR (Status) || Current.GcdMemoryType != EfiGcdMemoryTypeNonExistent ||
+      Current.BaseAddress > Best.Base || Current.Length == 0 ||
+      Current.Length > MAX_UINT64 - Current.BaseAddress ||
+      Current.BaseAddress + Current.Length < Best.End ||
+      Current.ImageHandle != NULL || Current.DeviceHandle != NULL) {
+    gBS->RestoreTPL (PreviousTpl);
+    *Reason = L"M05 GCD ownership changed before publication";
+    return EFI_ERROR (Status) ? Status : EFI_ACCESS_DENIED;
+  }
+  mState = 1;
+  mPublished = Best;
+  Status = ArmSetMemoryAttributes (Best.Base, Bytes, EFI_MEMORY_WB, 0);
+  if (EFI_ERROR (Status)) {
+    Status = Stopped (Status, L"M05 WB mapping failed; no retry this boot", Reason);
+    gBS->RestoreTPL (PreviousTpl);
+    return Status;
+  }
+  // Commit point: DXE can synchronously allocate from the new bank as part of
+  // adding its conventional-memory descriptors. Never blindly remove/unmap
+  // this bank after this call, including on partial failure.
+  Status = gDS->AddMemorySpace (EfiGcdMemoryTypeSystemMemory, Best.Base, Bytes, Capabilities);
+  if (EFI_ERROR (Status)) {
+    Status = Stopped (Status, L"M05 GCD add failed/partial; mapped RAM retained", Reason);
+    gBS->RestoreTPL (PreviousTpl);
+    return Status;
+  }
+  Status = gDS->SetMemorySpaceAttributes (Best.Base, Bytes, EFI_MEMORY_WB);
+  if (EFI_ERROR (Status)) {
+    Status = Stopped (Status, L"M05 GCD attribute update failed; RAM retained", Reason);
+    gBS->RestoreTPL (PreviousTpl);
+    return Status;
+  }
+  CopyMem (&mSavedInfo, &Info, sizeof (Info));
+  mFdtPhysical = FdtPhysical; mFdtBytes = FdtBytes;
+  mInitrdPhysical = InitrdPhysical; mInitrdBytes = InitrdBytes;
+  mState = 2;
+  *Published = Best;
+  *Reason = L"M05 measured FDT RAM published";
+  gBS->RestoreTPL (PreviousTpl);
+  return EFI_SUCCESS;
+}
+
+#ifdef K70_RAM_PUBLISH_TEST
+VOID K70ResetMeasuredRamForTest (VOID) {
+  mState = 0; ZeroMem (&mPublished, sizeof (mPublished));
+  ZeroMem (&mSavedInfo, sizeof (mSavedInfo));
+  mFdtPhysical = mFdtBytes = mInitrdPhysical = mInitrdBytes = 0;
+  mStoppedStatus = 0; mStoppedReason = NULL;
+}
+#endif
