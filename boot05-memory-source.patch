+import struct
+import uuid
+
+HERE = Path(__file__).resolve().parent
+BASE = HERE.parent
+UEFI = Path('/root/k70-clean-20261104/uefi')
+manifest = BASE/'firmware-inputs/oem-inf-manifest.json'
+raw = manifest.read_bytes()
+assert hashlib.sha256(raw).hexdigest() == '9cf1145b1cebd0822608b5df5d2c00d5ff60986e39e0536bf47644df298f582c'
+modules = json.loads(raw)['modules']
+needle = uuid.UUID('5172ffb5-4253-7d51-c641-a701f973103c').bytes_le
+references = []
+for module in modules:
+    data = Path(module['pe']['path']).read_bytes()
+    assert hashlib.sha256(data).hexdigest() == module['pe']['sha256']
+    offsets = []
+    at = 0
+    while True:
+        at = data.find(needle, at)
+        if at < 0:
+            break
+        offsets.append(hex(at)); at += 16
+    if offsets:
+        references.append({'ui':module['ui_name'], 'guid':module['ffs_guid'],
+                           'pe_sha256':module['pe']['sha256'], 'literal_file_offsets':offsets})
+env = next(module for module in modules if module['ui_name']=='EnvDxe')
+data = Path(env['pe']['path']).read_bytes()
+table = list(struct.unpack_from('<8Q', data, 0xe290))
+assert table == [0x10002,0x21e8,0x220c,0x2274,0x2228,0x2354,0x23a0,0x10004]
+assert struct.unpack_from('<QQ',data,0xc7a0) == (0x80000000,0x60000000)
