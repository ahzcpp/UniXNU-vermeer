+                require(actual == expected, 'Final SEC TE does not match own-build PE + explained transform')
+                check.update(equal=True, conversion=conversion, fd_te_sha256=sha(actual))
+                te_checks.append(check)
+                sec_pe, sec_te = p.read_bytes(), actual
+            else:
+                require(len(pes) == 1, 'Executable has no unique PE32 section')
+                check['pe'] = helper.compare_pe(p.read_bytes(), audit.memory[pes[0]['payload']['path']])
+                require(check['pe']['equal'], 'Own-build PE differs from final FFS: ' + str(f['ui']))
+                pe_checks.append(check)
+        require(len(te_checks) == 1 and sec_pe is not None, 'Exactly one SEC TE must be code-bound')
+        for guid, label in REQUIRED.items():
+            require(sum(c['guid'] == guid and c['pe']['equal'] for c in pe_checks) == 1,
+                    'Required module lacks exact own-build PE proof: ' + label)
+        darwin_check = next(c for c in pe_checks if c['guid'] == '1b64af87-8415-4b57-9b16-680d70913b9f')
+        darwin_output = Path(darwin_check['output_path'])
+        darwin_sources = [WORK / name for name in source_snapshot
+                          if name.startswith('darwinboot/DarwinBootPkg/Driver/')
+                          and Path(name).suffix.lower() in ('.c', '.h', '.s', '.inf')]
+        require(darwin_sources and all(p.stat().st_mtime <= darwin_output.stat().st_mtime for p in darwin_sources),
+                'DarwinBoot own-build OUTPUT predates current isolated loader source')
+        darwin_check['critical_source_snapshot'] = [
+            {'path': str(p), 'sha256': sha(p.read_bytes())} for p in darwin_sources]
