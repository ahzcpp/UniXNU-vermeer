+}
diff --git a/research/memory-next/stop-platform-build.py b/research/memory-next/stop-platform-build.py
new file mode 100644
index 0000000..611d904
--- /dev/null
+++ b/research/memory-next/stop-platform-build.py
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+"""Stop only the active boot05 all-target EDK process tree, preserving its failure status."""
+import datetime
+import json
+import os
+from pathlib import Path
+import signal
+
+profile = 'K70Boot05Pkg/Profiles/vermeer-boot05.dsc'
+processes = {}
+for p in Path('/proc').iterdir():
+    if not p.name.isdigit():
+        continue
+    try:
+        command = [x.decode() for x in (p/'cmdline').read_bytes().split(b'\0') if x]
+        stat = (p/'stat').read_text()
+        parent = int(stat[stat.rfind(')')+2:].split()[1])
+        processes[int(p.name)] = (parent, command)
+    except (OSError, ValueError, UnicodeError):
+        pass
+edk_script = Path('/root/k70-clean-20261104/out-firmware/feeds/mu_basecore-8f10084c/BaseTools/Source/Python/build/build.py').resolve()
+roots = [pid for pid,(parent,cmd) in processes.items()
+         if profile in cmd and any(x.endswith('/build.py') and Path(x).resolve() == edk_script for x in cmd)]
+if len(roots) != 1:
+    raise SystemExit('Expected exactly one matching boot05 EDK all-target process')
+selected = {roots[0]}
+while True:
+    more = {pid for pid,(parent,cmd) in processes.items() if parent in selected}
+    if more <= selected:
+        break
+    selected |= more
+sent = []
+for pid in sorted(selected, reverse=True):
+    try:
+        os.kill(pid, signal.SIGINT);sent.append(pid)
+    except ProcessLookupError:
+        pass
+record = {'schema':1, 'utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),
+          'reason':'All-target rebuild was unnecessarily recompiling unchanged OpenSSL; completed new DarwinBoot PE is retained for audited FDS-only packaging.',
+          'profile':profile, 'signal':'SIGINT', 'matched_processes':len(selected),
+          'signals_sent':len(sent), 'all_target_cancelled':True, 'reported_as_success':False,
+          'device_io':False}
+out=Path(__file__).resolve().parent.parent/'boot-chain-05/all-target-cancellation.json'
+out.write_text(json.dumps(record,indent=2)+'\n')
+print(json.dumps(record))
diff --git a/research/memory-next/test-fdt-ram.c b/research/memory-next/test-fdt-ram.c
new file mode 100644
index 0000000..6ac0af8
--- /dev/null
+++ b/research/memory-next/test-fdt-ram.c
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Host-only tests. Synthetic bank fixtures are not measurements of the K70.
+#include "FdtRamPlan.h"
+#include <assert.h>
+#include <libfdt.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static unsigned char Blob[16384] __attribute__((aligned(8)));
+static unsigned Seed = 0x7040506;
+static unsigned Next(void) { Seed ^= Seed << 13; Seed ^= Seed >> 17; Seed ^= Seed << 5; return Seed; }
+static void Fixture(void) {
+  int Node;
+  assert(fdt_create_empty_tree(Blob, sizeof Blob) == 0);
+  assert(fdt_setprop_u32(Blob, 0, "#address-cells", 2) == 0);
+  assert(fdt_setprop_u32(Blob, 0, "#size-cells", 2) == 0);
+  Node = fdt_add_subnode(Blob, 0, "reserved-memory"); assert(Node >= 0);
+  assert(fdt_setprop_u32(Blob, Node, "#address-cells", 2) == 0);
+  assert(fdt_setprop_u32(Blob, Node, "#size-cells", 2) == 0);
+  assert(fdt_setprop(Blob, Node, "ranges", 0, 0) == 0);
+  Node = fdt_add_subnode(Blob, 0, "memory@80000000"); assert(Node >= 0);
+  assert(fdt_setprop_string(Blob, Node, "device_type", "memory") == 0);
+}
+static void Reg(int Node, const char *Name, K70_U64 Base, K70_U64 Bytes) {
+  fdt64_t Data[2] = {cpu_to_fdt64(Base), cpu_to_fdt64(Bytes)};
+  assert(fdt_setprop(Blob, Node, Name, Data, sizeof Data) == 0);
+}
+static void CheckParse(void) {
+  K70_FDT_RAM Info;
+  int Node, Parent;
+  Fixture();
+  Node = fdt_path_offset(Blob, "/memory@80000000");
+  Reg(Node, "reg", 0, 0);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_NO_BANK);
+  Reg(Node, "reg", 0x80000000ULL, 0x100000000ULL);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_OK);
+  assert(Info.BankCount == 1 && Info.Banks[0].Base == 0x80000000ULL && Info.Banks[0].End == 0x180000000ULL);
+  Parent = fdt_path_offset(Blob, "/reserved-memory");
+  Node = fdt_add_subnode(Blob, Parent, "guard@90000000"); assert(Node >= 0);
+  Reg(Node, "reg", 0x90000000ULL, 0x1000000);
+  assert(fdt_add_mem_rsv(Blob, 0xa0000000ULL, 0x200000) == 0);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_OK && Info.ReservedCount == 2);
+  Parent = fdt_path_offset(Blob, "/reserved-memory");
+  Node = fdt_add_subnode(Blob, Parent, "unknown-dynamic"); assert(Node >= 0);
+  assert(fdt_setprop_u64(Blob, Node, "size", 0x800000) == 0);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_DYNAMIC_UNKNOWN);
+  assert(Info.DynamicReservationUnknown == 1);
+  Reg(Node, "alloc-ranges", 0xb0000000ULL, 0x10000000);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_OK && Info.ReservedCount == 3);
+  assert(K70ReadFdtRam(Blob, 39, &Info) == K70_RAM_BAD_FDT);
+  assert(K70ReadFdtRam(Blob, fdt_totalsize(Blob)-1, &Info) == K70_RAM_BAD_FDT);
+  Fixture(); Node = fdt_path_offset(Blob, "/memory@80000000");
+  Reg(Node, "reg", 0xfffffffffffff000ULL, 0x2000);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_BAD_RANGES);
+  Fixture(); Node = fdt_path_offset(Blob, "/memory@80000000");
+  Reg(Node, "reg", 0x80000000ULL, 0x8000000);
+  assert(fdt_setprop_string(Blob, Node, "status", "disabled") == 0);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_NO_BANK);
+}
+static int Contains(K70_RAM_RANGE R, K70_U64 P) { return R.Base <= P && P < R.End; }
+static void CheckPlanner(void) {
+  unsigned Round, P, I, Count;
+  const K70_U64 Base = 0x90000000ULL;
+  K70_FDT_RAM Info;
+  K70_RAM_RANGE Gaps[2], Exclude[4], Out[K70_RAM_PIECES];
+  for (Round = 0; Round < 1500; ++Round) {
+    memset(&Info, 0, sizeof Info);
+    Info.BankCount = 1; Info.Banks[0] = (K70_RAM_RANGE){Base, Base + 256*4096};
+    Gaps[0] = (K70_RAM_RANGE){Base + 4096*(Next()%32), Base + 128*4096};
+    Gaps[1] = (K70_RAM_RANGE){Base + 160*4096, Base + 256*4096};
+    Info.ReservedCount = 4;
+    for (I = 0; I < 4; ++I) {
+      K70_U64 R = Base + (Next()%256)*4096;
+      Info.Reserved[I] = (K70_RAM_RANGE){R, R + (1+Next()%24)*4096};
+      R = Base + (Next()%256)*4096;
+      Exclude[I] = (K70_RAM_RANGE){R, R + (1+Next()%16)*4096};
+    }
+    assert(K70PlanNewRam(&Info, Gaps, 2, Exclude, 4, 40, Out, K70_RAM_PIECES, &Count) == K70_RAM_OK);
+    for (P = 0; P < 256; ++P) {
+      K70_U64 Address = Base + P*4096;
+      int Expected = Contains(Gaps[0], Address) || Contains(Gaps[1], Address);
+      unsigned Seen = 0;
+      for (I = 0; I < 4; ++I) if (Contains(Info.Reserved[I], Address) || Contains(Exclude[I], Address)) Expected = 0;
+      for (I = 0; I < Count; ++I) {
+        assert(Out[I].Base < Out[I].End && !(Out[I].Base & 4095) && !(Out[I].End & 4095));
+        Seen += Contains(Out[I], Address);
+      }
+      assert(Seen == (unsigned)Expected);
+    }
+  }
+  Info.DynamicReservationUnknown = 1;
+  assert(K70PlanNewRam(&Info, Gaps, 2, Exclude, 4, 40, Out, K70_RAM_PIECES, &Count) == K70_RAM_BAD_RANGES && Count == 0);
+  Info.DynamicReservationUnknown = 0;
+  assert(K70PlanNewRam(&Info, Gaps, 2, Exclude, 4, 40, Out, 0, &Count) == K70_RAM_CAPACITY && Count == 0);
+  Gaps[1] = Gaps[0];
+  assert(K70PlanNewRam(&Info, Gaps, 2, Exclude, 4, 40, Out, K70_RAM_PIECES, &Count) == K70_RAM_BAD_RANGES && Count == 0);
+}
+static void Stock(const char *Name) {
+  FILE *F = fopen(Name, "rb"); long Length; void *Data; K70_FDT_RAM Info; int Result;
+  assert(F); assert(fseek(F, 0, SEEK_END) == 0); Length = ftell(F); assert(Length > 0 && Length <= 0x100000);
+  rewind(F); Data = malloc((size_t)Length); assert(Data); assert(fread(Data, 1, (size_t)Length, F) == (size_t)Length); fclose(F);
+  Result = K70ReadFdtRam(Data, (size_t)Length, &Info);
+  printf("stock_file=%s parse=%d nonzero_banks=%u reservations=%u dynamic_unknown=%u\n", Name, Result, Info.BankCount, Info.ReservedCount, Info.DynamicReservationUnknown);
+  assert(Result == K70_RAM_NO_BANK && Info.BankCount == 0);
+  free(Data);
+}
+int main(int Argc, char **Argv) {
+  int I;
+  CheckParse(); CheckPlanner();
+  for (I = 1; I < Argc; ++I) Stock(Argv[I]);
+  puts("PASS: bounded parsing, explicit refusals, 1500 randomized page-set comparisons; no device memory accessed");
+  return 0;
+}
diff --git a/research/memory-next/test-publish-ram.c b/research/memory-next/test-publish-ram.c
new file mode 100644
index 0000000..61717e1
--- /dev/null
+++ b/research/memory-next/test-publish-ram.c
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include "PublishTestShim.h"
+#include "MeasuredRam.h"
+#include <assert.h>
+#include <libfdt.h>
+#include <stdio.h>
+
+static unsigned char Blob[4096] __attribute__((aligned(8)));
+static unsigned Fail, Calls, Adds, Sets, CurrentTpl, Mapped, PublishedMock;
+static K70_RAM_RANGE NewRange;
+static EFI_STATUS Map(UINTN *Count, EFI_GCD_MEMORY_SPACE_DESCRIPTOR **Out) {
+  ++Calls; assert(CurrentTpl==4);
+  *Count=1; *Out=calloc(1,sizeof(**Out)); assert(*Out);
+  (*Out)[0].BaseAddress=0x900000000ULL; (*Out)[0].Length=0x80000000ULL;
+  (*Out)[0].GcdMemoryType=EfiGcdMemoryTypeNonExistent;
+  return EFI_SUCCESS;
+}
+static EFI_STATUS Desc(UINT64 Base,EFI_GCD_MEMORY_SPACE_DESCRIPTOR *Out) {
+  ++Calls; memset(Out,0,sizeof(*Out));
+  if (Base==0xBAB00000) {
+    assert(CurrentTpl==4);
+    Out->BaseAddress=0xBAB00000; Out->Length=0xD1C0000;
+    Out->GcdMemoryType=EfiGcdMemoryTypeSystemMemory;
+    Out->Capabilities=15|EFI_MEMORY_RUNTIME;
+  } else {
+    assert(CurrentTpl==TPL_NOTIFY && Base==0x900000000ULL);
+    Out->BaseAddress=Base; Out->Length=0x80000000ULL;
+    Out->GcdMemoryType=Fail==1?EfiGcdMemoryTypeSystemMemory:EfiGcdMemoryTypeNonExistent;
+  }
+  return EFI_SUCCESS;
+}
+unsigned ArmGetPhysicalAddressBits(void) { return 40; }
+EFI_STATUS ArmSetMemoryAttributes(UINT64 Base,UINT64 Bytes,UINT64 Attr,UINT64 Mask) {
+  assert(CurrentTpl==TPL_NOTIFY && !Adds && !Sets);
+  assert(Base==0x900000000ULL && Bytes==0x40000000 && Attr==EFI_MEMORY_WB && Mask==0);
+  ++Calls; Mapped=1; NewRange=(K70_RAM_RANGE){Base,Base+Bytes};
+  return Fail==2?EFI_DEVICE_ERROR:EFI_SUCCESS;
+}
+static EFI_STATUS Add(unsigned Type,UINT64 Base,UINT64 Bytes,UINT64 Caps) {
+  assert(CurrentTpl==TPL_NOTIFY && Mapped && !Sets);
+  assert(Type==EfiGcdMemoryTypeSystemMemory && Base==NewRange.Base && Base+Bytes==NewRange.End && Caps==15);
+  ++Calls; ++Adds; PublishedMock=1;
+  return Fail==3?EFI_DEVICE_ERROR:EFI_SUCCESS;
+}
+static EFI_STATUS Set(UINT64 Base,UINT64 Bytes,UINT64 Attr) {
+  assert(CurrentTpl==TPL_NOTIFY && Mapped && Adds==1 && PublishedMock);
+  assert(Base==NewRange.Base && Base+Bytes==NewRange.End && Attr==EFI_MEMORY_WB);
+  ++Calls; ++Sets;
+  return Fail==4?EFI_DEVICE_ERROR:EFI_SUCCESS;
+}
+static EFI_TPL Raise(EFI_TPL Tpl) { assert(CurrentTpl==4&&Tpl==TPL_NOTIFY);CurrentTpl=Tpl;return 4; }
+static void Restore(EFI_TPL Tpl) { assert(CurrentTpl==TPL_NOTIFY&&Tpl==4);CurrentTpl=Tpl; }
+static MOCK_DS Ds={Map,Desc,Add,Set}; MOCK_DS *gDS=&Ds;
+static MOCK_BS Bs={Raise,Restore}; MOCK_BS *gBS=&Bs;
+static void Fixture(void) {
+  int N; fdt64_t Reg[2]={cpu_to_fdt64(0x880000000ULL),cpu_to_fdt64(0x180000000ULL)};
+  assert(fdt_create_empty_tree(Blob,sizeof Blob)==0);
+  assert(fdt_setprop_u32(Blob,0,"#address-cells",2)==0);
+  assert(fdt_setprop_u32(Blob,0,"#size-cells",2)==0);
+  N=fdt_add_subnode(Blob,0,"memory@880000000");assert(N>=0);
+  assert(fdt_setprop_string(Blob,N,"device_type","memory")==0);
+  assert(fdt_setprop(Blob,N,"reg",Reg,sizeof Reg)==0);
+}
+static EFI_STATUS Run(K70_RAM_RANGE *Out,const CHAR16 **Reason) {
+  return K70PublishMeasuredRam(Blob,sizeof Blob,(UINT64)(uintptr_t)Blob,0xa9000000,0x4000000,Out,Reason);
+}
+int main(void) {
+  unsigned F, Prior; EFI_STATUS Status; K70_RAM_RANGE Out; const CHAR16 *Reason;
+  Fixture();
+  for(F=0;F<=4;++F) {
+    K70ResetMeasuredRamForTest(); Fail=F; Calls=Adds=Sets=Mapped=PublishedMock=0;CurrentTpl=4;
+    Status=Run(&Out,&Reason);assert(Reason&&CurrentTpl==4);
+    if(F==0) {
+      assert(Status==EFI_SUCCESS && Out.Base==0x900000000ULL && Out.End==0x940000000ULL);
+      Prior=Calls;assert(Run(&Out,&Reason)==EFI_SUCCESS && Calls==Prior && Adds==1);
+    } else {
+      assert(EFI_ERROR(Status)&&Out.Base==0&&Out.End==0);
+      if(F==1) assert(!Mapped&&!Adds&&!Sets);
+      if(F==2) assert(Mapped&&!Adds&&!Sets);
+      if(F==3) assert(Mapped&&Adds==1&&PublishedMock&&!Sets);
+      if(F==4) assert(Mapped&&Adds==1&&PublishedMock&&Sets==1);
+      if(F>=2) { Prior=Calls;assert(EFI_ERROR(Run(&Out,&Reason))&&Calls==Prior); }
+    }
+  }
+  // Missing bank is rejected before any service or physical bank access.
+  K70ResetMeasuredRamForTest();Calls=0;Fail=0;CurrentTpl=4;
+  assert(fdt_del_node(Blob,fdt_path_offset(Blob,"/memory@880000000"))==0);
+  assert(EFI_ERROR(Run(&Out,&Reason)) && Calls==0);
+  puts("PASS: metadata-only publication model; premap before commit; no retry/unmap after partial failure");
+  return 0;
+}
