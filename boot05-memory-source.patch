+    'new_hob_list': UEFI/'Silicon/Silicium/SiliciumPkg/Sec/Sec.c',
+    'shim': UEFI/'BootShim/BootShim.S',
+    'xbl_hob_builder': UEFI/'Silicon/Qualcomm/QcomPkg/Library/PlatformPeiLib/PlatformPei.c',
+    'ram_partition_consumer': UEFI/'Silicon/Qualcomm/QcomPkg/Library/RamManagerLib/RamManager.c',
