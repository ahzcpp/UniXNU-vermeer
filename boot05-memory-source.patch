diff --git a/research/boot-chain-05/verify-pe-recovery.py b/research/boot-chain-05/verify-pe-recovery.py
new file mode 100644
index 0000000..4e933b9
--- /dev/null
+++ b/research/boot-chain-05/verify-pe-recovery.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Read-only reconstruction of the PcdDxe recovery performed before final FDS.
+
+No compiled output is modified. The relinked PE is retained locally, never in
+the public patch; the receipt identifies its bounded CodeView-only difference.
+"""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+
+W=Path(__file__).resolve().parent
+S=W/'source-snapshots/initial-verified-2d207ced'
+initial=json.loads((S/'fd-audit.json').read_text())
+record=next(r for r in initial['source_pe_checks'] if r['guid']=='80cf7257-87ab-47f9-a3fe-d50b76d89541')
+def sha(data):return hashlib.sha256(data).hexdigest()
+spec=importlib.util.spec_from_file_location('boot05_audit',W/'audit-fd.py')
+m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
+h=m.load_helper();A=h.load_parser(m.PARSER);a=A()
+fd=(W.parent/'artifacts/boot-chain-05/SILICIUM_UEFI.fd').read_bytes()
+assert sha(fd)==initial['fd_sha256']
+a.scan(fd,'FD',[]);assert not a.errors and not a.warnings
+files=[f for f in a.files if f['guid']==record['guid']];assert len(files)==1
+pe_sections=[s for s in files[0]['sections'] if s['type']==16];assert len(pe_sections)==1
+raw_sections=[s for s in files[0]['sections'] if s['type']==25];assert len(raw_sections)==1
+original=a.memory[pe_sections[0]['payload']['path']]
+relinked=(W/'local-relinked-pe/PcdDxe.efi').read_bytes()
+assert sha(original)==record['pe']['original_sha256']
+assert len(original)==len(relinked)
+def codeview(image):
+    pe=struct.unpack_from('<I',image,0x3c)[0];opt=pe+24
+    nsec=struct.unpack_from('<H',image,pe+6)[0]
+    optsize=struct.unpack_from('<H',image,pe+20)[0]
+    rva,size=struct.unpack_from('<II',image,opt+112+6*8);assert size==28
+    raw=None
+    for i in range(nsec):
+        s=opt+optsize+i*40;_,va,rs,rp=struct.unpack_from('<IIII',image,s+8)
+        if va<=rva and rva+size<=va+rs:raw=rp+rva-va
+    assert raw is not None and raw+28<=len(image)
+    _,_,_,_,kind,length,_,pointer=struct.unpack_from('<IIHHIIII',image,raw)
+    assert kind==2 and length>=24 and pointer+length<=len(image)
+    assert image[pointer:pointer+4]==b'RSDS'
+    return pointer+4,pointer+20
+span=codeview(original);assert codeview(relinked)==span
+diff=[i for i,(x,y) in enumerate(zip(original,relinked)) if x!=y]
+assert len(diff)==8 and all(span[0]<=i<span[1] for i in diff)
+output=Path(record['output_path']);debug=output.parent.parent/'DEBUG'/output.name
+assert output.read_bytes()==debug.read_bytes()==original
+pcd=a.memory[raw_sections[0]['payload']['path']]
+assert (output.parent/'DXEPcdDataBase.raw').read_bytes()==pcd
+report={
+    'schema':1,'success':True,'device_io':False,'build_outputs_modified_by_this_check':False,
+    'method':'Read-only reconstruction of the explicit original-PE restoration before the final successful serial GenFds invocation.',
+    'guid':record['guid'],'original_successful_fd_sha256':sha(fd),
+    'recovered_pe_sha256':sha(original),'preserved_relinked_pe_sha256':sha(relinked),
+    'only_different_region':'PE debug directory -> CodeView RSDS PDB GUID',
+    'pdb_guid_file_range_inclusive_exclusive':list(span),'changed_byte_offsets':diff,
+    'all_other_pe_bytes_exact':True,'pcd_raw_bytes':len(pcd),'pcd_raw_sha256':sha(pcd),
+    'output_pe_matches_original':True,'debug_pe_matches_original':True,
+    'raw_pcd_database_matches_original':True,
+}
+(W/'pe-output-recovery.json').write_text(json.dumps(report,indent=2)+'\n')
+print(json.dumps(report,indent=2))
