diff --git a/research/boot-chain-05/export-source.py b/research/boot-chain-05/export-source.py
new file mode 100644
index 0000000..885934e
--- /dev/null
+++ b/research/boot-chain-05/export-source.py
@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+"""Export owned UTF-8 source/reports, preserving exact bytes and helper hashes.
+
+This fixed-workspace exporter never reads phone identifiers, keys, root images,
+or OEM/Apple binary payloads. It does not publish or operate a device.
+"""
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+HERE=Path(__file__).resolve().parent
+DELIVERY=HERE.parent
+OUT=DELIVERY/'device-source'
+ARTIFACT=DELIVERY/'artifacts/boot-chain-05r1'
+INITIAL=HERE/'source-snapshots/initial-verified-2d207ced'
+FINAL=HERE/'source-snapshots/r1-verified-3947586d'
+
+def sha(data):return hashlib.sha256(data).hexdigest()
+
+audit=json.loads((HERE/'fd-audit.json').read_text())
+build=json.loads((HERE/'build-result.json').read_text())
+verification=json.loads((ARTIFACT/'verification.json').read_text())
+assert audit['success'] and build['exit_code']==0 and not build['source_changed_during_build']
+assert audit['fd_sha256']==verification['firmware_sha256']=='3947586d054aaecea3f622d5e2c6f04fa71f8532cbc157b8f4aaf82c5daed1f2'
+assert verification['boot_image_sha256']=='d516e32db5d0c27cbc5397cef1902f763e4e0629b98d7cb5162c1e5a93ccd773'
+for relative,digest in build['source_sha256'].items():
+    assert sha((HERE/relative).read_bytes())==digest,'Runtime source changed: '+relative
+
+# Keep the exact final owned runtime and reports locally, without copying any
+# binary artifact into the source snapshot or the public patch.
+preserve={p:HERE/p for p in build['source_sha256']}
+for name in ('build-result.json','fd-audit.json','durable-stop-change.json',
+             'coff-check.json','window-check.json','all-target-cancellation.json',
+             'cancelled-all-build-result.json','pe-output-recovery.json','incremental-ui.py','build.py',
+             'package.py','audit-fd.py','README.md','test-result-guide.json'):
+    preserve[name]=HERE/name
+preserve['verification.json']=ARTIFACT/'verification.json'
+for relative,source in preserve.items():
+    dest=FINAL/relative;data=source.read_bytes()
+    if dest.exists():assert dest.read_bytes()==data,'Frozen r1 snapshot differs: '+relative
+    else:dest.parent.mkdir(parents=True,exist_ok=True);dest.write_bytes(data)
+
+extensions={'.py','.c','.h','.S','.inf','.dsc','.fdf','.inc','.md'}
+json_names={
+    'build-result.json','fd-audit.json','durable-stop-change.json',
+    'coff-check.json','window-check.json','preparation-audit.json',
+    'all-target-cancellation.json','cancelled-all-build-result.json',
+    'test-result-guide.json','host-test-results.json','source-audit.json','pe-output-recovery.json',
+}
+text_names={'LICENSE','SOURCE-REVIEW.txt','test-result-guide.txt'}
+skip={'__pycache__','Build','.git','source-snapshots','local-relinked-pe'}
+mapping={}
+
+def add(target,source):
+    data=source.read_bytes()
+    text=data.decode('utf-8-sig')
+    assert '\0' not in text,'Binary input rejected: '+str(source)
+    assert not re.search(r'-----BEGIN [^-]*PRIVATE KEY-----',text),'Key input rejected'
+    assert target.startswith(('research/boot-chain-05/','research/memory-next/'))
+    assert target not in mapping
+    mapping[target]=data
+
+for base,prefix in ((HERE,'research/boot-chain-05'),(DELIVERY/'memory-next','research/memory-next')):
+    for source in sorted(base.rglob('*')):
+        if not source.is_file() or any(p in skip for p in source.relative_to(base).parts):continue
+        if source.suffix not in extensions and source.name not in json_names|text_names:continue
+        add(prefix+'/'+source.relative_to(base).as_posix(),source)
+add('research/boot-chain-05/verification.json',ARTIFACT/'verification.json')
+
+# Current unchanged runtime files plus the original DarwinBoot C are enough
+# to review the display-only delta. Keep successful historical proof separate
+# from the cancelled broad rebuild and the final serial-FDS proof.
+for name in ('build-result.json','fd-audit.json','verification.json','build.py','package.py'):
+    add('research/boot-chain-05/original-verified/'+name,INITIAL/name)
+add('research/boot-chain-05/original-verified/DarwinBoot.c',INITIAL/'darwinboot/DarwinBootPkg/Driver/DarwinBoot.c')
+
+manifest={}
+with tempfile.TemporaryDirectory(prefix='k70-boot05-source-') as name:
+    repo=Path(name)
+    subprocess.run(['git','init','-q',str(repo)],check=True)
+    subprocess.run(['git','-C',str(repo),'config','core.autocrlf','false'],check=True)
+    for target,data in mapping.items():
+        path=repo/target;path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(data)
+        manifest[target]={'bytes':len(data),'sha256':sha(data)}
+    subprocess.run(['git','-C',str(repo),'add','--all'],check=True)
+    patch=subprocess.check_output(['git','-C',str(repo),'diff','--cached','--binary','--no-ext-diff'])
+with tempfile.TemporaryDirectory(prefix='k70-boot05-apply-') as name:
+    repo=Path(name);subprocess.run(['git','init','-q',str(repo)],check=True)
+    subprocess.run(['git','-C',str(repo),'config','core.autocrlf','false'],check=True)
+    candidate=repo/'source.patch';candidate.write_bytes(patch)
+    subprocess.run(['git','-C',str(repo),'apply','--check',str(candidate)],check=True)
+    subprocess.run(['git','-C',str(repo),'apply',str(candidate)],check=True)
+    for target,data in mapping.items():assert (repo/target).read_bytes()==data,'Patch roundtrip mismatch: '+target
+
+patch_path=OUT/'boot05-memory-source.patch'
+patch_path.write_bytes(patch)
+result={
+    'format':'new-source-files-git-patch','files':manifest,'file_count':len(mapping),
+    'patch_bytes':len(patch),'patch_sha256':sha(patch),
+    'clean_repository_apply_and_exact_readback':True,
+    'contains_apple_or_oem_binaries':False,'contains_private_phone_identifiers':False,
+    'fixed_local_workspace_dependency':True,
+    'runtime_status':'Original boot05 returned generic Compromised Data; precise reason hidden by menu. r1 durable-stop awaits hardware result.',
+    'r1_firmware_sha256':verification['firmware_sha256'],
+    'r1_boot_image_sha256':verification['boot_image_sha256'],
+    'build_method':'Initial full boot05 succeeded; new r1 DarwinBoot compile/link completed; broad rebuild cancelled; verified unchanged/recovered PEs plus serial GenFds succeeded.',
+    'frozen_r1_source_files':len(preserve),
+}
+(OUT/'boot05-memory-source.manifest.json').write_text(json.dumps(result,indent=2)+'\n')
+print(json.dumps({k:v for k,v in result.items() if k!='files'},indent=2))
