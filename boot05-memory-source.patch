+                err('executable FFS contains neither auditable PE32 nor source SEC TE',guid=f['guid'],ui=f['ui']); continue
+            if f['guid'] in all_oem and len(sections)==1:
+                om=all_oem[f['guid']]; original=Path(om['pe']['path']).read_bytes()
+                same=compare_pe(original,audit.memory[sections[0]['payload']['path']])
+                if same['equal']:
