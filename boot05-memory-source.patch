+    '37cf646d-1729-4afd-998f-285df8864211': 'VermeerBootMemoryDxe',
+    '6c561b72-e945-4fcf-8cd9-ab763ceb493c': 'K70UsbDiagDxe',
+    '0a43774a-8887-4b61-8aa1-9cdaef4a3c69': 'K70LogRingDxe',
+}
+# The unchanged baseline Extra.fdf.inc includes this binary-only application.
+# It has no compiler OUTPUT or AutoGen.c. Accept only this exact reviewed INF
+# and PE original, with its original FFS identity/type and fully checked bytes.
+PREBUILT = {
+    '643d4788-63c8-40d2-bd7a-6842e66850d1': {
+        'ui': 'ufpdevicefw', 'type': 9,
+        'inf': 'Silicon/Silicium/SiliciumPkg/Applications/UFP/ufpdevicefw.inf',
+        'inf_sha256': '24e8a29179fd40f48dbf0c02b28dede757cd2c2fe1fd25bc8411dc0010bb337c',
