diff --git a/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/Entry.S b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/Entry.S
new file mode 100644
index 0000000..8c6c0a4
--- /dev/null
+++ b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/Entry.S
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include <AsmMacroLib.h>
+
+ASM_FUNC(DarwinCurrentEl)
+  mrs x0, CurrentEL
+  ret
+
+// x0=boot_args PA, x1=entry PA, x2=owned PA, x3=owned size, x4=frame buffer
+// PA (0 for none), x5=its size in bytes. EL1 only.
+// Diagnostic-only bands at the bottom; x0 (boot_args) and x1 (entry)
+// remain untouched. The normal XNU entry probes use the top bands.
+.macro HANDOFF_BAND band, lo, hi
+  cbz x14, 9f
+  lsr x13, x15, #4
+  bic x13, x13, #7
+  cbz x13, 9f
+  mov x17, #\band
+  mul x12, x13, x17
+  add x12, x14, x12
+  movz w16, #\lo
+  movk w16, #\hi, lsl #16
+8:
+  stp w16, w16, [x12], #8
+  subs x13, x13, #8
+  b.hi 8b
+  dsb sy
+9:
+.endm
+
+ASM_FUNC(DarwinEnter)
+  mov x14, x4
+  mov x15, x5
+  msr daifset, #15
+  // Paint the top 1/16 of the framebuffer green (BGRA 0xFF00FF00)
+  // before cache maintenance, MMU shutdown and the branch to the kernel.
+  cbz x4, 2f
+  lsr x9, x5, #4
+  bic x9, x9, #7
+  mov w10, #0xFF00
+  movk w10, #0xFF00, lsl #16
+  mov x11, x4
+3:
+  stp w10, w10, [x11], #8
+  subs x9, x9, #8
+  b.hi 3b
+  dsb sy
+2:
+  add x5, x2, x3
+  mrs x6, ctr_el0
+  ubfx x6, x6, #16, #4
+  mov x7, #4
+  lsl x6, x7, x6
+  sub x7, x6, #1
+  bic x4, x2, x7
+  dsb sy
+1:
+  dc civac, x4
+  add x4, x4, x6
+  cmp x4, x5
+  b.lo 1b
+  dsb sy
+  ic iallu
+  dsb sy
+  isb
+  // Yellow: owned-window cache maintenance completed.
+  HANDOFF_BAND 13, 0xFF00, 0xFFFF
+  mrs x4, sctlr_el1
+  bic x4, x4, #1
+  bic x4, x4, #4
+  bic x4, x4, #0x1000
+  msr sctlr_el1, x4
+  isb
+  tlbi vmalle1
+  dsb sy
+  isb
+  // Cyan: MMU disabled and TLB invalidation completed.
+  HANDOFF_BAND 14, 0xFFFF, 0xFF00
+  br x1
diff --git a/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/FdtRamPlan.c b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/FdtRamPlan.c
new file mode 100644
index 0000000..889fda2
--- /dev/null
+++ b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/FdtRamPlan.c
@@ -0,0 +1,216 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include "FdtRamPlan.h"
+
+#ifdef K70_RAM_HOST
+#include <string.h>
+#include <libfdt.h>
+#define FdtCheckHeader fdt_check_header
+#define FdtTotalSize fdt_totalsize
+#define FdtPathOffset fdt_path_offset
+#define FdtGetProp fdt_getprop
+#define FdtFirstSubnode fdt_first_subnode
+#define FdtNextSubnode fdt_next_subnode
+#define FdtGetNumberOfReserveMapEntries fdt_num_mem_rsv
+#define FdtGetReserveMapEntry fdt_get_mem_rsv
+#define Clear(B,N) memset((B),0,(N))
+#else
+#include <Library/BaseMemoryLib.h>
+#include <Library/FdtLib.h>
+#define Clear(B,N) ZeroMem((B),(N))
+// The pinned BaseFdtLib.inf compiles libfdt/fdt_check.c. Unlike a header-only
+// FdtCheckHeader, this performs a bounded full structure/reservation check.
+extern int fdt_check_full (const void *Fdt, K70_SIZE Size);
+#endif
+
+static unsigned Be32 (const unsigned char *P) {
+  return ((unsigned)P[0] << 24) | ((unsigned)P[1] << 16) |
+         ((unsigned)P[2] << 8) | P[3];
+}
+static K70_U64 Cells (const unsigned char *P, unsigned Count) {
+  K70_U64 V = Be32(P);
+  return Count == 2 ? (V << 32) | Be32(P + 4) : V;
+}
+static int Exact (const void *Data, int Length, const char *Text) {
+  const unsigned char *P = Data;
+  int I = 0;
+  if (Data == 0) return 0;
+  do {
+    if (I >= Length || P[I] != (unsigned char)Text[I]) return 0;
+  } while (Text[I++] != 0);
+  return I == Length;
+}
+static int CellCount (const void *Fdt, int Node, const char *Name) {
+  int Length;
+  const unsigned char *P = FdtGetProp(Fdt, Node, Name, &Length);
+  if (P == 0 || Length != 4) return -1;
+  return Be32(P) == 1 ? 1 : Be32(P) == 2 ? 2 : -1;
+}
+static int Append (K70_RAM_RANGE *Ranges, unsigned *Count, unsigned Max,
+                   K70_U64 Base, K70_U64 Bytes) {
+  if (Bytes == 0) return K70_RAM_OK;
+  if (Bytes > ~(K70_U64)0 - Base) return K70_RAM_BAD_RANGES;
+  if (*Count == Max) return K70_RAM_CAPACITY;
+  Ranges[*Count].Base = Base;
+  Ranges[*Count].End = Base + Bytes;
+  ++*Count;
+  return K70_RAM_OK;
+}
+static int Reg (const unsigned char *P, int Length, int Ac, int Sc,
+                K70_RAM_RANGE *Out, unsigned *Count, unsigned Max) {
+  unsigned Step;
+  int Offset, Error;
+  if (P == 0 || Ac < 1 || Ac > 2 || Sc < 1 || Sc > 2 || Length <= 0)
+    return K70_RAM_BAD_FDT;
+  Step = 4U * (unsigned)(Ac + Sc);
+  if ((unsigned)Length % Step != 0) return K70_RAM_BAD_FDT;
+  for (Offset = 0; Offset < Length; Offset += (int)Step) {
+    Error = Append(Out, Count, Max, Cells(P + Offset, (unsigned)Ac),
+                   Cells(P + Offset + 4 * Ac, (unsigned)Sc));
+    if (Error) return Error;
+  }
+  return K70_RAM_OK;
+}
+
+int K70ReadFdtRam (const void *Fdt, K70_SIZE ReadableBytes, K70_FDT_RAM *Out) {
+  int Root, Reserved, Node, Ac, Sc, Rac, Rsc, Length, Error, Count, Index;
+  const unsigned char *P;
+  unsigned Visited = 0;
+  K70_U64 Base, Bytes;
+  if (Out == 0) return K70_RAM_BAD_FDT;
+  Clear(Out, sizeof(*Out));
+  if (Fdt == 0 || ReadableBytes < 40 || ReadableBytes > 0x100000 ||
+      FdtCheckHeader(Fdt) != 0 || FdtTotalSize(Fdt) > ReadableBytes ||
+      fdt_check_full(Fdt, ReadableBytes) != 0) return K70_RAM_BAD_FDT;
+  Root = FdtPathOffset(Fdt, "/");
+  Ac = CellCount(Fdt, Root, "#address-cells");
+  Sc = CellCount(Fdt, Root, "#size-cells");
+  if (Root < 0 || Ac < 0 || Sc < 0) return K70_RAM_BAD_FDT;
+  Node = FdtFirstSubnode(Fdt, Root);
+  for (; Node >= 0; Node = FdtNextSubnode(Fdt, Node)) {
+    if (++Visited > 4096) return K70_RAM_CAPACITY;
+    P = FdtGetProp(Fdt, Node, "device_type", &Length);
+    if (!Exact(P, Length, "memory")) continue;
+    P = FdtGetProp(Fdt, Node, "status", &Length);
+    if (P != 0 && !Exact(P, Length, "ok") && !Exact(P, Length, "okay")) continue;
+    // Do not silently broaden a restricted or hot-pluggable memory node.
+    P = FdtGetProp(Fdt, Node, "linux,usable-memory", &Length);
+    if (P != 0) return K70_RAM_BAD_FDT;
+    if (Length != -FDT_ERR_NOTFOUND) return K70_RAM_BAD_FDT;
+    P = FdtGetProp(Fdt, Node, "hotpluggable", &Length);
+    if (P != 0) continue;
+    P = FdtGetProp(Fdt, Node, "reg", &Length);
+    Error = Reg(P, Length, Ac, Sc, Out->Banks, &Out->BankCount, K70_RAM_BANKS);
+    if (Error) return Error;
+  }
+  if (Node != -FDT_ERR_NOTFOUND) return K70_RAM_BAD_FDT;
+  P = FdtGetProp(Fdt, FdtPathOffset(Fdt, "/chosen"), "linux,usable-memory-range", &Length);
+  if (P != 0) return K70_RAM_BAD_FDT; // Restrictive kdump ABI needs its own explicit integration.
+  Count = (int)FdtGetNumberOfReserveMapEntries(Fdt);
+  if (Count < 0 || Count > K70_RAM_RESERVATIONS) return K70_RAM_BAD_FDT;
+  for (Index = 0; Index < Count; ++Index) {
+    if (FdtGetReserveMapEntry(Fdt, Index, &Base, &Bytes) != 0) return K70_RAM_BAD_FDT;
+    Error = Append(Out->Reserved, &Out->ReservedCount, K70_RAM_RESERVATIONS, Base, Bytes);
+    if (Error) return Error;
+  }
+  Reserved = FdtPathOffset(Fdt, "/reserved-memory");
+  if (Reserved >= 0) {
+    Rac = CellCount(Fdt, Reserved, "#address-cells");
+    Rsc = CellCount(Fdt, Reserved, "#size-cells");
+    P = FdtGetProp(Fdt, Reserved, "ranges", &Length);
+    if (Rac < 0 || Rsc < 0 || P == 0 || Length != 0) return K70_RAM_BAD_FDT;
+    Node = FdtFirstSubnode(Fdt, Reserved);
+    for (; Node >= 0; Node = FdtNextSubnode(Fdt, Node)) {
+      if (++Visited > 4096) return K70_RAM_CAPACITY;
+      // Even disabled/reusable reservations remain excluded conservatively.
+      P = FdtGetProp(Fdt, Node, "reg", &Length);
+      if (P != 0) {
+        Error = Reg(P, Length, Rac, Rsc, Out->Reserved, &Out->ReservedCount, K70_RAM_RESERVATIONS);
+        if (Error) return Error;
+      } else {
+        if (Length != -FDT_ERR_NOTFOUND) return K70_RAM_BAD_FDT;
+        P = FdtGetProp(Fdt, Node, "size", &Length);
+        if (P != 0) {
+          P = FdtGetProp(Fdt, Node, "alloc-ranges", &Length);
+          if (P == 0) Out->DynamicReservationUnknown = 1;
+          else {
+            Error = Reg(P, Length, Rac, Rsc, Out->Reserved, &Out->ReservedCount, K70_RAM_RESERVATIONS);
+            if (Error) return Error;
+          }
+        }
+      }
+    }
+    if (Node != -FDT_ERR_NOTFOUND) return K70_RAM_BAD_FDT;
+  } else if (Reserved != -FDT_ERR_NOTFOUND) return K70_RAM_BAD_FDT;
+  if (Out->BankCount == 0) return K70_RAM_NO_BANK;
+  return Out->DynamicReservationUnknown ? K70_RAM_DYNAMIC_UNKNOWN : K70_RAM_OK;
+}
+
+static int Subtract (K70_RAM_RANGE *Pieces, unsigned *Count, K70_RAM_RANGE Cut) {
+  unsigned I, Original = *Count;
+  if (Cut.Base >= Cut.End) return K70_RAM_BAD_RANGES;
+  for (I = 0; I < Original; ++I) {
+    K70_RAM_RANGE R = Pieces[I];
+    if (R.Base >= R.End || Cut.End <= R.Base || Cut.Base >= R.End) continue;
+    if (Cut.Base > R.Base && Cut.End < R.End) {
+      if (*Count == K70_RAM_PIECES) return K70_RAM_CAPACITY;
+      Pieces[(*Count)++] = (K70_RAM_RANGE){Cut.End, R.End};
+      Pieces[I].End = Cut.Base;
+    } else if (Cut.Base > R.Base) Pieces[I].End = Cut.Base;
+    else if (Cut.End < R.End) Pieces[I].Base = Cut.End;
+    else Pieces[I].End = Pieces[I].Base;
+  }
+  return K70_RAM_OK;
+}
+
+int K70PlanNewRam (const K70_FDT_RAM *Info, const K70_RAM_RANGE *Gaps, unsigned GapCount,
+                  const K70_RAM_RANGE *Exclude, unsigned ExcludeCount, unsigned Bits,
+                  K70_RAM_RANGE *Out, unsigned Capacity, unsigned *OutCount) {
+  K70_RAM_RANGE Pieces[K70_RAM_PIECES];
+  K70_U64 Limit, Start, End;
+  unsigned B, G, I, J, Count, Result = 0;
+  int Error;
+  if (OutCount == 0) return K70_RAM_BAD_RANGES;
+  *OutCount = 0;
+  if (Info == 0 || Out == 0 || Gaps == 0 || (ExcludeCount && Exclude == 0) ||
+      Info->BankCount > K70_RAM_BANKS || Info->ReservedCount > K70_RAM_RESERVATIONS ||
+      Info->DynamicReservationUnknown || Bits < 32 || Bits > 52 || GapCount > 256 || ExcludeCount > 256)
+    return K70_RAM_BAD_RANGES;
+  if (Info->BankCount == 0) return K70_RAM_NO_BANK;
+  Limit = (K70_U64)1 << Bits;
+  for (I = 0; I < GapCount; ++I) {
+    if (Gaps[I].Base >= Gaps[I].End) return K70_RAM_BAD_RANGES;
+    for (J = 0; J < I; ++J) if (Gaps[I].Base < Gaps[J].End && Gaps[J].Base < Gaps[I].End)
+      return K70_RAM_BAD_RANGES;
+  }
+  for (B = 0; B < Info->BankCount; ++B) {
+    K70_RAM_RANGE Bank = Info->Banks[B];
+    if (Bank.Base >= Bank.End || Bank.Base < 0x80000000ULL || Bank.End > Limit) return K70_RAM_BAD_RANGES;
+    for (J = 0; J < B; ++J) if (Bank.Base < Info->Banks[J].End && Info->Banks[J].Base < Bank.End)
+      return K70_RAM_BAD_RANGES;
+    for (G = 0; G < GapCount; ++G) {
+      Start = Bank.Base > Gaps[G].Base ? Bank.Base : Gaps[G].Base;
+      End = Bank.End < Gaps[G].End ? Bank.End : Gaps[G].End;
+      if (Start >= End) continue;
+      Pieces[0] = (K70_RAM_RANGE){Start, End};
+      Count = 1;
+      for (I = 0; I < Info->ReservedCount; ++I) {
+        Error = Subtract(Pieces, &Count, Info->Reserved[I]);
+        if (Error) return Error;
+      }
+      for (I = 0; I < ExcludeCount; ++I) {
+        Error = Subtract(Pieces, &Count, Exclude[I]);
+        if (Error) return Error;
+      }
+      for (I = 0; I < Count; ++I) {
+        if (Pieces[I].Base >= Pieces[I].End || Pieces[I].Base > ~(K70_U64)0 - 4095) continue;
+        Start = (Pieces[I].Base + 4095) & ~(K70_U64)4095;
+        End = Pieces[I].End & ~(K70_U64)4095;
+        if (End <= Start) continue;
+        if (Result == Capacity) return K70_RAM_CAPACITY;
+        Out[Result++] = (K70_RAM_RANGE){Start, End};
+      }
+    }
+  }
+  *OutCount = Result;
+  return K70_RAM_OK;
+}
diff --git a/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/FdtRamPlan.h b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/FdtRamPlan.h
new file mode 100644
index 0000000..fe62a25
--- /dev/null
+++ b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/FdtRamPlan.h
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef K70_FDT_RAM_PLAN_H
+#define K70_FDT_RAM_PLAN_H
+
+// Pure metadata planner. No physical read, MMIO, allocation, HOB publication,
+// GCD mutation, or device I/O occurs in these functions. Fdt must be an already
+// validated readable buffer, not an arbitrary physical address.
+#ifdef K70_RAM_HOST
+#include <stddef.h>
+#include <stdint.h>
+typedef uint64_t K70_U64;
+typedef size_t K70_SIZE;
+#else
+#include <Uefi.h>
+typedef UINT64 K70_U64;
+typedef UINTN K70_SIZE;
+#endif
+
+#define K70_RAM_BANKS 64
+#define K70_RAM_RESERVATIONS 256
+#define K70_RAM_PIECES 128
+typedef struct { K70_U64 Base, End; } K70_RAM_RANGE; // End is exclusive.
+typedef struct {
+  K70_RAM_RANGE Banks[K70_RAM_BANKS];
+  K70_RAM_RANGE Reserved[K70_RAM_RESERVATIONS];
+  unsigned BankCount, ReservedCount;
+  unsigned DynamicReservationUnknown;
+} K70_FDT_RAM;
+
+enum {
+  K70_RAM_OK = 0,
+  K70_RAM_NO_BANK = 1,
+  K70_RAM_DYNAMIC_UNKNOWN = 2,
+  K70_RAM_BAD_FDT = 3,
+  K70_RAM_CAPACITY = 4,
+  K70_RAM_BAD_RANGES = 5
+};
+
+int K70ReadFdtRam (const void *Fdt, K70_SIZE ReadableBytes, K70_FDT_RAM *Out);
+
+// Gaps must be the current GCD's EfiGcdMemoryTypeNonExistent ranges, not
+// guessed spaces between addresses. Exclude must contain FDT/initrd and every
+// live firmware region not represented in GCD. Never reclassifies an existing
+// Reserved, MMIO, BootServices or Runtime range. Output stays page-aligned.
+int K70PlanNewRam (
+  const K70_FDT_RAM *Info,
+  const K70_RAM_RANGE *Gaps, unsigned GapCount,
+  const K70_RAM_RANGE *Exclude, unsigned ExcludeCount,
+  unsigned PhysicalAddressBits,
+  K70_RAM_RANGE *Out, unsigned Capacity, unsigned *OutCount
+  );
+#endif
diff --git a/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/HeapWindow.h b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/HeapWindow.h
new file mode 100644
index 0000000..3a517b4
--- /dev/null
+++ b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/HeapWindow.h
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef K70_BOOT05_INPUT_HEAP_GUARD_H
+#define K70_BOOT05_INPUT_HEAP_GUARD_H
+// This known heap is used only to reject unreserved live firmware inputs.
+// Kernel window allocation is exclusively in MeasuredWindow.h.
+#define K70_HEAP_BASE 0xBAB00000ULL
+#define K70_HEAP_END  0xC7CC0000ULL
+static inline int K70InputOutsideHeap(unsigned long long Base, unsigned long long Bytes) {
+  if (!Base || !Bytes || Bytes > ~0ULL - Base) return 0;
+  return Base >= K70_HEAP_END || Base + Bytes <= K70_HEAP_BASE;
+}
+#endif
diff --git a/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/MeasuredRam.c b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/MeasuredRam.c
new file mode 100644
index 0000000..6941565
--- /dev/null
+++ b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/MeasuredRam.c
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifdef K70_RAM_PUBLISH_TEST
+#include "PublishTestShim.h"
+#else
+#include <PiDxe.h>
+#include <Library/ArmLib.h>
+#include <Library/ArmMmuLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DxeServicesTableLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#endif
+#include "MeasuredRam.h"
+
+#define K70_WINDOW_BYTES  0x20000000ULL
+#define K70_MAX_PUBLISH   0x40000000ULL
+#define K70_PHASE_MARGIN  0x00200000ULL
+#define K70_OEM_HEAP      0xBAB00000ULL
+
+// State 0: no attempt, 1: commit in progress, 2: ready, 3: stopped/quarantined.
+// Failed or partial publication is never retried until a firmware reboot.
+STATIC unsigned mState;
+STATIC K70_RAM_RANGE mPublished;
+STATIC K70_FDT_RAM mSavedInfo;
+STATIC UINT64 mFdtPhysical, mFdtBytes, mInitrdPhysical, mInitrdBytes;
+STATIC EFI_STATUS mStoppedStatus;
+STATIC CONST CHAR16 *mStoppedReason;
+
+STATIC EFI_STATUS
+Stopped (EFI_STATUS Status, CONST CHAR16 *Text, CONST CHAR16 **Reason)
+{
+  mState = 3;
+  mStoppedStatus = Status;
+  mStoppedReason = Text;
+  *Reason = Text;
+  return Status;
+}
+
+EFI_STATUS
+K70PublishMeasuredRam (
+  CONST VOID *Fdt, UINTN FdtBytes, UINT64 FdtPhysical,
+  UINT64 InitrdPhysical, UINT64 InitrdBytes,
+  K70_RAM_RANGE *Published, CONST CHAR16 **Reason)
+{
+  K70_FDT_RAM Info;
+  K70_RAM_RANGE Gaps[256], Exclude[2], Plan[K70_RAM_PIECES], Best = {0, 0};
+  EFI_GCD_MEMORY_SPACE_DESCRIPTOR *Map = NULL, Current, Heap;
+  UINTN MapCount = 0, Index;
+  UINT64 Bytes, Capabilities;
+  unsigned GapCount = 0, Count = 0;
+  EFI_STATUS Status;
+  EFI_TPL PreviousTpl;
+  int Parsed;
+
+  if (Published == NULL || Reason == NULL) { return EFI_INVALID_PARAMETER; }
+  ZeroMem (Published, sizeof (*Published));
+  *Reason = L"M05 invalid input metadata";
+  if (FdtPhysical == 0 || (UINTN)Fdt != FdtPhysical || FdtBytes == 0 ||
+      FdtBytes > MAX_UINT64 - FdtPhysical || InitrdPhysical == 0 || InitrdBytes == 0 ||
+      InitrdBytes > MAX_UINT64 - InitrdPhysical) { return EFI_INVALID_PARAMETER; }
+  if (mState == 3) { *Reason = mStoppedReason; return mStoppedStatus; }
+  if (mState == 1) { *Reason = L"M05 publication already in progress"; return EFI_NOT_READY; }
+
+  Parsed = K70ReadFdtRam (Fdt, FdtBytes, &Info);
+  if (Parsed != K70_RAM_OK) {
+    *Reason = Parsed == K70_RAM_NO_BANK ? L"M05 runtime FDT has no nonzero RAM bank" :
+              Parsed == K70_RAM_DYNAMIC_UNKNOWN ? L"M05 FDT reservation address unknown" :
+              L"M05 runtime FDT RAM metadata rejected";
+    return EFI_COMPROMISED_DATA;
+  }
+  if (mState == 2) {
+    if (FdtPhysical != mFdtPhysical || FdtBytes != mFdtBytes || InitrdPhysical != mInitrdPhysical ||
+        InitrdBytes != mInitrdBytes || CompareMem (&Info, &mSavedInfo, sizeof (Info)) != 0) {
+      *Reason = L"M05 inputs changed after RAM publication";
+      return EFI_COMPROMISED_DATA;
+    }
+    *Published = mPublished;
+    *Reason = L"M05 existing measured RAM retained";
+    return EFI_SUCCESS;
+  }
+
+  Status = gDS->GetMemorySpaceMap (&MapCount, &Map);
+  if (EFI_ERROR (Status) || Map == NULL) {
+    *Reason = L"M05 current GCD map unavailable";
+    if (Map != NULL) { FreePool (Map); }
+    return EFI_ERROR (Status) ? Status : EFI_COMPROMISED_DATA;
+  }
+  for (Index = 0; Index < MapCount; ++Index) {
+    if (Map[Index].GcdMemoryType != EfiGcdMemoryTypeNonExistent) { continue; }
+    if (Map[Index].Length == 0 || Map[Index].Length > MAX_UINT64 - Map[Index].BaseAddress ||
+        GapCount == ARRAY_SIZE (Gaps) || Map[Index].ImageHandle != NULL || Map[Index].DeviceHandle != NULL) {
+      FreePool (Map); *Reason = L"M05 inconsistent nonexistent GCD range";
+      return EFI_COMPROMISED_DATA;
+    }
+    Gaps[GapCount++] = (K70_RAM_RANGE){Map[Index].BaseAddress, Map[Index].BaseAddress + Map[Index].Length};
+  }
+  FreePool (Map);
+  Exclude[0] = (K70_RAM_RANGE){FdtPhysical, FdtPhysical + FdtBytes};
+  Exclude[1] = (K70_RAM_RANGE){InitrdPhysical, InitrdPhysical + InitrdBytes};
+  Parsed = K70PlanNewRam (&Info, Gaps, GapCount, Exclude, ARRAY_SIZE (Exclude),
+                         ArmGetPhysicalAddressBits (), Plan, ARRAY_SIZE (Plan), &Count);
+  if (Parsed != K70_RAM_OK) {
+    *Reason = L"M05 FDT and current GCD plan rejected";
+    return EFI_COMPROMISED_DATA;
+  }
+  for (Index = 0; Index < Count; ++Index) {
+    Bytes = Plan[Index].End - Plan[Index].Base;
+    if (Bytes >= K70_WINDOW_BYTES + K70_PHASE_MARGIN && Bytes > Best.End - Best.Base) { Best = Plan[Index]; }
+  }
+  if (Best.Base == Best.End) {
+    *Reason = L"M05 no measured 514MiB contiguous GCD gap";
+    return EFI_OUT_OF_RESOURCES;
+  }
+  Bytes = MIN (Best.End - Best.Base, K70_MAX_PUBLISH);
+  Best.End = Best.Base + Bytes;
+  Status = gDS->GetMemorySpaceDescriptor (K70_OEM_HEAP, &Heap);
+  if (EFI_ERROR (Status) || Heap.GcdMemoryType != EfiGcdMemoryTypeSystemMemory ||
+      (Heap.Capabilities & EFI_MEMORY_WB) == 0) {
+    *Reason = L"M05 known heap memory capabilities unavailable";
+    return EFI_ERROR (Status) ? Status : EFI_COMPROMISED_DATA;
+  }
+  Capabilities = Heap.Capabilities & ~EFI_MEMORY_RUNTIME;
+
+  // All validation precedes commit. Prevent lower-TPL callbacks between final
+  // ownership check and publication. Synchronous allocations inside GCD remain
+  // possible, so the real WB CPU mapping is installed before AddMemorySpace.
+  PreviousTpl = gBS->RaiseTPL (TPL_NOTIFY);
+  Status = gDS->GetMemorySpaceDescriptor (Best.Base, &Current);
+  if (EFI_ERROR (Status) || Current.GcdMemoryType != EfiGcdMemoryTypeNonExistent ||
+      Current.BaseAddress > Best.Base || Current.Length == 0 ||
+      Current.Length > MAX_UINT64 - Current.BaseAddress ||
+      Current.BaseAddress + Current.Length < Best.End ||
+      Current.ImageHandle != NULL || Current.DeviceHandle != NULL) {
+    gBS->RestoreTPL (PreviousTpl);
+    *Reason = L"M05 GCD ownership changed before publication";
+    return EFI_ERROR (Status) ? Status : EFI_ACCESS_DENIED;
+  }
+  mState = 1;
+  mPublished = Best;
+  Status = ArmSetMemoryAttributes (Best.Base, Bytes, EFI_MEMORY_WB, 0);
+  if (EFI_ERROR (Status)) {
+    Status = Stopped (Status, L"M05 WB mapping failed; no retry this boot", Reason);
+    gBS->RestoreTPL (PreviousTpl);
+    return Status;
+  }
+  // Commit point: DXE can synchronously allocate from the new bank as part of
+  // adding its conventional-memory descriptors. Never blindly remove/unmap
+  // this bank after this call, including on partial failure.
+  Status = gDS->AddMemorySpace (EfiGcdMemoryTypeSystemMemory, Best.Base, Bytes, Capabilities);
+  if (EFI_ERROR (Status)) {
+    Status = Stopped (Status, L"M05 GCD add failed/partial; mapped RAM retained", Reason);
+    gBS->RestoreTPL (PreviousTpl);
+    return Status;
+  }
+  Status = gDS->SetMemorySpaceAttributes (Best.Base, Bytes, EFI_MEMORY_WB);
+  if (EFI_ERROR (Status)) {
+    Status = Stopped (Status, L"M05 GCD attribute update failed; RAM retained", Reason);
+    gBS->RestoreTPL (PreviousTpl);
+    return Status;
+  }
+  CopyMem (&mSavedInfo, &Info, sizeof (Info));
+  mFdtPhysical = FdtPhysical; mFdtBytes = FdtBytes;
+  mInitrdPhysical = InitrdPhysical; mInitrdBytes = InitrdBytes;
+  mState = 2;
+  *Published = Best;
+  *Reason = L"M05 measured FDT RAM published";
+  gBS->RestoreTPL (PreviousTpl);
+  return EFI_SUCCESS;
+}
+
+#ifdef K70_RAM_PUBLISH_TEST
+VOID K70ResetMeasuredRamForTest (VOID) {
+  mState = 0; ZeroMem (&mPublished, sizeof (mPublished));
+  ZeroMem (&mSavedInfo, sizeof (mSavedInfo));
+  mFdtPhysical = mFdtBytes = mInitrdPhysical = mInitrdBytes = 0;
+  mStoppedStatus = 0; mStoppedReason = NULL;
+}
+#endif
diff --git a/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/MeasuredRam.h b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/MeasuredRam.h
new file mode 100644
index 0000000..3a2b8a8
--- /dev/null
+++ b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/MeasuredRam.h
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef K70_MEASURED_RAM_H
+#define K70_MEASURED_RAM_H
+#include "FdtRamPlan.h"
+
+// Must be called at TPL_APPLICATION only after boot04's physical-input
+// coverage checks succeed. No handoff pointers are discovered by this helper.
+// A successful result is one new, explicitly FDT-described contiguous region;
+// an error leaves the caller in firmware, and never permits a fallback range.
+EFI_STATUS K70PublishMeasuredRam (
+  CONST VOID *Fdt, UINTN FdtBytes, UINT64 FdtPhysical,
+  UINT64 InitrdPhysical, UINT64 InitrdBytes,
+  K70_RAM_RANGE *Published, CONST CHAR16 **Reason
+  );
+
+#ifdef K70_RAM_PUBLISH_TEST
+VOID K70ResetMeasuredRamForTest (VOID);
+#endif
+#endif
diff --git a/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/MeasuredWindow.h b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/MeasuredWindow.h
new file mode 100644
index 0000000..6dc3655
--- /dev/null
+++ b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/MeasuredWindow.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef K70_MEASURED_WINDOW_H
+#define K70_MEASURED_WINDOW_H
+// All bounds come from successful runtime FDT + current GCD publication.
+// This allocator deliberately has no heap, static high-bank, or hole fallback.
+static inline int K70MeasuredWindowCandidate(
+  unsigned long long RunStart, unsigned long long RunEnd,
+  unsigned long long KernelBase, unsigned long long Size,
+  unsigned long long AllowedStart, unsigned long long AllowedEnd,
+  unsigned long long *Candidate) {
+  unsigned long long Start, End, Address;
+  if (!Candidate || RunStart >= RunEnd || AllowedStart >= AllowedEnd || Size != 0x20000000ULL) return 0;
+  Start = RunStart > AllowedStart ? RunStart : AllowedStart;
+  End = RunEnd < AllowedEnd ? RunEnd : AllowedEnd;
+  if (Start >= End) return 0;
+  Address = (Start & ~0x1FFFFFULL) | (KernelBase & 0x1FFFFFULL);
+  if (Address < Start) {
+    if (Address > ~0ULL - 0x200000ULL) return 0;
+    Address += 0x200000ULL;
+  }
+  if (Address < Start || Address >= End || Size > End - Address) return 0;
+  *Candidate = Address; return 1;
+}
+static inline int K70MeasuredLayoutFits(
+  unsigned long long Address, unsigned long long Size, unsigned long long Used,
+  unsigned long long AllowedStart, unsigned long long AllowedEnd) {
+  return AllowedStart < AllowedEnd && Address >= AllowedStart && Address < AllowedEnd &&
+         Size == 0x20000000ULL && Size <= AllowedEnd - Address && Used <= Size - 0x200000ULL;
+}
+#endif
diff --git a/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/PackedRamdisk.h b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/PackedRamdisk.h
new file mode 100644
index 0000000..f34485a
--- /dev/null
+++ b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/PackedRamdisk.h
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Little-endian DBRDISK1: version, page size, expanded bytes, extent count;
+// then sorted (destination offset, byte count) pairs and concatenated bytes.
+// Omitted ranges are real zeroed RAM, not virtual/simulated disk storage.
+#ifndef DARWIN_BOOT_PACKED_RAMDISK_H
+#define DARWIN_BOOT_PACKED_RAMDISK_H
+
+// A packed disk handed to the native sparse block driver keeps only its nonzero pages (KeepPacked), so its logical size is bounded by the
+// disk format, not by memory; a dense expansion still has to fit the window, which the caller checks.
+#define SIZE_MAX_LOGICAL  (1ULL << 40)
+
+STATIC
+BOOLEAN
+RamdiskLayout (CONST VOID *Input, UINTN InputSize, UINTN *Expanded, BOOLEAN *Packed)
+{
+  CONST UINT8 *Bytes = Input;
+  UINT64 Logical, Count, Table, Cursor, End, Index, Offset, Length;
+  *Expanded = InputSize;
+  *Packed = FALSE;
+  if ((InputSize > SIZE_256MB) || ((Input == NULL) != (InputSize == 0))) { return FALSE; }
+  if ((InputSize < 8) || (CompareMem (Input, "DBRDISK1", 8) != 0)) { return TRUE; }
+  if ((InputSize < 32) || (ReadUnaligned32 ((CONST UINT32 *)(Bytes + 8)) != 1) ||
+      (ReadUnaligned32 ((CONST UINT32 *)(Bytes + 12)) != EFI_PAGE_SIZE)) { return FALSE; }
+  Logical = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 16));
+  Count = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 24));
+  if ((Logical == 0) || (Logical > SIZE_MAX_LOGICAL) || (Logical & (EFI_PAGE_SIZE - 1)) ||
+      (Count > 65536) || (Count > (InputSize - 32) / 16)) { return FALSE; }
+  Table = 32 + Count * 16;
+  Cursor = Table;
+  End = 0;
+  for (Index = 0; Index < Count; Index++) {
+    Offset = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 32 + Index * 16));
+    Length = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 40 + Index * 16));
+    if (!Length || ((Offset | Length) & (EFI_PAGE_SIZE - 1)) || (Offset < End) ||
+        (Offset > Logical) || (Length > Logical - Offset) || (Length > InputSize - Cursor)) { return FALSE; }
+    End = Offset + Length;
+    Cursor += Length;
+  }
+  if (Cursor != InputSize) { return FALSE; }
+  *Expanded = (UINTN)Logical;
+  *Packed = TRUE;
+  return TRUE;
+}
+
+STATIC
+VOID
+CopyRamdisk (VOID *Destination, CONST VOID *Input, UINTN InputSize, BOOLEAN Packed)
+{
+  CONST UINT8 *Bytes = Input;
+  UINT64 Count, Cursor, Index, Offset, Length;
+  // Caller has validated every range and zeroed the entire expanded allocation.
+  if (!Packed) { CopyMem (Destination, Input, InputSize); return; }
+  Count = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 24));
+  Cursor = 32 + Count * 16;
+  for (Index = 0; Index < Count; Index++) {
+    Offset = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 32 + Index * 16));
+    Length = ReadUnaligned64 ((CONST UINT64 *)(Bytes + 40 + Index * 16));
+    CopyMem ((UINT8 *)Destination + Offset, Bytes + Cursor, (UINTN)Length);
+    Cursor += Length;
+  }
+}
+#endif
diff --git a/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/WindowSize.h b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/WindowSize.h
new file mode 100644
index 0000000..fae3636
--- /dev/null
+++ b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/WindowSize.h
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef DARWINBOOT_WINDOW_SIZE_H
+#define DARWINBOOT_WINDOW_SIZE_H
+// Allocation still requires one real conventional-memory run. This is a
+// parser bound, never a declaration of available RAM or an allocation fallback.
+static inline int DarwinWindowSizeValid(unsigned long long size) {
+  // Parser bounds only. Boot05 separately requires an explicit 512 MiB
+  // ADT value and newly published FDT-described memory; no allocation fallback.
+  return size >= 0x08000000ULL && size <= 0x200000000ULL && !(size & 0x1fffffULL);
+}
+#endif
