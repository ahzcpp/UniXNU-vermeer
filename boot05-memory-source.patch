+#!/usr/bin/env python3
+"""Compile/test only metadata code against the existing pinned bundled libfdt."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parent
+LIB = Path('/root/k70-clean-20261104/out-firmware/feeds/mu_basecore-8f10084c/MdePkg/Library/BaseFdtLib/libfdt/libfdt')
+STOCK = ROOT.parent / 'stock-analysis'
+files = ['fdt.c', 'fdt_ro.c', 'fdt_wip.c', 'fdt_sw.c', 'fdt_rw.c', 'fdt_strerror.c',
+         'fdt_empty_tree.c', 'fdt_addresses.c', 'fdt_check.c']
+with tempfile.TemporaryDirectory(prefix='k70-ram-plan-') as tmp:
+    binary = Path(tmp) / 'test-fdt-ram'
+    command = ['/usr/lib/llvm-18/bin/clang', '-DK70_RAM_HOST', '-D_POSIX_C_SOURCE=200809L', '-std=c11', '-g', '-O1',
+               '-Wall', '-Wextra', '-Werror', '-fsanitize=address,undefined',
+               '-I', str(LIB), str(ROOT / 'FdtRamPlan.c'), str(ROOT / 'test-fdt-ram.c'),
+               *[str(LIB / p) for p in files], '-o', str(binary)]
+    compiled = subprocess.run(command, capture_output=True, text=True, timeout=60)
+    if compiled.returncode:
+        print(compiled.stderr)
+        raise SystemExit(compiled.returncode)
+    result = subprocess.run([str(binary), str(STOCK/'vendor_boot/dtb-002.dtb'),
+                             str(STOCK/'dtbo/vermeer-v2-composed.dtb')],
+                            capture_output=True, text=True, timeout=30)
+    report = {'success': result.returncode == 0, 'device_io': False,
+              'no_actual_ram_measurement': True, 'sanitizers': ['address', 'undefined'],
+              'stdout': result.stdout, 'stderr': result.stderr,
+              'source_sha256': {p.name: hashlib.sha256(p.read_bytes()).hexdigest()
+                                for p in (ROOT/'FdtRamPlan.c', ROOT/'FdtRamPlan.h', ROOT/'test-fdt-ram.c')},
+              'libfdt_source_sha256': {p: hashlib.sha256((LIB/p).read_bytes()).hexdigest() for p in files}}
+    (ROOT/'host-test-results.json').write_text(json.dumps(report, indent=2)+'\n')
+    print(result.stdout, end='')
+    if result.stderr:
+        print(result.stderr)
+    if result.returncode:
+        raise SystemExit(result.returncode)
+    binary = Path(tmp) / 'test-publish-ram'
+    command = ['/usr/lib/llvm-18/bin/clang', '-DK70_RAM_HOST', '-DK70_RAM_PUBLISH_TEST',
+               '-D_POSIX_C_SOURCE=200809L', '-std=c11', '-g', '-O1',
+               '-Wall', '-Wextra', '-Werror', '-fsanitize=address,undefined',
+               '-I', str(LIB), str(ROOT / 'FdtRamPlan.c'), str(ROOT/'MeasuredRam.c'),
+               str(ROOT/'test-publish-ram.c'), *[str(LIB / p) for p in files], '-o', str(binary)]
+    subprocess.run(command, capture_output=True, text=True, timeout=60, check=True)
+    result = subprocess.run([str(binary)], capture_output=True, text=True, timeout=30)
+    report['publication_model_success'] = result.returncode == 0
+    report['publication_model_stdout'] = result.stdout
+    report['publication_model_stderr'] = result.stderr
+    report['success'] = report['success'] and result.returncode == 0
+    report['source_sha256'].update({p.name: hashlib.sha256(p.read_bytes()).hexdigest()
+        for p in (ROOT/'MeasuredRam.c', ROOT/'MeasuredRam.h', ROOT/'PublishTestShim.h', ROOT/'test-publish-ram.c')})
+    (ROOT/'host-test-results.json').write_text(json.dumps(report, indent=2)+'\n')
+    print(result.stdout, end='')
+    if result.stderr:
+        print(result.stderr)
+    raise SystemExit(result.returncode)
