@@ -0,0 +1,181 @@
+#!/usr/bin/env python3
+"""Build only DarwinBoot (optional), then FDS, reusing completed unchanged SDK PEs.
+
+An interrupted platform/all invocation is preserved as a failure. It is never
+reported as a successful full rebuild. Before packaging, every unrelated PE is
+required to remain byte-identical to the previously fully built/audited image.
+No object timestamps are forged and no baseline artifact is overwritten.
+"""
+import argparse
+import datetime
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import tomllib
+
+cli=argparse.ArgumentParser()
+cli.add_argument('--reuse-linked-module',action='store_true',help='Accept the already completed new DarwinBoot PE after validating its own object/source identity.')
+args=cli.parse_args()
+WORK=Path(__file__).resolve().parent
+BASE=WORK.parent
+ROOT=Path('/root/k70-clean-20261104')
+UEFI=ROOT/'uefi'
+EDK=ROOT/'out-firmware/feeds/mu_basecore-8f10084c'
+TREE=ROOT/'out-firmware/vermeer/ipados-17.7.11-21H461/vermeer/tree'
+CONF=ROOT/'out-firmware/vermeer/ipados-17.7.11-21H461/vermeer/edk2-conf'
+TOOLS=EDK/'BaseTools'
+SNAP=WORK/'source-snapshots/initial-verified-2d207ced'
+BUILD=UEFI/'Build/vermeerBoot05/DEBUG_CLANGPDB'
+DARWIN=BUILD/'AARCH64/DarwinBootPkg/Driver/DarwinBoot/OUTPUT/DarwinBoot.efi'
+SOURCE=WORK/'darwinboot/DarwinBootPkg/Driver/DarwinBoot.c'
+def sha(data):return hashlib.sha256(data).hexdigest()
+
+initial_build=json.loads((SNAP/'build-result.json').read_text())
+initial_audit=json.loads((SNAP/'fd-audit.json').read_text())
+assert initial_build['exit_code']==0 and initial_audit['success']
+assert initial_audit['fd_sha256']=='2d207ced094daee8b72c22029efc64b54f37021546af1c1663a0614ee4a164fc'
+for name,digest in initial_build['source_sha256'].items():
+    if not name.endswith('/DarwinBoot.c'):
+        assert sha((WORK/name).read_bytes())==digest,'Unrelated runtime/config changed: '+name
+
+# The cancelled platform run relinked PcdDxe before its unchanged libraries.
+# Permit explicit recovery only when the complete previous PE is preserved in
+# the audited FD and the sole new bytes are its CodeView PDB identifier. The
+# PCD database must itself be byte-exact; this is not a general reuse waiver.
+recovered=[]
+def recover_pcd_pe(record, path):
+    assert record['guid']=='80cf7257-87ab-47f9-a3fe-d50b76d89541'
+    spec=importlib.util.spec_from_file_location('boot05_audit',WORK/'audit-fd.py')
+    audit_module=importlib.util.module_from_spec(spec); spec.loader.exec_module(audit_module)
+    helper=audit_module.load_helper(); Audit=helper.load_parser(audit_module.PARSER)
+    audit=Audit(); fd=(BASE/'artifacts/boot-chain-05/SILICIUM_UEFI.fd').read_bytes()
+    assert sha(fd)==initial_audit['fd_sha256']
+    audit.scan(fd,'FD',[]); assert not audit.errors and not audit.warnings
+    files=[f for f in audit.files if f['guid']==record['guid']]; assert len(files)==1
+    pe_sections=[s for s in files[0]['sections'] if s['type']==16]; assert len(pe_sections)==1
+    raw_sections=[s for s in files[0]['sections'] if s['type']==25]; assert len(raw_sections)==1
+    original=audit.memory[pe_sections[0]['payload']['path']]
+    assert sha(original)==record['pe']['original_sha256']
+    assert audit.memory[raw_sections[0]['payload']['path']]==(path.parent/'DXEPcdDataBase.raw').read_bytes()
+    debug_path=path.parent.parent/'DEBUG'/path.name
+    candidates=[p for p in (path,debug_path) if p.read_bytes()!=original]
+    assert candidates
+    current=candidates[0].read_bytes(); assert len(original)==len(current)
+    assert all(p.read_bytes() in (original,current) for p in (path,debug_path))
+    # Resolve the CodeView payload through the bounded PE debug-directory
+    # entry, rather than accepting an arbitrary RSDS byte occurrence.
+    def codeview(image):
+        pe=struct.unpack_from('<I',image,0x3c)[0]; opt=pe+24
+        nsec=struct.unpack_from('<H',image,pe+6)[0]
+        optsize=struct.unpack_from('<H',image,pe+20)[0]
+        rva,size=struct.unpack_from('<II',image,opt+112+6*8)
+        assert size==28
+        raw=None
+        for i in range(nsec):
+            s=opt+optsize+i*40; _,va,rs,rp=struct.unpack_from('<IIII',image,s+8)
+            if va<=rva and rva+size<=va+rs: raw=rp+rva-va
+        assert raw is not None and raw+28<=len(image)
+        _,_,_,_,kind,length,_,pointer=struct.unpack_from('<IIHHIIII',image,raw)
+        assert kind==2 and length>=24 and pointer+length<=len(image)
+        assert image[pointer:pointer+4]==b'RSDS'
+        return pointer+4,pointer+20
+    span=codeview(original); assert codeview(current)==span
+    differences=[i for i,(a,b) in enumerate(zip(original,current)) if a!=b]
+    assert differences and all(span[0]<=i<span[1] for i in differences)
+    proof={'guid':record['guid'],'output_path':str(path),'debug_path':str(debug_path),'relinked_pe_sha256':sha(current),
+           'recovered_original_pe_sha256':sha(original),'changed_byte_offsets':differences,
+           'only_changed_region':'PE CodeView RSDS PDB GUID; PCD raw database exact',
+           'raw_pcd_sha256':sha((path.parent/'DXEPcdDataBase.raw').read_bytes()),
+           'recovered_from_fd_sha256':sha(fd)}
+    backup=WORK/'local-relinked-pe'; backup.mkdir(exist_ok=True)
+    (backup/'PcdDxe.efi').write_bytes(current)
+    path.write_bytes(original)
+    debug_path.write_bytes(original)
+    recovered.append(proof)
+
+# Validate all unrelated completed module PEs exactly against the preserved
+# successful full build, including SEC. A corrupted/changed output must be
+# repaired explicitly, rather than silently trusted from the aborted build.
+reused=[]
+for record in initial_audit['source_pe_checks']:
+    if record['guid']=='1b64af87-8415-4b57-9b16-680d70913b9f':continue
+    p=Path(record['output_path'])
+    if (sha(p.read_bytes())!=record['pe']['original_sha256'] or
+        (record['guid']=='80cf7257-87ab-47f9-a3fe-d50b76d89541' and
+         sha((p.parent.parent/'DEBUG'/p.name).read_bytes())!=record['pe']['original_sha256'])):
+        recover_pcd_pe(record,p)
+    assert sha(p.read_bytes())==record['pe']['original_sha256'],'Unrelated completed PE changed: '+str(p)
+    reused.append({'path':str(p),'sha256':sha(p.read_bytes())})
+for record in initial_audit['source_sec_checks']:
+    p=Path(record['output_path'])
+    assert sha(p.read_bytes())==record['conversion']['source_output_pe_sha256'],'SEC PE changed'
+    reused.append({'path':str(p),'sha256':sha(p.read_bytes())})
+
+board=tomllib.loads((BASE/'device-source/board.toml').read_text())
+fields={'uefi':str(UEFI),'edk2':str(EDK),'tree':str(TREE)}
+packages=[str(WORK/'package'),str(WORK/'darwinboot')]+[p.format(**fields) for p in board['firmware']['packages']]
+env=dict(os.environ,WORKSPACE=str(UEFI),EDK_TOOLS_PATH=str(TOOLS),CONF_PATH=str(CONF),
+         PACKAGES_PATH=':'.join(packages),PYTHON_COMMAND='python3',CLANG_BIN='/usr/lib/llvm-18/bin/',
+         CLANGPDB_AARCH64_PREFIX='aarch64-linux-gnu-',
+         SOURCE_DATE_EPOCH=subprocess.check_output(['git','-C',str(UEFI),'log','-1','--format=%ct'],text=True).strip(),
+         PATH=':'.join((str(TOOLS/'BinWrappers/PosixLike'),str(TOOLS/'Source/C/bin'),os.environ['PATH'])))
+common=initial_build['command'][1:]
+snapshot={str(p.relative_to(WORK)):sha(p.read_bytes()) for base in (WORK/'package',WORK/'darwinboot/DarwinBootPkg')
+          for p in sorted(base.rglob('*')) if p.is_file() and not any(x in {'__pycache__','Build'} for x in p.parts)}
+prior=WORK/'build-result.json'
+if prior.exists() and json.loads(prior.read_text()).get('exit_code')!=0 and 'mode' not in json.loads(prior.read_text()):
+    shutil.copyfile(prior,WORK/'cancelled-all-build-result.json')
+    shutil.copyfile(WORK/'build.log',WORK/'cancelled-all-build.log')
+started=datetime.datetime.now(datetime.timezone.utc).isoformat()
+commands=[]
+if not args.reuse_linked_module:
+    cmd=['build','-m','DarwinBootPkg/Driver/DarwinBoot.inf',*common]
+    commands.append(cmd)
+    with (WORK/'module-ui-build.log').open('w') as log:
+        subprocess.run(cmd,cwd=UEFI,env=env,stdout=log,stderr=subprocess.STDOUT,check=True)
+
+# This new module was compiled and linked by the previous invocation, or by
+# the module-only step above. Bind its LLVM object to current exact C bytes.
+obj=DARWIN.parent/'DarwinBoot.obj'
+ir=subprocess.check_output(['/usr/lib/llvm-18/bin/llvm-dis',str(obj),'-o','-'],text=True,timeout=45)
+assert 'source_filename = "'+str(SOURCE)+'"' in ir
+assert 'checksumkind: CSK_MD5, checksum: "'+hashlib.md5(SOURCE.read_bytes()).hexdigest()+'"' in ir
+pe=DARWIN.read_bytes()
+assert DARWIN.stat().st_mtime>=SOURCE.stat().st_mtime
+assert pe[:2]==b'MZ' and 'K70 BOOT05R1 - FAILURE HELD'.encode('utf-16-le') in pe
+# GenFds can reuse cached section/FFS outputs despite the explicitly restored
+# PE. Recreate only this profile's generated FV containers; every compiled
+# OUTPUT above has already been validated and remains untouched.
+fv=BUILD/'FV'
+assert fv.resolve()==UEFI.resolve()/'Build/vermeerBoot05/DEBUG_CLANGPDB/FV'
+if fv.exists():
+    shutil.rmtree(fv)
+# The threaded FDS mode assumes module makefiles already created their FFS
+# outputs. Serial GenFds regenerates those containers from the validated PEs;
+# it does not change a compiler/linker flag or rebuild an SDK library.
+cmd=['build','fds','--no-genfds-multi-thread',*common]
+commands.append(cmd)
+with (WORK/'fds-ui-build.log').open('w') as log:
+    p=subprocess.run(cmd,cwd=UEFI,env=env,stdout=log,stderr=subprocess.STDOUT)
+changed=[name for name,digest in snapshot.items() if sha((WORK/name).read_bytes())!=digest]
+report={'schema':2,'started_utc':started,'command':commands[-1],'commands':commands,
+        'exit_code':p.returncode,'source_sha256':snapshot,'source_changed_during_build':changed,
+        'mode':'validated completed new DarwinBoot PE + FDS only' if args.reuse_linked_module else 'DarwinBoot module-only + FDS',
+        'prior_successful_full_build_fd_sha256':initial_audit['fd_sha256'],
+        'unrelated_completed_pe_byte_exact_to_full_build':reused,
+        'explicit_verified_output_recovery':recovered,
+        'darwin_c_sha256':sha(SOURCE.read_bytes()),'darwin_object_sha256':sha(obj.read_bytes()),
+        'darwin_object_source_md5':hashlib.md5(SOURCE.read_bytes()).hexdigest(),
+        'darwin_pe_sha256':sha(pe),'cancelled_all_target_is_not_success':True,
+        'sdk_flags_same_as_preserved_full_build':True,'hardware_tested':False,'contains_os_root':False}
+report['generated_fv_cache_recreated']=True
+report['genfds_serial_container_generation_only']=True
+(WORK/'build-result.json').write_text(json.dumps(report,indent=2)+'\n')
+print(json.dumps({'exit_code':p.returncode,'mode':report['mode'],'source_files':len(snapshot),
+                  'reused_unrelated_pes':len(reused),'source_changed':changed}))
+raise SystemExit(p.returncode or bool(changed))
