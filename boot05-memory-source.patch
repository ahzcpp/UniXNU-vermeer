+#!/usr/bin/env python3
+"""Host-only reference checks of the actual isolated boot05 window header."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+WORK = HERE.parent/'boot-chain-05'
+HEADER = WORK/'darwinboot/DarwinBootPkg/Driver/MeasuredWindow.h'
+code = r'''
+#include "MeasuredWindow.h"
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+static unsigned S=0x5121705;
+static unsigned R(void){S^=S<<13;S^=S>>17;S^=S<<5;return S;}
+int main(void){
+  unsigned I;unsigned long long A,B,E,V,P,Got,Ref,Start,End;
+  for(I=0;I<600;++I){
+    A=0x900000000ULL+(R()%1024)*4096ULL;
+    B=A+(512ULL+(R()%1024))*1024*1024;
+    Start=A+(R()%64)*4096ULL;End=B-(R()%64)*4096ULL;
+    V=(R()%512)*4096ULL;Ref=0;
+    for(P=Start;P<End&&0x20000000ULL<=End-P;P+=4096){if((P&0x1fffff)==V){Ref=P;break;}}
+    Got=0;E=K70MeasuredWindowCandidate(Start,End,V,0x20000000ULL,A,B,&Got);
+    assert(E==(Ref!=0));if(E)assert(Got==Ref);
+    assert(!K70MeasuredWindowCandidate(Start,End,V,0x08000000ULL,A,B,&Got));
+    assert(!K70MeasuredWindowCandidate(0xBAB00000ULL,0xC7CC0000ULL,V,0x20000000ULL,A,B,&Got));
+  }
+  A=0x900000000ULL;B=A+0x40000000ULL;
+  assert(K70MeasuredLayoutFits(A,0x20000000ULL,0x1fe00000ULL,A,B));
+  assert(!K70MeasuredLayoutFits(A,0x20000000ULL,0x1fe00001ULL,A,B));
+  assert(!K70MeasuredLayoutFits(A-4096,0x20000000ULL,0,A,B));
+  assert(!K70MeasuredWindowCandidate(~0ULL-8191,~0ULL,0x1ff000,0x20000000ULL,~0ULL-8191,~0ULL,&Got));
+  puts("PASS: 600 brute page-search comparisons, fixed 512MiB request, no heap fallback, overflow/layout guards");return 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix='k70-measured-window-') as tmp:
+    tmp=Path(tmp); src=tmp/'test.c'; binary=tmp/'test';src.write_text(code)
+    subprocess.run(['/usr/lib/llvm-18/bin/clang','-std=c11','-O1','-Wall','-Wextra','-Werror',
+                    '-fsanitize=address,undefined','-I',str(HEADER.parent),str(src),'-o',str(binary)],
+                   capture_output=True,text=True,timeout=30,check=True)
+    result=subprocess.run([str(binary)],capture_output=True,text=True,timeout=30)
+    report={'success':result.returncode==0,'device_io':False,'header_sha256':hashlib.sha256(HEADER.read_bytes()).hexdigest(),
+            'stdout':result.stdout,'stderr':result.stderr}
+    (WORK/'window-check.json').write_text(json.dumps(report,indent=2)+'\n')
+    print(result.stdout,end='')
+    if result.stderr:print(result.stderr)
+    raise SystemExit(result.returncode)
