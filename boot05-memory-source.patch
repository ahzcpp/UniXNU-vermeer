+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def load_helper():
+    data = HELPER.read_bytes()
+    require(sha(data) == HELPER_SHA, 'Reviewed FV/PE helper changed')
+    require(b"if __name__=='__main__':" in data, 'Helper has no main guard')
+    spec = importlib.util.spec_from_file_location('k70_reviewed_fd_helpers', HELPER)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def unique_blob_offset(haystack, blob, label):
+    start = haystack.find(blob)
+    require(start >= 0 and haystack.find(blob, start + 1) < 0,
+            label + ' must contain the complete compiled table exactly once')
+    return start
+
+
+def llvm_string(text):
+    out = bytearray()
+    index = 0
+    while index < len(text):
+        if text[index] == '\\':
+            require(index + 2 < len(text) and re.fullmatch(r'[0-9A-Fa-f]{2}', text[index+1:index+3]),
+                    'Unsupported LLVM constant string escape')
+            out.append(int(text[index+1:index+3], 16))
+            index += 3
+        else:
+            out.append(ord(text[index]))
+            index += 1
+    return bytes(out)
+
+
+def source_memory_table(data):
+    # These concrete enum/alias values are the current Silicium/PI AArch64 ABI.
+    # Unknown tokens fail, rather than being treated as conventional memory.
+    values = {
+        'NoHob': 0, 'AddMem': 1, 'AddDev': 2, 'HobOnlyNoCacheSetting': 3,
+        'SYS_MEM': 0, 'MMAP_IO': 1, 'MEM_RES': 5,
+        'SYS_MEM_CAP': 7355399, 'UNCACHEABLE': 1024, 'INITIALIZED': 2,
+        'Reserv': 0, 'BsData': 4, 'RtData': 6, 'Conv': 7, 'MmIO': 11,
+        'UNCACHED_UNBUFFERED_XN': 0, 'WRITE_BACK': 1, 'WRITE_BACK_XN': 1,
+        'WRITE_THROUGH_XN': 5, 'NS_DEVICE': 6,
+    }
+    pattern = re.compile(r'^\s*\{"([^"]+)",\s*(0x[0-9A-Fa-f]+),\s*(0x[0-9A-Fa-f]+),\s*(\w+),\s*(\w+),\s*(\w+),\s*(\w+),\s*(\w+)\},?\s*$', re.M)
+    rows = []
+    for match in pattern.finditer(data.decode('utf-8')):
+        name = match[1].encode('ascii')
+        require(len(name) < 32, 'Memory table name does not fit the ABI')
+        nums = [int(match[2], 16), int(match[3], 16)]
+        try:
+            nums += [values[match[i]] for i in range(4, 9)]
+        except KeyError as exc:
+            raise ValueError('Unreviewed MemoryMap ABI token: ' + str(exc))
+        rows.append((name.ljust(32, b'\0'), *nums))
+    require(60 < len(rows) < 128, 'Source memory table parse/count failed')
+    conventional = [r for r in rows if r[4] == 0 and r[6] == 7]
+    require(len(conventional) == 1 and conventional[0][:3] ==
+            (b'DXE Heap'.ljust(32, b'\0'), 0xBAB00000, 0xD1C0000),
+            'Source policy must expose only the exact OEM DXE heap')
+    for name in ('DRAM gap 0xC7CC0000', 'DRAM gap 0xCCF80000',
+                 'DRAM gap 0xE671D000', 'DRAM bank 1 low', 'Kernel'):
+        matches = [r for r in rows if r[0].split(b'\0', 1)[0].decode() == name]
+        require(len(matches) == 1 and matches[0][6] == 0, 'Required reserved source region changed: ' + name)
+    return rows
+
+
+def verify_memory_binding(args, sec_pe, sec_te, source_snapshot):
+    source = WORK / 'package/K70Boot05Pkg/Library/MemoryMapLib/MemoryMapLib.c'
+    source_data = source.read_bytes()
+    relative = str(source.relative_to(WORK))
+    require(source_snapshot.get(relative) == sha(source_data), 'MemoryMap source differs from completed build snapshot')
+    expected_rows = source_memory_table(source_data)
+    objects = list((args.build_root / 'AARCH64/K70Boot05Pkg/Library/MemoryMapLib').rglob('OUTPUT/MemoryMapLib.obj'))
+    require(len(objects) == 1, 'Isolated MemoryMap compiled object missing or ambiguous')
+    obj = objects[0]
+    require(obj.read_bytes().startswith(b'BC\xc0\xde'), 'Expected CLANGPDB LLVM bitcode object')
+    result = subprocess.run([str(args.llvm_dis), str(obj), '-o', '-'], capture_output=True,
+                            text=True, timeout=45, check=True)
+    ir = result.stdout
+    require(len(ir) < 2 * 1024 * 1024, 'LLVM memory object disassembly exceeds audit bound')
+    require(f'source_filename = "{source}"' in ir, 'MemoryMap object was compiled from another source path')
+    md5 = hashlib.md5(source_data).hexdigest()
+    require(re.search(r'!DIFile\(filename: "' + re.escape(str(source)) +
+                      r'",[^\n]*checksumkind: CSK_MD5, checksum: "' + md5 + r'"', ir) is not None,
+            'Compiled MemoryMap source checksum does not match current source bytes')
+    table = re.search(r'^@gMemoryDescriptor = internal global \[(\d+) x %struct\.EFI_MEMORY_REGION_DESCRIPTOR\] (.*?), align \d+', ir, re.M)
+    require(table is not None, 'MemoryMap bitcode has no complete expected table definition')
+    rowpat = re.compile(r'%struct\.EFI_MEMORY_REGION_DESCRIPTOR \{ \[32 x i8\] c"((?:[^"\\]|\\[0-9A-Fa-f]{2})*)", i64 (-?\d+), i64 (-?\d+), i32 (-?\d+), i32 (-?\d+), i32 (-?\d+), i32 (-?\d+), i32 (-?\d+) \}')
+    rows = [(llvm_string(m[1]), *[int(m[i]) for i in range(2, 9)]) for m in rowpat.finditer(table[2])]
+    require(len(rows) == int(table[1]) and rows == expected_rows,
+            'Compiled descriptor data differs from current source/ABI')
+    function = re.search(r'^define[^\n]*@GetMemoryMap\([^\n]*\).*?^}', ir, re.M | re.S)
+    require(function is not None and 'store ptr @gMemoryDescriptor,' in function[0]
+            and re.search(r'\bstore i8 ' + str(len(rows)) + r',', function[0]) is not None,
+            'Compiled GetMemoryMap does not return this table and exact count')
+    require('%struct.EFI_MEMORY_REGION_DESCRIPTOR = type { [32 x i8], i64, i64, i32, i32, i32, i32, i32 }' in ir,
+            'Compiled descriptor ABI differs')
+    encoded = b''.join(struct.pack('<32sQQIIIII4x', *row) for row in rows)
+    pe_off = unique_blob_offset(sec_pe, encoded, 'Current SEC PE')
+    te_off = unique_blob_offset(sec_te, encoded, 'Final FD SEC TE')
+    sec_out = args.build_root / 'AARCH64/SiliciumPkg/Sec/Sec/OUTPUT'
+    libraries = (sec_out / 'static_library_files.lst').read_text()
+    lib = obj.with_suffix('.lib')
+    require(str(lib) in libraries.splitlines(), 'SEC link input list does not include isolated MemoryMap library')
+    require(lib.is_file(), 'SEC MemoryMap library input is absent')
+    archive_list = subprocess.run(['/usr/lib/llvm-18/bin/llvm-ar', 't', str(lib)], capture_output=True,
+                                  text=True, timeout=30, check=True).stdout.splitlines()
+    members = [name for name in archive_list if Path(name).name == 'MemoryMapLib.obj']
+    require(len(members) == 1, 'MemoryMap library has ambiguous object member')
+    member = subprocess.run(['/usr/lib/llvm-18/bin/llvm-ar', 'p', str(lib), members[0]],
+                            capture_output=True, timeout=30, check=True).stdout
+    require(member == obj.read_bytes(), 'SEC library member differs from audited MemoryMap object')
+    return {
+        'success': True, 'method': 'source snapshot + compiled LLVM constant table + exact SEC PE/final TE table data',
+        'source_path': str(source), 'source_sha256': sha(source_data), 'compiled_source_md5': md5,
+        'object_path': str(obj), 'object_sha256': sha(obj.read_bytes()),
+        'llvm_dis_sha256': sha(args.llvm_dis.read_bytes()),
+        'descriptor_count': len(rows), 'descriptor_bytes': 72, 'table_sha256': sha(encoded),
+        'sec_pe_table_file_offset': hex(pe_off), 'fd_sec_te_table_file_offset': hex(te_off),
+        'link_library_path': str(lib), 'link_library_sha256': sha(lib.read_bytes()),
+        'library_member_equals_object': True,
+        'limitation': 'Not an independent compiler rebuild of all SEC code. Does establish all current descriptor bytes, table-return IR, link input membership, and their exact presence in the source-bound SEC image.',
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--build-root', type=Path, default=BUILD)
+    ap.add_argument('--fd', type=Path, default=BUILD / 'FV/SILICIUM_UEFI.fd')
+    ap.add_argument('--build-result', type=Path, default=WORK / 'build-result.json')
+    ap.add_argument('--genfw', type=Path, default=GENFW)
+    ap.add_argument('--llvm-dis', type=Path, default=LLVM_DIS)
+    ap.add_argument('--output', type=Path, default=WORK / 'fd-audit.json')
+    args = ap.parse_args()
+    report = {'schema': 'k70-boot05-fd-audit/1', 'success': False, 'errors': [],
+              'hardware_tested': False, 'script_sha256': sha(Path(__file__).read_bytes()),
+              'created_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+              'limitations': ['Offline artifact identity/structure only; no XNU execution or iPadOS startup established.']}
+    try:
+        require(args.build_root.resolve() == BUILD.resolve(), 'Only the vermeerBoot05 final build tree is accepted')
+        require(args.fd.resolve() == (args.build_root / 'FV/SILICIUM_UEFI.fd').resolve(), 'FD is not exact named boot05 output')
+        result_bytes = args.build_result.read_bytes()
+        result = json.loads(result_bytes)
+        require(result['exit_code'] == 0 and result['source_changed_during_build'] == [], 'Build is incomplete or sources changed')
+        source_snapshot = result['source_sha256']
+        require(source_snapshot, 'No completed build source snapshot')
+        for name, digest in source_snapshot.items():
+            p = (WORK / name).resolve()
+            require(p.is_relative_to(WORK.resolve()) and p.is_file(), 'Build snapshot source path escapes or is absent')
+            require(sha(p.read_bytes()) == digest, 'Current source differs from completed build snapshot: ' + name)
+        fd_stat = args.fd.stat()
+        started = datetime.datetime.fromisoformat(result['started_utc'])
+        require(started.tzinfo is not None and fd_stat.st_mtime >= started.timestamp(), 'FD predates this completed build')
+        fd = args.fd.read_bytes()
+        require(len(fd) == 0x300000, 'Unexpected complete FD size')
+        report.update(fd_path=str(args.fd), fd_sha256=sha(fd), fd_bytes=len(fd),
