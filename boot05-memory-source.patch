+#!/usr/bin/env python3
+"""Compile the isolated boot05 C/assembly with real EDK headers, no EDK build."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+ROOT = Path('/root/k70-clean-20261104')
+WORK = HERE.parent/'boot-chain-05'
+DRIVER = WORK/'darwinboot/DarwinBootPkg/Driver'
+EDK = ROOT/'out-firmware/feeds/mu_basecore-8f10084c'
+AUTOGEN = ROOT/'uefi/Build/vermeerBoot04/DEBUG_CLANGPDB/AARCH64/DarwinBootPkg/Driver/DarwinBoot/DEBUG'
+includes = [DRIVER, AUTOGEN, EDK/'MdePkg/Include', EDK/'MdePkg/Include/AArch64',
+            EDK/'ArmPkg/Include', EDK/'UefiCpuPkg/Include',
+            ROOT/'UniXNU/package/UniXNUPkg/Include',
+            ROOT/'uefi/Silicon/Silicium/SiliciumPkg/Include']
+sources = ['FdtRamPlan.c','MeasuredRam.c','DarwinBoot.c']
+assert (DRIVER/'Entry.S').read_bytes() == (HERE.parent/'boot-chain-04/darwinboot/DarwinBootPkg/Driver/Entry.S').read_bytes()
+checks = []
+with tempfile.TemporaryDirectory(prefix='k70-boot05-coff-') as tmp:
+    for name in sources:
+        source = DRIVER/name
+        target = Path(tmp)/(name+'.obj')
+        command = ['/usr/lib/llvm-18/bin/clang', '--target=aarch64-unknown-windows-msvc',
+                   '-fshort-wchar','-fno-builtin','-fno-stack-protector','-mno-implicit-float',
+                   '-mno-stack-arg-probe','-funsigned-char','-Werror','-Wall',
+                   '-Wno-microsoft-enum-forward-reference','-Wno-incompatible-library-redeclaration',
+                   '-D__GNUC__=4','-D__GNUC_MINOR__=2','-D__GNUC_PATCHLEVEL__=1',
+                   '-D__MINGW32__=1', '-include', str(AUTOGEN/'AutoGen.h')]
+        for directory in includes:
+            command += ['-I',str(directory)]
+        command += ['-c',str(source),'-o',str(target)]
+        p = subprocess.run(command,capture_output=True,text=True,timeout=45)
+        record = {'source':name,'source_sha256':hashlib.sha256(source.read_bytes()).hexdigest(),
+                  'success':p.returncode==0,'stderr':p.stderr[:4000]}
+        checks.append(record)
+        if p.returncode:
+            print(name,p.stderr[:4000])
+            break
+        obj=target.read_bytes()
+        if obj[:2] != b'\x64\xaa':
+            raise SystemExit('Not AArch64 COFF: '+name)
+        record['aarch64_coff']=True
+        record['object_bytes']=len(obj)
+        record['object_sha256']=hashlib.sha256(obj).hexdigest()
+report={'success':len(checks)==len(sources) and all(x['success'] for x in checks),
+        'device_io':False,'link_test':False,'full_firmware_build':False,
+        'autogen_header_from_verified_boot04':True,
+        'entry_assembly_unchanged_from_verified_boot04':True,
+        'limitation':'Real production headers and COFF compile only; new library constructors and complete firmware link remain for the separate EDK build.',
+        'checks':checks}
+(WORK/'coff-check.json').write_text(json.dumps(report,indent=2)+'\n')
+print(json.dumps({'success':report['success'],'checks':len(checks),'output':str(WORK/'coff-check.json')}))
+raise SystemExit(0 if report['success'] else 1)
