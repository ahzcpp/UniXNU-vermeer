--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/DiagPolicy.c
@@ -0,0 +1,45 @@
+/** @file
+  Always-on action policy for the isolated USB diagnostics profile.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#include "Internal.h"
+STATIC UNIXNU_ENTRY mDiagnosticEntries[3];
+BOOLEAN
+DiagEntryAllowed (IN CONST UNIXNU_ENTRY *Entry)
+{
+  return (BOOLEAN)((Entry != NULL) && (Entry->Type == UniXNUEntryAction) &&
+    ((Entry->Action == UniXNUActionTools) || (Entry->Action == UniXNUActionReset) ||
+     (Entry->Action == UniXNUActionShutdown)));
+}
+VOID
+DiagRestrictConfig (IN OUT UNIXNU_CONFIG *Config)
+{
+  UniXNULog ("diag: replacing %u entries; disabling %u drivers, %u ACPI, %u DT patches, %u slices, %u kexts",
+    (UINT32)Config->EntryCount, (UINT32)Config->DriverCount, (UINT32)Config->AcpiCount,
+    (UINT32)Config->PatchCount, (UINT32)Config->SliceCount, (UINT32)Config->KextCount);
+  ZeroMem (mDiagnosticEntries, sizeof (mDiagnosticEntries));
+  mDiagnosticEntries[0].Id = "diag-tools";
+  mDiagnosticEntries[0].Title = L"Tools (USB diagnostics)";
+  mDiagnosticEntries[0].Action = UniXNUActionTools;
+  mDiagnosticEntries[1].Id = "diag-reset";
+  mDiagnosticEntries[1].Title = L"Restart";
+  mDiagnosticEntries[1].Action = UniXNUActionReset;
+  mDiagnosticEntries[2].Id = "diag-shutdown";
+  mDiagnosticEntries[2].Title = L"Power off";
+  mDiagnosticEntries[2].Action = UniXNUActionShutdown;
+  mDiagnosticEntries[0].Type = UniXNUEntryAction;
+  mDiagnosticEntries[1].Type = UniXNUEntryAction;
+  mDiagnosticEntries[2].Type = UniXNUEntryAction;
+  Config->Entries = mDiagnosticEntries;
+  Config->EntryCount = ARRAY_SIZE (mDiagnosticEntries);
+  Config->DefaultIndex = 0;
+  Config->Timeout = -1; Config->FallbackTimeout = 10; Config->RotateSeconds = 0;
+  Config->ConnectAll = FALSE;
+  Config->Drivers = NULL; Config->DriverCount = 0;
+  Config->Patches = NULL; Config->PatchCount = 0;
+  Config->AcpiTables = NULL; Config->AcpiCount = 0;
+  Config->Slices = NULL; Config->SliceCount = 0;
+  Config->Kexts = NULL; Config->KextCount = 0; Config->KextConfigError = FALSE;
+  /* UI settings remain usable. No entry-supplied args/confirmation/variables,
+     DTB, initrd or kext data reaches these fixed static actions. */
+}
