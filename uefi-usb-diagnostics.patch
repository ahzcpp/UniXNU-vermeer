+$script:K70DisappearAt = 0
+function Invoke-K70UefiProcess {
+    param([string]$Executable, [string[]]$Arguments, [string]$Directory,
+          [string]$Label, [int]$TimeoutMs = 5000, [int]$MaxStreamBytes = 1MB)
+    if ($Label -match 'usb-') {
+        $script:K70InventoryCount++
+        $out = Join-Path $Directory ($Label + '.stdout.txt')
+        $err = Join-Path $Directory ($Label + '.stderr.txt')
+        $json = if ($script:K70InventoryCount -eq $script:K70DisappearAt) { '[]' } else {
+            '[{"InstanceId":"USB\\VID_18D1&PID_D00D\\K70UEFI20261104","Status":"OK"}]'
+        }
+        [IO.File]::WriteAllText($out,$json); [IO.File]::WriteAllText($err,'')
+        return [pscustomobject]@{ executable='offline-PnP-mock'; arguments=@(); exit_code=0
+            timeout=$false; output_limit=$false; output_complete=$true; error=$null
+            stdout_path=$out; stderr_path=$err }
+    }
+    Assert-Mock ($Executable -ceq 'C:\Windows\System32\fastboot.exe') 'main fixes the fastboot executable'
+    Assert-K70UefiArguments $Arguments
+    return & $script:K70RealProcess -Executable $script:K70MockShell `
+        -Arguments (@('-NoProfile','-NonInteractive','-File',$script:K70MockWorker,'ok') + $Arguments) `
+        -Directory $Directory -Label $Label -TimeoutMs $TimeoutMs -MaxStreamBytes $MaxStreamBytes
+}
