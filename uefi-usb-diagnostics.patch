diff --git a/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Inject.c b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Inject.c
new file mode 100644
index 0000000..c322ef5
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Inject.c
@@ -0,0 +1,44 @@
+/** @file
+  Injection is disabled for the diagnostic profile.
+  Copyright (c) 2026, UniXNU contributors. All rights reserved.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#include "Internal.h"
+VOID UniXNUConnectAll (VOID) { }
+VOID UniXNUInjectDrivers (IN EFI_HANDLE ImageHandle, IN UNIXNU_CONFIG *Config, OUT UNIXNU_INJECT_STATS *Stats)
+{
+  (VOID)ImageHandle; Stats->DriversFailed += Config->DriverCount;
+  if (Config->DriverCount != 0) { UniXNULog ("diag: driver injection refused"); }
+}
+VOID UniXNUInjectAcpi (IN UNIXNU_CONFIG *Config, OUT UNIXNU_INJECT_STATS *Stats)
+{
+  Stats->AcpiFailed += Config->AcpiCount;
+  if (Config->AcpiCount != 0) { UniXNULog ("diag: ACPI injection refused"); }
+}
+CONST CHAR8 *UniXNUFirmwareCompatible (OUT UINTN *Length)
+{
+  if (Length != NULL) { *Length = 0; }
+  return NULL;
+}
+EFI_STATUS UniXNUApplyDtPatches (IN OUT VOID *Fdt, IN UNIXNU_DT_PATCH *Patches, IN UINTN Count)
+{
+  (VOID)Fdt; (VOID)Patches; (VOID)Count;
+  return EFI_ACCESS_DENIED;
+}
+EFI_STATUS UniXNUPrepareDeviceTree (IN UNIXNU_CONFIG *Config, IN UNIXNU_ENTRY *Entry, OUT VOID **Fdt OPTIONAL, OUT UINTN *FdtSize OPTIONAL)
+{
+  (VOID)Config; (VOID)Entry;
+  if (Fdt != NULL) { *Fdt = NULL; } if (FdtSize != NULL) { *FdtSize = 0; }
+  return EFI_ACCESS_DENIED;
+}
+EFI_STATUS UniXNUInstallInitrd (IN VOID *Data, IN UINTN Size, OUT EFI_HANDLE *Handle)
+{
+  (VOID)Data; (VOID)Size;
+  if (Handle != NULL) { *Handle = NULL; }
+  return EFI_ACCESS_DENIED;
+}
+VOID UniXNUUninstallInitrd (IN EFI_HANDLE Handle) { (VOID)Handle; }
+EFI_STATUS UniXNUSetEntryVariables (IN UNIXNU_ENTRY *Entry)
+{
+  (VOID)Entry; return EFI_ACCESS_DENIED;
+}
