index 0000000..57c4956
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Drivers/K70LogRingDxe/K70LogRingDxe.c
@@ -0,0 +1,117 @@
+/** @file
+  Allocate one log table inside MemoryMapLib's current "DXE Heap" descriptor.
+  No fixed physical address, disk write, protocol lookup, or DEBUG recursion.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#include <Uefi.h>
+#include <Guid/EventGroup.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/MemoryMapLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <K70LogRing.h>
+
+STATIC
+VOID
+EFIAPI
+K70LogRingExitBootServices (
+  IN EFI_EVENT Event,
+  IN VOID      *Context
+  )
+{
+  K70_LOG_RING *Ring;
+
+  (VOID)Event;
+  Ring = (K70_LOG_RING *)Context;
+  Ring->Active = 0U;
+  MemoryFence ();
+}
+
+EFI_STATUS
+EFIAPI
+K70LogRingDxeEntryPoint (
+  IN EFI_HANDLE       ImageHandle,
+  IN EFI_SYSTEM_TABLE *SystemTable
+  )
+{
+  EFI_MEMORY_REGION_DESCRIPTOR *Map;
+  EFI_MEMORY_REGION_DESCRIPTOR *Heap;
+  EFI_PHYSICAL_ADDRESS          Address;
+  EFI_PHYSICAL_ADDRESS          HeapEnd;
+  EFI_STATUS                    Status;
+  EFI_EVENT                     ExitEvent;
+  K70_LOG_RING                  *Ring;
+  UINT8                         Count;
+  UINTN                         Index;
+  CONST UINTN                   Pages = EFI_SIZE_TO_PAGES (K70_LOG_RING_ALLOCATION_BYTES);
+  STATIC CONST UINT8            Banner[] = "[K70LogRingDxe] shared DXE RAM log ready; boot services only\r\n";
+
+  (VOID)ImageHandle;
+  if ((SystemTable == NULL) || (gBS == NULL) ||
+      (SystemTable->NumberOfTableEntries > K70_LOG_RING_MAX_TABLES) ||
+      ((SystemTable->NumberOfTableEntries != 0U) && (SystemTable->ConfigurationTable == NULL))) {
+    return EFI_INVALID_PARAMETER;
+  }
+  for (Index = 0; Index < SystemTable->NumberOfTableEntries; Index++) {
+    if (CompareGuid (&SystemTable->ConfigurationTable[Index].VendorGuid, &gK70LogRingTableGuid)) {
+      return K70LogRingIsValid ((K70_LOG_RING *)SystemTable->ConfigurationTable[Index].VendorTable) ?
+             EFI_ALREADY_STARTED : EFI_COMPROMISED_DATA;
+    }
+  }
+
+  Map   = NULL;
+  Count = 0;
+  Heap  = NULL;
+  GetMemoryMap (&Map, &Count);
+  if ((Map == NULL) || (Count == 0U) || (Count > MAX_ARM_MEMORY_REGION_DESCRIPTOR_COUNT)) {
+    return EFI_NOT_FOUND;
+  }
+  for (Index = 0; Index < Count; Index++) {
+    if (AsciiStrnCmp (Map[Index].Name, "DXE Heap", sizeof ("DXE Heap")) == 0) {
+      if (Heap != NULL) {
+        return EFI_COMPROMISED_DATA;
+      }
+      Heap = &Map[Index];
+    }
+  }
+  if ((Heap == NULL) || (Heap->Length < K70_LOG_RING_ALLOCATION_BYTES) ||
+      (Heap->Address > MAX_UINT64 - (Heap->Length - 1U))) {
+    return EFI_NOT_FOUND;
+  }
+
+  HeapEnd = Heap->Address + Heap->Length - 1U;
+  Address = HeapEnd;
+  Status = gBS->AllocatePages (AllocateMaxAddress, EfiBootServicesData, Pages, &Address);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+  if ((Address < Heap->Address) || (Address > HeapEnd) ||
+      (HeapEnd - Address < K70_LOG_RING_ALLOCATION_BYTES - 1U) ||
+      (Address > MAX_UINTN - (K70_LOG_RING_ALLOCATION_BYTES - 1U))) {
+    gBS->FreePages (Address, Pages);
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  Ring = (K70_LOG_RING *)(UINTN)Address;
+  ZeroMem (Ring, K70_LOG_RING_ALLOCATION_BYTES);
+  Ring->Version     = K70_LOG_RING_VERSION;
+  Ring->HeaderBytes = K70_LOG_RING_HEADER_BYTES;
+  Ring->Capacity    = K70_LOG_RING_MAX_CAPACITY;
+  Ring->Active      = 1U;
+  MemoryFence ();
+  Ring->Signature   = K70_LOG_RING_SIGNATURE;
+  K70LogRingAppend (Ring, Banner, sizeof (Banner) - 1U);
+
+  Status = gBS->CreateEventEx (EVT_NOTIFY_SIGNAL, TPL_NOTIFY, K70LogRingExitBootServices,
+                             Ring, &gEfiEventExitBootServicesGuid, &ExitEvent);
+  if (EFI_ERROR (Status)) {
+    gBS->FreePages (Address, Pages);
+    return Status;
+  }
+  Status = gBS->InstallConfigurationTable (&gK70LogRingTableGuid, Ring);
+  if (EFI_ERROR (Status)) {
+    gBS->CloseEvent (ExitEvent);
+    gBS->FreePages (Address, Pages);
+  }
+  return Status;
+}
