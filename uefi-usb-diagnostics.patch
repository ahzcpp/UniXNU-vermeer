diff --git a/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Tests/AutoToolHost.c b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Tests/AutoToolHost.c
new file mode 100644
index 0000000..1cb0168
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Tests/AutoToolHost.c
@@ -0,0 +1,77 @@
+/* Run the actual one-shot app-level tool selection; no USB/firmware is opened.
+   SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "../Internal.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static EFI_BOOT_SERVICES Services;
+EFI_BOOT_SERVICES *gBS = &Services;
+EFI_GUID gUniXNUMenuPluginProtocolGuid;
+static UNIXNU_MENU_PLUGIN_PROTOCOL Target, Other;
+static EFI_GRAPHICS_OUTPUT_PROTOCOL Gop;
+static UINTN HandleCount = 2, RunCalls, OtherCalls, LocateCalls;
+static EFI_TPL CurrentTpl = TPL_APPLICATION;
+
+VOID EFIAPI FreePool(VOID *Buffer) { free(Buffer); }
+VOID EFIAPI UniXNULog(CONST CHAR8 *Format, ...) { (VOID)Format; }
+EFI_TPL EFIAPI EfiGetCurrentTpl(VOID) { return CurrentTpl; }
+INTN EFIAPI StrnCmp(CONST CHAR16 *A, CONST CHAR16 *B, UINTN Limit)
+{
+  while (Limit-- != 0) { if (*A != *B) return *A < *B ? -1 : 1; if (*A++ == 0) return 0; ++B; }
+  return 0;
+}
+VOID UniXNUUiDrawFrame(UNIXNU_UI *Ui, UNIXNU_CONFIG *Config) { (VOID)Ui; (VOID)Config; }
+VOID UniXNUUiDrawStatus(UNIXNU_UI *Ui, UINTN Line, CONST CHAR16 *Text) { (VOID)Ui; (VOID)Line; (VOID)Text; }
+static EFI_STATUS EFIAPI Run(UNIXNU_MENU_PLUGIN_PROTOCOL *This, EFI_GRAPHICS_OUTPUT_PROTOCOL *Graphics,
+                            CONST UNIXNU_PLUGIN_RECT *Rect, UNIXNU_MENU_PLUGIN_DRAW_STATUS Draw)
+{
+  if (This == &Other) { ++OtherCalls; return EFI_DEVICE_ERROR; }
+  ++RunCalls;
+  assert(CurrentTpl == TPL_APPLICATION && This == &Target && Graphics == &Gop);
+  assert(Rect->X == 0 && Rect->Y == 100 && Rect->Width == 1440 && Rect->Height == 200);
+  assert(Draw != NULL); Draw(This, 0, L"mock service ended");
+  return EFI_TIMEOUT;
+}
+static EFI_STATUS EFIAPI Locate(EFI_LOCATE_SEARCH_TYPE Type, EFI_GUID *Guid, VOID *Key, UINTN *Count, EFI_HANDLE **Handles)
+{
+  UINTN i; (VOID)Type; (VOID)Guid; (VOID)Key; ++LocateCalls;
+  if (HandleCount == 0) return EFI_NOT_FOUND;
+  *Count = HandleCount; *Handles = malloc(HandleCount * sizeof(**Handles)); assert(*Handles != NULL);
+  for (i = 0; i < HandleCount; ++i) (*Handles)[i] = i == 0 ? &Target : &Other;
+  return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI Protocol(EFI_HANDLE Handle, EFI_GUID *Guid, VOID **Interface)
+{ (VOID)Guid; *Interface = Handle; return EFI_SUCCESS; }
+
+int main(int argc, char **argv)
+{
+  UNIXNU_UI ui = {0}; UNIXNU_CONFIG config = {0}; EFI_STATUS expected, actual;
+  assert(argc == 2);
+  Target.Signature = UNIXNU_MENU_PLUGIN_PROTOCOL_SIGNATURE;
+  Target.Version = UNIXNU_MENU_PLUGIN_PROTOCOL_VERSION;
+  Target.Title = L"K70 USB diagnostics (read-only)"; Target.Run = Run;
+  Other = Target; Other.Title = L"Other tool";
+  Services.LocateHandleBuffer = Locate; Services.HandleProtocol = Protocol;
+  ui.Mode = UniXNUUiGraphics; ui.Gop = &Gop; ui.Width = 1440;
+  ui.ContentTop = 100; ui.ContentBottom = 300;
+  expected = EFI_TIMEOUT;
+  if (strcmp(argv[1], "missing") == 0) { HandleCount = 0; expected = EFI_NOT_FOUND; }
+  if (strcmp(argv[1], "duplicate") == 0) { Other.Title = Target.Title; expected = EFI_COMPROMISED_DATA; }
+  if (strcmp(argv[1], "wrong-title") == 0) { Target.Title = L"K70 USB diagnostics (read-only) extra"; expected = EFI_NOT_FOUND; }
+  if (strcmp(argv[1], "bad-version") == 0) { Target.Version++; expected = EFI_NOT_FOUND; }
+  if (strcmp(argv[1], "bad-signature") == 0) { Target.Signature++; expected = EFI_NOT_FOUND; }
+  if (strcmp(argv[1], "null-title") == 0) { Target.Title = NULL; expected = EFI_NOT_FOUND; }
+  if (strcmp(argv[1], "bad-tpl") == 0) { CurrentTpl = TPL_CALLBACK; expected = EFI_UNSUPPORTED; }
+  if (strcmp(argv[1], "no-gop") == 0) { ui.Gop = NULL; expected = EFI_UNSUPPORTED; }
+  if (strcmp(argv[1], "too-many") == 0) { HandleCount = 129; expected = EFI_OUT_OF_RESOURCES; }
+  actual = DiagAutoRunUsbTool(&ui,&config);
+  assert(actual == expected && OtherCalls == 0);
+  assert(RunCalls == (expected == EFI_TIMEOUT ? 1U : 0U));
+  if (expected == EFI_UNSUPPORTED) assert(LocateCalls == 0);
+  assert(DiagAutoRunUsbTool(&ui,&config) == EFI_ALREADY_STARTED);
+  assert(RunCalls <= 1 && OtherCalls == 0);
+  printf("Actual one-shot app tool selection: %s PASS\n",argv[1]);
+  return 0;
+}
diff --git a/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Tests/PolicyHost.c b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Tests/PolicyHost.c
new file mode 100644
index 0000000..0543b12
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Tests/PolicyHost.c
@@ -0,0 +1,104 @@
+/* Tests the actual restricted library sources; no firmware or USB is opened.
+   SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "../Internal.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static EFI_RUNTIME_SERVICES Runtime;
+static EFI_BOOT_SERVICES Services;
+static EFI_SYSTEM_TABLE System;
+EFI_RUNTIME_SERVICES *gRT = &Runtime;
+EFI_BOOT_SERVICES *gBS = &Services;
+EFI_SYSTEM_TABLE *gST = &System;
+EFI_GUID gEfiSimpleTextInProtocolGuid;
+EFI_GUID gEfiDevicePathProtocolGuid;
+static unsigned ResetCalls, WaitCalls, NondefaultHighlight;
+
+VOID *EFIAPI ZeroMem(VOID *Buffer, UINTN Bytes) { return memset(Buffer, 0, Bytes); }
+UINT64 EFIAPI MultU64x32(UINT64 Value, UINT32 Factor) { return Value * Factor; }
+VOID EFIAPI FreePool(VOID *Buffer) { free(Buffer); }
+VOID EFIAPI UniXNULog(CONST CHAR8 *Format, ...) { (VOID)Format; }
+UINTN EFIAPI UnicodeSPrint(CHAR16 *Buffer, UINTN Bytes, CONST CHAR16 *Format, ...)
+{ (VOID)Format; if (Bytes >= sizeof(*Buffer)) Buffer[0] = 0; return 0; }
+VOID UniXNUUiDrawFrame(UNIXNU_UI *Ui, UNIXNU_CONFIG *Config) { (VOID)Ui; (VOID)Config; }
+VOID UniXNUUiDrawStatus(UNIXNU_UI *Ui, UINTN Line, CONST CHAR16 *Text) { (VOID)Ui; (VOID)Line; (VOID)Text; }
+VOID UniXNUUiDrawEntry(UNIXNU_UI *Ui, UNIXNU_CONFIG *Config, UINTN Index, BOOLEAN Selected)
+{ (VOID)Ui; (VOID)Config; if (Selected && Index != 0) ++NondefaultHighlight; }
+static VOID EFIAPI Reset(EFI_RESET_TYPE Type, EFI_STATUS Status, UINTN Bytes, VOID *Data)
+{ (VOID)Type; (VOID)Status; (VOID)Bytes; (VOID)Data; ++ResetCalls; }
+static EFI_STATUS EFIAPI Create(UINT32 Type, EFI_TPL Tpl, EFI_EVENT_NOTIFY Fn, VOID *Context, EFI_EVENT *Event)
+{ (VOID)Type; (VOID)Tpl; (VOID)Fn; (VOID)Context; *Event = (VOID *)1; return EFI_SUCCESS; }
+static EFI_STATUS EFIAPI Timer(EFI_EVENT Event, EFI_TIMER_DELAY Delay, UINT64 Time)
+{ (VOID)Event; (VOID)Delay; (VOID)Time; return EFI_SUCCESS; }
+static EFI_STATUS EFIAPI Wait(UINTN Count, EFI_EVENT *Events, UINTN *Index)
+{
+  (VOID)Count; (VOID)Events;
+  ++WaitCalls; *Index = 0;
+  return WaitCalls <= 1000 ? EFI_SUCCESS : EFI_ABORTED;
+}
+static EFI_STATUS EFIAPI Close(EFI_EVENT Event) { (VOID)Event; return EFI_SUCCESS; }
+
+int main(void)
+{
+  UNIXNU_CONFIG config = {0};
+  UNIXNU_ENTRY entry = {0};
+  UNIXNU_UI ui = {0};
+  UNIXNU_INJECT_STATS stats = {0};
+  VOID *fdt = (VOID *)1; UINTN size = 99, count = 99;
+  EFI_HANDLE handle = (VOID *)1;
+  UNIXNU_LOADER_KEXT *kexts = (VOID *)1;
+  Runtime.ResetSystem = Reset;
+  Services.CreateEvent = Create; Services.SetTimer = Timer;
+  Services.WaitForEvent = Wait; Services.CloseEvent = Close;
+
+  /* Refused entries contain unusable paths/metadata: reaching a loader,
+     runtime variable write, or injection API would fail this host test. */
+  entry.Path = (VOID *)1; entry.Variables = (VOID *)1; entry.VariableCount = 1;
+  entry.Action = UniXNUActionTools;
+  entry.Type = UniXNUEntryEfi; assert(UniXNUBootEntry(NULL,&config,&entry) == EFI_ACCESS_DENIED);
+  entry.Type = UniXNUEntryLinux; assert(UniXNUBootEntry(NULL,&config,&entry) == EFI_ACCESS_DENIED);
+  entry.Type = UniXNUEntryXnu; assert(UniXNUBootEntry(NULL,&config,&entry) == EFI_ACCESS_DENIED);
+  entry.Type = (UNIXNU_ENTRY_TYPE)99; assert(UniXNUBootEntry(NULL,&config,&entry) == EFI_ACCESS_DENIED);
+  entry.Type = UniXNUEntryAction;
+  entry.Action = UniXNUActionExit; assert(UniXNUBootEntry(NULL,&config,&entry) == EFI_ACCESS_DENIED);
+  entry.Action = UniXNUActionNone; assert(UniXNUBootEntry(NULL,&config,&entry) == EFI_ACCESS_DENIED);
+  entry.Action = (UNIXNU_ACTION)99; assert(UniXNUBootEntry(NULL,&config,&entry) == EFI_ACCESS_DENIED);
+  assert(UniXNUBootEntry(NULL,&config,NULL) == EFI_ACCESS_DENIED);
+  entry.Action = UniXNUActionTools; assert(UniXNUBootEntry(NULL,&config,&entry) == EFI_SUCCESS);
+  assert(ResetCalls == 0);
+  entry.Action = UniXNUActionReset; assert(UniXNUBootEntry(NULL,&config,&entry) == EFI_DEVICE_ERROR);
+  entry.Action = UniXNUActionShutdown; assert(UniXNUBootEntry(NULL,&config,&entry) == EFI_DEVICE_ERROR);
+  assert(ResetCalls == 2); ResetCalls = 0;
+
+  config.DriverCount = 2; config.AcpiCount = 3; config.SliceCount = 4;
+  config.PatchCount = 5; config.KextCount = 6;
+  UniXNUConnectAll(); UniXNUInjectDrivers(NULL,&config,&stats); UniXNUInjectAcpi(&config,&stats);
+  UniXNUPublishSlices(&config);
+  assert(stats.DriversLoaded == 0 && stats.DriversFailed == 2 && stats.AcpiInstalled == 0 && stats.AcpiFailed == 3);
+  assert(UniXNUApplyDtPatches((VOID *)1,(VOID *)1,1) == EFI_ACCESS_DENIED);
+  assert(UniXNUPrepareDeviceTree(&config,&entry,&fdt,&size) == EFI_ACCESS_DENIED && fdt == NULL && size == 0);
+  assert(UniXNUInstallInitrd((VOID *)1,1,&handle) == EFI_ACCESS_DENIED && handle == NULL);
+  assert(UniXNUSetEntryVariables(&entry) == EFI_ACCESS_DENIED);
+  assert(UniXNUStageKexts(&config,&entry,&kexts,&count) == EFI_ACCESS_DENIED && kexts == NULL && count == 0);
+  assert(UniXNUFirmwareCompatible(&size) == NULL && size == 0);
+
+  config.Entries = &entry; config.EntryCount = 1; config.DefaultIndex = 99;
+  config.Timeout = 0; config.FallbackTimeout = 1; config.RotateSeconds = 1;
+  DiagRestrictConfig(&config);
+  assert(config.EntryCount == 3 && config.DefaultIndex == 0 && config.Entries[0].Action == UniXNUActionTools);
+  assert(config.DriverCount == 0 && config.AcpiCount == 0 && config.SliceCount == 0 && config.PatchCount == 0 && config.KextCount == 0);
+  assert(config.Entries[0].Path == NULL && config.Entries[1].Variables == NULL && config.Entries[2].KextCount == 0);
+
+  /* Force hostile timing settings after config filtering. Run the real menu
+     for 1000 virtual 100ms ticks with no input, then inject an event error.
+     Both normal and Tools-menu calls must keep waiting, with no rotation. */
+  config.Timeout = 0; config.FallbackTimeout = 1; config.RotateSeconds = 1;
+  assert(UniXNUMenuRun(&ui,&config,TRUE) == 0 && WaitCalls == 1001 && NondefaultHighlight == 0);
+  WaitCalls = 0;
+  assert(UniXNUMenuRun(&ui,&config,FALSE) == 0 && WaitCalls == 1001 && NondefaultHighlight == 0);
+  assert(ResetCalls == 0);
+  puts("DiagUniXNULib actual-source policy/injection/no-input menu tests PASS");
+  return 0;
+}
diff --git a/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Tests/run-host-tests.sh b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Tests/run-host-tests.sh
new file mode 100644
index 0000000..eaaec70
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Tests/run-host-tests.sh
@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+set -eu
+src=$(cd "$(dirname "$0")/.." && pwd)
+out=${1:-/tmp/k70-diag-menu-tests}
+mkdir -p "$out"
+base=${EDK2_ROOT:?Set EDK2_ROOT to the pinned edk2 or mu_basecore checkout}
+core=${UNIXNU_ROOT:?Set UNIXNU_ROOT to the pinned UniXNU checkout}
+clang-18 -std=c11 -fshort-wchar -ffunction-sections -fdata-sections -Wall -Wextra -Werror -Wno-unused-parameter -g -fsanitize=address,undefined -fno-omit-frame-pointer -I"$base/MdePkg/Include" -I"$base/MdePkg/Include/X64" -I"$core/package/UniXNUPkg/Include" "$src/Boot.c" "$src/DiagPolicy.c" "$src/Inject.c" "$src/Kext.c" "$src/Slice.c" "$src/Menu.c" "$src/Tests/PolicyHost.c" -Wl,--gc-sections -o "$out/policy-host"
+"$out/policy-host"
