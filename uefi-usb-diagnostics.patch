+}
+if ($Mode -eq 'flood') {
+    $block = [byte[]]::new(16384)
+    [Array]::Fill[byte]($block, 65)
+    $out = [Console]::OpenStandardOutput(); $err = [Console]::OpenStandardError()
+    for ($i = 0; $i -lt 1000; $i++) { $out.Write($block); $err.Write($block) }
+    exit 0
+}
+if ($Mode -eq 'fail') { [Console]::Error.WriteLine("FAILED (remote: 'firmware log ring not installed')"); exit 1 }
+if ($a.Count -eq 1 -and $a[0] -eq 'devices') {
+    [Console]::Out.WriteLine("K70UEFI20261104`tfastboot")
