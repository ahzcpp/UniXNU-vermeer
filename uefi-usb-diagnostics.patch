+Assert-Mock ((Get-K70UefiIdentity @($device)).InstanceId -ceq $device.InstanceId) 'exact VID/PID/serial should match'
+foreach ($id in @('USB\VID_18D1&PID_D00D\K70UEFI20261104X', 'USB\VID_18D1&PID_D00E\K70UEFI20261104',
