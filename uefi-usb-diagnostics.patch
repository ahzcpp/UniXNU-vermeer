diff --git a/package/uefi/K70DiagnosticsPkg/Drivers/K70LogRingDxe/Tests/HostTest.c b/package/uefi/K70DiagnosticsPkg/Drivers/K70LogRingDxe/Tests/HostTest.c
new file mode 100644
index 0000000..5149cce
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Drivers/K70LogRingDxe/Tests/HostTest.c
@@ -0,0 +1,175 @@
+/* Offline test of the actual header and driver, using the pinned EDK2 headers.
+ * SPDX-License-Identifier: BSD-2-Clause-Patent
+ */
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#undef NULL
+#include <K70LogRing.h>
+#include <Library/MemoryMapLib.h>
+#include <Library/FrameBufferHandoff.h>
+#include <Library/SerialPortLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+EFI_BOOT_SERVICES *gBS;
+EFI_SYSTEM_TABLE  *gST;
+EFI_GUID gK70LogRingTableGuid = { 0x51d830e8,0x1c82,0x4bf5,{0x91,0x83,0x24,0xf4,0xbc,0x58,0xf5,0xf9} };
+EFI_GUID gEfiEventExitBootServicesGuid = { 0x27abf055,0xb1b8,0x4c26,{0x80,0x48,0x74,0x8f,0x37,0xba,0xa2,0xdf} };
+
+static K70_LOG_RING *NestedRing;
+static unsigned Nested;
+static unsigned FreeCount;
+static unsigned CloseCount;
+static unsigned AllocationMode;
+static EFI_STATUS EventStatus;
+static EFI_STATUS InstallStatus;
+static EFI_EVENT_NOTIFY ExitCallback;
+static void *ExitContext;
+static EFI_MEMORY_REGION_DESCRIPTOR Map[2];
+static UINT8 MapCount;
+static _Alignas(4096) UINT8 Storage[K70_LOG_RING_ALLOCATION_BYTES];
+static EFI_CONFIGURATION_TABLE Tables[1];
+static _Alignas(8) UINT8 Screen[65536];
+static unsigned ScreenFlushes, InterruptDisables, InterruptEnables;
+static BOOLEAN InterruptsEnabled=TRUE;
+
+BOOLEAN EFIAPI ArmGetInterruptState (VOID) { return InterruptsEnabled; }
+UINTN EFIAPI ArmDisableInterrupts (VOID) { InterruptsEnabled=FALSE; InterruptDisables++; return 0; }
+VOID EFIAPI ArmEnableInterrupts (VOID) { InterruptsEnabled=TRUE; InterruptEnables++; }
+UINTN EFIAPI MicroSecondDelay (UINTN N) { return N; }
+VOID *EFIAPI WriteBackInvalidateDataCacheRange (VOID *P, UINTN N) {
+  assert (P == Screen && N == 64U*64U*4U); ScreenFlushes++; return P;
+}
+EFI_STATUS EFIAPI LocateMemoryRegionByName (CHAR8 *Name, EFI_MEMORY_REGION_DESCRIPTOR *D) {
+  assert (!strcmp(Name,"Display Reserved") || !strcmp(Name,"Display_Reserved"));
+  memset (D,0,sizeof *D); D->Address=(UINTN)Screen; D->Length=sizeof Screen; return EFI_SUCCESS;
+}
+
+VOID EFIAPI MemoryFence (VOID) { __atomic_thread_fence (__ATOMIC_SEQ_CST); }
+UINT32 EFIAPI InterlockedCompareExchange32 (volatile UINT32 *P, UINT32 C, UINT32 V) {
+  __atomic_compare_exchange_n (P, &C, V, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); return C;
+}
+UINT32 EFIAPI InterlockedIncrement (volatile UINT32 *P) { return __atomic_add_fetch (P, 1, __ATOMIC_SEQ_CST); }
+VOID *EFIAPI CopyMem (VOID *D, CONST VOID *S, UINTN N) {
+  if (Nested) { Nested = 0; assert (K70LogRingAppend (NestedRing, (CONST UINT8 *)"nested", 6) == 0); }
+  return memmove (D, S, (size_t)N);
+}
+VOID *EFIAPI ZeroMem (VOID *D, UINTN N) { return memset (D, 0, (size_t)N); }
+BOOLEAN EFIAPI CompareGuid (CONST GUID *A, CONST GUID *B) { return (BOOLEAN)(memcmp (A, B, sizeof (*A)) == 0); }
+INTN EFIAPI AsciiStrnCmp (CONST CHAR8 *A, CONST CHAR8 *B, UINTN N) { return strncmp (A, B, (size_t)N); }
+VOID GetMemoryMap (EFI_MEMORY_REGION_DESCRIPTOR **P, UINT8 *N) { *P = Map; *N = MapCount; }
+
+static EFI_STATUS EFIAPI Allocate (EFI_ALLOCATE_TYPE Type, EFI_MEMORY_TYPE Memory, UINTN Pages, EFI_PHYSICAL_ADDRESS *P) {
+  assert (Type == AllocateMaxAddress && Memory == EfiBootServicesData);
+  assert (Pages == EFI_SIZE_TO_PAGES (K70_LOG_RING_ALLOCATION_BYTES));
+  assert (*P == Map[0].Address + Map[0].Length - 1);
+  if (AllocationMode == 2) return EFI_OUT_OF_RESOURCES;
+  *P = AllocationMode == 1 ? Map[0].Address - EFI_PAGE_SIZE : (UINTN)Storage;
+  return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI Free (EFI_PHYSICAL_ADDRESS P, UINTN Pages) { (void)P; (void)Pages; FreeCount++; return EFI_SUCCESS; }
+static EFI_STATUS EFIAPI Create (UINT32 T, EFI_TPL Tpl, EFI_EVENT_NOTIFY F, CONST VOID *C, CONST EFI_GUID *G, EFI_EVENT *E) {
+  assert (T == EVT_NOTIFY_SIGNAL && Tpl == TPL_NOTIFY && CompareGuid (G, &gEfiEventExitBootServicesGuid));
+  ExitCallback=F; ExitContext=(void *)C; *E=(EFI_EVENT)1; return EventStatus;
+}
+static EFI_STATUS EFIAPI Close (EFI_EVENT E) { (void)E; CloseCount++; return EFI_SUCCESS; }
+static EFI_STATUS EFIAPI Install (EFI_GUID *G, VOID *T) {
+  assert (CompareGuid (G, &gK70LogRingTableGuid));
+  if (!EFI_ERROR (InstallStatus)) { Tables[0].VendorGuid=*G; Tables[0].VendorTable=T; gST->NumberOfTableEntries=1; }
+  return InstallStatus;
+}
+EFI_STATUS EFIAPI K70LogRingDxeEntryPoint (EFI_HANDLE, EFI_SYSTEM_TABLE *);
+EFI_STATUS EFIAPI DxeLogSerialPortLibConstructor (EFI_HANDLE, EFI_SYSTEM_TABLE *);
+
+static void Reset (void) {
+  static EFI_BOOT_SERVICES Bs;
+  static EFI_SYSTEM_TABLE St;
+  memset (&Bs,0,sizeof Bs); memset (&St,0,sizeof St); memset (Map,0,sizeof Map);
+  Bs.AllocatePages=Allocate; Bs.FreePages=Free; Bs.CreateEventEx=Create; Bs.CloseEvent=Close; Bs.InstallConfigurationTable=Install;
+  St.ConfigurationTable=Tables; gBS=&Bs; gST=&St;
+  memcpy (Map[0].Name,"DXE Heap",9); Map[0].Address=(UINTN)Storage; Map[0].Length=sizeof Storage; MapCount=1;
+  FreeCount=CloseCount=AllocationMode=Nested=0; EventStatus=InstallStatus=EFI_SUCCESS;
+  memset (Storage,0,sizeof Storage);
+}
+static void DriverTests (void) {
+  Reset (); assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_SUCCESS);
+  K70_LOG_RING *R=(K70_LOG_RING *)Storage;
+  assert (K70LogRingIsValid (R) && R->ValidBytes > 0 && R->Capacity == K70_LOG_RING_MAX_CAPACITY);
+  assert (Tables[0].VendorTable == R && R->Active);
+  assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_ALREADY_STARTED);
+  ExitCallback ((EFI_EVENT)1,ExitContext); assert (!R->Active);
+  assert (K70LogRingAppend (R,(CONST UINT8 *)"late",4) == 0);
+  Reset (); AllocationMode=1; assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_OUT_OF_RESOURCES && FreeCount == 1);
+  Reset (); AllocationMode=2; assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_OUT_OF_RESOURCES && FreeCount == 0);
+  Reset (); EventStatus=EFI_OUT_OF_RESOURCES; assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_OUT_OF_RESOURCES && FreeCount == 1);
+  Reset (); InstallStatus=EFI_OUT_OF_RESOURCES; assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_OUT_OF_RESOURCES && FreeCount == 1 && CloseCount == 1);
+  Reset (); memcpy (Map[1].Name,"DXE Heap",9); MapCount=2; assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_COMPROMISED_DATA);
+  Reset (); Map[0].Address=MAX_UINT64-1; Map[0].Length=K70_LOG_RING_ALLOCATION_BYTES; assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_NOT_FOUND);
+  Reset (); Map[0].Length=K70_LOG_RING_ALLOCATION_BYTES-1; assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_NOT_FOUND);
+  Reset (); Map[0].Name[0]='?'; assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_NOT_FOUND);
+}
+static void RingTests (void) {
+  Reset (); assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_SUCCESS);
+  K70_LOG_RING *R=(K70_LOG_RING *)Storage;
+  R->WriteOffset=R->ValidBytes=0; R->SuccessfulWrites=R->TotalInputBytes=0;
+  UINTN Cap=R->Capacity, N=0;
+  UINT8 *Input=malloc ((size_t)Cap*3), *Out=malloc ((size_t)Cap), *Ref=malloc ((size_t)Cap);
+  assert (Input && Out && Ref);
+  for (UINTN I=0; I<Cap*3; I++) Input[I]=(UINT8)(I*17U+I/251U);
+  UINTN Size=Cap; assert (K70LogRingCopySnapshot (R,NULL,&Size,NULL) == EFI_SUCCESS && Size == 0);
+  unsigned Seed=12345;
+  for (unsigned Step=0; Step<10000; Step++) {
+    Seed=Seed*1103515245U+12345U; UINTN Bytes=Seed % (Cap*3);
+    UINTN Keep=MIN(Bytes,Cap), Old=MIN(N,Cap-Keep);
+    memmove (Ref,Ref+N-Old,(size_t)Old); memcpy (Ref+Old,Input+Bytes-Keep,(size_t)Keep); N=Old+Keep;
+    assert (K70LogRingAppend (R,Input,Bytes) == Keep);
+    Size=Cap; assert (K70LogRingCopySnapshot (R,Out,&Size,NULL) == EFI_SUCCESS);
+    assert (Size == N && memcmp (Ref,Out,(size_t)N) == 0);
+  }
+  Size=0; assert (K70LogRingCopySnapshot (R,NULL,&Size,NULL) == EFI_BUFFER_TOO_SMALL && Size == N);
+  Size=Cap; assert (K70LogRingCopySnapshot (R,(UINT8 *)(UINTN)(MAX_UINTN-1),&Size,NULL) == EFI_INVALID_PARAMETER && R->Busy == 0);
+  UINT32 Drops=R->ReentryDropCalls; R->Busy=1;
+  assert (K70LogRingAppend (R,Input,5) == 0 && R->ReentryDropCalls == Drops+1);
+  Size=Cap; assert (K70LogRingCopySnapshot (R,Out,&Size,NULL) == EFI_NOT_READY); R->Busy=0;
+  NestedRing=R; Nested=1; assert (K70LogRingAppend (R,Input,5) == 5 && R->ReentryDropCalls == Drops+2 && R->Busy == 0);
+  R->TotalInputBytes=MAX_UINT64-1; assert (K70LogRingAppend (R,Input,5) == 5 && R->TotalInputBytes == MAX_UINT64);
+  assert (K70LogRingAppend (R,(UINT8 *)(UINTN)(MAX_UINTN-1),4) == 0);
+  assert (K70LogRingAppend (R,NULL,5) == 0);
+  R->Capacity=0; assert (!K70LogRingIsValid(R));
+  free (Input); free (Out); free (Ref);
+}
+static void WrapperTests (void) {
+  Reset (); memset (Screen,0,sizeof Screen);
+  FB_HANDOFF *F=(FB_HANDOFF *)(Screen+sizeof Screen-FB_HANDOFF_OFFSET);
+  F->Base=(UINTN)Screen; F->Width=F->Height=64; F->PitchBytes=256; F->Magic=FB_HANDOFF_MAGIC;
+  ScreenFlushes=InterruptDisables=InterruptEnables=0; InterruptsEnabled=TRUE;
+  assert (SerialPortInitialize () == EFI_SUCCESS);
+  // First call precedes installation, but must still render and not cache absence.
+  assert (SerialPortWrite ((UINT8 *)"A",1) == 1 && ScreenFlushes == 1);
+  assert (K70LogRingDxeEntryPoint (NULL,gST) == EFI_SUCCESS);
+  K70_LOG_RING *R=(K70_LOG_RING *)Storage;
+  UINT32 Before=R->ValidBytes;
+  // Even with a table installed, a not-yet-constructed instance is screen-only.
+  assert (SerialPortWrite ((UINT8 *)"B",1) == 1 && ScreenFlushes == 2);
+  assert (R->ValidBytes == Before);
+  assert (DxeLogSerialPortLibConstructor (NULL,gST) == EFI_SUCCESS);
+  assert (SerialPortWrite ((UINT8 *)"C",1) == 1 && ScreenFlushes == 3);
+  UINT8 Out[K70_LOG_RING_MAX_CAPACITY]; UINTN Size=sizeof Out;
+  assert (K70LogRingCopySnapshot (R,Out,&Size,NULL) == EFI_SUCCESS && Size > 0 && Out[Size-1]=='C');
+  assert (InterruptDisables == 3 && InterruptEnables == 3 && InterruptsEnabled);
+  unsigned Nonzero=0; for (unsigned I=0; I<64U*64U*4U; I++) Nonzero += Screen[I] != 0;
+  assert (Nonzero > 0); // Actual original glyph renderer wrote pixel bytes.
+  R->Busy=1; UINT32 Drops=R->ReentryDropCalls;
+  assert (SerialPortWrite ((UINT8 *)"D",1) == 1 && ScreenFlushes == 4 && R->ReentryDropCalls == Drops+1);
+  R->Busy=0;
+  assert (SerialPortPoll () == FALSE && SerialPortRead (Out,1) == 0);
+  assert (DxeLogSerialPortLibConstructor (NULL,NULL) == EFI_INVALID_PARAMETER);
+  Before=R->ValidBytes;
+  assert (SerialPortWrite ((UINT8 *)"E",1) == 1 && ScreenFlushes == 5 && R->ValidBytes == Before);
+}
+int main (void) {
+  DriverTests (); RingTests (); WrapperTests ();
+  puts ("PASS: driver allocation/lifecycle failures; 10000 reference ring writes; wrap/truncate/snapshot/reentry/overflow; actual framebuffer wrapper before/after shared-table install and busy drop");
+  return 0;
+}
diff --git a/package/uefi/K70DiagnosticsPkg/Drivers/K70LogRingDxe/Tests/run-host-tests.py b/package/uefi/K70DiagnosticsPkg/Drivers/K70LogRingDxe/Tests/run-host-tests.py
