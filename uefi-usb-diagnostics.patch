diff --git a/package/uefi/K70DiagnosticsPkg/Include/K70LogRing.h b/package/uefi/K70DiagnosticsPkg/Include/K70LogRing.h
new file mode 100644
index 0000000..7b59b2f
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Include/K70LogRing.h
@@ -0,0 +1,223 @@
+/** @file
+  A single RAM log shared through the EFI configuration table, ABI version 1.
+
+  The table and its bytes are EfiBootServicesData, not persistent storage. They
+  must not be accessed after ExitBootServices. No SEC/PEI or XNU log coverage is
+  implied. Each image may cache a pointer; it must never allocate its own ring.
+
+  The one-attempt lock deliberately drops nested/contended writes, including an
+  exception during a snapshot, rather than waiting for the interrupted writer.
+  Append and snapshot do not allocate, discover protocols, or emit DEBUG output.
+  Default atomic primitives use SynchronizationLib. A serial implementation can
+  supply the two K70_LOG_RING_* hooks before inclusion to avoid a DebugLib
+  dependency cycle; their acquire/increment semantics must remain atomic.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#ifndef K70_LOG_RING_H_
+#define K70_LOG_RING_H_
+
+#include <Uefi.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+
+#ifndef K70_LOG_RING_TRY_LOCK
+#include <Library/SynchronizationLib.h>
+#define K70_LOG_RING_TRY_LOCK(Field) (InterlockedCompareExchange32 ((Field), 0U, 1U) == 0U)
+#endif
+#ifndef K70_LOG_RING_COUNT_DROP
+#include <Library/SynchronizationLib.h>
+#define K70_LOG_RING_COUNT_DROP(Field) ((VOID)InterlockedIncrement (Field))
+#endif
+
+#define K70_LOG_RING_SIGNATURE         SIGNATURE_64 ('K', '7', '0', 'L', 'O', 'G', '0', '1')
+#define K70_LOG_RING_VERSION           1U
+#define K70_LOG_RING_ALLOCATION_BYTES  (64U * 1024U)
+#define K70_LOG_RING_MAX_TABLES        4096U
+
+extern EFI_GUID gK70LogRingTableGuid;
+
+typedef struct {
+  UINT64           Signature;
+  UINT32           Version;
+  UINT32           HeaderBytes;
+  UINT32           Capacity;
+  volatile UINT32  Busy;
+  UINT32           WriteOffset;       // Next byte to replace, always < Capacity.
+  UINT32           ValidBytes;        // Number of initialized bytes, <= Capacity.
+  volatile UINT32  ReentryDropCalls;  // Atomic count, modulo 2^32; byte count unknown.
+  volatile UINT32  Active;            // Cleared by the ExitBootServices callback.
+  UINT64           TotalInputBytes;   // Successful-lock input bytes, saturating.
+  UINT64           OverwrittenBytes;  // Previously retained bytes replaced, saturating.
+  UINT64           TruncatedBytes;    // Input prefix omitted for writes > Capacity.
+  UINT64           SuccessfulWrites;
+  UINT64           SnapshotCount;
+  UINT8            Data[1];
+} K70_LOG_RING;
+
+#define K70_LOG_RING_HEADER_BYTES  ((UINT32)OFFSET_OF (K70_LOG_RING, Data))
+#define K70_LOG_RING_MAX_CAPACITY  (K70_LOG_RING_ALLOCATION_BYTES - K70_LOG_RING_HEADER_BYTES)
+
+typedef struct {
+  UINT32  Version;
+  UINT32  Capacity;
+  UINT32  ValidBytes;
+  UINT32  ReentryDropCalls;
+  UINT64  TotalInputBytes;
+  UINT64  OverwrittenBytes;
+  UINT64  TruncatedBytes;
+  UINT64  SuccessfulWrites;
+  UINT64  SnapshotCount;
+} K70_LOG_SNAPSHOT_METADATA;
+
+STATIC inline
+UINT64
+K70LogRingSaturatingAdd (
+  IN UINT64 Value,
+  IN UINT64 Increment
+  )
+{
+  return (Increment > MAX_UINT64 - Value) ? MAX_UINT64 : Value + Increment;
+}
+
+STATIC inline
+BOOLEAN
+K70LogRingIsValid (
+  IN CONST K70_LOG_RING *Ring
+  )
+{
+  return (BOOLEAN)(
+    (Ring != NULL) &&
+    (((UINTN)Ring & (sizeof (UINT64) - 1U)) == 0U) &&
+    (Ring->Signature == K70_LOG_RING_SIGNATURE) &&
+    (Ring->Version == K70_LOG_RING_VERSION) &&
+    (Ring->HeaderBytes == K70_LOG_RING_HEADER_BYTES) &&
+    (Ring->Capacity != 0U) &&
+    (Ring->Capacity <= K70_LOG_RING_MAX_CAPACITY) &&
+    (Ring->WriteOffset < Ring->Capacity) &&
+    (Ring->ValidBytes <= Ring->Capacity)
+    );
+}
+
+/** Return the retained byte count, zero if unavailable or another call owns it.
+    For input larger than the ring only the newest Capacity bytes are copied.
+    At most Capacity bytes and two CopyMem calls are executed per append. */
+STATIC inline
+UINTN
+K70LogRingAppend (
+  IN OUT K70_LOG_RING *Ring,
+  IN CONST UINT8     *Buffer,
+  IN UINTN           NumberOfBytes
+  )
+{
+  UINTN  Retained;
+  UINTN  Prefix;
+  UINTN  First;
+  UINTN  Replaced;
+
+  if (!K70LogRingIsValid (Ring) || (Ring->Active == 0U) ||
+      (Buffer == NULL) || (NumberOfBytes == 0U) ||
+      ((UINTN)Buffer > MAX_UINTN - (NumberOfBytes - 1U))) {
+    return 0;
+  }
+
+  if (!K70_LOG_RING_TRY_LOCK (&Ring->Busy)) {
+    K70_LOG_RING_COUNT_DROP (&Ring->ReentryDropCalls);
+    return 0;
+  }
+
+  MemoryFence ();
+  if (Ring->Active == 0U) {
+    MemoryFence ();
+    Ring->Busy = 0U;
+    return 0;
+  }
+
+  Retained = (NumberOfBytes > Ring->Capacity) ? Ring->Capacity : NumberOfBytes;
+  Prefix   = NumberOfBytes - Retained;
+  Buffer  += Prefix;
+  First    = MIN (Retained, Ring->Capacity - Ring->WriteOffset);
+  CopyMem (&Ring->Data[Ring->WriteOffset], Buffer, First);
+  if (Retained > First) {
+    CopyMem (Ring->Data, Buffer + First, Retained - First);
+  }
+
+  Replaced = (Ring->ValidBytes + Retained > Ring->Capacity) ?
+             Ring->ValidBytes + Retained - Ring->Capacity : 0U;
+  Ring->WriteOffset       = (UINT32)((Ring->WriteOffset + Retained) % Ring->Capacity);
+  Ring->ValidBytes        = (UINT32)MIN (Ring->Capacity, Ring->ValidBytes + Retained);
+  Ring->TotalInputBytes   = K70LogRingSaturatingAdd (Ring->TotalInputBytes, NumberOfBytes);
+  Ring->OverwrittenBytes  = K70LogRingSaturatingAdd (Ring->OverwrittenBytes, Replaced);
+  Ring->TruncatedBytes    = K70LogRingSaturatingAdd (Ring->TruncatedBytes, Prefix);
+  Ring->SuccessfulWrites = K70LogRingSaturatingAdd (Ring->SuccessfulWrites, 1U);
+  MemoryFence ();
+  Ring->Busy = 0U;
+  return Retained;
+}
+
+/** Copy a consistent snapshot, oldest byte first, with no terminator appended.
+    BufferBytes is an input capacity and output actual/required byte count.
+    EFI_BUFFER_TOO_SMALL includes a size query with a NULL Buffer. Allocate a
+    Capacity-sized buffer before calling, outside exception/serial paths.
+    EFI_NOT_READY means inactive or busy; retry later from the USB event loop,
+    never by spinning in an exception handler. Metadata is optional. */
+STATIC inline
+EFI_STATUS
+K70LogRingCopySnapshot (
+  IN OUT K70_LOG_RING          *Ring,
+  OUT UINT8                   *Buffer OPTIONAL,
+  IN OUT UINTN                *BufferBytes,
+  OUT K70_LOG_SNAPSHOT_METADATA *Metadata OPTIONAL
+  )
+{
+  EFI_STATUS  Status;
+  UINTN       Required;
+  UINTN       Start;
+  UINTN       First;
+
+  if ((BufferBytes == NULL) || !K70LogRingIsValid (Ring)) {
+    return EFI_INVALID_PARAMETER;
+  }
+  if ((Ring->Active == 0U) ||
+      !K70_LOG_RING_TRY_LOCK (&Ring->Busy)) {
+    return EFI_NOT_READY;
+  }
+  MemoryFence ();
+  Required = Ring->ValidBytes;
+  if (Ring->Active == 0U) {
+    Status = EFI_NOT_READY;
+  } else if ((*BufferBytes < Required) || ((Buffer == NULL) && (Required != 0U))) {
+    *BufferBytes = Required;
+    Status = EFI_BUFFER_TOO_SMALL;
+  } else if ((Required != 0U) && ((UINTN)Buffer > MAX_UINTN - (Required - 1U))) {
+    Status = EFI_INVALID_PARAMETER;
+  } else {
+    Start = (Ring->WriteOffset + Ring->Capacity - Required) % Ring->Capacity;
+    First = MIN (Required, Ring->Capacity - Start);
+    if (First != 0U) {
+      CopyMem (Buffer, &Ring->Data[Start], First);
+    }
+    if (Required > First) {
+      CopyMem (Buffer + First, Ring->Data, Required - First);
+    }
+    *BufferBytes = Required;
+    Ring->SnapshotCount = K70LogRingSaturatingAdd (Ring->SnapshotCount, 1U);
+    Status = EFI_SUCCESS;
+  }
+  if (Metadata != NULL) {
+    Metadata->Version          = Ring->Version;
+    Metadata->Capacity         = Ring->Capacity;
+    Metadata->ValidBytes       = Ring->ValidBytes;
+    Metadata->ReentryDropCalls = Ring->ReentryDropCalls;
+    Metadata->TotalInputBytes  = Ring->TotalInputBytes;
+    Metadata->OverwrittenBytes = Ring->OverwrittenBytes;
+    Metadata->TruncatedBytes   = Ring->TruncatedBytes;
+    Metadata->SuccessfulWrites = Ring->SuccessfulWrites;
+    Metadata->SnapshotCount    = Ring->SnapshotCount;
+  }
+  MemoryFence ();
+  Ring->Busy = 0U;
+  return Status;
+}
+
+#endif
