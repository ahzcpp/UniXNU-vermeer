+#!/usr/bin/env python3
+"""Offline scanner/FV-list tests: actual EDK2 headers and bundled libfdt.
+SPDX-License-Identifier: BSD-2-Clause-Patent
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+parser=argparse.ArgumentParser()
+parser.add_argument("--uefi",type=Path,required=True)
+parser.add_argument("--result",type=Path,required=True)
+args=parser.parse_args()
+uefi=args.uefi.resolve()
+directory=Path(__file__).resolve().parent
+source=directory.parent
+lib=uefi/"Mu_Basecore/MdePkg/Library/BaseFdtLib/libfdt/libfdt"
+includes=[uefi/"Mu_Basecore/MdePkg/Include",uefi/"Mu_Basecore/ArmPkg/Include",
+          uefi/"Silicon/Qualcomm/QcomPkg/Include",uefi/"Silicon/Silicium/SiliciumPkg/Include"]
+steps=[]
+def run(name,command):
+    p=subprocess.run(command,capture_output=True,text=True)
+    clean=lambda s:s.replace(str(uefi),"<UEFI>").replace(str(source),"<K70PlatformPeiLib>")
+    steps.append({"name":name,"exit":p.returncode,"stdout":clean(p.stdout),"stderr":clean(p.stderr)})
+    print(name,p.returncode,p.stdout,p.stderr,flush=True)
+    if p.returncode: raise RuntimeError(name+" failed")
+try:
+    common=["clang","-std=gnu11","-fshort-wchar","-O1","-g","-fsanitize=address,undefined","-DMDEPKG_NDEBUG",
+            "-Wall","-Wextra","-Werror","-Wno-unused-parameter","-Wno-pointer-sign"]
+    host=common+["-I"+str(p) for p in includes]+["-I"+str(uefi/"Mu_Basecore/MdePkg/Include/X64")]
+    with tempfile.TemporaryDirectory(prefix="k70-pei-test-") as temporary:
+        scanner=Path(temporary)/"scanner"
+        run("scanner-compile-asan-ubsan",host+["-I"+str(lib),str(directory/"ScannerTest.c"),str(lib/"fdt.c"),str(lib/"fdt_ro.c"),"-o",str(scanner)])
+        run("scanner-real-libfdt",[str(scanner)])
+        fvlist=Path(temporary)/"fvlist"
+        run("fvlist-compile-asan-ubsan",host+["-ffunction-sections","-fdata-sections","-Wl,--gc-sections",str(directory/"FvListTest.c"),"-o",str(fvlist)])
+        run("fvlist-real-function-mock-locks",[str(fvlist)])
+        flags=["clang","-target","aarch64-pc-windows-msvc","-std=gnu11","-fshort-wchar","-ffreestanding","-fsyntax-only",
+               "-Wall","-Wextra","-Werror","-Wno-unused-parameter","-Wno-pointer-sign"]+["-I"+str(p) for p in includes]
+        flags += ["-I"+str(uefi/"Mu_Basecore/MdePkg/Include/AArch64")]
+        pcds={"PcdFdBaseAddress":"0xA7100000ULL","PcdFdSize":"0x400000U","PcdFvBaseAddress":"0xA7100000ULL","PcdFvSize":"0x400000U","PcdBuildXblHobs":"1"}
+        flags += ["-D_PCD_VALUE_"+key+"="+value for key,value in pcds.items()]
+        for name in ["XblProtocols.c","PlatformPei.c"]:
+            run("aarch64-coff-syntax-"+name,flags+[str(source/name)])
+finally:
+    hashes={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in [source/"XblProtocols.c",source/"PlatformPei.c",source/"DtbTemplate.h",source/"SchedulerTemplate.h",source/"PlatformPeiLib.inf"]}
+    args.result.write_text(json.dumps({"hardware_tested":False,"oem_code_executed":False,
+       "fvlist_validator_mocked_only_in_separate_fvlist_test":True,"source_sha256":hashes,"steps":steps},indent=2)+"\n")
