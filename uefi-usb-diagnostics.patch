+/** @file
+  Consume the original Qualcomm USB ABI with current MdePkg USB headers.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#ifndef K70_QCOM_USB_COMPAT_H_
+#define K70_QCOM_USB_COMPAT_H_
+
+#include <IndustryStandard/Usb.h>
+#include <Protocol/UsbIo.h>
+
+/* The 2018 Qcom extension repeats these modern MdePkg identifiers.
+   Rename only those source identifiers; the supplied protocol's types,
+   sizes, fields, calling convention, and binary ABI remain unchanged. */
+#define USB_BOS_DESCRIPTOR K70_QCOM_USB_BOS_DESCRIPTOR
+#define EFI_USB_BOS_DESCRIPTOR K70_QCOM_EFI_USB_BOS_DESCRIPTOR
+#define USB_INTERFACE_ASSOCIATION_DESCRIPTOR K70_QCOM_USB_INTERFACE_ASSOCIATION_DESCRIPTOR
+#define USB_DESC_TYPE_INTERFACE_ASSOCIATION K70_QCOM_USB_DESC_TYPE_INTERFACE_ASSOCIATION
+#define USB_DESC_TYPE_BOS K70_QCOM_USB_DESC_TYPE_BOS
+#include <Protocol/EFIUsbDevice.h>
+#include <Protocol/EFIUsbfnIo.h>
+#undef USB_BOS_DESCRIPTOR
+#undef EFI_USB_BOS_DESCRIPTOR
+#undef USB_INTERFACE_ASSOCIATION_DESCRIPTOR
+#undef USB_DESC_TYPE_INTERFACE_ASSOCIATION
+#undef USB_DESC_TYPE_BOS
+
+/* QcomPkg.dec provides this event-group GUID without a declaring header. */
+extern EFI_GUID gUsbControllerInitGuid;
+
+#endif
diff --git a/package/uefi/K70DiagnosticsPkg/Drivers/K70UsbDiagDxe/README.md b/package/uefi/K70DiagnosticsPkg/Drivers/K70UsbDiagDxe/README.md
