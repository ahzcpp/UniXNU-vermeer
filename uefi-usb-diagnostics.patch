@@ -0,0 +1,217 @@
+#!/usr/bin/env python3
+"""Portable bounded FV/FFS parser. Firmware is parsed as data, never executed.
+
+Copied imports/constants/functions/Audit from the reviewed local extractor
+SHA256 2d2183b7937fd300a31907c15035dcde089be9036f4a96d3700f86d8b490dab4.
+Its host-manifest CLI/main is intentionally excluded. prepare-oem.py overrides
+Audit.emit to keep payloads in memory and controls every output destination.
+SPDX-License-Identifier: BSD-2-Clause-Patent
+"""
+import argparse
+
+import csv
+
+import gzip
+
+import hashlib
+
+import json
+
+import lzma
+
+import re
+
+import struct
+
+import sys
+
+import uuid
+
+import zipfile
+
+from pathlib import Path
+
+IMAGEFV_SHA = "50367d472a97a4ffa68b8ae1290dca81cd2b4c89dab0dbc5009f1a9581788b41"
+
+GZIP_GUID = "1d301fe9-be79-4353-91c2-d23bc959ae0c"
+
+LZMA_GUID = "ee4e5898-3914-4259-9d6e-dc7bd79403cf"
+
+FFS_NAMES = {1:"RAW",2:"FREEFORM",3:"SECURITY_CORE",4:"PEI_CORE",5:"DXE_CORE",6:"PEIM",7:"DRIVER",8:"COMBINED_PEIM_DRIVER",9:"APPLICATION",10:"SMM",11:"FV_IMAGE",12:"COMBINED_SMM_DXE",13:"SMM_CORE",0xf0:"PAD"}
+
+SEC_NAMES = {1:"COMPRESSION",2:"GUID_DEFINED",0x10:"PE32",0x11:"PIC",0x12:"TE",0x13:"DXE_DEPEX",0x14:"VERSION",0x15:"UI",0x16:"COMPAT16",0x17:"FV_IMAGE",0x18:"FREEFORM_SUBTYPE_GUID",0x19:"RAW",0x1b:"PEI_DEPEX",0x1c:"SMM_DEPEX"}
+
+FFS_GUIDS = {"7a9354d9-0468-444a-81ce-0bf617d890df", "8c8ce578-8a3d-4f1c-9935-896185c32dd3", "5473c07a-3dcb-4dca-bd6f-1e9689e7349a", "631008b0-b2d1-410a-8b49-2c5c4d8ecc7e"}
+
+def sha(data): return hashlib.sha256(data).hexdigest()
+
+def guid(data): return str(uuid.UUID(bytes_le=bytes(data)))
+
+def u24(data): return int.from_bytes(data, "little")
+
+def align(n, a): return (n+a-1)&~(a-1)
+
+def padding(data): return not data or all(x == 0xff for x in data) or all(x == 0 for x in data)
+
+def depex(data):
+    """Decode PI dependency bytecode, preserving all operands (no label guesses)."""
+    result, pos, stack = [], 0, 0
+    pushes = []
+    while pos < len(data):
+        op = data[pos]; pos += 1
+        if op in (0,1,2):
+            if pos+16 > len(data): raise ValueError("truncated DEPEX GUID")
+            value = guid(data[pos:pos+16]); pos += 16
+            result.append({"op":{0:"BEFORE",1:"AFTER",2:"PUSH"}[op], "guid":value})
+            pushes.append(value)
+            if op == 2: stack += 1
+        elif op in (3,4):
+            if stack < 2: raise ValueError("DEPEX binary stack underflow")
+            stack -= 1; result.append({"op":{3:"AND",4:"OR"}[op]})
+        elif op == 5:
+            if stack < 1: raise ValueError("DEPEX NOT stack underflow")
+            result.append({"op":"NOT"})
+        elif op in (6,7):
+            stack += 1; result.append({"op":{6:"TRUE",7:"FALSE"}[op]})
