+/** @file
+  Kext staging is disabled for the diagnostic profile.
+  Copyright (c) 2026, UniXNU contributors. All rights reserved.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#include "Internal.h"
+EFI_STATUS UniXNUStageKexts (IN UNIXNU_CONFIG *Config, IN UNIXNU_ENTRY *Entry, OUT UNIXNU_LOADER_KEXT **Kexts, OUT UINTN *Count)
+{
+  (VOID)Config; (VOID)Entry;
+  if (Kexts != NULL) { *Kexts = NULL; } if (Count != NULL) { *Count = 0; }
+  return EFI_ACCESS_DENIED;
+}
+VOID UniXNUFreeKexts (IN UNIXNU_LOADER_KEXT *Kexts OPTIONAL, IN UINTN Count) { (VOID)Kexts; (VOID)Count; }
