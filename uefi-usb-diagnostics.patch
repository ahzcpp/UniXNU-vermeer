+Assert-Mock (([IO.FileInfo]$flood.stdout_path).Length -le 1MB -and ([IO.FileInfo]$flood.stderr_path).Length -le 1MB) 'raw byte caps apply to both files'
+Assert-Mock ($flood.elapsed_ms -lt 8000) 'overflow cleanup remains bounded'
+$inherited = Invoke-Mock 'inherited-pipe' @('devices') 'hold-pipe'
+Assert-Mock (-not (Test-K70UefiProcessSuccess $inherited)) 'inherited open pipe cannot be accepted as complete output'
+Assert-Mock ($inherited.elapsed_ms -lt 4500) 'a descendant holding inherited pipes cannot force an unbounded wait'
