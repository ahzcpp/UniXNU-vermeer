+/* Tests actual CreateFvList byte offsets and cleanup with a mocked validator.
+ * This does not bypass validation in production. SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#undef NULL
+#include <Uefi.h>
+#include <Protocol/EFIKernelInterface.h>
+static unsigned Created,Destroyed,Allocations,Frees,ValidationCalls;
+static int FailAt=-1,NullAt=-1,AllocFail,ValidationFail;
+static UINT8 *Raw,*List;
+EFI_STATUS ShimInstallLib(CHAR8 *N,UINT32 V,VOID *P){(void)N;(void)V;(void)P;abort();}
+EFI_STATUS ShimLoadLib(CHAR8 *N,UINT32 V,VOID **P){(void)N;(void)V;(void)P;abort();}
+EFI_STATUS K70ValidateScheduler(EFI_PHYSICAL_ADDRESS A){ValidationCalls++;assert(A);return ValidationFail?EFI_SECURITY_VIOLATION:EFI_SUCCESS;}
+VOID *EFIAPI AllocateZeroPool(UINTN N){
+ assert(N==592);Allocations++;if(AllocFail)return NULL;
+ Raw=malloc((size_t)N+128);assert(Raw);memset(Raw,0xa5,(size_t)N+128);List=Raw+64;memset(List,0,(size_t)N);return List;
+}
+VOID EFIAPI FreePool(VOID *P){
+ assert(P==List);for(unsigned I=0;I<64;I++)assert(Raw[I]==0xa5&&Raw[656+I]==0xa5);free(Raw);Raw=NULL;List=NULL;Frees++;
+}
+VOID *EFIAPI CopyMem(VOID *D,CONST VOID *S,UINTN N){return memmove(D,S,(size_t)N);}
+UINTN EFIAPI AsciiSPrint(CHAR8 *B,UINTN N,CONST CHAR8 *F,...){
+ (void)F;int C=snprintf(B,(size_t)N,"FVLCK%u",Created);return(UINTN)C;
+}
+static EFI_STATUS Init(CONST CHAR8 *Name,LockHandle **H){
+ char Expected[16];snprintf(Expected,sizeof Expected,"FVLCK%u",Created);assert(!strcmp(Name,Expected));
+ if((int)Created==FailAt)return EFI_DEVICE_ERROR;
+ if((int)Created==NullAt){*H=NULL;return EFI_SUCCESS;}
+ *H=(LockHandle *)(UINTN)(Created+1U);Created++;return EFI_SUCCESS;
+}
+static VOID Destroy(LockHandle *H){assert((UINTN)H==Destroyed+1U);Destroyed++;}
+#define _PCD_VALUE_PcdFvBaseAddress 0xA7100000ULL
+#define _PCD_VALUE_PcdFvSize 0x400000U
+#define _PCD_VALUE_PcdBuildXblHobs 1
+#include "../PlatformPei.c"
+static void Reset(void){Created=Destroyed=Allocations=Frees=ValidationCalls=0;FailAt=NullAt=-1;AllocFail=ValidationFail=0;}
+int main(void){
+ LockIntf L={0};L.InitLock=Init;L.DestroyLock=Destroy;EFI_KERNEL_PROTOCOL S={0};S.Lock=&L;
+ Reset();UINTN *P=CreateFvList(&S);assert(P&&Created==8&&ValidationCalls==1);
+ UINT8 Expected[592]={0};for(unsigned I=0;I<8;I++){UINT64 H=I+1;memcpy(Expected+0x18+I*0x48,&H,8);}
+ assert(!memcmp(P,Expected,sizeof Expected));DestroyFvList(&S,(UINT8 *)P,8);assert(Destroyed==8&&Frees==1);
+ Reset();FailAt=3;assert(!CreateFvList(&S)&&Created==3&&Destroyed==3&&Frees==1);
+ Reset();NullAt=2;assert(!CreateFvList(&S)&&Created==2&&Destroyed==2&&Frees==1);
+ Reset();AllocFail=1;assert(!CreateFvList(&S)&&Created==0&&Frees==0);
+ Reset();ValidationFail=1;assert(!CreateFvList(&S)&&Allocations==0&&Created==0);
+ Reset();S.Lock=NULL;assert(!CreateFvList(&S)&&Allocations==0);S.Lock=&L;
+ Reset();L.InitLock=NULL;assert(!CreateFvList(&S)&&Allocations==0);L.InitLock=Init;
+ Reset();L.DestroyLock=NULL;assert(!CreateFvList(&S)&&Allocations==0);L.DestroyLock=Destroy;
+ Reset();assert(!CreateFvList(NULL)&&ValidationCalls==0);
+ puts("PASS: actual 592-byte OEM FV list layout/guard bytes, eight locks, partial init cleanup, null-success, allocation/validation/null-method guards");return 0;
+}
