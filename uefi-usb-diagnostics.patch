+#!/usr/bin/env python3
+"""Verify a locally supplied OEM image and reproduce 30 local binary INFs.
+
+Firmware is parsed as data, never executed. No device, network, DSC or FDF action.
+SPDX-License-Identifier: BSD-2-Clause-Patent
+"""
+import argparse
+import hashlib
+import importlib.metadata
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import sys
+import uuid
+
+IMAGE_BYTES = 2945024
+IMAGE_SHA256 = "30501ff03e3a79bc8785ec767bfff53e39290caf15eb401c15836afb0759276b"
+PARSER_SHA256 = "36567781b2a375ca8a8fed86571406cab0c261fb900de3780a2e2b95b3bbd7a1"
+MODULES_SHA256 = "3747f9c9153d73c13fe9eb89c2501e8ff789823799e0c4fcfe94bc8054bd9e9e"
+OUTPUT_PREFIX = Path("Binaries/vermeerUsbDiag/Oem")
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def checked_input(path):
+    if not path.is_file() or path.stat().st_size != IMAGE_BYTES:
+        raise ValueError("uefi.img must be the exact 2,945,024-byte vermeer OS2.0.218.0.VNKCNXM input")
+    data = path.read_bytes()
+    if len(data) != IMAGE_BYTES or sha(data) != IMAGE_SHA256:
+        raise ValueError("uefi.img SHA-256 mismatch; no parsing or output is permitted")
+    return data
+
+
+def load_modules(directory):
+    # Git may use CRLF on Windows. Pin canonical UTF-8/LF source text.
+    data = (directory / "oem-modules.json").read_text(encoding="utf-8-sig").encode("utf-8")
+    if sha(data) != MODULES_SHA256:
+        raise ValueError("pinned OEM whitelist changed; review the source before updating its digest")
+    manifest = json.loads(data)
+    if manifest.get("schema") != "k70-portable-oem-whitelist/1" or manifest.get("module_count") != 30:
+        raise ValueError("unexpected OEM whitelist schema/count")
+    modules = manifest["modules"]
+    if len(modules) != 30 or len({m["guid"] for m in modules}) != 30:
+        raise ValueError("duplicate or missing OEM whitelist entry")
+    for module in modules:
+        if str(uuid.UUID(module["guid"])) != module["guid"]:
+            raise ValueError("noncanonical module GUID")
+        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,95}", module["name"]):
+            raise ValueError("unsafe module filename")
+        if module["ffs_type"] != 7 or module["pe"]["subsystem"] not in (11, 12):
+            raise ValueError("unsupported original module type")
+        for item in (module["pe"], module["depex"]):
+            if item is not None and (not isinstance(item["bytes"], int) or item["bytes"] <= 0 or
+                                     not re.fullmatch(r"[0-9a-f]{64}", item["sha256"])):
+                raise ValueError("invalid payload size/digest")
+    return modules
+
+
+def parse_image(directory, image):
+    source = directory / "oem-fv-audit.py"
+    if sha(source.read_text(encoding="utf-8-sig").encode("utf-8")) != PARSER_SHA256:
+        raise ValueError("pinned portable FV parser changed")
+    # Avoid putting __pycache__ next to the source-only distribution.
+    sys.dont_write_bytecode = True
+    spec = importlib.util.spec_from_file_location("k70_portable_oem_fv", source)
+    parser = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(parser)
+
+    class MemoryAudit(parser.Audit):
+        def __init__(self):
+            super().__init__(Path.cwd())
+            self.memory = {}
+
+        def emit(self, name, data, kind):
+            if name in self.memory and self.memory[name] != data:
+                raise ValueError("different payloads at one parser identity")
+            self.memory[name] = data
+            result = {"path": name, "kind": kind, "bytes": len(data), "sha256": sha(data)}
+            self.blobs.append(result)
+            return result
+
+    audit = MemoryAudit()
+    if audit.scan(image, "uefi", [{"image_sha256": IMAGE_SHA256}]) == 0:
+        raise ValueError("no validated firmware volume in pinned input")
+    if audit.errors or audit.warnings:
+        raise ValueError("OEM firmware parser reported errors/warnings: " +
+                         json.dumps({"errors": audit.errors, "warnings": audit.warnings}))
+    return audit
+
+
+def check_payload(data, expected, label):
+    if len(data) != expected["bytes"] or sha(data) != expected["sha256"]:
+        raise ValueError(label + " does not match the original pinned bytes")
+
+
+def check_pe(data, expected):
+    if len(data) < 64 or data[:2] != b"MZ":
+        raise ValueError("original payload is not a PE image")
+    offset = struct.unpack_from("<I", data, 0x3C)[0]
+    if offset > len(data) - 24 or data[offset:offset + 4] != b"PE\0\0":
+        raise ValueError("invalid PE signature/header bounds")
+    optional = offset + 24
+    optional_bytes = struct.unpack_from("<H", data, offset + 20)[0]
+    if optional_bytes < 70 or optional_bytes > len(data) - optional:
+        raise ValueError("invalid PE optional header")
+    machine = struct.unpack_from("<H", data, offset + 4)[0]
+    magic = struct.unpack_from("<H", data, optional)[0]
+    subsystem = struct.unpack_from("<H", data, optional + 68)[0]
+    if machine != 0xAA64 or magic != 0x20B or subsystem != expected["subsystem"]:
+        raise ValueError("original PE ARM64/subsystem does not match the whitelist")
+    return "DXE_DRIVER" if subsystem == 11 else "DXE_RUNTIME_DRIVER"
+
+
+def render_inf(module, module_type):
+    name = module["name"]
+    absent = module["depex"] is None
+    lines = [
+        "# Local OEM binary input; original PE and DEPEX preserved byte for byte.",
+        "# Source: vermeer OS2.0.218.0.VNKCNXM uefi.img; not selected for a firmware build.",
+        "# Original FFS type: DRIVER (0x07); original DEPEX " + ("absent." if absent else "present."),
+        "[Defines]", "  INF_VERSION    = 0x0001001B", "  BASE_NAME      = " + name,
+        "  FILE_GUID      = " + module["guid"].upper(), "  MODULE_TYPE    = " + module_type,
+        "  VERSION_STRING = 1.0", "", "[Binaries.AARCH64]", "  PE32|" + name + ".efi|*",
+    ]
+    if not absent:
+        lines.append("  DXE_DEPEX|" + name + ".depex|*")
+    data = ("\n".join(lines) + "\n").encode("utf-8")
+    if sha(data) != module["inf_sha256"]:
+        raise ValueError("generated INF differs from its reviewed original serialization")
+    return data
+
+
+def plan_outputs(audit, modules):
+    inventory = {}
+    for item in audit.files:
+        inventory.setdefault(item["guid"], []).append(item)
+    outputs = {}
+    absent_depex = []
+    records = []
+    for module in modules:
+        found = inventory.get(module["guid"], [])
+        if len(found) != 1 or found[0]["type"] != module["ffs_type"] or found[0]["ui"] != [module["ui"]]:
+            raise ValueError("OEM FFS identity is missing or ambiguous: " + module["name"])
+        sections = found[0]["sections"]
+        pes = [s for s in sections if s["type"] == 0x10]
+        deps = [s for s in sections if s["type"] == 0x13]
+        if len(pes) != 1 or len(deps) != (0 if module["depex"] is None else 1):
+            raise ValueError("original PE/DEPEX multiplicity changed: " + module["name"])
+        pe = audit.memory[pes[0]["payload"]["path"]]
+        check_payload(pe, module["pe"], module["name"] + " PE")
+        module_type = check_pe(pe, module["pe"])
+        folder = OUTPUT_PREFIX / (module["name"] + "_" + module["guid"])
+        prefix = folder / module["name"]
+        outputs[prefix.with_suffix(".efi")] = pe
+        outputs[prefix.with_suffix(".inf")] = render_inf(module, module_type)
+        if module["depex"] is None:
+            absent_depex.append(prefix.with_suffix(".depex"))
+        else:
+            dep = audit.memory[deps[0]["payload"]["path"]]
+            check_payload(dep, module["depex"], module["name"] + " DEPEX")
+            outputs[prefix.with_suffix(".depex")] = dep
+        records.append({"guid": module["guid"], "ui": module["ui"], "subsystem": module["pe"]["subsystem"],
+                        "module_type": module_type, "original_depex_absent": module["depex"] is None})
+    return outputs, absent_depex, records
+
+
+def safe_destination(root, relative):
+    relative = Path(relative)
+    if relative.is_absolute() or any(piece in ("", ".", "..") for piece in relative.parts):
+        raise ValueError("unsafe relative output")
+    result = root / relative
+    if not result.resolve().is_relative_to(root):
+        raise ValueError("output escapes the explicitly selected UEFI root")
+    current = root
+    for piece in relative.parts:
+        current = current / piece
+        attributes = getattr(current.lstat(), "st_file_attributes", 0) if current.exists() else 0
+        if current.is_symlink() or attributes & 0x400:
+            raise ValueError("symlink/reparse output component is not permitted: " + str(relative))
+    return result
+
+
+def write_outputs(root, outputs, absent_depex):
+    if root == root.parent or (root.exists() and not root.is_dir()):
+        raise ValueError("UEFI root must be a non-root directory")
+    # Preflight the whole set before creating any firmware payload or directory.
+    for relative in absent_depex:
+        if safe_destination(root, relative).exists():
+            raise ValueError("originally absent DEPEX already exists: " + str(relative))
+    for relative, data in outputs.items():
+        path = safe_destination(root, relative)
+        if path.exists() and (not path.is_file() or path.read_bytes() != data):
+            raise ValueError("refuse differing pre-existing output: " + str(relative))
+    result = []
+    for relative, data in outputs.items():
+        path = safe_destination(root, relative)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        # Check again after directory creation; never open an existing file for writing.
+        path = safe_destination(root, relative)
+        try:
+            with path.open("xb") as stream:
+                stream.write(data)
+            disposition = "created"
+        except FileExistsError:
+            if not path.is_file() or path.read_bytes() != data:
+                raise ValueError("output changed during preparation: " + str(relative))
+            disposition = "identical-existing"
+        if path.read_bytes() != data:
+            raise ValueError("post-write byte verification failed: " + str(relative))
+        result.append({"path": relative.as_posix(), "bytes": len(data), "sha256": sha(data), "disposition": disposition})
+    return result
+
+
+def prepare(image_path, uefi_root):
+    image = checked_input(image_path)  # Authenticate before importing the parser.
+    directory = Path(__file__).resolve().parent
+    modules = load_modules(directory)
+    audit = parse_image(directory, image)
+    outputs, absent, records = plan_outputs(audit, modules)
+    root = uefi_root.resolve()
+    generated = write_outputs(root, outputs, absent)
+    try:
+        dependency_version = importlib.metadata.version("uefi_firmware")
+    except importlib.metadata.PackageNotFoundError:
+        dependency_version = "not installed / unused by this image"
+    return {"schema": "k70-portable-oem-preparation/1", "success": True,
+            "hardware_tested": False, "firmware_executed": False, "dsc_modified": False, "fdf_modified": False,
+            "input_bytes": len(image), "input_sha256": sha(image), "parser_sha256": PARSER_SHA256,
+            "whitelist_sha256": MODULES_SHA256, "uefi_firmware_version": dependency_version,
+            "module_count": len(records), "modules": records, "generated_files": generated}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--uefi-image", type=Path, required=True, help="locally obtained original vermeer uefi.img")
+    parser.add_argument("--uefi-root", type=Path, required=True, help="explicit target UEFI checkout or empty staging root")
+    parser.add_argument("--report", type=Path, help="optional NEW JSON report file; never overwrites history")
+    args = parser.parse_args()
+    try:
+        if args.report and args.report.exists():
+            raise ValueError("report already exists; choose a new local report filename")
+        result = prepare(args.uefi_image, args.uefi_root)
+        code = 0
+    except Exception as error:
+        result = {"schema": "k70-portable-oem-preparation/1", "success": False,
+                  "hardware_tested": False, "firmware_executed": False,
+                  "error": type(error).__name__ + ": " + str(error)}
+        code = 1
+    if args.report:
+        args.report.parent.mkdir(parents=True, exist_ok=True)
+        try:
+            with args.report.open("x", encoding="utf-8") as stream:
+                json.dump(result, stream, indent=2)
+                stream.write("\n")
+        except FileExistsError:
+            print("Refusing to overwrite existing report", file=sys.stderr)
+            return 1
+    print(json.dumps({key: result[key] for key in ("success", "module_count", "error", "hardware_tested", "firmware_executed") if key in result}))
+    return code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
