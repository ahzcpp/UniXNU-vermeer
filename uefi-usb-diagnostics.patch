diff --git a/package/uefi/K70DiagnosticsPkg/Drivers/K70UsbDiagDxe/K70UsbDiagCore.c b/package/uefi/K70DiagnosticsPkg/Drivers/K70UsbDiagDxe/K70UsbDiagCore.c
