+++ b/package/uefi/K70DiagnosticsPkg/Drivers/K70LogRingDxe/Tests/run-host-tests.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""No device access: actual EDK2 headers, ASan/UBSan reference model and AArch64 syntax.
+SPDX-License-Identifier: BSD-2-Clause-Patent
+"""
+import argparse
+import json
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--uefi", type=Path, required=True, help="pinned uefi-vermeer source root")
+parser.add_argument("--result", type=Path, help="optional local JSON result path")
+args = parser.parse_args()
+pkg = Path(__file__).resolve().parents[3]
+uefi = args.uefi.resolve()
+base = [uefi / "Mu_Basecore/MdePkg/Include", uefi / "Silicon/Silicium/SiliciumPkg/Include", pkg / "Include"]
+steps = []
+
+
+def run(name, command):
+    result = subprocess.run(command, text=True, capture_output=True)
+    steps.append({"name": name, "command": [str(p) for p in command], "exit": result.returncode,
+                  "stdout": result.stdout, "stderr": result.stderr})
+    print(name, result.returncode, result.stdout, result.stderr, flush=True)
+    if result.returncode:
+        raise RuntimeError(name + " failed")
+
+
+try:
+    with tempfile.TemporaryDirectory(prefix="k70-ring-host-") as directory:
+        executable = Path(directory) / "host-test"
+        run("host-compile-asan-ubsan", ["clang", "-std=c11", "-fshort-wchar", "-O1", "-g", "-Wall", "-Wextra", "-Werror",
+            "-fsanitize=address,undefined", *["-I" + str(p) for p in base], "-I" + str(uefi / "Mu_Basecore/MdePkg/Include/X64"),
+            "-D_PCD_VALUE_PcdFrameBufferWidth=1440", "-D_PCD_VALUE_PcdFrameBufferHeight=3200",
+            "-D_PCD_VALUE_PcdFrameBufferColorDepth=32", "-D_PCD_VALUE_PcdFrameBufferDelay=0",
+            "-D_PCD_VALUE_PcdFrameBufferFontScale=0", "-D_PCD_VALUE_PcdFrameBufferFreezeWhenFull=0",
+            "-Wno-unused-parameter", str(pkg / "Drivers/K70LogRingDxe/Tests/HostTest.c"),
+            str(pkg / "Drivers/K70LogRingDxe/K70LogRingDxe.c"),
+            str(pkg / "Library/DxeLogSerialPortLib/DxeLogSerialPortLib.c"), "-o", str(executable)])
+        run("host-reference-model-and-driver", [str(executable)])
+    syntax = ["clang", "-target", "aarch64-none-elf", "-mno-outline-atomics", "-std=gnu11", "-fshort-wchar", "-ffreestanding", "-fsyntax-only", "-Wall", "-Wextra",
+              "-Werror", "-Wno-unused-parameter", *["-I" + str(p) for p in base], "-I" + str(uefi / "Mu_Basecore/MdePkg/Include/AArch64")]
+    pcds = {"Width":1440, "Height":3200, "ColorDepth":32, "Delay":0, "FontScale":0, "FreezeWhenFull":0}
+    syntax += ["-D_PCD_VALUE_PcdFrameBuffer" + key + "=" + str(value) for key, value in pcds.items()]
+    for source in ["Drivers/K70LogRingDxe/K70LogRingDxe.c", "Library/DxeLogSerialPortLib/DxeLogSerialPortLib.c"]:
+        run("aarch64-syntax-" + Path(source).stem, syntax + [str(pkg / source)])
+    with tempfile.TemporaryDirectory(prefix="k70-ring-host-") as directory:
+        obj = Path(directory) / "wrapper.obj"
+        coff = ["clang", "-target", "aarch64-pc-windows-msvc", "-std=gnu11", "-fshort-wchar", "-ffreestanding", "-O2", "-c",
+                "-fno-stack-protector", "-mno-stack-arg-probe", "-mno-outline-atomics", "-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter",
+                *["-I" + str(p) for p in base], "-I" + str(uefi / "Mu_Basecore/MdePkg/Include/AArch64"),
+                *["-D_PCD_VALUE_PcdFrameBuffer" + key + "=" + str(value) for key, value in pcds.items()]]
+        run("arm64-coff-object", coff + [str(pkg / "Library/DxeLogSerialPortLib/DxeLogSerialPortLib.c"), "-o", str(obj)])
+        run("arm64-coff-undefined", ["llvm-nm-14", "--undefined-only", str(obj)])
+        symbols = steps[-1]["stdout"]
+        assert not re.search(r"\b(?:gST|gBS|__aarch64_\w*|__atomic_\w*|Interlocked\w*)\b", symbols), symbols
+        disassembly = subprocess.check_output(["llvm-objdump-14", "-d", "--no-show-raw-insn", str(obj)], text=True)
+        assert "ldaxr" in disassembly and "stxr" in disassembly and "ldxr" in disassembly
+        # Preserve the actual generated code for review without temp/audit paths.
+        disassembly = disassembly.replace(str(obj), "<WRAPPER_ARM64_COFF_OBJECT>")
+        audit = "ARM64 COFF undefined symbols (no gST/gBS/Interlocked/libatomic/outlined helpers):\n" + symbols
+        audit += "\nActual object disassembly:\n" + disassembly
+        (Path(__file__).resolve().parent / "coff-atomic-audit.txt").write_text(audit)
+        steps.append({"name":"arm64-coff-atomic-audit", "exit":0,
+                      "stdout":"COFF disassembly contains inline ldaxr/stxr CAS and ldxr/stxr drop increment; no prohibited undefined helpers.\n", "stderr":""})
+finally:
+    if args.result:
+        # Keep the reviewable report free of local audit paths and temp names.
+        for step in steps:
+            if "command" in step:
+                step["command"] = [p.replace(str(uefi), "<UEFI>").replace(str(pkg), "<PACKAGE>") for p in step["command"]]
+                step["command"] = ["<HOST_TEST_TEMP_ARTIFACT>" if "k70-ring-host-" in p else p for p in step["command"]]
+        commit = subprocess.check_output(["git", "-C", str(uefi), "rev-parse", "HEAD"], text=True).strip()
+        args.result.write_text(json.dumps({"hardware_tested": False, "uefi_commit": commit, "steps": steps}, indent=2) + "\n")
