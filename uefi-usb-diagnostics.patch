+/** Matching OS2.0.218 OEM SEC Scheduler 1.11 prefix metadata.
+ * Relative offsets only; no OEM code or runtime physical address.
+ * SEC TE SHA256 06ca85d1d987767af6c0877c6890dc0bf38ae0e560150e50c2b259c51b76b40a.
+ * SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef K70_SCHEDULER_TEMPLATE_H_
+#define K70_SCHEDULER_TEMPLATE_H_
+#define K70_SCHEDULER_VERSION 0x0001000BULL
+#define K70_SCHEDULER_TEXT_BEFORE_TABLE 0x38948U
+#define K70_SCHEDULER_TEXT_BYTES 0x38000U
+#define K70_SCHEDULER_DATA_BEFORE_TABLE 0x948U
+#define K70_SCHEDULER_DATA_BYTES 0xB000U
+#define K70_SCHEDULER_TABLE_AFTER_PRODUCER 0x1166CU
+#define K70_SCHEDULER_GUID_BEFORE_TABLE 0x6A8U
+STATIC CONST INT32 mSchedulerTopDeltas[11] = {-0x2D0, -0x130, -0x200, -0x2A0, -0x260, -0x230, 0x9410, -0x110, -0x58, -0x34AB0, -0x28};
+STATIC CONST INT32 mSchedulerInterruptFunctions[4] = {-0x348E8, -0x34098, -0x34060, -0x34018};
+STATIC CONST INT32 mSchedulerTimerFunctions[4] = {-0x34AE0, -0x30078, -0x30060, -0x30048};
+STATIC CONST INT32 mSchedulerThreadFunctions[24] = {-0x325C8, -0x32458, -0x311A8, -0x34E50, -0x34E70, -0x34E60, 0, -0x34E58, -0x31EA0, -0x31E88, -0x32130, -0x31328, -0x319D0, -0x311E0, 0, 0, 0, 0, -0x33AC0, -0x34AA0, -0x30990, -0x30938, -0x308D8, -0x308E0};
+STATIC CONST INT32 mSchedulerEventFunctions[8] = {-0x34D40, -0x337E0, -0x11694, -0x1167C, -0x33710, -0x33630, -0x334F0, -0x34E90};
+STATIC CONST INT32 mSchedulerMutexFunctions[6] = {-0x34E48, -0x33458, -0x11674, -0x33308, -0x331D8, -0x34E88};
+STATIC CONST INT32 mSchedulerSemFunctions[6] = {-0x34C08, -0x2FE68, -0x2FDE0, -0x2FCD0, -0x2FBE8, -0x2FB18};
+STATIC CONST INT32 mSchedulerSpinlockFunctions[5] = {0, 0, 0, 0, 0};
+STATIC CONST INT32 mSchedulerMpCpuFunctions[13] = {-0x30BC8, -0x35160, -0x35150, -0x34E68, -0x30BC0, -0x30AA0, 0, -0x35048, -0x350B8, -0x35050, -0x13A78, -0x142BC, -0x14274};
+STATIC CONST INT32 mSchedulerWDogFunctions[6] = {-0xB398, -0xB1D4, -0xB3BC, -0xB1B4, -0xB1B0, -0xB3AC};
+STATIC CONST INT32 mSchedulerLockFunctions[5] = {-0x115E4, -0x114F0, -0x11634, -0x114E8, -0x11458};
+typedef struct { UINT32 TopIndex; UINT32 Count; UINT32 ReservedMask; UINT32 OptionalNullMask; CONST INT32 *Functions; CONST CHAR8 *Name; } K70_SCHEDULER_SUBTABLE;
+STATIC CONST K70_SCHEDULER_SUBTABLE mSchedulerSubtables[] = {
+  {0U, 4U, 0U, 0U, mSchedulerInterruptFunctions, "Interrupt"},
+  {1U, 4U, 0U, 0U, mSchedulerTimerFunctions, "Timer"},
+  {2U, 24U, ((1U<<6)|(0xFU<<14)), 0U, mSchedulerThreadFunctions, "Thread"},
+  {3U, 8U, 0U, 0U, mSchedulerEventFunctions, "Event"},
+  {4U, 6U, 0U, 0U, mSchedulerMutexFunctions, "Mutex"},
+  {5U, 6U, 0U, 0U, mSchedulerSemFunctions, "Sem"},
+  {6U, 5U, 0U, 0x1FU, mSchedulerSpinlockFunctions, "Spinlock"},
+  {7U, 13U, 0U, (1U<<6), mSchedulerMpCpuFunctions, "MpCpu"},
+  {8U, 6U, 0U, 0U, mSchedulerWDogFunctions, "WDog"},
+  {10U, 5U, 0U, 0U, mSchedulerLockFunctions, "Lock"},
+};
+#endif
