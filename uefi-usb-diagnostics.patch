diff --git a/package/uefi/K70DiagnosticsPkg/Library/K70PlatformPeiLib/PlatformPei.c b/package/uefi/K70DiagnosticsPkg/Library/K70PlatformPeiLib/PlatformPei.c
new file mode 100644
index 0000000..116f7ad
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Library/K70PlatformPeiLib/PlatformPei.c
@@ -0,0 +1,127 @@
+/** @file
+  K70 guarded copy of Qualcomm PlatformPeiLib. Baseline is left unchanged.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+  Original portions Copyright (c) 2011-2014 ARM Limited; 2014 Linaro Limited.
+**/
+#include <Uefi.h>
+#include <Library/PcdLib.h>
+#include <Library/DebugLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/MemoryMapHelperLib.h>
+#include <Library/PrintLib.h>
+#include <Library/HobLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Protocol/EFIKernelInterface.h>
+#include "ShimLibraries/EFIShim.h"
+#include "Include/FvList.h"
+#include "PlatformPei.h"
+#include "K70XblValidation.h"
+
+#define FV_LIST_BYTES       (FV_LIST_STRUCTURE_SIZE * MAX_FV_ENTRIES)
+#define FV_LOCK_OFFSET(I)   (0x18U + (UINTN)(I) * 0x48U)
+STATIC_ASSERT (FV_LIST_BYTES == 0x250U, "OEM FV list ABI includes occupancy[8] at 0x248");
+STATIC_ASSERT (FV_LOCK_OFFSET (MAX_FV_ENTRIES - 1U) + sizeof (UINT64) <= FV_LIST_BYTES, "FV lock bounds");
+
+EFI_SHIM_LIBRARY_LOADER ShLibraryLoader = {0x00010001, ShimInstallLib, ShimLoadLib};
+
+STATIC VOID
+DestroyFvList (EFI_KERNEL_PROTOCOL *Scheduler, UINT8 *List, UINTN Created)
+{
+  UINTN Index;
+  LockHandle *Handle;
+  if (List == NULL) { return; }
+  // Caller validated the backing Scheduler and both Init/Destroy methods before
+  // creating any handle. Never call through an unvalidated candidate here.
+  for (Index = 0; Index < Created; ++Index) {
+    CopyMem (&Handle, List + FV_LOCK_OFFSET (Index), sizeof (Handle));
+    if (Handle != NULL) { Scheduler->Lock->DestroyLock (Handle); }
+  }
+  FreePool (List);
+}
+
+UINTN *
+CreateFvList (EFI_KERNEL_PROTOCOL *Scheduler)
+{
+  UINT8 *List;
+  EFI_STATUS Status;
+  UINTN Index;
+  LockHandle *Handle;
+  CHAR8 Name[16];
+  if ((Scheduler == NULL) || EFI_ERROR (K70ValidateScheduler ((UINTN)Scheduler))) {
+    DEBUG ((DEBUG_ERROR, "K70 XBL: FV list refuses unvalidated Scheduler\n"));
+    return NULL;
+  }
+  if ((Scheduler->Lock == NULL) || (Scheduler->Lock->InitLock == NULL) || (Scheduler->Lock->DestroyLock == NULL)) {
+    DEBUG ((DEBUG_ERROR, "K70 XBL: FV list missing lock methods\n"));
+    return NULL;
+  }
+  List = AllocateZeroPool (FV_LIST_BYTES);
+  if (List == NULL) { return NULL; }
+  for (Index = 0; Index < MAX_FV_ENTRIES; ++Index) {
+    if (FV_LOCK_OFFSET (Index) > FV_LIST_BYTES - sizeof (UINT64)) {
+      DestroyFvList (Scheduler, List, Index); return NULL;
+    }
+    Handle = NULL;
+    AsciiSPrint (Name, sizeof (Name), "FVLCK%u", (UINT32)Index);
+    Status = Scheduler->Lock->InitLock (Name, &Handle);
+    // A failed InitLock does not transfer a defined handle to this caller.
+    if (EFI_ERROR (Status) || (Handle == NULL)) {
+      DEBUG ((DEBUG_ERROR, "K70 XBL: FV lock %u creation failed %r\n", (UINT32)Index, Status));
+      DestroyFvList (Scheduler, List, Index); return NULL;
+    }
+    CopyMem (List + FV_LOCK_OFFSET (Index), &Handle, sizeof (Handle));
+  }
+  return (UINTN *)List;
+}
+
+STATIC EFI_STATUS
+BuildXblHobs (EFI_PHYSICAL_ADDRESS SchedulerAddress, EFI_PHYSICAL_ADDRESS DtbAddress)
+{
+  EFI_MEMORY_REGION_DESCRIPTOR Info = {0};
+  UINTN ShimAddress = (UINTN)&ShLibraryLoader;
+  BOOLEAN Prodmode = FALSE;
+  UINTN *List;
+  EFI_KERNEL_PROTOCOL *Scheduler = (EFI_KERNEL_PROTOCOL *)(UINTN)SchedulerAddress;
+  EFI_STATUS Status;
+  // Both interfaces must pass retention and schema checks before any OEM call.
+  Status = K70ValidateDtb (DtbAddress);
+  if (EFI_ERROR (Status)) { return Status; }
+  Status = K70ValidateScheduler (SchedulerAddress);
+  if (EFI_ERROR (Status)) { return Status; }
+  List = CreateFvList (Scheduler);
+  if (List == NULL) { return EFI_OUT_OF_RESOURCES; }
+  LocateMemoryRegionByName ("Info Blk", &Info);
+  if (Info.Address == 0U) { LocateMemoryRegionByName ("Info_Blk", &Info); }
+  if ((Info.Address == 0U) || (Info.Length < sizeof (UINT64))) {
+    DestroyFvList (Scheduler, (UINT8 *)List, MAX_FV_ENTRIES); return EFI_NOT_FOUND;
+  }
+  if ((BuildGuidDataHob (&gEfiInfoBlkHobGuid, &Info.Address, sizeof (Info.Address)) == NULL) ||
+      (BuildGuidDataHob (&gEfiShimLibraryHobGuid, &ShimAddress, sizeof (ShimAddress)) == NULL) ||
+      (BuildGuidDataHob (&gEfiProdmodeHobGuid, &Prodmode, sizeof (Prodmode)) == NULL) ||
+      (BuildGuidDataHob (&gEfiSchedulerInterfaceHobGuid, &SchedulerAddress, sizeof (SchedulerAddress)) == NULL) ||
+      (BuildGuidDataHob (&gEfiFvListHobGuid, &List, sizeof (List)) == NULL) ||
+      (BuildGuidDataHob (&gEfiDtbExtensionHobGuid, &DtbAddress, sizeof (DtbAddress)) == NULL)) {
+    // Partial HOBs are not rollback-capable. The SEC caller MUST return on error
+    // before DXE dispatch, so no consumer is given these now-aborted pointers.
+    DestroyFvList (Scheduler, (UINT8 *)List, MAX_FV_ENTRIES); return EFI_OUT_OF_RESOURCES;
+  }
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS EFIAPI
+PlatformPeim (VOID)
+{
+  EFI_PHYSICAL_ADDRESS Scheduler = 0, Dtb = 0;
+  EFI_STATUS Status;
+  // Upstream HobLib BuildFvHob has a VOID interface, unlike BuildGuidDataHob.
+  BuildFvHob (FixedPcdGet64 (PcdFvBaseAddress), FixedPcdGet32 (PcdFvSize));
+  if (!FixedPcdGetBool (PcdBuildXblHobs)) { return EFI_SUCCESS; }
+  Status = GetXblHobAddresses (&Scheduler, &Dtb);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "K70 XBL GUARD STOP: %r; no Scheduler/DTB/FV-list HOB published; OEM DXE must not run\n", Status));
+    return Status;
+  }
+  Status = BuildXblHobs (Scheduler, Dtb);
+  if (EFI_ERROR (Status)) { DEBUG ((DEBUG_ERROR, "K70 XBL GUARD STOP: HOB construction failed %r\n", Status)); }
+  return Status;
+}
