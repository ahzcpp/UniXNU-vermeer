+  { 464, 2, 25 },
+  { 466, 2, 7 },
+  { 468, 2, 7 },
+  { 470, 4, 7 },
+  { 474, 43, 7 },
+};
+
+#endif
diff --git a/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Main.c b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Main.c
new file mode 100644
index 0000000..72f3c93
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Main.c
@@ -0,0 +1,175 @@
+/** @file
+  UniXNURun() and logging.
+
+  Copyright (c) 2026, UniXNU contributors. All rights reserved.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "Internal.h"
+
+#include <Protocol/SerialIo.h>
+
+STATIC EFI_SERIAL_IO_PROTOCOL  *mSerial;
+
+VOID
+UniXNULogInit (
+  VOID
+  )
+{
+  if (EFI_ERROR (gBS->LocateProtocol (&gEfiSerialIoProtocolGuid, NULL, (VOID **)&mSerial))) {
+    mSerial = NULL;
+  }
+}
+
+VOID
+EFIAPI
+UniXNULog (
+  IN CONST CHAR8  *Format,
+  ...
+  )
+{
+  VA_LIST  Args;
+  CHAR8    Line[256];
+  UINTN    Prefix;
+  UINTN    Size;
+
+  Prefix = AsciiSPrint (Line, sizeof (Line), "UNIXNU: ");
+  VA_START (Args, Format);
+  AsciiVSPrint (Line + Prefix, sizeof (Line) - Prefix - 2, Format, Args);
+  VA_END (Args);
+  AsciiStrCatS (Line, sizeof (Line), "\r\n");
+
+  DEBUG ((PcdGet32 (PcdUniXNUDebugLevel), "%a", Line));
+  if (mSerial != NULL) {
+    Size = AsciiStrLen (Line);
+    mSerial->Write (mSerial, &Size, Line);
+  }
+}
+
+EFI_STATUS
+EFIAPI
+UniXNURun (
+  IN EFI_HANDLE      ImageHandle,
+  IN UNIXNU_HOST  Host
+  )
+{
+  EFI_STATUS       Status;
+  UNIXNU_CONFIG        Config;
+  UNIXNU_UI            Ui;
+  UNIXNU_INJECT_STATS  Stats;
+  UINTN            Index;
+  BOOLEAN          Countdown;
+  UNIXNU_ENTRY         *Entry;
+  UNIXNU_ENTRY         BootCopy;
+
+  //
+  // A boot manager waits for people; the 5 minute BDS watchdog does not.
+  //
+  gBS->SetWatchdogTimer (0, 0, 0, NULL);
+  UniXNULogInit ();
+  UniXNULog (
+    "UniXNU %a starting as %a, firmware %s rev 0x%x",
+    UNIXNU_VERSION_STRING,
+    (Host == UniXNUHostFirmware) ? "firmware boot option" : "application",
+    (gST->FirmwareVendor != NULL) ? gST->FirmwareVendor : L"?",
+    gST->FirmwareRevision
+    );
+
+  //
+  // Storage may not be connected yet, whichever way UniXNU was entered. Started
+  // from BDS it is because nothing has connected the controllers; started as a
+  // DXE driver it is because the ramdisk BlockIo is dispatched before
+  // UniXNURamDiskDxe installs it, so without this the initrd volume never gets a
+  // SimpleFileSystem and payload discovery reports that no payload exists.
+  //
+  UniXNUConnectAll ();
+
+  UniXNUConfigLoad (ImageHandle, &Config);
+  DiagRestrictConfig (&Config);
+  UniXNULog (
+    "config: %u entries, %u drivers, %u dt patches, %u acpi tables, %u slices, %u kits loaded, %u skipped",
+    (UINT32)Config.EntryCount,
+    (UINT32)Config.DriverCount,
+    (UINT32)Config.PatchCount,
+    (UINT32)Config.AcpiCount,
+    (UINT32)Config.SliceCount,
+    (UINT32)Config.KitsLoaded,
+    (UINT32)Config.KitsSkipped
+    );
+
+  UniXNUPublishSlices (&Config);
+
+  //
+  // Drivers before the UI: an injected driver may provide the display or
+  // the input device the menu needs.
+  //
+  ZeroMem (&Stats, sizeof (Stats));
+  UniXNUInjectDrivers (ImageHandle, &Config, &Stats);
+  UniXNUInjectAcpi (&Config, &Stats);
+
+  UniXNUUiInit (&Config, &Ui);
+
+  UnicodeSPrint (
+    Ui.Info,
+    sizeof (Ui.Info),
+    L"drivers %u loaded / %u failed    kits %u    acpi %u",
+    (UINT32)Stats.DriversLoaded,
+    (UINT32)Stats.DriversFailed,
+    (UINT32)Config.KitsLoaded,
+    (UINT32)Stats.AcpiInstalled
+    );
+
+  // The restricted application runs at TPL_APPLICATION. Start the sole K70
+  // USB service once here, before waiting for keys; never from a timer.
+  Status = DiagAutoRunUsbTool (&Ui, &Config);
+  UniXNULog ("diag: automatic USB tool returned %r; waiting for user input", Status);
+  UnicodeSPrint (Ui.Notice, sizeof (Ui.Notice), L"USB diagnostic service returned %r; Tools remains available", Status);
+
+  Countdown = TRUE;
+  for ( ; ;) {
+    Index  = UniXNUMenuRun (&Ui, &Config, Countdown);
+    Entry  = &Config.Entries[Index];
+    BootCopy = *Entry;
+    if (Entry->Confirm != NULL) {
+      UINTN  Choice;
+
+      if (!UniXNUMenuConfirm (&Ui, Entry, &Choice)) {
+        UniXNULog ("menu: entry %u not confirmed", (UINT32)Index);
+        UnicodeSPrint (Ui.Notice, sizeof (Ui.Notice), L"'%s' cancelled", Entry->Title);
+        Countdown = FALSE;
+        continue;
+      }
+
+      if (Entry->ConfirmCount > 0) {
+        //
+        // The chosen option's arguments follow the entry's own, on a copy: the entry itself stays as configured.
+        //
+        UINTN  Length = (Entry->Args != NULL ? StrLen (Entry->Args) : 0) + 1 + StrLen (Entry->ConfirmArgs[Choice]) + 1;
+
+        BootCopy.Args = AllocateZeroPool (Length * sizeof (CHAR16));
+        if (BootCopy.Args != NULL) {
+          UnicodeSPrint (BootCopy.Args, Length * sizeof (CHAR16), L"%s %s", Entry->Args != NULL ? Entry->Args : L"", Entry->ConfirmArgs[Choice]);
+        } else {
+          BootCopy.Args = Entry->Args;
+        }
+      }
+    }
+
+    if ((Entry->Type == UniXNUEntryAction) && (Entry->Action == UniXNUActionTools)) {
+      UniXNUMenuRunTools (&Ui, &Config);
+      Countdown = FALSE;
+      continue;
+    }
+
+    Status = UniXNUBootEntry (ImageHandle, &Config, &BootCopy);
+
+    //
+    // The payload returned or failed: back to the menu, without the
+    // countdown so a broken default cannot loop on a machine with input.
+    //
+    UnicodeSPrint (Ui.Notice, sizeof (Ui.Notice), L"'%s' returned: %r", Entry->Title, Status);
+    UniXNULog ("menu: entry %u returned %r", (UINT32)Index, Status);
+    gBS->SetWatchdogTimer (0, 0, 0, NULL);
+    Countdown = FALSE;
+  }
+}
diff --git a/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Menu.c b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Menu.c
new file mode 100644
index 0000000..8c335a4
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/Menu.c
@@ -0,0 +1,524 @@
+/** @file
+  Diagnostic menu loop. Waits for actual input with no unattended countdown,
+  no-input fallback selection, or idle rotation, including the Tools submenu.
+
+  Copyright (c) 2026, UniXNU contributors. All rights reserved.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "Internal.h"
+
+#define TICK_MS             100
+#define DEFAULT_ROTATE_SEC  2
+
+#ifndef SCAN_SUSPEND
+#define SCAN_SUSPEND  0x0102
+#endif
+
+//
+// Physical input = a SimpleTextIn instance that sits on a device path; the
+// ConSplitter's virtual handle has none.
+//
+STATIC
+UINTN
+CountInputDevices (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  *Handles;
+  UINTN       Count;
+  UINTN       Index;
+  UINTN       Physical;
+  VOID        *Path;
+
+  if (gST->ConIn == NULL) {
+    return 0;
+  }
+
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleTextInProtocolGuid, NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) {
+    return 0;
+  }
+
+  Physical = 0;
+  for (Index = 0; Index < Count; Index++) {
+    if (!EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiDevicePathProtocolGuid, &Path))) {
+      Physical++;
+    }
+  }
+
+  FreePool (Handles);
+  return Physical;
+}
+
+STATIC
+VOID
+DrawCountdown (
+  IN UNIXNU_UI      *Ui,
+  IN UNIXNU_CONFIG  *Config,
+  IN INTN       RemainingMs,
+  IN BOOLEAN    HasInput
+  )
+{
+  CHAR16  Line[128];
+
+  if (RemainingMs >= 0) {
+    UnicodeSPrint (
+      Line,
+      sizeof (Line),
+      L"Booting %s in %u s",
+      Config->Entries[Config->DefaultIndex].Title,
+      (UINT32)((RemainingMs + 999) / 1000)
+      );
+  } else {
+    UnicodeSPrint (Line, sizeof (Line), L"Select an entry");
+  }
+
+  UniXNUUiDrawStatus (Ui, 0, Line);
+}
+
+UINTN
+UniXNUMenuRun (
+  IN UNIXNU_UI      *Ui,
+  IN UNIXNU_CONFIG  *Config,
+  IN BOOLEAN    Countdown
+  )
+{
+  EFI_STATUS     Status;
+  EFI_EVENT      Timer;
+  EFI_EVENT      Events[2];
+  UINTN          EventCount;
+  UINTN          Signaled;
+  EFI_INPUT_KEY  Key;
+  UINTN          Selected;
+  UINTN          Previous;
+  UINTN          Index;
+  BOOLEAN        HasInput;
+  BOOLEAN        UserActive;
+  INTN           RemainingMs;
+  UINTN          RotateMs;
+  UINTN          RotateAccum;
+  INTN           LastShownSecond;
+  UINTN          Count;
+
+  Count    = Config->EntryCount;
+  Selected = Config->DefaultIndex;
+  HasInput = (CountInputDevices () > 0);
+
+  // Diagnostics wait for actual input; no countdown, no-input fallback,
+  // rotation, or unattended action selection (including the Tools submenu).
+  (VOID)Countdown;
+  RemainingMs = -1;
+  RotateMs = 0;
+
+  UniXNUUiDrawFrame (Ui, Config);
+  for (Index = 0; Index < Count; Index++) {
+    UniXNUUiDrawEntry (Ui, Config, Index, Index == Selected);
+  }
+
+  UniXNUUiDrawStatus (
+    Ui,
+    1,
+    HasInput ? L"Up/Down: select    Enter: boot    1-9: boot entry    Esc: stop timer"
+             : L"USB diagnostics active; waiting for keyboard input"
+    );
+  if (Ui->Notice[0] != L'\0') {
+    UniXNUUiDrawStatus (Ui, 2, Ui->Notice);
+  }
+
+  UniXNULog (
+    "menu: shown %u entries, default %u '%a', timeout %d ms, input %a, rotate %u ms",
+    (UINT32)Count,
+    (UINT32)Config->DefaultIndex,
+    (Config->Entries[Config->DefaultIndex].Id != NULL) ? Config->Entries[Config->DefaultIndex].Id : "?",
+    (INT32)RemainingMs,
+    HasInput ? "yes" : "no",
+    (UINT32)RotateMs
+    );
+
+  if (RemainingMs == 0) {
+    UniXNULog ("menu: timeout 0, booting default");
+    return Config->DefaultIndex;
+  }
+
+  Status = gBS->CreateEvent (EVT_TIMER, TPL_CALLBACK, NULL, NULL, &Timer);
+  if (EFI_ERROR (Status)) {
+    return Config->DefaultIndex;
+  }
+
+  gBS->SetTimer (Timer, TimerPeriodic, EFI_TIMER_PERIOD_MILLISECONDS (TICK_MS));
+
+  EventCount = 0;
+  Events[EventCount++] = Timer;
+  if (gST->ConIn != NULL) {
+    Events[EventCount++] = gST->ConIn->WaitForKey;
+  }
+
+  UserActive      = FALSE;
+  RotateAccum     = 0;
+  LastShownSecond = -2;
+  for ( ; ;) {
+    INTN  Second = (RemainingMs < 0) ? -1 : (RemainingMs + 999) / 1000;
+
+    if (Second != LastShownSecond) {
+      DrawCountdown (Ui, Config, RemainingMs, HasInput);
+      LastShownSecond = Second;
+    }
+
+    Status = gBS->WaitForEvent (EventCount, Events, &Signaled);
+    if (EFI_ERROR (Status)) {
+      break;
+    }
+
+    Previous = Selected;
+    if (Signaled == 0) {
+      if (RemainingMs > 0) {
+        RemainingMs -= TICK_MS;
+        if (RemainingMs <= 0) {
+          UniXNULog ("menu: timeout, booting default %u", (UINT32)Config->DefaultIndex);
+          Selected = Config->DefaultIndex;
+          break;
+        }
+      }
+
+      if (!UserActive && (RotateMs > 0) && (Count > 1)) {
+        RotateAccum += TICK_MS;
+        if (RotateAccum >= RotateMs) {
+          RotateAccum = 0;
+          Selected    = (Selected + 1) % Count;
+        }
+      }
+    } else {
+      if (EFI_ERROR (gST->ConIn->ReadKeyStroke (gST->ConIn, &Key))) {
+        continue;
+      }
+
+      if (!UserActive) {
+        //
+        // The first key takes over: no more countdown or rotation, and the
+        // highlight returns to the default before the key applies.
+        //
+        UserActive  = TRUE;
+        RemainingMs = -1;
+        Selected    = Config->DefaultIndex;
+      }
+
+      if ((Key.ScanCode == SCAN_UP) || (Key.UnicodeChar == L'k')) {
+        Selected = (Selected + Count - 1) % Count;
+      } else if ((Key.ScanCode == SCAN_DOWN) || (Key.UnicodeChar == L'j')) {
+        Selected = (Selected + 1) % Count;
+      } else if (Key.ScanCode == SCAN_HOME) {
+        Selected = 0;
+      } else if (Key.ScanCode == SCAN_END) {
+        Selected = Count - 1;
+      } else if ((Key.UnicodeChar >= L'1') && (Key.UnicodeChar <= L'9') && ((UINTN)(Key.UnicodeChar - L'1') < Count)) {
+        Selected = Key.UnicodeChar - L'1';
+        UniXNULog ("menu: key %c, booting %u", Key.UnicodeChar, (UINT32)Selected);
+        break;
+      } else if ((Key.UnicodeChar == CHAR_CARRIAGE_RETURN) || (Key.UnicodeChar == CHAR_LINEFEED) ||
+                 (Key.UnicodeChar == L' ') || (Key.ScanCode == SCAN_RIGHT) || (Key.ScanCode == SCAN_SUSPEND))
+      {
+        UniXNULog ("menu: enter, booting %u", (UINT32)Selected);
+        break;
+      }
+    }
+
+    if (Selected != Previous) {
+      UniXNUUiDrawEntry (Ui, Config, Previous, FALSE);
+      UniXNUUiDrawEntry (Ui, Config, Selected, TRUE);
+    }
+  }
+
+  gBS->SetTimer (Timer, TimerCancel, 0);
+  gBS->CloseEvent (Timer);
+  return Selected;
+}
+
+//
+// The Tools submenu reuses the ordinary menu loop against a temporary config
+// whose entries are the installed menu plugins plus a leading Back entry. The
+// selected plugin draws between the header and footer; DrawStatus lets it
+// update the footer without owning it.
+//
+STATIC UNIXNU_UI  *mToolsUi;
+STATIC BOOLEAN    mDiagnosticAutoAttempted;
+
+STATIC
+VOID
+EFIAPI
+ToolsDrawStatus (
+  IN CONST UNIXNU_MENU_PLUGIN_PROTOCOL  *This,
+  IN UINTN                              Line,
+  IN CONST CHAR16                       *Text
+  )
+{
+  (VOID)This;
+  if (mToolsUi != NULL) {
+    UniXNUUiDrawStatus (mToolsUi, Line, Text);
+  }
+}
+
+STATIC
+EFI_STATUS
+RunTool (IN UNIXNU_UI *Ui, IN UNIXNU_MENU_PLUGIN_PROTOCOL *Plugin)
+{
+  UNIXNU_PLUGIN_RECT Content;
+  EFI_STATUS Status;
+
+  Content.X = 0;
+  Content.Y = (UINT32)Ui->ContentTop;
+  Content.Width = Ui->Width;
+  Content.Height = (UINT32)((Ui->ContentBottom > Ui->ContentTop) ? Ui->ContentBottom - Ui->ContentTop : 0);
+  mToolsUi = Ui;
+  Status = Plugin->Run (Plugin, Ui->Gop, &Content, ToolsDrawStatus);
+  mToolsUi = NULL;
+  return Status;
+}
+
+EFI_STATUS
+DiagAutoRunUsbTool (IN UNIXNU_UI *Ui, IN UNIXNU_CONFIG *Config)
+{
+  STATIC CONST CHAR16 Title[] = L"K70 USB diagnostics (read-only)";
+  EFI_HANDLE *Handles = NULL;
+  UINTN Count = 0, Index, Matches = 0;
+  EFI_STATUS Status;
+  UNIXNU_MENU_PLUGIN_PROTOCOL *Candidate = NULL;
+
+  if (mDiagnosticAutoAttempted) {
+    return EFI_ALREADY_STARTED;
+  }
+  mDiagnosticAutoAttempted = TRUE;
+  if ((Ui == NULL) || (Config == NULL) || (Ui->Mode != UniXNUUiGraphics) ||
+      (Ui->Gop == NULL) || (EfiGetCurrentTpl () != TPL_APPLICATION)) {
+    UniXNULog ("diag: automatic USB service needs graphics and TPL_APPLICATION");
+    return EFI_UNSUPPORTED;
+  }
+
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gUniXNUMenuPluginProtocolGuid,
+                                    NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+  if ((Count > 128) || ((Count != 0) && (Handles == NULL))) {
+    if (Handles != NULL) { FreePool (Handles); }
+    return EFI_OUT_OF_RESOURCES;
+  }
+  for (Index = 0; Index < Count; Index++) {
+    UNIXNU_MENU_PLUGIN_PROTOCOL *Plugin = NULL;
+    if (!EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gUniXNUMenuPluginProtocolGuid, (VOID **)&Plugin)) &&
+        (Plugin != NULL) && (Plugin->Signature == UNIXNU_MENU_PLUGIN_PROTOCOL_SIGNATURE) &&
+        (Plugin->Version == UNIXNU_MENU_PLUGIN_PROTOCOL_VERSION) && (Plugin->Run != NULL) &&
+        (Plugin->Title != NULL) && (StrnCmp (Plugin->Title, Title, ARRAY_SIZE (Title)) == 0)) {
+      Candidate = Plugin;
+      Matches++;
+    }
+  }
+  if (Handles != NULL) { FreePool (Handles); }
+  if (Matches != 1) {
+    UniXNULog ("diag: automatic USB selection found %u exact matching plugins", (UINT32)Matches);
+    return Matches == 0 ? EFI_NOT_FOUND : EFI_COMPROMISED_DATA;
+  }
+  UniXNUUiDrawFrame (Ui, Config);
+  UniXNULog ("diag: starting the sole K70 USB tool at TPL_APPLICATION");
+  return RunTool (Ui, Candidate);
+}
+
+VOID
+UniXNUMenuRunTools (
+  IN UNIXNU_UI      *Ui,
+  IN UNIXNU_CONFIG  *Config
+  )
+{
+  EFI_STATUS                   Status;
+  EFI_HANDLE                   *Handles;
+  UINTN                        HandleCount;
+  UINTN                        Index;
+  UINTN                        PluginCount;
+  UNIXNU_MENU_PLUGIN_PROTOCOL  **Plugins;
+  UNIXNU_ENTRY                 *Entries;
+  UNIXNU_CONFIG                Tools;
+  UINTN                        Selected;
+  CHAR16                       SavedNotice[sizeof (Ui->Notice) / sizeof (Ui->Notice[0])];
+
+  if (Ui->Mode != UniXNUUiGraphics) {
+    return;
+  }
+
+  Handles     = NULL;
+  Plugins     = NULL;
+  Entries     = NULL;
+  PluginCount = 0;
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gUniXNUMenuPluginProtocolGuid,
+                  NULL,
+                  &HandleCount,
+                  &Handles
+                  );
+  if (EFI_ERROR (Status) || (HandleCount == 0)) {
+    UniXNULog ("tools: no menu plugins installed");
+    goto Done;
+  }
+
+  Plugins = AllocateZeroPool (HandleCount * sizeof (*Plugins));
+  if (Plugins == NULL) {
+    goto Done;
+  }
+
+  for (Index = 0; Index < HandleCount; Index++) {
+    UNIXNU_MENU_PLUGIN_PROTOCOL  *Plugin;
+
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gUniXNUMenuPluginProtocolGuid, (VOID **)&Plugin)) ||
+        (Plugin == NULL) ||
+        (Plugin->Signature != UNIXNU_MENU_PLUGIN_PROTOCOL_SIGNATURE) ||
+        (Plugin->Version != UNIXNU_MENU_PLUGIN_PROTOCOL_VERSION) ||
+        (Plugin->Run == NULL))
+    {
+      continue;
+    }
+
+    Plugins[PluginCount++] = Plugin;
+  }
+
+  if (PluginCount == 0) {
+    UniXNULog ("tools: %u handle(s), none usable", (UINT32)HandleCount);
+    goto Done;
+  }
+
+  Entries = AllocateZeroPool ((PluginCount + 1) * sizeof (*Entries));
+  if (Entries == NULL) {
+    goto Done;
+  }
+
+  //
+  // Back is first so a first key press cannot launch a tool; the default
+  // highlight starts on Back and any Up/Down/Enter press takes over cleanly.
+  //
+  Entries[0].Id     = "back";
+  Entries[0].Title  = L"Back";
+  Entries[0].Type   = UniXNUEntryAction;
+  Entries[0].Action = UniXNUActionNone;
+  for (Index = 0; Index < PluginCount; Index++) {
+    Entries[Index + 1].Id     = "tool";
+    Entries[Index + 1].Title  = (CHAR16 *)Plugins[Index]->Title;
+    Entries[Index + 1].Type   = UniXNUEntryAction;
+    Entries[Index + 1].Action = UniXNUActionNone;
+  }
+
+  Tools              = *Config;
+  Tools.Entries      = Entries;
+  Tools.EntryCount   = PluginCount + 1;
+  Tools.DefaultIndex = 0;
+  Tools.Timeout      = -1;
+  Tools.Error[0]     = '\0';
+  Tools.Notice[0]    = '\0';
+
+  CopyMem (SavedNotice, Ui->Notice, sizeof (SavedNotice));
+  Ui->Notice[0] = L'\0';
+  for ( ; ;) {
+    Selected = UniXNUMenuRun (Ui, &Tools, FALSE);
+    if ((Selected == 0) || (Selected > PluginCount)) {
+      break;
+    }
+
+    RunTool (Ui, Plugins[Selected - 1]);
+  }
+
+  CopyMem (Ui->Notice, SavedNotice, sizeof (SavedNotice));
+
+Done:
+  if (Entries != NULL) {
+    FreePool (Entries);
+  }
+
+  if (Plugins != NULL) {
+    FreePool (Plugins);
+  }
+
+  if (Handles != NULL) {
+    FreePool (Handles);
+  }
+}
+
+BOOLEAN
+UniXNUMenuConfirm (
+  IN  UNIXNU_UI      *Ui,
+  IN  UNIXNU_ENTRY   *Entry,
+  OUT UINTN      *Choice
+  )
+{
+  EFI_INPUT_KEY  Key;
+  UINTN          Index;
+  UINTN          Shown;
+  UINTN          Items;
+  CHAR16         Line[160];
+
+  *Choice = 0;
+  if ((gST->ConIn == NULL) || (CountInputDevices () == 0)) {
+    UniXNULog ("menu: confirmation needs an input device, cancelled");
+    return FALSE;
+  }
+
+  //
+  // With choices the items are the choices and then Cancel, and Cancel is shown first, so the first press cannot confirm anything.
+  //
+  Items = (Entry->ConfirmCount > 0) ? Entry->ConfirmCount + 1 : 0;
+  Shown = Items > 0 ? Items - 1 : 0;
+
+  UnicodeSPrint (Line, sizeof (Line), L"%s", Entry->Confirm);
+  UniXNUUiDrawStatus (Ui, 0, Line);
+  UniXNUUiDrawStatus (Ui, 2, Items > 0 ? L"Volume keys: choose     Power key: confirm" : L"Power key = confirm     any other key = cancel");
+
+  //
+  // The press that chose the entry, and anything typed since, must not answer the question.
+  //
+  gBS->Stall (500000);
+  while (!EFI_ERROR (gST->ConIn->ReadKeyStroke (gST->ConIn, &Key))) {
+  }
+
+  for ( ; ;) {
+    if (Items > 0) {
+      UnicodeSPrint (Line, sizeof (Line), L"<  %s  >", (Shown + 1 == Items) ? L"Cancel" : Entry->ConfirmTitles[Shown]);
+      UniXNUUiDrawStatus (Ui, 1, Line);
+    } else {
+      UniXNUUiDrawStatus (Ui, 1, L"");
+    }
+
+    if (EFI_ERROR (gBS->WaitForEvent (1, &gST->ConIn->WaitForKey, &Index))) {
+      return FALSE;
+    }
+
+    if (EFI_ERROR (gST->ConIn->ReadKeyStroke (gST->ConIn, &Key))) {
+      continue;
+    }
+
+    if (Items > 0) {
+      if (Key.ScanCode == SCAN_UP) {
+        Shown = (Shown + Items - 1) % Items;
+        continue;
+      }
+
+      if (Key.ScanCode == SCAN_DOWN) {
+        Shown = (Shown + 1) % Items;
+        continue;
+      }
+    }
+
+    if ((Key.UnicodeChar == CHAR_CARRIAGE_RETURN) || (Key.UnicodeChar == CHAR_LINEFEED)) {
+      if (Items > 0) {
+        if (Shown + 1 == Items) {
+          return FALSE;
+        }
+
+        *Choice = Shown;
+      }
+
+      UniXNULog ("menu: confirmed '%a' choice %u", (Entry->Id != NULL) ? Entry->Id : "?", (UINT32)*Choice);
+      return TRUE;
+    }
+
+    return FALSE;
+  }
+}
diff --git a/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/README.md b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/README.md
new file mode 100644
index 0000000..8931bb7
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Library/DiagUniXNULib/README.md
@@ -0,0 +1,68 @@
+# Restricted UniXNU library for the K70 USB diagnostic profile
+
+This is an isolated copy of upstream UniXNULib, pinned in `SOURCE-PIN.json`
+(commit and SHA-256 of every original copied file). Original copyright and
+`BSD-2-Clause-Patent` notices remain in the sources. It is always restricted;
+there is no compiler define that restores the original payload or injection
+implementation. The normal UniXNULib source tree is unchanged.
+
+Map only the diagnostic profile's `UniXNULib` class to
+`K70DiagnosticsPkg/Library/DiagUniXNULib/DiagUniXNULib.inf`.
+
+After the normal read-only configuration discovery, `Main.c` immediately calls
+`DiagRestrictConfig()`. Regardless of a present, absent, or old configuration,
+the executable entries become a fixed static list: Tools, Restart, Power off.
+The default is Tools. UI preferences can still come from configuration, but
+entry arguments, confirmation data, variables, DTBs, initrds, kexts, block
+slices, ACPI tables, and dynamic driver requests are discarded.
+
+The restricted `Menu.c` waits for actual input in both the main menu and Tools
+submenu. It has no countdown, no-input fallback, or idle rotation. In particular,
+an absent filesystem does not cause the upstream built-in ten-second “Return to
+firmware” entry to execute. After UI initialization the normal UniXNU application
+automatically runs the USB service once at `TPL_APPLICATION`. It accepts exactly
+one installed plugin with the exact title `K70 USB diagnostics (read-only)` and
+valid signature/version. Missing, duplicate, malformed, or differently named
+plugins are not automatically invoked. A missing graphics context or any other
+TPL also prevents automatic entry. The same content rectangle and status
+callback serve the automatic and manual Tools paths.
+
+After that call returns, the application remains in its menu waiting for real
+input; it does not re-enter the provider automatically. The USB diagnostic
+profile sets `K70_USB_DIAG_AUTOSTART=0`, so OEM USB operations are not run by a
+`TPL_CALLBACK` timer. The consumer's optional ReadyToBoot/timer alternative
+remains available in source but is disabled for this profile.
+
+`Boot.c` independently refuses EFI/Linux/XNU payloads, firmware Exit, unknown
+types/actions, and NULL entries. The only actions are Tools and user-selected
+Restart/Power off. `Inject.c`, `Kext.c`, and `Slice.c` contain rejecting stubs:
+no dynamic driver/ACPI/DT/initrd/variable/kext injection, recursive controller
+connection, or block-slice publication occurs. These sources contain no
+LoadImage, StartImage, loader-protocol handoff, or ExitBootServices call.
+
+The UniXNU application is loaded from the firmware volume by UniXNUDxe/BDS;
+it requires no FAT volume. This library can display its menu with no Android
+ramdisk or other filesystem.
+
+This restriction does not replace platform BDS policy. BDS/UefiBootManagerLib
+still has BootNext/BootOrder and generic EFI loading, and the Tools menu invokes
+installed menu-plugin callbacks. The isolated FV must therefore contain only
+the intended USB diagnostic plugin, omit OS loaders and physical storage
+providers, and carry no executable filesystem. The normal successful UniXNU
+application path remains in its fixed menu and does not return to BDS.
+
+Validation compiles the actual restricted sources with ASan/UBSan. The host
+test calls the real Boot/injection functions and runs the real Menu.c through
+1,000 virtual timer ticks without input (both countdown settings), confirming
+no automatic action or rotation. ResetSystem and event services are local mocks;
+no device or firmware is opened. A separate actual-Menu.c mock tests one-shot
+automatic selection, exact title/signature/version, missing/duplicate plugins,
+TPL/GOP rejection, bounded handle count, and refusal to auto-run a second time.
+Run `bash Tests/run-host-tests.sh` with `EDK2_ROOT` and `UNIXNU_ROOT` pointing
+to the pinned edk2/mu_basecore and UniXNU checkouts. No local checkout path is
+embedded in the test script. `ClangdAutoGen.h` is generated editor/standalone
+support synchronized from the baseline, excluded from this publication, and
+not an EDK INF source. All library C sources also compile to AArch64 COFF with
+the real MdePkg/UniXNUPkg headers and `-Wall -Wextra -Werror`; standalone checks
+use a two-PCD compile shim, while the integrated firmware uses EDK AutoGen.
+Full firmware linkage and handset behavior are separate checks.
