index 0000000..223012a
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Drivers/K70UsbDiagDxe/K70UsbDiagCore.c
@@ -0,0 +1,282 @@
+/** @file
+  Only complete, explicitly allowed fastboot commands produce query replies.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#include "K70UsbDiagCore.h"
+
+static void
+Clear(void *Buffer, KD_SIZE Bytes)
+{
+  KD_BYTE *Out = (KD_BYTE *)Buffer;
+  while (Bytes-- != 0U) {
+    *Out++ = 0;
+  }
+}
+
+static int
+Equals(const KD_BYTE *Command, KD_SIZE Bytes, const char *Expected)
+{
+  KD_SIZE Index;
+  for (Index = 0; Expected[Index] != '\0'; ++Index) {
+    if ((Index >= Bytes) || (Command[Index] != (KD_BYTE)Expected[Index])) {
+      return 0;
+    }
+  }
+  return Index == Bytes;
+}
+
+static void
+Packet(KD_REPLY_PLAN *Plan, const char *Code, const char *Text)
+{
+  KD_SIZE Index;
+  KD_SIZE Length = 0;
+  if (Plan->Count >= KD_MAX_PACKETS) {
+    return;
+  }
+  for (Index = 0; Index < 4U; ++Index) {
+    Plan->Packet[Plan->Count][Length++] = (KD_BYTE)Code[Index];
+  }
+  for (Index = 0; (Text[Index] != '\0') && (Length < KD_PACKET_BYTES); ++Index) {
+    Plan->Packet[Plan->Count][Length++] = (KD_BYTE)Text[Index];
+  }
+  Plan->Length[Plan->Count++] = Length;
+}
+
+void
+KdBuildReply(const KD_BYTE *Command, KD_SIZE Bytes, KD_REPLY_PLAN *Plan)
+{
+  KD_SIZE Index;
+  Clear(Plan, (KD_SIZE)sizeof(*Plan));
+  if ((Bytes == 0U) || (Bytes > KD_COMMAND_BYTES) || (Command == 0)) {
+    Packet(Plan, "FAIL", "invalid command length");
+    return;
+  }
+  for (Index = 0; Index < Bytes; ++Index) {
+    if ((Command[Index] < 0x20U) || (Command[Index] > 0x7eU)) {
+      Packet(Plan, "FAIL", "command must be printable ASCII");
+      return;
+    }
+  }
+  if (Equals(Command, Bytes, "getvar:version")) {
+    Packet(Plan, "OKAY", "0.4");
+  } else if (Equals(Command, Bytes, "getvar:product")) {
+    Packet(Plan, "OKAY", "vermeer");
+  } else if (Equals(Command, Bytes, "getvar:serialno")) {
+    Packet(Plan, "OKAY", "K70UEFI20261104");
+  } else if (Equals(Command, Bytes, "getvar:k70-diag")) {
+    Packet(Plan, "OKAY", "uefi-usb-probe-v1");
+  } else if (Equals(Command, Bytes, "getvar:k70-hello")) {
+    Packet(Plan, "OKAY", "HELLO K70 UEFI read-only query service");
+  } else if (Equals(Command, Bytes, "getvar:k70-log")) {
+    Plan->RequestLog = 1;
+  } else if (Equals(Command, Bytes, "getvar:all")) {
+    Packet(Plan, "INFO", "version:0.4");
+    Packet(Plan, "INFO", "product:vermeer");
+    Packet(Plan, "INFO", "serialno:K70UEFI20261104");
+    Packet(Plan, "INFO", "k70-diag:uefi-usb-probe-v1");
+    Packet(Plan, "INFO", "k70-log:query snapshot separately");
+    Packet(Plan, "OKAY", "");
+  } else {
+    Packet(Plan, "FAIL", "unsupported; read-only query service");
+  }
+}
+
+void
+KdSessionStart(KD_SESSION *Session, const KD_IO *Io, KD_BYTE *Rx,
+               KD_BYTE *Tx, KD_SIZE BufferBytes, KD_TIME NowMs)
+{
+  Clear(Session, (KD_SIZE)sizeof(*Session));
+  Session->Io = *Io;
+  Session->Rx = Rx;
+  Session->Tx = Tx;
+  Session->BufferBytes = BufferBytes;
+  Session->StartedMs = NowMs;
+  Session->LastActivityMs = NowMs;
+  if ((Rx == 0) || (Tx == 0) || (BufferBytes < KD_PACKET_BYTES) ||
+      (Io->Queue == 0) || (Io->Abort == 0)) {
+    Session->StopReason = KdTransportError;
+  }
+}
+
+void
+KdSessionStop(KD_SESSION *Session, KD_STOP_REASON Reason)
+{
+  if (Session->StopReason != KdRunning) {
+    return;
+  }
+  Session->StopReason = Reason;
+  if (Session->PendingRx) {
+    Session->Io.Abort(Session->Io.Context, (KD_BYTE)KD_EP_OUT);
+  }
+  if (Session->PendingTx) {
+    Session->Io.Abort(Session->Io.Context, (KD_BYTE)KD_EP_IN);
+  }
+  /* The adapter retains independent DMA ownership until terminal events. */
+  Session->PendingRx = 0;
+  Session->PendingTx = 0;
+}
+
+void
+KdSessionTick(KD_SESSION *Session, KD_TIME NowMs)
+{
+  KD_SIZE Index;
+  KD_SIZE Bytes;
+  int Queued;
+  if (Session->StopReason != KdRunning) {
+    return;
+  }
+  if (NowMs - Session->StartedMs >= KD_SESSION_TIMEOUT_MS) {
+    KdSessionStop(Session, KdSessionTimeout);
+    return;
+  }
+  if (!Session->Connected && (Session->Commands == 0U) &&
+      (NowMs - Session->StartedMs >= KD_CONNECT_TIMEOUT_MS)) {
+    KdSessionStop(Session, KdConnectTimeout);
+    return;
+  }
+  if (Session->Connected &&
+      (NowMs - Session->LastActivityMs >= KD_IDLE_TIMEOUT_MS)) {
+    KdSessionStop(Session, KdIdleTimeout);
+    return;
+  }
+  if (Session->PendingTx &&
+      (NowMs - Session->TxStartedMs >= KD_TX_TIMEOUT_MS)) {
+    KdSessionStop(Session, KdTransferTimeout);
+    return;
+  }
+  if (Session->PendingRx || Session->PendingTx ||
+      (Session->QueueBackoff &&
+       (NowMs - Session->LastQueueAttemptMs < KD_QUEUE_RETRY_MS))) {
+    return;
+  }
+  Session->LastQueueAttemptMs = NowMs;
+  if (Session->LogActive || (Session->Replies.Next < Session->Replies.Count)) {
+    Session->PendingLogKind = 0;
+    if (Session->LogActive) {
+      if (Session->LogOffset < Session->LogBytes) {
+        static const char Info[] = "INFO";
+        Bytes = 4U;
+        for (Index = 0; Index < 4U; ++Index) {
+          Session->Tx[Index] = (KD_BYTE)Info[Index];
+        }
+        Index = Session->LogOffset;
+        while ((Index < Session->LogBytes) && (Bytes < KD_PACKET_BYTES)) {
+          KD_BYTE Ch = Session->LogData[Index++];
+          if (((Ch < 0x20U) && (Ch != '\r') && (Ch != '\n')) || (Ch > 0x7eU)) {
+            Ch = '?';
+          }
+          Session->Tx[Bytes++] = Ch;
+        }
+        Session->PendingLogOffset = Index;
+        Session->PendingLogKind = 1;
+      } else {
+        static const char Okay[] = "OKAY";
+        Bytes = 4U;
+        for (Index = 0; Index < 4U; ++Index) {
+          Session->Tx[Index] = (KD_BYTE)Okay[Index];
+        }
+        Session->PendingLogKind = 2;
+      }
+    } else {
+      Bytes = Session->Replies.Length[Session->Replies.Next];
+      for (Index = 0; Index < Bytes; ++Index) {
+        Session->Tx[Index] = Session->Replies.Packet[Session->Replies.Next][Index];
+      }
+    }
+    Queued = Session->Io.Queue(Session->Io.Context, (KD_BYTE)KD_EP_IN,
+                               Session->Tx, Bytes);
+    if (Queued == KD_QUEUE_OK) {
+      Session->PendingTx = 1;
+      Session->PendingTxBytes = Bytes;
+      Session->TxStartedMs = NowMs;
+    }
+  } else {
+    Queued = Session->Io.Queue(Session->Io.Context, (KD_BYTE)KD_EP_OUT,
+                               Session->Rx, KD_COMMAND_BYTES);
+    if (Queued == KD_QUEUE_OK) {
+      Session->PendingRx = 1;
+    }
+  }
+  Session->QueueBackoff = Queued == KD_QUEUE_RETRY;
+  if ((Queued != KD_QUEUE_OK) && (Queued != KD_QUEUE_RETRY)) {
+    KdSessionStop(Session, KdTransportError);
+  }
+}
+
+void
+KdSessionConnection(KD_SESSION *Session, int Connected, KD_TIME NowMs)
+{
+  if (Session->StopReason != KdRunning) {
+    return;
+  }
+  if (Connected) {
+    Session->Connected = 1;
+    Session->LastActivityMs = NowMs;
+    Session->QueueBackoff = 0;
+  } else if (Session->Connected || (Session->Commands != 0U)) {
+    KdSessionStop(Session, KdDisconnected);
+  }
+  /* An initial disconnected notification is normal before enumeration. */
+}
+
+void
+KdSessionTransfer(KD_SESSION *Session, KD_BYTE Endpoint, int CompleteOk,
+                  KD_SIZE Bytes, const void *Buffer, KD_TIME NowMs)
+{
+  if (Session->StopReason != KdRunning) {
+    return;
+  }
+  if ((Endpoint == KD_EP_OUT) && Session->PendingRx && (Buffer == Session->Rx)) {
+    Session->PendingRx = 0;
+    if (!CompleteOk) {
+      if (Session->Connected || (Session->Commands != 0U)) {
+        KdSessionStop(Session, KdTransportError);
+      }
+      return;
+    }
+    if ((Bytes > KD_COMMAND_BYTES) || (Bytes > Session->BufferBytes)) {
+      KdSessionStop(Session, KdTransportError);
+      return;
+    }
+    Session->Connected = 1;
+    Session->LastActivityMs = NowMs;
+    Session->QueueBackoff = 0;
+    ++Session->Commands;
+    KdBuildReply(Session->Rx, Bytes, &Session->Replies);
+    if (Session->Replies.RequestLog) {
+      const KD_BYTE *Snapshot = 0;
+      KD_SIZE SnapshotBytes = 0;
+      int Result = Session->Io.Snapshot == 0 ? 1 :
+        Session->Io.Snapshot(Session->Io.Context, &Snapshot, &SnapshotBytes);
+      if ((Result == 0) && (SnapshotBytes <= KD_LOG_LIMIT) &&
+          ((Snapshot != 0) || (SnapshotBytes == 0U))) {
+        Session->LogData = Snapshot;
+        Session->LogBytes = SnapshotBytes;
+        Session->LogOffset = 0;
+        Session->LogActive = 1;
+      } else {
+        Packet(&Session->Replies, "FAIL", Result == 1 ? "firmware log ring not installed" :
+          Result == 2 ? "firmware log ring busy; retry" : "invalid firmware log snapshot");
+      }
+    }
+  } else if ((Endpoint == KD_EP_IN) && Session->PendingTx && (Buffer == Session->Tx)) {
+    Session->PendingTx = 0;
+    if (!CompleteOk || (Bytes != Session->PendingTxBytes)) {
+      KdSessionStop(Session, KdTransportError);
+      return;
+    }
+    Session->LastActivityMs = NowMs;
+    Session->QueueBackoff = 0;
+    if (Session->PendingLogKind == 1) {
+      Session->LogOffset = Session->PendingLogOffset;
+    } else if (Session->PendingLogKind == 2) {
+      Session->LogActive = 0;
+      Session->LogData = 0;
+      Session->LogBytes = 0;
+    } else {
+      ++Session->Replies.Next;
+    }
+  } else {
+    ++Session->IgnoredCompletions;
+  }
+}
diff --git a/package/uefi/K70DiagnosticsPkg/Drivers/K70UsbDiagDxe/K70UsbDiagCore.h b/package/uefi/K70DiagnosticsPkg/Drivers/K70UsbDiagDxe/K70UsbDiagCore.h
new file mode 100644
index 0000000..14e1ae5
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Drivers/K70UsbDiagDxe/K70UsbDiagCore.h
@@ -0,0 +1,93 @@
+/** @file
+  Bounded, storage-free fastboot query state machine.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#ifndef K70_USB_DIAG_CORE_H
+#define K70_USB_DIAG_CORE_H
+
+/* No UEFI or libc dependency: the same engine is exercised by the host mock. */
+typedef unsigned char KD_BYTE;
+typedef unsigned int KD_SIZE;
+typedef unsigned long long KD_TIME;
+
+#define KD_EP_OUT                 0x01U
+#define KD_EP_IN                  0x81U
+#define KD_COMMAND_BYTES          64U
+#define KD_PACKET_BYTES           64U
+#define KD_MAX_PACKETS            8U
+#define KD_CONNECT_TIMEOUT_MS     30000ULL
+#define KD_IDLE_TIMEOUT_MS        60000ULL
+#define KD_TX_TIMEOUT_MS          5000ULL
+#define KD_SESSION_TIMEOUT_MS     180000ULL
+#define KD_QUEUE_RETRY_MS         100ULL
+#define KD_LOG_LIMIT              65536U
+
+enum {
+  KD_QUEUE_OK = 0,
+  KD_QUEUE_RETRY = 1,
+  KD_QUEUE_ERROR = -1
+};
+
+typedef enum {
+  KdRunning = 0,
+  KdUserExit,
+  KdConnectTimeout,
+  KdIdleTimeout,
+  KdTransferTimeout,
+  KdSessionTimeout,
+  KdTransportError,
+  KdDisconnected
+} KD_STOP_REASON;
+
+typedef struct {
+  KD_BYTE Packet[KD_MAX_PACKETS][KD_PACKET_BYTES];
+  KD_SIZE Length[KD_MAX_PACKETS];
+  KD_SIZE Count;
+  KD_SIZE Next;
+  int RequestLog;
+} KD_REPLY_PLAN;
+
+typedef struct {
+  void *Context;
+  int (*Queue)(void *Context, KD_BYTE Endpoint, KD_BYTE *Buffer, KD_SIZE Bytes);
+  void (*Abort)(void *Context, KD_BYTE Endpoint);
+  /* 0 = immutable snapshot ready, 1 = no ring, 2 = busy, -1 = invalid. */
+  int (*Snapshot)(void *Context, const KD_BYTE **Data, KD_SIZE *Bytes);
+} KD_IO;
+
+typedef struct {
+  KD_IO Io;
+  KD_BYTE *Rx;
+  KD_BYTE *Tx;
+  KD_SIZE BufferBytes;
+  KD_REPLY_PLAN Replies;
+  KD_TIME StartedMs;
+  KD_TIME LastActivityMs;
+  KD_TIME TxStartedMs;
+  KD_TIME LastQueueAttemptMs;
+  KD_SIZE Commands;
+  KD_SIZE IgnoredCompletions;
+  KD_SIZE PendingTxBytes;
+  const KD_BYTE *LogData;
+  KD_SIZE LogBytes;
+  KD_SIZE LogOffset;
+  KD_SIZE PendingLogOffset;
+  int LogActive;
+  int PendingLogKind;
+  int Connected;
+  int PendingRx;
+  int PendingTx;
+  int QueueBackoff;
+  KD_STOP_REASON StopReason;
+} KD_SESSION;
+
+void KdBuildReply(const KD_BYTE *Command, KD_SIZE Bytes, KD_REPLY_PLAN *Plan);
+void KdSessionStart(KD_SESSION *Session, const KD_IO *Io, KD_BYTE *Rx,
+                    KD_BYTE *Tx, KD_SIZE BufferBytes, KD_TIME NowMs);
+void KdSessionTick(KD_SESSION *Session, KD_TIME NowMs);
+void KdSessionConnection(KD_SESSION *Session, int Connected, KD_TIME NowMs);
+void KdSessionTransfer(KD_SESSION *Session, KD_BYTE Endpoint, int CompleteOk,
+                       KD_SIZE Bytes, const void *Buffer, KD_TIME NowMs);
+void KdSessionStop(KD_SESSION *Session, KD_STOP_REASON Reason);
+
+#endif
diff --git a/package/uefi/K70DiagnosticsPkg/Drivers/K70UsbDiagDxe/K70UsbDiagDxe.c b/package/uefi/K70DiagnosticsPkg/Drivers/K70UsbDiagDxe/K70UsbDiagDxe.c
