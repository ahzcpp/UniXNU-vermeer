@@ -0,0 +1,333 @@
+#!/usr/bin/env python3
+"""Build the isolated Redmi K70 USB diagnostic firmware from an assembled SDK.
+
+Python 3.11+, Linux/WSL, the existing assembled UniXNU firmware environment,
+prepared OEM inputs, and a compatible CLANGPDB toolchain are prerequisites.
+This entry point does not download an SDK, assemble feeds, or access a device.
+"""
+from __future__ import annotations
+
+import argparse
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import shlex
+import signal
+import subprocess
+import sys
+import tomllib
+
+PROFILE = "K70DiagnosticsPkg/Profiles/vermeer-usb-diag.dsc"
+DEFINES = {
+    "FD_BASE": "0xa7100000",
+    "FD_SIZE": "0x300000",
+    "FD_BLOCKS": "768",
+    "ENABLE_SECUREBOOT": "1",
+    "DEVICE_MODEL": "vermeer",
+    "MEMORY_PROTECTION": "TRUE",
+    "SHIP_MODE": "FALSE",
+    "BUILDID_STRING": "vermeer-usb-diag-01",
+}
+TEMPLATES = {"target.template": "target.txt", "tools_def.template": "tools_def.txt", "build_rule.template": "build_rule.txt"}
+
+
+def sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def git(root: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess:
+    return subprocess.run(["git", "-C", str(root), *args], check=check, capture_output=True)
+
+
+def existing_dir(value: Path, label: str) -> Path:
+    path = value.expanduser().resolve()
+    if not path.is_dir():
+        raise ValueError(f"{label} is not an existing directory: {path}")
+    return path
+
+
+def executable(path: Path) -> None:
+    if not path.is_file() or not os.access(path, os.X_OK):
+        raise ValueError(f"required executable is unavailable: {path}")
+
+
+def make_plan(args: argparse.Namespace) -> dict:
+    if os.name != "posix":
+        raise ValueError("run this build entry point under Linux or WSL")
+    if args.jobs < 1:
+        raise ValueError("--jobs must be at least 1")
+    uefi = existing_dir(args.uefi_root, "--uefi-root")
+    edk2 = existing_dir(args.edk2_root, "--edk2-root")
+    tree = existing_dir(args.tree, "--tree (assembled firmware tree)")
+    device = existing_dir(args.device_root, "--device-root")
+    if not args.clang_bin:
+        raise ValueError("provide --clang-bin or set CLANG_BIN")
+    clang = existing_dir(Path(args.clang_bin), "--clang-bin / CLANG_BIN")
+    for name in ("clang", "clang++", "lld-link", "llvm-lib"):
+        executable(clang / name)
+    tools = edk2 / "BaseTools"
+    wrapper = tools / "BinWrappers/PosixLike/build"
+    executable(wrapper)
+    for name in ("GenFw", "GenFfs", "GenFv", "GenSec"):
+        executable(tools / "Source/C/bin" / name)
+    for source in TEMPLATES:
+        if not (tools / "Conf" / source).is_file():
+            raise ValueError(f"missing BaseTools configuration template: {source}")
+    board_path = device / "board.toml"
+    board = tomllib.loads(board_path.read_text(encoding="utf-8-sig"))
+    if board.get("board", {}).get("name") != "vermeer":
+        raise ValueError("this diagnostic profile requires a vermeer board.toml")
+    entries = board.get("firmware", {}).get("packages")
+    if not isinstance(entries, list) or not entries or not all(isinstance(p, str) for p in entries):
+        raise ValueError("board.toml [firmware].packages must be a nonempty string array")
+    fields = {"uefi": str(uefi), "edk2": str(edk2), "tree": str(tree)}
+    packages = [device / "package/uefi"]
+    for entry in entries:
+        try:
+            expanded = entry.format(**fields)
+        except (KeyError, ValueError, IndexError) as exc:
+            raise ValueError(f"invalid [firmware].packages template: {entry}") from exc
+        path = Path(expanded)
+        if not path.is_absolute():
+            path = device / path
+        packages.append(path)
+    packages = list(dict.fromkeys(existing_dir(p, "firmware package") for p in packages))
+    profile = device / "package/uefi" / PROFILE
+    dsc = profile.read_text(encoding="utf-8-sig")
+    output_lines = [line.split("=", 1)[1].strip().split("#", 1)[0].strip()
+                    for line in dsc.splitlines() if line.strip().startswith("OUTPUT_DIRECTORY") and "=" in line]
+    if output_lines != ["Build/vermeerUsbDiag"]:
+        raise ValueError("diagnostic DSC must keep OUTPUT_DIRECTORY=Build/vermeerUsbDiag")
+    if "K70DiagnosticsPkg/Profiles/vermeer-usb-diag.fdf" not in dsc:
+        raise ValueError("diagnostic DSC does not select its isolated FDF")
+    for name in ("vermeer-usb-diag.fdf", "DXE.inc", "APRIORI.inc"):
+        if not profile.with_name(name).is_file():
+            raise ValueError(f"diagnostic profile input missing: {name}")
+    # Missing prepared OEM binaries are an input error, not a reason to copy a
+    # different board's binaries or run arbitrary preparation scripts here.
+    for line in profile.with_name("DXE.inc").read_text(encoding="utf-8-sig").splitlines():
+        line = line.split("#", 1)[0].strip()
+        if line.startswith("INF Binaries/vermeerUsbDiag/Oem/"):
+            relative = line.split()[1]
+            if not any((package / relative).is_file() for package in packages):
+                raise ValueError(f"prepared OEM INF is missing: {relative}; run prepare-oem.py first")
+    patch_entries = board.get("firmware", {}).get("patches", [])
+    if not isinstance(patch_entries, list) or not all(isinstance(p, str) for p in patch_entries):
+        raise ValueError("[firmware].patches must be a string array")
+    patches = []
+    for entry in patch_entries:
+        relative = PurePosixPath(entry)
+        if relative.is_absolute() or ".." in relative.parts:
+            raise ValueError(f"patch must be relative to --uefi-root: {entry}")
+        path = (uefi / entry).resolve()
+        if not path.is_relative_to(uefi) or not path.is_file():
+            raise ValueError(f"firmware patch is missing or escapes --uefi-root: {entry}")
+        patches.append(path)
+    epoch = os.environ.get("SOURCE_DATE_EPOCH")
+    if epoch is None:
+        epoch = git(uefi, "log", "-1", "--format=%ct").stdout.decode().strip()
+    if not epoch.isdigit():
+        raise ValueError("SOURCE_DATE_EPOCH must be a nonnegative integer")
+    log = args.log.expanduser().resolve()
+    conf = log.with_name(log.name + ".conf")
+    command = [str(wrapper), "-p", PROFILE, "-a", "AARCH64", "-b", "DEBUG", "-t", "CLANGPDB", "-n", str(args.jobs)]
+    for name, value in DEFINES.items():
+        command += ["-D", f"{name}={value}"]
+    env = dict(os.environ)
+    env.update(WORKSPACE=str(uefi), EDK_TOOLS_PATH=str(tools), CONF_PATH=str(conf),
+               PACKAGES_PATH=os.pathsep.join(map(str, packages)), PYTHON_COMMAND=sys.executable,
+               CLANG_BIN=str(clang) + os.sep,
+               CLANGPDB_AARCH64_PREFIX=os.environ.get("CLANGPDB_AARCH64_PREFIX", "aarch64-linux-gnu-"),
+               SOURCE_DATE_EPOCH=epoch)
+    env["PATH"] = os.pathsep.join([str(tools / "BinWrappers/PosixLike"), str(tools / "Source/C/bin"), str(clang), os.environ.get("PATH", "")])
+    return dict(uefi=uefi, edk2=edk2, tree=tree, device=device, tools=tools, log=log, conf=conf,
+                packages=packages, patches=patches, command=command, env=env,
+                board_sha256=sha(board_path.read_bytes()), profile_sha256=sha(profile.read_bytes()))
+
+
+def initialize_conf(plan: dict) -> None:
+    conf, tools = plan["conf"], plan["tools"]
+    expected = {target: sha((tools / "Conf" / source).read_bytes()) for source, target in TEMPLATES.items()}
+    marker = conf / "k70-usb-diag-conf.json"
+    if conf.exists() and any(conf.iterdir()):
+        if not marker.is_file():
+            raise ValueError(f"refusing to modify an unowned CONF directory: {conf}")
+        saved = json.loads(marker.read_text())
+        if saved.get("templates") != expected:
+            raise ValueError("CONF was created with different BaseTools templates; choose a new --log")
+        for target, digest in expected.items():
+            if not (conf / target).is_file() or sha((conf / target).read_bytes()) != digest:
+                raise ValueError(f"owned CONF file was changed; refusing to overwrite: {target}")
+        return
+    conf.mkdir(parents=True, exist_ok=True)
+    for source, target in TEMPLATES.items():
+        (conf / target).write_bytes((tools / "Conf" / source).read_bytes())
+    marker.write_text(json.dumps({"schema": "k70-usb-diag-conf/1", "templates": expected}, indent=2) + "\n")
+
+
+@contextmanager
+def sdk_patch_lock(root: Path):
+    """Serialize this tool's precheck/apply/build/reverse transaction."""
+    path = root / ".k70-usb-diag-patch.lock"
+    try:
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    except FileExistsError as exc:
+        raise ValueError(f"another build owns the SDK patch lock: {path}") from exc
+    identity = os.fstat(fd)
+    try:
+        os.write(fd, f"pid={os.getpid()}\n".encode())
+        yield
+    finally:
+        os.close(fd)
+        if path.exists():
+            current = path.stat()
+            if (current.st_dev, current.st_ino) != (identity.st_dev, identity.st_ino):
+                raise RuntimeError("SDK patch lock was replaced unexpectedly")
+            path.unlink()
+
+
+class PatchSet:
+    """Reverse only patches applied by this invocation and verify exact bytes."""
+    def __init__(self, root: Path):
+        self.root = root
+        self.records: list[dict] = []
+
+    def apply(self, patch: Path) -> None:
+        checked = git(self.root, "apply", "--check", str(patch), check=False)
+        if checked.returncode:
+            raise RuntimeError(f"patch precheck failed (possibly already applied externally): {patch.name}\n" + checked.stderr.decode(errors="replace"))
+        listing = git(self.root, "apply", "--numstat", "-z", str(patch)).stdout
+        paths = []
+        for entry in listing.split(b"\0"):
+            if not entry:
+                continue
+            fields = entry.split(b"\t", 2)
+            if len(fields) != 3:
+                raise ValueError("unsupported patch filename/rename metadata")
+            relative = PurePosixPath(fields[2].decode())
+            if relative.is_absolute() or ".." in relative.parts:
+                raise ValueError("patch target escapes the EDK tree")
+            path = (self.root / str(relative)).resolve()
+            if not path.is_relative_to(self.root):
+                raise ValueError("patch target resolves outside the EDK tree")
+            paths.append(path)
+        if not paths:
+            raise ValueError("firmware patch has no file targets")
+        before = {path: path.read_bytes() if path.exists() else None for path in paths}
+        # Register before mutation so an interrupted apply is covered by finally.
+        self.records.append({"patch": patch, "patch_sha256": sha(patch.read_bytes()), "before": before})
+        git(self.root, "apply", str(patch))
+
+    def cleanup(self) -> None:
+        failures = []
+        for record in reversed(self.records):
+            before = record["before"]
+            def unchanged():
+                return all((path.read_bytes() if path.exists() else None) == value for path, value in before.items())
+            try:
+                if unchanged():
+                    continue
+                if sha(record["patch"].read_bytes()) != record["patch_sha256"]:
+                    raise RuntimeError("patch input changed during build")
+                git(self.root, "apply", "--reverse", "--check", str(record["patch"]))
+                git(self.root, "apply", "--reverse", str(record["patch"]))
+                if not unchanged():
+                    raise RuntimeError("target bytes do not match the pre-apply snapshot")
+            except Exception as exc:
+                failures.append(f"{record['patch'].name}: {exc}")
+        if failures:
+            raise RuntimeError("patch cleanup verification failed; build is not successful: " + "; ".join(failures))
+
+
+def run_build_locked(plan: dict) -> int:
+    if plan["log"].exists():
+        raise ValueError("--log already exists; choose a new log to preserve previous build evidence")
+    initialize_conf(plan)
+    plan["log"].parent.mkdir(parents=True, exist_ok=True)
+    patches = PatchSet(plan["edk2"])
+    result = {"command": plan["command"], "defines": DEFINES, "profile_sha256": plan["profile_sha256"],
+              "board_sha256": plan["board_sha256"], "hardware_tested": False,
+              "exit_code": 1, "patch_cleanup_verified": False}
+    child = None
+    old_term = signal.getsignal(signal.SIGTERM)
+    def interrupted(signum, frame):
+        raise KeyboardInterrupt
+    signal.signal(signal.SIGTERM, interrupted)
+    try:
+        with plan["log"].open("x", encoding="utf-8") as output:
+            output.write("Command: " + shlex.join(plan["command"]) + "\n")
+            output.write("CONF_PATH: " + str(plan["conf"]) + "\n")
+            output.flush()
+            try:
+                for patch in plan["patches"]:
+                    patches.apply(patch)
+                child = subprocess.Popen(plan["command"], cwd=plan["uefi"], env=plan["env"],
+                                         stdout=output, stderr=subprocess.STDOUT, start_new_session=True)
+                result["exit_code"] = child.wait()
+            except KeyboardInterrupt:
+                result["exit_code"] = 130
+                if child is not None and child.poll() is None:
+                    os.killpg(child.pid, signal.SIGTERM)
+                    try:
+                        child.wait(timeout=10)
+                    except subprocess.TimeoutExpired:
+                        os.killpg(child.pid, signal.SIGKILL)
+                        child.wait()
+            except Exception as exc:
+                result["error"] = str(exc)
+            finally:
+                # Do not let a second ordinary interrupt interrupt source repair.
+                old_int = signal.signal(signal.SIGINT, signal.SIG_IGN)
+                term_during_cleanup = signal.signal(signal.SIGTERM, signal.SIG_IGN)
+                try:
+                    patches.cleanup()
+                    result["patch_cleanup_verified"] = True
+                except Exception as exc:
+                    result["cleanup_error"] = str(exc)
+                    result["exit_code"] = 2
+                finally:
+                    signal.signal(signal.SIGINT, old_int)
+                    signal.signal(signal.SIGTERM, term_during_cleanup)
+    finally:
+        signal.signal(signal.SIGTERM, old_term)
+        result["success"] = result["exit_code"] == 0 and result["patch_cleanup_verified"]
+        plan["log"].with_name(plan["log"].name + ".result.json").write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps({"success": result["success"], "exit_code": result["exit_code"], "log": str(plan["log"]),
+                      "patch_cleanup_verified": result["patch_cleanup_verified"], "hardware_tested": False}))
+    return result["exit_code"]
+
+
+def run_build(plan: dict) -> int:
+    with sdk_patch_lock(plan["edk2"]):
+        return run_build_locked(plan)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--uefi-root", type=Path, required=True, help="prepared Mu-Silicium source checkout")
+    parser.add_argument("--edk2-root", type=Path, required=True, help="assembled pinned EDK2/Mu BaseCore feed with built BaseTools")
+    parser.add_argument("--tree", type=Path, required=True, help="already assembled UniXNU firmware tree")
+    parser.add_argument("--device-root", type=Path, default=Path(__file__).resolve().parents[4], help="device repository containing board.toml; inferred from this Tools path")
+    parser.add_argument("--clang-bin", default=os.environ.get("CLANG_BIN"), help="compatible LLVM binary directory, or CLANG_BIN environment variable")
+    parser.add_argument("--jobs", type=int, default=2, help="EDK parallel jobs (default: 2)")
+    parser.add_argument("--log", type=Path, required=True, help="new build log; an independent <log>.conf directory is created beside it")
+    parser.add_argument("--check-only", action="store_true", help="validate paths/inputs and print the plan; no build, patch, CONF or log writes")
+    args = parser.parse_args()
+    try:
+        plan = make_plan(args)
+        if args.check_only:
+            print(json.dumps({"valid": True, "build_started": False, "writes_performed": False,
+                              "command": plan["command"], "conf_path": str(plan["conf"]),
+                              "packages_path": [str(p) for p in plan["packages"]],
+                              "patches": [p.name for p in plan["patches"]], "hardware_tested": False}, indent=2))
+            return 0
+        return run_build(plan)
+    except (ValueError, OSError, subprocess.CalledProcessError) as exc:
+        parser.error(str(exc))
+    return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
