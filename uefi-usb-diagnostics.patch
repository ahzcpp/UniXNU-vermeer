+#include "DtbTemplate.h"
+#include "SchedulerTemplate.h"
+
+#define FUNCTION_SCAN_BYTES  1024U
+#define MAX_ADDRESS_PAIRS    64U
+#define MAX_OEM_WINDOW_BYTES (4U * 1024U * 1024U)
+#define HOB_PROLOGUE         0xA9017BFDD10083FFULL
+#define DTB_LIVE_POINTER_AFTER_TABLE 0x75C0U
+STATIC_ASSERT (sizeof (EFI_KERNEL_PROTOCOL) == 0x60U, "Scheduler ABI size");
+STATIC_ASSERT (OFFSET_OF (EFI_KERNEL_PROTOCOL, WDog) == 0x48U, "Scheduler WDog ABI");
+STATIC_ASSERT (OFFSET_OF (EFI_KERNEL_PROTOCOL, Lock) == 0x58U, "Scheduler Lock ABI");
+
+BOOLEAN
+K70OemRangeContains (CONST K70_OEM_WINDOW *Window, EFI_PHYSICAL_ADDRESS Address, UINTN Bytes)
+{
+  UINT64 Offset;
+  if ((Window == NULL) || (Window->Bytes == 0U) || (Bytes == 0U) ||
+      (Window->Base > MAX_UINT64 - (Window->Bytes - 1U)) || (Address < Window->Base)) {
+    return FALSE;
+  }
+  Offset = Address - Window->Base;
+  return (BOOLEAN)((Offset < Window->Bytes) && (Bytes <= Window->Bytes - Offset));
+}
+
+EFI_STATUS
+K70GetOemWindow (K70_OEM_WINDOW *Window)
+{
+  EFI_MEMORY_REGION_DESCRIPTOR *Map, *Match;
+  UINT8 Count;
+  UINTN Index;
+  UINT64 NewBase, NewBytes;
+  if (Window == NULL) { return EFI_INVALID_PARAMETER; }
+  ZeroMem (Window, sizeof (*Window));
+  Map = NULL; Count = 0; Match = NULL;
+  GetMemoryMap (&Map, &Count);
+  if ((Map == NULL) || (Count == 0U) || (Count > MAX_ARM_MEMORY_REGION_DESCRIPTOR_COUNT)) {
+    return EFI_NOT_FOUND;
+  }
+  for (Index = 0; Index < Count; ++Index) {
+    if ((AsciiStrnCmp (Map[Index].Name, "FD Reserved", sizeof ("FD Reserved")) == 0) ||
+        (AsciiStrnCmp (Map[Index].Name, "FD_Reserved", sizeof ("FD_Reserved")) == 0)) {
+      if (Match != NULL) { return EFI_COMPROMISED_DATA; }
+      Match = &Map[Index];
+    }
+  }
+  if ((Match == NULL) || (Match->Address == 0U) || ((Match->Address & 3U) != 0U) ||
+      (Match->Length < 36U) || (Match->Length > MAX_OEM_WINDOW_BYTES) || (Match->Address > MAX_UINT64 - Match->Length) ||
+      (Match->ResourceType != EFI_RESOURCE_SYSTEM_MEMORY) ||
+      ((Match->MemoryType != EfiBootServicesCode) && (Match->MemoryType != EfiBootServicesData) &&
+       (Match->MemoryType != EfiReservedMemoryType)) ||
+      (Match->ArmAttributes != ARM_MEMORY_REGION_ATTRIBUTE_WRITE_BACK)) {
+    DEBUG ((DEBUG_ERROR, "K70 XBL: FD Reserved missing, ambiguous, non-RAM, XN, or invalid range\n"));
+    return EFI_SECURITY_VIOLATION;
+  }
+  NewBase = FixedPcdGet64 (PcdFdBaseAddress);
+  NewBytes = FixedPcdGet32 (PcdFdSize);
+  if ((NewBytes == 0U) || (NewBase > MAX_UINT64 - NewBytes) ||
+      ((Match->Address < NewBase + NewBytes) && (NewBase < Match->Address + Match->Length))) {
+    DEBUG ((DEBUG_ERROR, "K70 XBL: replacement FD overlaps OEM retention window; refusing stale backing\n"));
+    return EFI_SECURITY_VIOLATION;
+  }
+  Window->Base = Match->Address; Window->Bytes = Match->Length;
+  return EFI_SUCCESS;
+}
+
+STATIC EFI_STATUS
+CheckFunctionTable (CONST K70_OEM_WINDOW *Window, UINTN Address, UINTN Count, UINT32 SkipMask, CONST CHAR8 *Name)
+{
+  UINTN Index, Function;
+  UINT32 Instruction;
+  if (((Address & 7U) != 0U) || !K70OemRangeContains (Window, Address, Count * sizeof (UINTN))) {
+    DEBUG ((DEBUG_ERROR, "K70 XBL: %a table 0x%lx outside retained mapped FD\n", Name, (UINT64)Address));
+    return EFI_SECURITY_VIOLATION;
+  }
+  for (Index = 0; Index < Count; ++Index) {
+    if ((SkipMask & (1U << Index)) != 0U) { continue; }
+    CopyMem (&Function, (VOID *)(Address + Index * sizeof (UINTN)), sizeof (Function));
+    if ((Function == 0U) || ((Function & 3U) != 0U) || !K70OemRangeContains (Window, Function, sizeof (Instruction))) {
+      DEBUG ((DEBUG_ERROR, "K70 XBL: %a[%u] 0x%lx is not retained code\n", Name, (UINT32)Index, (UINT64)Function));
+      return EFI_SECURITY_VIOLATION;
+    }
+    CopyMem (&Instruction, (VOID *)Function, sizeof (Instruction));
+    if ((Instruction == 0U) || (Instruction == MAX_UINT32)) { return EFI_COMPROMISED_DATA; }
+  }
+  return EFI_SUCCESS;
+}
+
+STATIC BOOLEAN
+TemplateAddress (UINT64 Base, INT32 Delta, UINT64 *Result)
+{
+  if (Delta < 0) {
+    if (Base < (UINT64)(-(INT64)Delta)) { return FALSE; }
+    *Result = Base - (UINT64)(-(INT64)Delta);
+  } else {
+    if (Base > MAX_UINT64 - (UINT32)Delta) { return FALSE; }
+    *Result = Base + (UINT32)Delta;
+  }
+  return TRUE;
+}
+
+STATIC BOOLEAN
+SchedulerCodePointer (CONST K70_OEM_WINDOW *Window, UINT64 Interface, UINT64 Function)
+{
+  UINT32 Instruction;
+  UINT64 Text;
+  if ((Interface < K70_SCHEDULER_TEXT_BEFORE_TABLE) || ((Function & 3U) != 0U)) { return FALSE; }
+  Text = Interface - K70_SCHEDULER_TEXT_BEFORE_TABLE;
+  if ((Function < Text) || (Function - Text > K70_SCHEDULER_TEXT_BYTES - sizeof (Instruction)) ||
+      !K70OemRangeContains (Window, Function, sizeof (Instruction))) { return FALSE; }
+  CopyMem (&Instruction, (VOID *)(UINTN)Function, sizeof (Instruction));
+  return (BOOLEAN)((Instruction != 0U) && (Instruction != MAX_UINT32));
+}
+
+EFI_STATUS
+K70ValidateSchedulerInWindow (CONST K70_OEM_WINDOW *Window, EFI_PHYSICAL_ADDRESS Address)
+{
+  EFI_KERNEL_PROTOCOL Scheduler;
+  UINT64 Top[11], Expected, Function;
+  UINTN Index, Slot;
+  CONST K70_SCHEDULER_SUBTABLE *Table;
+  if (((Address & 7U) != 0U) || !K70OemRangeContains (Window, Address, sizeof (Scheduler))) { return EFI_SECURITY_VIOLATION; }
+  CopyMem (&Scheduler, (VOID *)(UINTN)Address, sizeof (Scheduler));
+  // This matched firmware is Scheduler 1.11. The public header is only the
+  // known 0x60-byte prefix. No future version/layout is inferred from ordering.
+  if (Scheduler.Version != K70_SCHEDULER_VERSION) { return EFI_UNSUPPORTED; }
+  if ((Address < K70_SCHEDULER_TEXT_BEFORE_TABLE) ||
+      !K70OemRangeContains (Window, Address - K70_SCHEDULER_TEXT_BEFORE_TABLE, K70_SCHEDULER_TEXT_BYTES) ||
+      !K70OemRangeContains (Window, Address - K70_SCHEDULER_DATA_BEFORE_TABLE, K70_SCHEDULER_DATA_BYTES)) {
+    return EFI_SECURITY_VIOLATION;
+  }
+  CopyMem (Top, (UINT8 *)&Scheduler + 8U, sizeof (Top));
+  for (Index = 0; Index < ARRAY_SIZE (Top); ++Index) {
+    if (!TemplateAddress (Address, mSchedulerTopDeltas[Index], &Expected) || Top[Index] != Expected) {
+      DEBUG ((DEBUG_ERROR, "K70 XBL: Scheduler 1.11 top[%u] common-TE relation mismatch\n", (UINT32)Index));
+      return EFI_COMPROMISED_DATA;
+    }
+  }
+  if (!SchedulerCodePointer (Window, Address, Top[9])) { return EFI_SECURITY_VIOLATION; }
+  for (Index = 0; Index < ARRAY_SIZE (mSchedulerSubtables); ++Index) {
+    Table = &mSchedulerSubtables[Index];
+    if (!K70OemRangeContains (Window, Top[Table->TopIndex], Table->Count * sizeof (UINT64))) { return EFI_SECURITY_VIOLATION; }
+    for (Slot = 0; Slot < Table->Count; ++Slot) {
+      CopyMem (&Function, (VOID *)(UINTN)(Top[Table->TopIndex] + Slot * sizeof (UINT64)), sizeof (Function));
+      if ((Table->ReservedMask & (1U << Slot)) != 0U) {
+        if (Function != 0U) { return EFI_COMPROMISED_DATA; }
+        continue;
+      }
+      // Exact OEM NULLs are legal in the five Spinlock methods and MpCpu[6].
+      // Runtime non-NULL replacements still have to point into retained TE code.
+      if ((Table->OptionalNullMask & (1U << Slot)) != 0U) {
+        if (Function == 0U) { continue; }
+        if (!SchedulerCodePointer (Window, Address, Function)) { return EFI_SECURITY_VIOLATION; }
+        continue;
+      }
+      if ((Table->Functions[Slot] == 0) ||
+          !TemplateAddress (Address, Table->Functions[Slot], &Expected) || (Function != Expected) ||
+          !SchedulerCodePointer (Window, Address, Function)) {
+        DEBUG ((DEBUG_ERROR, "K70 XBL: Scheduler 1.11 %a[%u] is not the matched retained code\n", Table->Name, (UINT32)Slot));
+        return EFI_SECURITY_VIOLATION;
+      }
+    }
+  }
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+K70ValidateScheduler (EFI_PHYSICAL_ADDRESS Address)
+{
+  K70_OEM_WINDOW Window;
+  EFI_STATUS Status = K70GetOemWindow (&Window);
+  return EFI_ERROR (Status) ? Status : K70ValidateSchedulerInWindow (&Window, Address);
+}
+
+STATIC UINT32
+ReadBigEndian32 (CONST UINT8 *P)
+{
+  return ((UINT32)P[0] << 24) | ((UINT32)P[1] << 16) | ((UINT32)P[2] << 8) | P[3];
+}
+
+STATIC EFI_STATUS
+ValidateLiveDtb (CONST K70_OEM_WINDOW *Oem, EFI_PHYSICAL_ADDRESS Interface)
+{
+  EFI_PHYSICAL_ADDRESS Pointer;
+  K70_OEM_WINDOW Blob;
+  EFI_MEMORY_REGION_DESCRIPTOR *Map;
+  UINT8 Count, Header[40];
+  UINTN Index, Found = 0;
+  UINT32 Total, Structure, Strings, Reserve, StructureBytes, StringBytes;
+  INT32 Node, PropertyBytes;
+  CONST VOID *Property;
+  if ((Interface > MAX_UINT64 - DTB_LIVE_POINTER_AFTER_TABLE) ||
+      !K70OemRangeContains (Oem, Interface + DTB_LIVE_POINTER_AFTER_TABLE, sizeof (Pointer))) { return EFI_SECURITY_VIOLATION; }
+  CopyMem (&Pointer, (VOID *)(UINTN)(Interface + DTB_LIVE_POINTER_AFTER_TABLE), sizeof (Pointer));
+  if ((Pointer == 0U) || ((Pointer & 7U) != 0U)) {
+    DEBUG ((DEBUG_ERROR, "K70 XBL: DTB live state is NULL/unaligned; original init not established\n"));
+    return EFI_NOT_READY;
+  }
+  Blob = *Oem;
+  if (!K70OemRangeContains (&Blob, Pointer, sizeof (Header))) {
+    Map = NULL; Count = 0; GetMemoryMap (&Map, &Count);
+    if ((Map == NULL) || (Count > MAX_ARM_MEMORY_REGION_DESCRIPTOR_COUNT)) { return EFI_SECURITY_VIOLATION; }
+    ZeroMem (&Blob, sizeof (Blob));
+    for (Index = 0; Index < Count; ++Index) {
+      if ((AsciiStrnCmp (Map[Index].Name, "XBL DT", sizeof ("XBL DT")) != 0) &&
+          (AsciiStrnCmp (Map[Index].Name, "XBL_DT", sizeof ("XBL_DT")) != 0)) { continue; }
+      ++Found;
+      if ((Map[Index].MemoryType != EfiReservedMemoryType) ||
+          ((Map[Index].ResourceType != EFI_RESOURCE_SYSTEM_MEMORY) && (Map[Index].ResourceType != EFI_RESOURCE_MEMORY_RESERVED)) ||
+          ((Map[Index].ArmAttributes != ARM_MEMORY_REGION_ATTRIBUTE_WRITE_BACK) &&
+           (Map[Index].ArmAttributes != ARM_MEMORY_REGION_ATTRIBUTE_WRITE_BACK_XP) &&
+           (Map[Index].ArmAttributes != ARM_MEMORY_REGION_ATTRIBUTE_UNCACHED_UNBUFFERED))) {
+        return EFI_SECURITY_VIOLATION;
+      }
+      Blob.Base = Map[Index].Address; Blob.Bytes = Map[Index].Length;
+    }
+    if ((Found != 1U) || !K70OemRangeContains (&Blob, Pointer, sizeof (Header))) {
+      DEBUG ((DEBUG_ERROR, "K70 XBL: live DTB 0x%lx not in a declared retained XBL DT/FD region\n", Pointer));
+      return EFI_SECURITY_VIOLATION;
+    }
+  }
+  CopyMem (Header, (VOID *)(UINTN)Pointer, sizeof (Header));
+  if (ReadBigEndian32 (Header) != 0xD00DFEEDU) { return EFI_COMPROMISED_DATA; }
+  Total = ReadBigEndian32 (Header + 4);
+  Structure = ReadBigEndian32 (Header + 8); Strings = ReadBigEndian32 (Header + 12);
+  Reserve = ReadBigEndian32 (Header + 16); StringBytes = ReadBigEndian32 (Header + 32);
+  StructureBytes = ReadBigEndian32 (Header + 36);
+  if ((Total < sizeof (Header)) || (Total > MAX_OEM_WINDOW_BYTES) || !K70OemRangeContains (&Blob, Pointer, Total) ||
+      (ReadBigEndian32 (Header + 20) != 17U) || (ReadBigEndian32 (Header + 24) > 17U) ||
+      (Structure < sizeof (Header)) || ((Structure & 3U) != 0U) || (Structure > Total) || (StructureBytes > Total - Structure) ||
+      (Strings < sizeof (Header)) || (Strings > Total) || (StringBytes > Total - Strings) ||
+      (Reserve < sizeof (Header)) || ((Reserve & 7U) != 0U) || (Reserve > Total - 16U) ||
+      (StructureBytes < 16U)) { return EFI_COMPROMISED_DATA; }
+  if (FdtCheckHeader ((VOID *)(UINTN)Pointer) != 0) { return EFI_COMPROMISED_DATA; }
+  Node = FdtPathOffset ((VOID *)(UINTN)Pointer, "/sw/boot");
+  if (Node < 0) { return EFI_NOT_FOUND; }
+  Property = FdtGetProp ((VOID *)(UINTN)Pointer, Node, "config", &PropertyBytes);
+  if ((Property == NULL) || (PropertyBytes < 12) || ((UINTN)Property < Pointer) ||
+      ((UINTN)Property - Pointer > Total) || ((UINT32)PropertyBytes > Total - ((UINTN)Property - Pointer))) {
+    return EFI_COMPROMISED_DATA;
+  }
+  DEBUG ((DEBUG_ERROR, "K70 XBL: live DTB 0x%lx (%u bytes) has bounded /sw/boot/config; OEM execution still unproven\n", Pointer, Total));
+  return EFI_SUCCESS;
+}
+
+// Derived from the matching OS2.0.218 OEM SEC TE producer and its table: a
+// version word followed by exactly 32 function pointers, total 0x108 bytes.
+// No linked template address is used as a runtime candidate.
+EFI_STATUS
+K70ValidateDtbInWindow (CONST K70_OEM_WINDOW *Window, EFI_PHYSICAL_ADDRESS Address)
+{
+  UINT64 Version, Function, Expected;
+  UINTN Index;
+  EFI_STATUS Status;
+  if (((Address & 7U) != 0U) || !K70OemRangeContains (Window, Address, 0x108U)) { return EFI_SECURITY_VIOLATION; }
+  CopyMem (&Version, (VOID *)(UINTN)Address, sizeof (Version));
+  if (Version != 0x00010001ULL) { return EFI_UNSUPPORTED; }
+  if ((Address < K70_DTB_TEXT_BEFORE_TABLE) ||
+      !K70OemRangeContains (Window, Address - K70_DTB_TEXT_BEFORE_TABLE, K70_DTB_TEXT_BYTES)) { return EFI_SECURITY_VIOLATION; }
+  Status = CheckFunctionTable (Window, (UINTN)Address + 8U, 32U, 0U, "DTB extension");
+  if (EFI_ERROR (Status)) { return Status; }
+  for (Index = 0; Index < ARRAY_SIZE (mDtbFunctionDeltas); ++Index) {
+    // The matched OEM table has all functions before it in the same TE text.
+    if ((mDtbFunctionDeltas[Index] >= 0) || (Address < (UINT64)(-(INT64)mDtbFunctionDeltas[Index]))) { return EFI_COMPROMISED_DATA; }
+    Expected = Address - (UINT64)(-(INT64)mDtbFunctionDeltas[Index]);
+    CopyMem (&Function, (VOID *)(UINTN)(Address + 8U + Index * 8U), sizeof (Function));
+    if (Function != Expected) {
+      DEBUG ((DEBUG_ERROR, "K70 XBL: DTB slot %u fails common-TE relocation relation\n", (UINT32)Index));
+      return EFI_COMPROMISED_DATA;
+    }
+  }
+  return ValidateLiveDtb (Window, Address);
+}
+
+EFI_STATUS
+K70ValidateDtb (EFI_PHYSICAL_ADDRESS Address)
+{
+  K70_OEM_WINDOW Window;
+  EFI_STATUS Status = K70GetOemWindow (&Window);
+  return EFI_ERROR (Status) ? Status : K70ValidateDtbInWindow (&Window, Address);
+}
+
+STATIC BOOLEAN
+DecodeAdjacentPair (UINT32 Adrp, UINT32 Add, EFI_PHYSICAL_ADDRESS Pc, EFI_PHYSICAL_ADDRESS *Address)
+{
+  INT64 Immediate, Delta;
+  UINT64 Page;
+  if (((Adrp & 0x9F000000U) != 0x90000000U) ||
+      ((Add & 0xFFC00000U) != 0x91000000U) ||
+      ((Adrp & 31U) == 31U) || (((Add >> 5) & 31U) != (Adrp & 31U)) || ((Add & 31U) == 31U)) {
+    return FALSE;
+  }
+  Immediate = (INT64)((((Adrp >> 5) & 0x7FFFFU) << 2) | ((Adrp >> 29) & 3U));
+  if ((Immediate & 0x100000) != 0) { Immediate -= 0x200000; }
+  Delta = Immediate * 4096; // Defined for negative offsets; no signed left shift.
+  Page = Pc & ~0xFFFULL;
+  if ((Delta < 0 && Page < (UINT64)(-Delta)) || (Delta >= 0 && Page > MAX_UINT64 - (UINT64)Delta)) { return FALSE; }
+  Page = Delta < 0 ? Page - (UINT64)(-Delta) : Page + (UINT64)Delta;
+  Immediate = (Add >> 10) & 0xFFFU;
+  if (Page > MAX_UINT64 - (UINT64)Immediate) { return FALSE; }
+  *Address = Page + (UINT64)Immediate;
+  return TRUE;
+}
+
+STATIC EFI_STATUS
+InspectFunction (CONST K70_OEM_WINDOW *Window, EFI_PHYSICAL_ADDRESS Start, EFI_PHYSICAL_ADDRESS *Candidate,
+                 BOOLEAN *HasSchedulerGuid, BOOLEAN *HasDtbGuid)
+{
+  EFI_PHYSICAL_ADDRESS Current, Address, Addresses[MAX_ADDRESS_PAIRS];
+  UINTN Count = 0, Index;
+  EFI_PHYSICAL_ADDRESS DtbGuidAddress = 0, SchedulerGuidAddress = 0;
+  UINT32 Instruction, Next;
+  BOOLEAN Returned = FALSE;
+  *Candidate = 0; *HasSchedulerGuid = FALSE; *HasDtbGuid = FALSE;
+  for (Current = Start; K70OemRangeContains (Window, Current, 4U) && Current - Start < FUNCTION_SCAN_BYTES; Current += 4U) {
+    CopyMem (&Instruction, (VOID *)(UINTN)Current, 4U);
+    if (Instruction == 0xD65F03C0U) { Returned = TRUE; break; }
+    if (!K70OemRangeContains (Window, Current, 8U) || Current - Start > FUNCTION_SCAN_BYTES - 8U) { continue; }
+    CopyMem (&Next, (VOID *)(UINTN)(Current + 4U), 4U);
+    if (!DecodeAdjacentPair (Instruction, Next, Current, &Address)) { continue; }
+    if (Count == MAX_ADDRESS_PAIRS) { return EFI_BAD_BUFFER_SIZE; }
+    Addresses[Count++] = Address;
+    // No GUID dereference takes place until all 16 bytes are in the allowlist.
+    if (((Address & 7U) == 0U) && K70OemRangeContains (Window, Address, sizeof (EFI_GUID))) {
+      if (CompareGuid ((EFI_GUID *)(UINTN)Address, &gEfiSchedulerInterfaceHobGuid)) { *HasSchedulerGuid = TRUE; SchedulerGuidAddress = Address; }
+      if (CompareGuid ((EFI_GUID *)(UINTN)Address, &gEfiDtbExtensionHobGuid)) { *HasDtbGuid = TRUE; DtbGuidAddress = Address; }
+    }
+  }
+  if (!Returned) { return EFI_COMPROMISED_DATA; }
+  if (*HasSchedulerGuid && *HasDtbGuid) { return EFI_COMPROMISED_DATA; }
+  if (!*HasSchedulerGuid && !*HasDtbGuid) { return EFI_SUCCESS; }
+  for (Index = 0; Index < Count; ++Index) {
+    // Version is read only after a bounded, aligned range check.
+    UINT64 Version;
+    Address = Addresses[Index];
+    if (((Address & 7U) != 0U) || !K70OemRangeContains (Window, Address, sizeof (Version))) { continue; }
+    CopyMem (&Version, (VOID *)(UINTN)Address, sizeof (Version));
+    if (*HasSchedulerGuid) {
+      if (Version != K70_SCHEDULER_VERSION) { continue; }
+      if (EFI_ERROR (K70ValidateSchedulerInWindow (Window, Address))) { continue; }
+      if ((Address < Start) || (Address - Start != K70_SCHEDULER_TABLE_AFTER_PRODUCER) ||
+          (Address < K70_SCHEDULER_GUID_BEFORE_TABLE) ||
+          (SchedulerGuidAddress != Address - K70_SCHEDULER_GUID_BEFORE_TABLE)) { return EFI_COMPROMISED_DATA; }
+    } else {
+      if (Version != 0x00010001ULL) { continue; }
+      if (EFI_ERROR (K70ValidateDtbInWindow (Window, Address))) { continue; }
+      if ((Address < Start) || (Address - Start != K70_DTB_TABLE_AFTER_PRODUCER) ||
+          (Address > MAX_UINT64 - K70_DTB_GUID_AFTER_TABLE) ||
+          (DtbGuidAddress != Address + K70_DTB_GUID_AFTER_TABLE)) { return EFI_COMPROMISED_DATA; }
+    }
+    if ((*Candidate != 0U) && (*Candidate != Address)) { return EFI_COMPROMISED_DATA; }
+    *Candidate = Address;
+  }
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+GetXblHobAddresses (EFI_PHYSICAL_ADDRESS *Scheduler, EFI_PHYSICAL_ADDRESS *Dtb)
+{
+  K70_OEM_WINDOW Window;
+  EFI_STATUS Status;
+  EFI_PHYSICAL_ADDRESS Current, Candidate;
+  UINT64 Prologue;
+  UINT32 Eighth;
+  UINTN Matches = 0;
+  BOOLEAN SchedulerGuid, DtbGuid, AnyDtb = FALSE;
+  if ((Scheduler == NULL) || (Dtb == NULL)) { return EFI_INVALID_PARAMETER; }
+  *Scheduler = 0; *Dtb = 0;
+  Status = K70GetOemWindow (&Window);
+  if (EFI_ERROR (Status)) { return Status; }
+  DEBUG ((DEBUG_ERROR, "K70 XBL: bounded scan 0x%lx + 0x%lx; no OEM calls\n", Window.Base, Window.Bytes));
+  for (Current = Window.Base; K70OemRangeContains (&Window, Current, 36U); Current += 4U) {
+    CopyMem (&Prologue, (VOID *)(UINTN)Current, sizeof (Prologue));
+    if (Prologue != HOB_PROLOGUE) { continue; }
+    CopyMem (&Eighth, (VOID *)(UINTN)(Current + 32U), 4U);
+    if ((Eighth & 0xFFFFFFE0U) != 0x52800100U) { continue; }
+    Status = InspectFunction (&Window, Current, &Candidate, &SchedulerGuid, &DtbGuid);
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_ERROR, "K70 XBL: malformed/ambiguous candidate at 0x%lx (%r)\n", Current, Status));
+      *Scheduler = 0; *Dtb = 0; return Status;
+    }
+    AnyDtb = (BOOLEAN)(AnyDtb || DtbGuid);
+    if (Candidate == 0U) { continue; }
+    if (SchedulerGuid) {
+      if ((*Scheduler != 0U) && (*Scheduler != Candidate)) { *Scheduler = 0; *Dtb = 0; return EFI_COMPROMISED_DATA; }
+      *Scheduler = Candidate; ++Matches;
+    } else if (DtbGuid) {
+      if ((*Dtb != 0U) && (*Dtb != Candidate)) { *Scheduler = 0; *Dtb = 0; return EFI_COMPROMISED_DATA; }
+      *Dtb = Candidate;
+    }
+  }
+  if (*Scheduler == 0U) {
+    DEBUG ((DEBUG_ERROR, "K70 XBL: no unique structurally valid retained Scheduler; refusing OEM DXE\n"));
+    *Dtb = 0;
+    return EFI_NOT_FOUND;
+  }
+  DEBUG ((DEBUG_ERROR, "K70 XBL: Scheduler candidate 0x%lx (%u registrations), execution NOT proven\n", *Scheduler, (UINT32)Matches));
+  if (*Dtb == 0U) {
+    DEBUG ((DEBUG_ERROR, "K70 XBL: DTB GUID seen=%u but no valid 0x108/v10001 table; strict guard CLOSED\n", AnyDtb));
+    *Scheduler = 0;
+    return EFI_NOT_FOUND;
+  }
+  DEBUG ((DEBUG_ERROR, "K70 XBL: DTB candidate 0x%lx structurally validated; execution NOT proven\n", *Dtb));
+  return EFI_SUCCESS;
+}
