index 0000000..4830bff
--- /dev/null
+++ b/package/uefi/K70DiagnosticsPkg/Drivers/K70UsbDiagDxe/K70UsbDiagDxe.c
@@ -0,0 +1,732 @@
+/** @file
+  Bounded USB device-protocol consumer. It implements no storage or boot API.
+
+  Qualcomm ABI comes from QcomPkg/Include/Protocol/EFIUsbDevice.h. The
+  descriptor shape/init-event sequence was checked against HakiOS xnuloader;
+  none of its loader, block I/O, download or flash code is included here.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#include <Uefi.h>
+#include <Guid/EventGroup.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/PrintLib.h>
+#include <Library/SynchronizationLib.h>
+#include <Library/TimerLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include "QcomUsbCompat.h"
+#include <Protocol/UniXNUMenuPlugin.h>
+#include <K70LogRing.h>
+#include "K70UsbDiagCore.h"
+#include "DiagFont.h"
+
+/* A platform USB-diagnostic profile may set this compiler define to 1. */
+#ifndef K70_USB_DIAG_AUTOSTART
+#define K70_USB_DIAG_AUTOSTART 0
+#endif
+
+#define TRANSFER_BUFFER_BYTES 4096U
+#define TIMER_PERIOD_100NS    250000ULL
+#define PROVIDER_WAIT_MS      2000ULL
+#define DMA_DRAIN_MS          250ULL
+#define EVENTS_PER_STEP       4U
+
+STATIC_ASSERT (sizeof (EFI_USB_DEVICE_PROTOCOL) == 0x50, "Qcom USB protocol ABI");
+STATIC_ASSERT (OFFSET_OF (EFI_USB_DEVICE_PROTOCOL, StartEx) == 0x48, "StartEx ABI");
+STATIC_ASSERT (sizeof (USB_DEVICE_DESCRIPTOR_SET) == 0x40, "descriptor-set ABI");
+STATIC_ASSERT (OFFSET_OF (USB_DEVICE_DESCRIPTOR_SET, StringDescritors) == 56, "strings ABI");
+STATIC_ASSERT (OFFSET_OF (USB_DEVICE_TRANSFER_OUTCOME, BytesCompleted) == 8, "transfer ABI");
+STATIC_ASSERT (sizeof (KD_TIME) == sizeof (UINT64), "core time ABI");
+
+typedef enum {
+  PhaseIdle, PhaseInventory, PhaseInitSignal, PhaseWaitProvider, PhaseStart,
+  PhaseAllocateRx, PhaseAllocateTx, PhaseRun, PhaseDrain,
+  PhaseFreeRx, PhaseFreeTx, PhaseStop, PhaseFinished
+} SERVICE_PHASE;
+
+typedef struct {
+  EFI_USB_DEVICE_PROTOCOL *Usb;
+  UINT8 *Rx;
+  UINT8 *Tx;
+  KD_SESSION Core;
+  SERVICE_PHASE Phase;
+  UINT64 BeganMs;
+  UINT64 PhaseBeganMs;
+  EFI_STATUS LastStatus;
+  EFI_STATUS InitStatus;
+  UINTN UsbfnHandles;
+  BOOLEAN Active;
+  BOOLEAN OwnsStart;
+  BOOLEAN CoreStarted;
+  BOOLEAN HardwareRxPending;
+  BOOLEAN HardwareTxPending;
+  BOOLEAN RetainBuffers;
+  BOOLEAN CleanupFailed;
+} USB_SERVICE;
+
+STATIC USB_SERVICE mService;
+STATIC volatile UINT32 mStepBusy;
+STATIC BOOLEAN mQuarantined;
+STATIC BOOLEAN mProviderStopped;
+STATIC BOOLEAN mLeavingBootServices;
+STATIC EFI_EVENT mBeforeExitEvent;
+STATIC EFI_EVENT mExitEvent;
+#if K70_USB_DIAG_AUTOSTART
+STATIC EFI_EVENT mTimerEvent;
+STATIC EFI_EVENT mReadyEvent;
+#endif
+STATIC UINT8 mSnapshot[KD_LOG_LIMIT];
+STATIC CONST UINT64 mFont[] = GLYPH_FONT;
+
+/* USB2 and USB3 sets share the fastboot interface and bounded bulk endpoints. */
+STATIC UINT8 mDevice[] = {
+  18,1,0x10,2,0,0,0,64,0xd1,0x18,0x0d,0xd0,0,1,1,2,3,1
+};
+STATIC UINT8 mSsDevice[] = {
+  18,1,0,3,0,0,0,9,0xd1,0x18,0x0d,0xd0,0,1,1,2,3,1
+};
+STATIC UINT8 mConfig[] = {
+  9,2,32,0,1,1,0,0x80,0x50,
+  9,4,0,0,2,0xff,0x42,0x03,4,
+  7,5,0x81,2,0,2,0, 7,5,0x01,2,0,2,0
+};
+STATIC UINT8 mSsConfig[] = {
+  9,2,44,0,1,1,0,0x80,0x10,
+  9,4,0,0,2,0xff,0x42,0x03,4,
+  7,5,0x81,2,0,4,0, 6,0x30,0,0,0,0,
+  7,5,0x01,2,0,4,0, 6,0x30,0,0,0,0
+};
+STATIC UINT8 mQualifier[] = {10,6,0x10,2,0,0,0,64,1,0};
+STATIC UINT8 mBos[] = {
+  5,15,22,0,2, 7,16,2,2,0,0,0,
+  10,16,3,0,0x0e,0,1,10,0xff,7
+};
+STATIC UINT8 mLang[] = {4,3,9,4};
+/* A USB string's trailing C terminator is excluded by bLength. */
+typedef struct { UINT8 Length, Type; CHAR16 Text[16]; } USB_STRING_16;
+typedef struct { UINT8 Length, Type; CHAR16 Text[32]; } USB_STRING_32;
+STATIC USB_STRING_32 mManufacturer = {32,3,L"UniXNU research"};
+STATIC USB_STRING_32 mProduct = {42,3,L"K70 UEFI diagnostics"};
+STATIC USB_STRING_16 mSerial = {32,3,L"K70UEFI20261104"};
+STATIC USB_STRING_32 mInterface = {38,3,L"Read-only fastboot"};
+STATIC VOID *mConfigs[] = {mConfig};
+STATIC VOID *mSsConfigs[] = {mSsConfig};
+STATIC EFI_USB_STRING_DESCRIPTOR *mStrings[] = {
+  (VOID *)mLang, (VOID *)&mManufacturer, (VOID *)&mProduct,
+  (VOID *)&mSerial, (VOID *)&mInterface
+};
+STATIC USB_DEVICE_DESCRIPTOR_SET mDescriptors = {
+  (VOID *)mDevice, mConfigs, (VOID *)mSsDevice, mSsConfigs,
+  (VOID *)mQualifier, mBos, 5, mStrings
+};
+
+STATIC UINT64
+NowMs (VOID)
+{
+  return GetTimeInNanoSecond (GetPerformanceCounter ()) / 1000000ULL;
+}
+
+STATIC VOID EFIAPI
+InitNotify (EFI_EVENT Event, VOID *Context)
+{
+  (VOID)Event;
+  (VOID)Context;
+}
+
+STATIC VOID
+SignalUsbInit (USB_SERVICE *Service)
+{
+  EFI_EVENT Event;
+  Service->InitStatus = gBS->CreateEventEx (EVT_NOTIFY_SIGNAL, TPL_CALLBACK,
+    InitNotify, NULL, &gUsbControllerInitGuid, &Event);
+  if (!EFI_ERROR (Service->InitStatus)) {
+    Service->InitStatus = gBS->SignalEvent (Event);
+    gBS->CloseEvent (Event);
+  }
+}
+
+STATIC int
+QueueTransfer (void *Context, KD_BYTE Endpoint, KD_BYTE *Buffer, KD_SIZE Bytes)
+{
+  USB_SERVICE *Service = Context;
+  if (mLeavingBootServices || (Service->Usb == NULL) || !Service->OwnsStart) {
+    return KD_QUEUE_ERROR;
+  }
+  Service->LastStatus = Service->Usb->Send (Endpoint, Bytes, Buffer);
+  if ((Service->LastStatus == EFI_NOT_READY) || (Service->LastStatus == EFI_NOT_STARTED)) {
+    return KD_QUEUE_RETRY;
+  }
+  if (EFI_ERROR (Service->LastStatus)) {
+    return KD_QUEUE_ERROR;
+  }
+  if (Endpoint == KD_EP_OUT) {
+    Service->HardwareRxPending = TRUE;
+  } else {
+    Service->HardwareTxPending = TRUE;
+  }
+  return KD_QUEUE_OK;
+}
+
+STATIC void
+AbortTransfer (void *Context, KD_BYTE Endpoint)
+{
+  USB_SERVICE *Service = Context;
+  if (!mLeavingBootServices && (Service->Usb != NULL) && Service->OwnsStart) {
+    EFI_STATUS Status = Service->Usb->AbortXfer (Endpoint);
+    if (EFI_ERROR (Status)) {
+      Service->LastStatus = Status;
+    }
+  }
+}
+
+STATIC int
+CopyLogSnapshot (void *Context, const KD_BYTE **Data, KD_SIZE *Bytes)
+{
+  UINTN Index, Size;
+  EFI_STATUS Status;
+  K70_LOG_RING *Ring;
+  (VOID)Context;
+  if ((gST == NULL) || (gST->NumberOfTableEntries > K70_LOG_RING_MAX_TABLES) ||
+      ((gST->NumberOfTableEntries != 0) && (gST->ConfigurationTable == NULL))) {
+    return -1;
+  }
+  for (Index = 0; Index < gST->NumberOfTableEntries; ++Index) {
+    if (!CompareGuid (&gST->ConfigurationTable[Index].VendorGuid, &gK70LogRingTableGuid)) {
+      continue;
+    }
+    Ring = gST->ConfigurationTable[Index].VendorTable;
+    if (!K70LogRingIsValid (Ring)) {
+      return -1;
+    }
+    Size = sizeof (mSnapshot);
+    Status = K70LogRingCopySnapshot (Ring, mSnapshot, &Size, NULL);
+    if (Status == EFI_NOT_READY) {
+      return 2;
+    }
+    if (EFI_ERROR (Status) || (Size > sizeof (mSnapshot))) {
+      return -1;
+    }
+    *Data = mSnapshot;
+    *Bytes = (KD_SIZE)Size;
+    return 0;
+  }
+  return 1;
+}
+
+/* A terminal notification is also a DMA-ownership fence for that buffer. */
+STATIC EFI_STATUS
+PumpEvents (USB_SERVICE *Service, BOOLEAN DeliverToCore)
+{
+  UINTN Attempt;
+  for (Attempt = 0; Attempt < EVENTS_PER_STEP; ++Attempt) {
+    USB_DEVICE_EVENT Event = UsbDeviceEventNoEvent;
+    USB_DEVICE_EVENT_DATA Data;
+    UINTN Size = sizeof (Data);
+    EFI_STATUS Status;
+    ZeroMem (&Data, sizeof (Data));
+    Status = Service->Usb->HandleEvent (&Event, &Size, &Data);
+    if (Status == EFI_NOT_READY) {
+      break;
+    }
+    if (EFI_ERROR (Status)) {
+      Service->LastStatus = Status;
+      return Status;
+    }
+    if (Event == UsbDeviceEventNoEvent) {
+      break;
+    }
+    if ((Event == UsbDeviceEventDeviceStateChange) && (Size >= sizeof (Data.DeviceState))) {
+      if (DeliverToCore) {
+        KdSessionConnection (&Service->Core, Data.DeviceState == UsbDeviceStateConnected, NowMs ());
+      }
+    } else if ((Event == UsbDeviceEventTransferNotification) &&
+               (Size >= sizeof (Data.TransferOutcome)) &&
+               (Data.TransferOutcome.Status >= UsbDeviceTransferStatusCompleteOK) &&
+               (Data.TransferOutcome.Status <= UsbDeviceTransferStatusCompleteError)) {
+      USB_DEVICE_TRANSFER_OUTCOME *Transfer = &Data.TransferOutcome;
+      BOOLEAN Owned = FALSE;
+      if ((Transfer->EndpointIndex == KD_EP_OUT) && (Transfer->DataBuffer == Service->Rx)) {
+        Service->HardwareRxPending = FALSE;
+        Owned = TRUE;
+      } else if ((Transfer->EndpointIndex == KD_EP_IN) && (Transfer->DataBuffer == Service->Tx)) {
+        Service->HardwareTxPending = FALSE;
+        Owned = TRUE;
+      }
+      if (DeliverToCore && Owned) {
+        if (Transfer->BytesCompleted > MAX_UINT32) {
+          KdSessionStop (&Service->Core, KdTransportError);
+        } else {
+          KdSessionTransfer (&Service->Core, Transfer->EndpointIndex,
+            Transfer->Status == UsbDeviceTransferStatusCompleteOK,
+            (KD_SIZE)Transfer->BytesCompleted, Transfer->DataBuffer, NowMs ());
+        }
+      }
+    } else if ((Event == UsbDeviceEventOemEvent) && (Size >= sizeof (Data.OemData)) &&
+               (Data.OemData.Context != NULL)) {
+      /* Qcom's ABI explicitly transfers ownership of OEM Context to caller. */
+      FreePool (Data.OemData.Context);
+    }
+    if (DeliverToCore && (Service->Core.StopReason != KdRunning)) {
+      break;
+    }
+  }
+  return EFI_SUCCESS;
+}
+
+STATIC VOID
+RequestStop (USB_SERVICE *Service, KD_STOP_REASON Reason)
+{
+  if (!Service->Active) {
+    return;
+  }
+  if (Service->CoreStarted) {
+    KdSessionStop (&Service->Core, Reason);
+  }
+  if (Service->OwnsStart && (Service->Phase < PhaseDrain)) {
+    Service->Phase = PhaseDrain;
+    Service->PhaseBeganMs = NowMs ();
+  } else if (!Service->OwnsStart) {
+    Service->Phase = PhaseFinished;
+    Service->Active = FALSE;
+  }
+}
+
+STATIC VOID
+BeginService (VOID)
+{
+  ZeroMem (&mService, sizeof (mService));
+  mService.Active = TRUE;
+  mService.Phase = PhaseInventory;
+  mService.BeganMs = NowMs ();
+}
+
+/* One bounded state-machine step: no waits and at most four provider events. */
+STATIC VOID
+ServiceStep (VOID)
+{
+  USB_SERVICE *Service = &mService;
+  KD_IO Io;
+  EFI_STATUS Status;
+  EFI_HANDLE *Handles;
+  VOID *AllocatedBuffer;
+  UINTN Count;
+  UINT64 Now;
+  if (!Service->Active || mLeavingBootServices ||
+      (InterlockedCompareExchange32 (&mStepBusy, 0, 1) != 0)) {
+    return;
+  }
+  Now = NowMs ();
+  switch (Service->Phase) {
+  case PhaseInventory:
+    Handles = NULL;
+    Count = 0;
+    Service->LastStatus = gBS->LocateProtocol (&gEfiUsbDeviceProtocolGuid,
+                                               NULL, (VOID **)&Service->Usb);
+    if (!EFI_ERROR (gBS->LocateHandleBuffer (ByProtocol, &gEfiUsbfnIoProtocolGuid,
+                                           NULL, &Count, &Handles))) {
+      Service->UsbfnHandles = Count;
+      FreePool (Handles);
+    }
+    Service->Phase = PhaseInitSignal;
+    break;
+  case PhaseInitSignal:
+    SignalUsbInit (Service);
+    Service->PhaseBeganMs = Now;
+    Service->Phase = PhaseWaitProvider;
+    break;
+  case PhaseWaitProvider:
+    Service->Usb = NULL;
+    Service->LastStatus = gBS->LocateProtocol (&gEfiUsbDeviceProtocolGuid,
+                                              NULL, (VOID **)&Service->Usb);
+    if (!EFI_ERROR (Service->LastStatus) && (Service->Usb != NULL)) {
+      Service->Phase = PhaseStart;
+    } else if (Now - Service->PhaseBeganMs >= PROVIDER_WAIT_MS) {
+      Service->LastStatus = EFI_NOT_FOUND;
+      RequestStop (Service, KdTransportError);
+    }
+    break;
+  case PhaseStart:
+    if ((Service->Usb->Revision < EFI_USB_DEVICE_PROTOCOL_REVISION) ||
+        (Service->Usb->StartEx == NULL) || (Service->Usb->Send == NULL) ||
+        (Service->Usb->HandleEvent == NULL) || (Service->Usb->AllocateTransferBuffer == NULL) ||
+        (Service->Usb->FreeTransferBuffer == NULL) || (Service->Usb->AbortXfer == NULL) ||
+        (Service->Usb->Stop == NULL)) {
+      Service->LastStatus = EFI_UNSUPPORTED;
+      RequestStop (Service, KdTransportError);
+      break;
+    }
+    Service->LastStatus = Service->Usb->StartEx (&mDescriptors);
+    if (EFI_ERROR (Service->LastStatus)) {
+      /* Never stop a provider we did not successfully start ourselves. */
+      RequestStop (Service, KdTransportError);
+    } else {
+      Service->OwnsStart = TRUE;
+      Service->Phase = PhaseAllocateRx;
+    }
+    break;
+  case PhaseAllocateRx:
+  case PhaseAllocateTx:
+    AllocatedBuffer = NULL;
+    Status = Service->Usb->AllocateTransferBuffer (TRANSFER_BUFFER_BYTES,
+                                                    &AllocatedBuffer);
+    Service->LastStatus = Status;
+    /* The ABI declares Buffer undefined on failure; do not save/free it. */
+    if (EFI_ERROR (Status) || (AllocatedBuffer == NULL)) {
+      if (!EFI_ERROR (Status)) {
+        Service->LastStatus = EFI_OUT_OF_RESOURCES;
+      }
+      RequestStop (Service, KdTransportError);
+    } else if (Service->Phase == PhaseAllocateRx) {
+      Service->Rx = AllocatedBuffer;
+      Service->Phase = PhaseAllocateTx;
+    } else {
+      Service->Tx = AllocatedBuffer;
+      Io.Context = Service;
+      Io.Queue = QueueTransfer;
+      Io.Abort = AbortTransfer;
+      Io.Snapshot = CopyLogSnapshot;
+      KdSessionStart (&Service->Core, &Io, Service->Rx, Service->Tx,
+                      TRANSFER_BUFFER_BYTES, Service->BeganMs);
+      Service->CoreStarted = TRUE;
+      Service->Phase = PhaseRun;
+    }
+    break;
+  case PhaseRun:
+    Status = PumpEvents (Service, TRUE);
+    if (EFI_ERROR (Status)) {
+      KdSessionStop (&Service->Core, KdTransportError);
+    }
+    /* Event delivery above records a fresh timestamp. Re-read the clock so
+       unsigned timeout subtraction cannot see an older pre-pump time. */
+    KdSessionTick (&Service->Core, NowMs ());
+    if (Service->Core.StopReason != KdRunning) {
+      RequestStop (Service, Service->Core.StopReason);
+    }
+    break;
+  case PhaseDrain:
+    if (!Service->HardwareRxPending && !Service->HardwareTxPending) {
+      Service->Phase = PhaseFreeRx;
+    } else {
+      PumpEvents (Service, FALSE);
+      if ((Service->HardwareRxPending || Service->HardwareTxPending) &&
+          (Now - Service->PhaseBeganMs >= DMA_DRAIN_MS)) {
+        /* Do not free a buffer while its DMA completion is unconfirmed. */
+        Service->RetainBuffers = TRUE;
+        Service->CleanupFailed = TRUE;
+        Service->Phase = PhaseStop;
+      }
+    }
+    break;
+  case PhaseFreeRx:
+  case PhaseFreeTx:
+    if ((Service->Phase == PhaseFreeRx ? Service->Rx : Service->Tx) != NULL) {
+      Status = Service->Usb->FreeTransferBuffer (
+        Service->Phase == PhaseFreeRx ? Service->Rx : Service->Tx);
+      if (EFI_ERROR (Status)) {
+        Service->LastStatus = Status;
+        Service->CleanupFailed = TRUE;
+      }
+    }
+    Service->Phase = Service->Phase == PhaseFreeRx ? PhaseFreeTx : PhaseStop;
+    break;
+  case PhaseStop:
+    Status = Service->Usb->Stop ();
+    mProviderStopped = TRUE;
+    Service->OwnsStart = FALSE;
+    if (EFI_ERROR (Status)) {
+      Service->LastStatus = Status;
+      Service->CleanupFailed = TRUE;
+    }
+    if (Service->CleanupFailed) {
+      mQuarantined = TRUE;
+    }
+    /* Qcom forbids further protocol access after Stop, including Free(). */
+    Service->Phase = PhaseFinished;
+    Service->Active = FALSE;
+    break;
+  default:
+    Service->Active = FALSE;
+    break;
+  }
+  MemoryFence ();
+  mStepBusy = 0;
+}
+
+STATIC BOOLEAN
+ExitKey (VOID)
+{
+  EFI_INPUT_KEY Key;
+  if ((gST->ConIn == NULL) || EFI_ERROR (gST->ConIn->ReadKeyStroke (gST->ConIn, &Key))) {
+    return FALSE;
+  }
+  return (BOOLEAN)((Key.ScanCode == SCAN_ESC) || (Key.UnicodeChar == CHAR_CARRIAGE_RETURN) ||
+                   (Key.UnicodeChar == CHAR_BACKSPACE));
+}
+
+STATIC VOID
+Fill (EFI_GRAPHICS_OUTPUT_PROTOCOL *Gop, CONST UNIXNU_PLUGIN_RECT *Rect,
+      UINT32 X, UINT32 Y, UINT32 Width, UINT32 Height,
+      EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Color)
+{
+  if ((X >= Rect->Width) || (Y >= Rect->Height)) {
+    return;
+  }
+  Width = MIN (Width, Rect->Width - X);
+  Height = MIN (Height, Rect->Height - Y);
+  Gop->Blt (Gop, Color, EfiBltVideoFill, 0, 0,
+             Rect->X + X, Rect->Y + Y, Width, Height, 0);
+}
+
+STATIC VOID
+Text (EFI_GRAPHICS_OUTPUT_PROTOCOL *Gop, CONST UNIXNU_PLUGIN_RECT *Rect,
+      UINT32 Row, CONST CHAR8 *Message)
+{
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL White = {0xee,0xee,0xee,0};
+  UINT32 Scale = Rect->Width >= 900 ? 4U : 2U;
+  UINT32 X = 8, Y = 8 + Row * 16 * Scale, Gx, Gy, Dx;
+  UINT64 Glyph, Bits;
+  CHAR8 Ch;
+  while ((Ch = *Message++) != 0) {
+    if ((Ch < 32) || (Ch > 126)) {
+      continue;
+    }
+    if (X + 6 * Scale > Rect->Width) {
+      return;
+    }
+    Glyph = mFont[Ch - 32];
+    for (Gy = 0; Gy < 12; ++Gy) {
+      Bits = Gy < 6 ? (Glyph >> 32) >> (Gy * 5) : (Glyph & 0xffffffffULL) >> ((Gy - 6) * 5);
+      for (Gx = 0; Gx < 5; ++Gx) {
+        if (((Bits >> Gx) & 1U) != 0) {
+          for (Dx = 0; Dx < Scale; ++Dx) {
+            Fill (Gop, Rect, X + Gx * Scale + Dx, Y + Gy * Scale, 1, Scale, &White);
+          }
+        }
+      }
+    }
+    X += 6 * Scale;
+  }
+}
+
+STATIC VOID
+Draw (EFI_GRAPHICS_OUTPUT_PROTOCOL *Gop, CONST UNIXNU_PLUGIN_RECT *Rect)
+{
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL Background = {0x18,0x12,0x10,0};
+  CHAR8 Line[96];
+  Fill (Gop, Rect, 0, 0, Rect->Width, Rect->Height, &Background);
+  Text (Gop, Rect, 0, "K70 UEFI USB diagnostics");
+  Text (Gop, Rect, 1, "Read-only queries; no storage commands");
+  AsciiSPrint (Line, sizeof (Line), "USBDevice %a; UsbfnIo handles %u",
+    mService.Usb == NULL ? "MISSING" : "present", (UINT32)mService.UsbfnHandles);
+  Text (Gop, Rect, 2, Line);
+  AsciiSPrint (Line, sizeof (Line), "Init 0x%lx  Last 0x%lx",
+    (UINT64)mService.InitStatus, (UINT64)mService.LastStatus);
+  Text (Gop, Rect, 3, Line);
+  AsciiSPrint (Line, sizeof (Line), "Phase %u; stop reason %u; %u seconds",
+    (UINT32)mService.Phase, (UINT32)mService.Core.StopReason,
+    (UINT32)((NowMs () - mService.BeganMs) / 1000));
+  Text (Gop, Rect, 4, Line);
+  AsciiSPrint (Line, sizeof (Line), "Connected %u; commands %u; RX %u TX %u",
+    mService.Core.Connected, mService.Core.Commands,
+    mService.HardwareRxPending, mService.HardwareTxPending);
+  Text (Gop, Rect, 5, Line);
+  Text (Gop, Rect, 6, "Serial: K70UEFI20261104");
+  Text (Gop, Rect, 7, "getvar:k70-hello / getvar:k70-log");
+  if (mQuarantined) {
+    Text (Gop, Rect, 8, "USB cleanup failed; buffers retained");
+  } else if (mService.LastStatus == EFI_NOT_FOUND) {
+    Text (Gop, Rect, 8, "No provider. An app cannot supply it.");
+  } else {
+    Text (Gop, Rect, 8, "30s connect / 60s idle / 180s total");
+  }
+  Text (Gop, Rect, 9, "Esc or Enter: return to Tools");
+}
+
+STATIC EFI_STATUS EFIAPI
+Run (UNIXNU_MENU_PLUGIN_PROTOCOL *This, EFI_GRAPHICS_OUTPUT_PROTOCOL *Gop,
+     CONST UNIXNU_PLUGIN_RECT *Content, UNIXNU_MENU_PLUGIN_DRAW_STATUS DrawStatus)
+{
+  UINT64 LastDraw = 0, FinishedAt = 0;
+  if ((Gop == NULL) || (Content == NULL) || (Content->Width < 120) ||
+      (Content->Height < 100) || (Gop->Mode == NULL) || (Gop->Mode->Info == NULL) ||
+      ((UINT64)Content->X + Content->Width > Gop->Mode->Info->HorizontalResolution) ||
+      ((UINT64)Content->Y + Content->Height > Gop->Mode->Info->VerticalResolution)) {
+    return EFI_INVALID_PARAMETER;
+  }
+  if (mLeavingBootServices || mQuarantined || mProviderStopped) {
+    return EFI_NOT_READY;
+  }
+#if K70_USB_DIAG_AUTOSTART
+  /* Take over an automatic session; a manual loop must not race its timer. */
+  if (mTimerEvent != NULL) {
+    gBS->SetTimer (mTimerEvent, TimerCancel, 0);
+  }
+#endif
+  if (!mService.Active) {
+    BeginService ();
+  }
+  if (DrawStatus != NULL) {
+    DrawStatus (This, 0, L"USB diagnostics: read-only; Esc/Enter returns to Tools");
+  }
+  for (;;) {
+    UINT64 Now = NowMs ();
+    if (ExitKey ()) {
+      RequestStop (&mService, KdUserExit);
+      FinishedAt = 1;
+    }
+    ServiceStep ();
+    if (Now - LastDraw >= 250) {
+      Draw (Gop, Content);
+      LastDraw = Now;
+    }
+    if (!mService.Active) {
+      if (FinishedAt == 0) {
+        FinishedAt = Now;
+        Draw (Gop, Content);
+      }
+      if ((FinishedAt == 1) || (Now - FinishedAt >= 5000)) {
+        break;
+      }
+    }
+    gBS->Stall (20000);
+  }
+  if (mService.LastStatus == EFI_NOT_FOUND) {
+    return EFI_NOT_FOUND;
+  }
+  if (mQuarantined) {
+    return EFI_DEVICE_ERROR;
+  }
+  /* NOT_READY from a normal Send retry must not hide the eventual timeout
+     or the user's deliberate exit. Cleanup failure has priority above. */
+  if (mService.CoreStarted && (mService.Core.StopReason == KdUserExit)) {
+    return EFI_SUCCESS;
+  }
+  if ((mService.Core.StopReason >= KdConnectTimeout) &&
+      (mService.Core.StopReason <= KdSessionTimeout)) {
+    return EFI_TIMEOUT;
+  }
+  if (mService.Core.StopReason == KdTransportError) {
+    return EFI_DEVICE_ERROR;
+  }
+  if (mService.Core.StopReason == KdDisconnected) {
+    return EFI_NOT_READY;
+  }
+  if (EFI_ERROR (mService.LastStatus)) {
+    return mService.LastStatus;
+  }
+  return EFI_SUCCESS;
+}
+
+/* No buffer is freed in either EBS callback. A caller must leave the tool
+   normally before launching an OS; event callbacks cannot veto a failed Stop. */
+STATIC VOID EFIAPI
+BeforeExit (EFI_EVENT Event, VOID *Context)
+{
+  (VOID)Event;
+  (VOID)Context;
+#if K70_USB_DIAG_AUTOSTART
+  if (mTimerEvent != NULL) {
+    gBS->SetTimer (mTimerEvent, TimerCancel, 0);
+  }
+#endif
+  if (mService.Active && mService.OwnsStart && (mService.Usb != NULL)) {
+    if (mService.HardwareRxPending) {
+      mService.Usb->AbortXfer (KD_EP_OUT);
+    }
+    if (mService.HardwareTxPending) {
+      mService.Usb->AbortXfer (KD_EP_IN);
+    }
+    mService.LastStatus = mService.Usb->Stop ();
+    mProviderStopped = TRUE;
+    mService.OwnsStart = FALSE;
+    mService.RetainBuffers = TRUE;
+    mQuarantined = TRUE;
+  }
+  mService.Active = FALSE;
+  mLeavingBootServices = TRUE;
+}
+
+STATIC VOID EFIAPI
+Exited (EFI_EVENT Event, VOID *Context)
+{
+  (VOID)Event;
+  (VOID)Context;
+  /* No Boot Services or USB provider calls after the final EBS notification. */
+  mLeavingBootServices = TRUE;
+  mService.Active = FALSE;
+}
+
+#if K70_USB_DIAG_AUTOSTART
+STATIC VOID EFIAPI
+TimerStep (EFI_EVENT Event, VOID *Context)
+{
+  (VOID)Context;
+  ServiceStep ();
+  if (!mService.Active) {
+    gBS->SetTimer (Event, TimerCancel, 0);
+  }
+}
+
+STATIC VOID EFIAPI
+Ready (EFI_EVENT Event, VOID *Context)
+{
+  (VOID)Event;
+  (VOID)Context;
+  if (!mService.Active && !mLeavingBootServices && !mQuarantined && !mProviderStopped) {
+    BeginService ();
+    gBS->SetTimer (mTimerEvent, TimerPeriodic, TIMER_PERIOD_100NS);
+  }
+}
+#endif
+
+STATIC UNIXNU_MENU_PLUGIN_PROTOCOL mPlugin = {
+  UNIXNU_MENU_PLUGIN_PROTOCOL_SIGNATURE,
+  UNIXNU_MENU_PLUGIN_PROTOCOL_VERSION,
+  L"K70 USB diagnostics (read-only)", Run
+};
+
+EFI_STATUS EFIAPI
+K70UsbDiagEntry (EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable)
+{
+  EFI_STATUS Status;
+  (VOID)SystemTable;
+  Status = gBS->CreateEventEx (EVT_NOTIFY_SIGNAL, TPL_CALLBACK, BeforeExit,
+    NULL, &gEfiEventBeforeExitBootServicesGuid, &mBeforeExitEvent);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+  Status = gBS->CreateEventEx (EVT_NOTIFY_SIGNAL, TPL_CALLBACK, Exited,
+    NULL, &gEfiEventExitBootServicesGuid, &mExitEvent);
+  if (EFI_ERROR (Status)) {
+    gBS->CloseEvent (mBeforeExitEvent);
+    return Status;
+  }
+#if K70_USB_DIAG_AUTOSTART
+  Status = gBS->CreateEvent (EVT_TIMER | EVT_NOTIFY_SIGNAL, TPL_CALLBACK,
+    TimerStep, NULL, &mTimerEvent);
+  if (!EFI_ERROR (Status)) {
+    Status = gBS->CreateEventEx (EVT_NOTIFY_SIGNAL, TPL_CALLBACK, Ready,
+      NULL, &gEfiEventReadyToBootGuid, &mReadyEvent);
+  }
+  if (EFI_ERROR (Status)) {
+    if (mTimerEvent != NULL) {
+      gBS->CloseEvent (mTimerEvent);
+    }
+    gBS->CloseEvent (mBeforeExitEvent);
+    gBS->CloseEvent (mExitEvent);
+    return Status;
+  }
+#endif
+  Status = gBS->InstallMultipleProtocolInterfaces (&ImageHandle,
+    &gUniXNUMenuPluginProtocolGuid, &mPlugin, NULL);
+  if (EFI_ERROR (Status)) {
+#if K70_USB_DIAG_AUTOSTART
+    gBS->CloseEvent (mReadyEvent);
+    gBS->CloseEvent (mTimerEvent);
+#endif
+    gBS->CloseEvent (mBeforeExitEvent);
+    gBS->CloseEvent (mExitEvent);
+  }
+  return Status;
+}
