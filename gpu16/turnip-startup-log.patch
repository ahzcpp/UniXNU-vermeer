+
+#ifdef __APPLE__
+#include <IOKit/IOKitLib.h>
+#include <errno.h>
+#include <unistd.h>
+/* One best-effort, checksummed numeric startup error per process. Dedicated
+ * rows survive the frontend's later no-device text. Existing shared marker
+ * framing can interleave; consumers must reject an incomplete/bad checksum.
+ * Only the source basename/line/result and PID are sent, never format/args. */
+static void
+k70_record_first_vk_error(VkResult error, const char *file, int line,
+                          const char *format, va_list args)
+{
+   (void)format; (void)args;
+   static unsigned recorded;
+   if (error >= 0 || !__sync_bool_compare_and_swap(&recorded, 0, 1))
+      return;
+   const int saved_errno = errno;
+   const char *base = file ? strrchr(file, '/') : NULL;
+   base = base ? base+1 : file ? file : "unknown";
+   char safe[17], text[96];
+   unsigned n = 0;
+   while (n < 16 && base[n]) {
+      unsigned char c = (unsigned char)base[n];
+      safe[n++] = c >= 32 && c < 127 ? c : '_';
+   }
+   safe[n] = 0;
+   int length = snprintf(text, sizeof(text), "VK435 p=%d e=%d f=%s l=%d", (int)getpid(), (int)error, safe, line);
+   if (length <= 0 || (unsigned)length + 8 >= sizeof(text)) {errno=saved_errno;return;}
+   unsigned checksum = 0;
+   for (int i=0;i<length;++i)checksum = ((checksum*33u) ^ (unsigned char)text[i]) & 0xffffu;
+   snprintf(text+length,sizeof(text)-(unsigned)length," c=%04x",checksum);
+   const char *who = getprogname();
+   unsigned row = who && strstr(who,"WebKit") ? 46u : who && strstr(who,"mediaserverd") ? 45u : 47u;
+   io_service_t service = IOServiceGetMatchingService(0, IOServiceMatching("IOAcceleratorES"));
+   if (service) {
+      io_connect_t unused = 0;
+      if (IOServiceOpen(service, mach_task_self(), 0x4147c000u | row, &unused) == KERN_SUCCESS)IOServiceClose(unused);
+      for (unsigned i=0;text[i] && i<sizeof(text)-1;i+=2) {
+         unsigned a=(unsigned char)text[i]&0x7fu;
+         unsigned b=text[i+1] ? ((unsigned char)text[i+1]&0x7fu) : 0u;
+         unused=0;
+         if (IOServiceOpen(service,mach_task_self(),0x41478000u | (a<<7) | b,&unused)==KERN_SUCCESS)IOServiceClose(unused);
+      }
+      IOObjectRelease(service);
+   }
+   errno=saved_errno;
+}
+#endif
+
 VkResult
 __vk_errorv(const void *_obj, VkResult error,
             const char *file, int line,
             const char *format, va_list va)
 {
+#ifdef __APPLE__
+   k70_record_first_vk_error(error, file, line, format, va);
+#endif
    struct vk_object_base *object = (struct vk_object_base *)_obj;
    struct vk_instance *instance = vk_object_to_instance(object);
    object = vk_object_for_error(object, error);
