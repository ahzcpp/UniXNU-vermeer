+static void Stock(const char *Name) {
+  FILE *F = fopen(Name, "rb"); long Length; void *Data; K70_FDT_RAM Info; int Result;
+  assert(F); assert(fseek(F, 0, SEEK_END) == 0); Length = ftell(F); assert(Length > 0 && Length <= 0x100000);
+  rewind(F); Data = malloc((size_t)Length); assert(Data); assert(fread(Data, 1, (size_t)Length, F) == (size_t)Length); fclose(F);
+  Result = K70ReadFdtRam(Data, (size_t)Length, &Info);
+  printf("stock_file=%s parse=%d nonzero_banks=%u reservations=%u dynamic_unknown=%u defer=%u\n", Name, Result, Info.BankCount, Info.ReservedCount, Info.DynamicReservationUnknown, Info.DeferredOsDynamicCount);
+  assert(Result == K70_RAM_NO_BANK && Info.BankCount == 0 && Info.DynamicReservationUnknown == 0 && Info.DeferredOsDynamicCount == 17);
+  free(Data);
+}
+int main(int Argc, char **Argv) {
+  int I;
+  CheckParse(); CheckPlanner(); CheckDynamic();
+  for (I = 1; I < Argc; ++I) Stock(Argv[I]);
+  puts("PASS: bounded parsing, explicit refusals, 1500 randomized page-set comparisons; no device memory accessed");
+  return 0;
+}
