diff --git a/research/boot-chain-05/export-r3-source.py b/research/boot-chain-05/export-r3-source.py
new file mode 100644
index 0000000..043869f
--- /dev/null
+++ b/research/boot-chain-05/export-r3-source.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Freeze source/reports and export a source-only delta on public r1 + r2."""
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+W=Path(__file__).resolve().parent
+B=W.parent
+O=B/'device-source'
+A=B/'artifacts/boot-chain-05r3'
+BASES=[(O/'boot05-memory-source.patch','588a60d1f22f45ba53a16596be18d2995a953f0cd0b18e9737a297fca884bb71'),
+       (O/'boot05r2-memory-source.patch','0042eea2b2e38291ac4742c99f110a3b5e778bc1b8db16d421d75ec93ba33bec')]
+def sha(data):return hashlib.sha256(data).hexdigest()
+for p,digest in BASES:assert sha(p.read_bytes())==digest
+audit=json.loads((A/'fd-audit.json').read_text())
+build=json.loads((W/'build-result.json').read_text())
+verification=json.loads((A/'verification.json').read_text())
+assert audit['success'] and build['exit_code']==0 and not build['source_changed_during_build']
+assert audit['fd_sha256']==verification['firmware_sha256']=='845d1790c4eda640435a17858cfbd4df4d91258e3fdcd904b453b78565631b9a'
+assert sha((A/'fd-audit.json').read_bytes())==verification['firmware_audit_snapshot_sha256']
+for rel,digest in build['source_sha256'].items():assert sha((W/rel).read_bytes())==digest
+
+mapping={};preserve={rel:W/rel for rel in build['source_sha256']}
+def add(target,source):
+    data=source.read_bytes();text=data.decode('utf-8-sig')
+    assert '\0' not in text and re.search(r'^-----BEGIN [A-Z ]*PRIVATE KEY-----$',text,re.M) is None
+    assert target.startswith(('research/boot-chain-05/','research/memory-next/'))
+    mapping[target]=data
+for name in ['DarwinBoot.c','FdtRamPlan.c','FdtRamPlan.h','QualifiedUnion.h']:
+    add('research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/'+name,W/'darwinboot/DarwinBootPkg/Driver'/name)
+for name in ['incremental-ui.py','package-r3.py','R3-README.md','export-r3-source.py']:
+    add('research/boot-chain-05/'+name,W/name);preserve[name]=W/name
+for name in ['prepare-r3-dynamic.py','run-r3-tests.py','test-fdt-ram-r3.c','r3-host-test-results.json',
+             'r3-prepare-reproduction.json','dynamic-os-request-evidence.json',
+             'next-qualified-union/QualifiedUnion.h','next-qualified-union/FdtRamPlan.h',
+             'next-qualified-union/test-qualified-union.c','next-qualified-union/verification.json']:
+    source=B/'memory-next'/name
+    add('research/memory-next/'+name,source);preserve['memory-next/'+name]=source
+for name in ['build-result.json','r3-change.json']:
+    add('research/boot-chain-05/r3/'+name,W/name);preserve[name]=W/name
+for name in ['fd-audit.json','verification.json']:
+    add('research/boot-chain-05/r3/'+name,A/name);preserve[name]=A/name
+source=B/'storage-next/high-pa-entry-readonly.json'
+add('research/boot-chain-05/r3/high-pa-entry-readonly.json',source)
+preserve['high-pa-entry-readonly.json']=source
+snapshot=W/'source-snapshots/r3-verified-845d1790'
+for target,source in preserve.items():
+    p=snapshot/target;data=source.read_bytes()
+    if p.exists():assert p.read_bytes()==data,'Frozen r3 snapshot differs: '+target
+    else:p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(data)
+
+def init(repo):
+    subprocess.run(['git','init','-q',str(repo)],check=True)
+    subprocess.run(['git','-C',str(repo),'config','core.autocrlf','false'],check=True)
+    for patch,_ in BASES:subprocess.run(['git','-C',str(repo),'apply','--whitespace=nowarn',str(patch)],check=True)
+with tempfile.TemporaryDirectory(prefix='k70-r3-delta-') as name:
+    repo=Path(name);init(repo)
+    subprocess.run(['git','-C',str(repo),'add','--all'],check=True)
+    subprocess.run(['git','-C',str(repo),'-c','user.name=Source Audit','-c','user.email=source-audit@localhost',
+                    'commit','-qm','Frozen r1 and r2 source base'],check=True)
+    before={str(p.relative_to(repo)):p.read_bytes() for p in repo.rglob('*') if p.is_file() and '.git' not in p.parts}
+    for target,data in mapping.items():
+        p=repo/target;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(data)
+    subprocess.run(['git','-C',str(repo),'add','--all'],check=True)
