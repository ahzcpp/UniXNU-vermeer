+static unsigned char Blob[16384] __attribute__((aligned(8)));
+static unsigned Seed = 0x7040506;
+static unsigned Next(void) { Seed ^= Seed << 13; Seed ^= Seed >> 17; Seed ^= Seed << 5; return Seed; }
+static void Fixture(void) {
+  int Node;
+  assert(fdt_create_empty_tree(Blob, sizeof Blob) == 0);
+  assert(fdt_setprop_u32(Blob, 0, "#address-cells", 2) == 0);
+  assert(fdt_setprop_u32(Blob, 0, "#size-cells", 2) == 0);
+  Node = fdt_add_subnode(Blob, 0, "reserved-memory"); assert(Node >= 0);
+  assert(fdt_setprop_u32(Blob, Node, "#address-cells", 2) == 0);
+  assert(fdt_setprop_u32(Blob, Node, "#size-cells", 2) == 0);
+  assert(fdt_setprop(Blob, Node, "ranges", 0, 0) == 0);
+  Node = fdt_add_subnode(Blob, 0, "memory@80000000"); assert(Node >= 0);
+  assert(fdt_setprop_string(Blob, Node, "device_type", "memory") == 0);
+}
+static void Reg(int Node, const char *Name, K70_U64 Base, K70_U64 Bytes) {
+  fdt64_t Data[2] = {cpu_to_fdt64(Base), cpu_to_fdt64(Bytes)};
+  assert(fdt_setprop(Blob, Node, Name, Data, sizeof Data) == 0);
+}
+static void CheckParse(void) {
+  K70_FDT_RAM Info;
+  int Node, Parent;
+  Fixture();
+  Node = fdt_path_offset(Blob, "/memory@80000000");
+  Reg(Node, "reg", 0, 0);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_NO_BANK);
+  Reg(Node, "reg", 0x80000000ULL, 0x100000000ULL);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_OK);
+  assert(Info.BankCount == 1 && Info.Banks[0].Base == 0x80000000ULL && Info.Banks[0].End == 0x180000000ULL);
+  Parent = fdt_path_offset(Blob, "/reserved-memory");
+  Node = fdt_add_subnode(Blob, Parent, "guard@90000000"); assert(Node >= 0);
+  Reg(Node, "reg", 0x90000000ULL, 0x1000000);
+  assert(fdt_add_mem_rsv(Blob, 0xa0000000ULL, 0x200000) == 0);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_OK && Info.ReservedCount == 2);
+  Parent = fdt_path_offset(Blob, "/reserved-memory");
+  Node = fdt_add_subnode(Blob, Parent, "unknown-dynamic"); assert(Node >= 0);
+  assert(fdt_setprop_u64(Blob, Node, "size", 0x800000) == 0);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_DYNAMIC_UNKNOWN);
+  assert(Info.DynamicReservationUnknown == 1);
+  Reg(Node, "alloc-ranges", 0xb0000000ULL, 0x10000000);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_DYNAMIC_UNKNOWN && Info.ReservedCount == 2);
+  assert(K70ReadFdtRam(Blob, 39, &Info) == K70_RAM_BAD_FDT);
+  assert(K70ReadFdtRam(Blob, fdt_totalsize(Blob)-1, &Info) == K70_RAM_BAD_FDT);
+  Fixture(); Node = fdt_path_offset(Blob, "/memory@80000000");
+  Reg(Node, "reg", 0xfffffffffffff000ULL, 0x2000);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_BAD_RANGES);
+  Fixture(); Node = fdt_path_offset(Blob, "/memory@80000000");
+  Reg(Node, "reg", 0x80000000ULL, 0x8000000);
+  assert(fdt_setprop_string(Blob, Node, "status", "disabled") == 0);
+  assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_NO_BANK);
+}
+static int Contains(K70_RAM_RANGE R, K70_U64 P) { return R.Base <= P && P < R.End; }
+static void CheckPlanner(void) {
+  unsigned Round, P, I, Count;
+  const K70_U64 Base = 0x90000000ULL;
+  K70_FDT_RAM Info;
+  K70_RAM_RANGE Gaps[2], Exclude[4], Out[K70_RAM_PIECES];
+  for (Round = 0; Round < 1500; ++Round) {
+    memset(&Info, 0, sizeof Info);
+    Info.BankCount = 1; Info.Banks[0] = (K70_RAM_RANGE){Base, Base + 256*4096};
+    Gaps[0] = (K70_RAM_RANGE){Base + 4096*(Next()%32), Base + 128*4096};
+    Gaps[1] = (K70_RAM_RANGE){Base + 160*4096, Base + 256*4096};
+    Info.ReservedCount = 4;
+    for (I = 0; I < 4; ++I) {
+      K70_U64 R = Base + (Next()%256)*4096;
+      Info.Reserved[I] = (K70_RAM_RANGE){R, R + (1+Next()%24)*4096};
+      R = Base + (Next()%256)*4096;
+      Exclude[I] = (K70_RAM_RANGE){R, R + (1+Next()%16)*4096};
+    }
+    assert(K70PlanNewRam(&Info, Gaps, 2, Exclude, 4, 40, Out, K70_RAM_PIECES, &Count) == K70_RAM_OK);
+    for (P = 0; P < 256; ++P) {
+      K70_U64 Address = Base + P*4096;
+      int Expected = Contains(Gaps[0], Address) || Contains(Gaps[1], Address);
+      unsigned Seen = 0;
+      for (I = 0; I < 4; ++I) if (Contains(Info.Reserved[I], Address) || Contains(Exclude[I], Address)) Expected = 0;
+      for (I = 0; I < Count; ++I) {
+        assert(Out[I].Base < Out[I].End && !(Out[I].Base & 4095) && !(Out[I].End & 4095));
+        Seen += Contains(Out[I], Address);
+      }
+      assert(Seen == (unsigned)Expected);
+    }
+  }
+  Info.DynamicReservationUnknown = 1;
+  assert(K70PlanNewRam(&Info, Gaps, 2, Exclude, 4, 40, Out, K70_RAM_PIECES, &Count) == K70_RAM_BAD_RANGES && Count == 0);
+  Info.DynamicReservationUnknown = 0;
+  assert(K70PlanNewRam(&Info, Gaps, 2, Exclude, 4, 40, Out, 0, &Count) == K70_RAM_CAPACITY && Count == 0);
+  Gaps[1] = Gaps[0];
+  assert(K70PlanNewRam(&Info, Gaps, 2, Exclude, 4, 40, Out, K70_RAM_PIECES, &Count) == K70_RAM_BAD_RANGES && Count == 0);
+}
+
+static int Pool (const char *Name, unsigned Debug) {
+  int N, Parent = fdt_path_offset(Blob,"/reserved-memory"), Soc, C;
+  N=fdt_add_subnode(Blob,Parent,Name);assert(N>=0);
+  assert(fdt_setprop_u64(Blob,N,"size",Debug?0x1000:0x4000000)==0);
+  Reg(N,"alloc-ranges",0,Debug?0xffffffffffffffffULL:0xffffffff);
+  if(Debug) {
+    assert(fdt_setprop(Blob,N,"no-map",0,0)==0);
+    assert(fdt_setprop_u32(Blob,N,"phandle",0xd8)==0);
+    Soc=fdt_add_subnode(Blob,0,"soc");assert(Soc>=0);
+    C=fdt_add_subnode(Blob,Soc,"google,debug-kinfo");assert(C>=0);
+    assert(fdt_setprop_string(Blob,C,"compatible","google,debug-kinfo")==0);
+    assert(fdt_setprop_u32(Blob,C,"memory-region",0xd8)==0);
+  } else {
+    assert(fdt_setprop_string(Blob,N,"compatible","shared-dma-pool")==0);
+    assert(fdt_setprop(Blob,N,"reusable",0,0)==0);
+    assert(fdt_setprop_u64(Blob,N,"alignment",0x400000)==0);
+  }
+  { char Path[128];snprintf(Path,sizeof Path,"/reserved-memory/%s",Name);return fdt_path_offset(Blob,Path); }
+}
+static void Base(void) {
+  int N;
+  Fixture();N=fdt_path_offset(Blob,"/memory@80000000");Reg(N,"reg",0x900000000ULL,0x40000000);
+}
+static void CheckDynamic(void) {
+  K70_FDT_RAM I;int N,C;
+  Base();N=Pool("qseecom_region",0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.ReservedCount==0&&I.DeferredOsDynamicCount==1);
+  assert(fdt_setprop_u64(Blob,N,"size",0x3600000)==0); // Base DT variant.
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.DeferredOsDynamicCount==1);
+  assert(fdt_setprop_u64(Blob,N,"size",0x4000000)==0); // Official DTBO54 variant.
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.DeferredOsDynamicCount==1);
+  Reg(N,"reg",0x910000000ULL,0x100000);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.ReservedCount==1&&I.DeferredOsDynamicCount==0);
+  assert(I.Reserved[0].Base==0x910000000ULL&&I.Reserved[0].End==0x910100000ULL);
+  assert(fdt_delprop(Blob,N,"reg")==0);
+  assert(fdt_setprop(Blob,N,"no-map",0,0)==0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("foreign_shared_pool",0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN&&I.ReservedCount==0);
+  Base();N=Pool("qseecom_region",0);assert(fdt_delprop(Blob,N,"reusable")==0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("qseecom_region",0);assert(fdt_setprop_u64(Blob,N,"alignment",3)==0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("qseecom_region",0);Reg(N,"alloc-ranges",0xfffffffffffff000ULL,0x2000);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("debug_kinfo_region",1);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.ReservedCount==0&&I.DeferredOsDynamicCount==1);
+  C=fdt_path_offset(Blob,"/soc/google,debug-kinfo");assert(fdt_setprop_u32(Blob,C,"memory-region",0xd9)==0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("debug_kinfo_region",1);assert(fdt_setprop_u64(Blob,N,"size",0x2000)==0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("debug_kinfo_region",1);Reg(N,"reg",0x910000000ULL,0x1000);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.ReservedCount==1&&I.DeferredOsDynamicCount==0);
+}
