+// Host-only tests. Synthetic bank fixtures are not measurements of the K70.
+#include "/mnt/e/K70-UniXNU-20261104/boot-chain-05/darwinboot/DarwinBootPkg/Driver/FdtRamPlan.h"
+#include <assert.h>
+#include <libfdt.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
