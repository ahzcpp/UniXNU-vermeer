diff --git a/research/boot-chain-05/package-r3.py b/research/boot-chain-05/package-r3.py
new file mode 100644
index 0000000..2aea370
--- /dev/null
+++ b/research/boot-chain-05/package-r3.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""Package measured512 firmware with the unchanged trace02 kernel; no phone I/O."""
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import tomllib
+import zlib
+
+if not __debug__:
+    raise SystemExit('Run without -O: validation is required')
+ROOT = Path('/root/k70-clean-20261104')
+DELIVERY = Path('/mnt/e/K70-UniXNU-20261104')
+WORK = DELIVERY / 'boot-chain-05'
+OUT = DELIVERY / 'artifacts/boot-chain-05r3'
+PREVIOUS = DELIVERY / 'artifacts/entry-fixed-video-02'
+FD = ROOT / 'uefi/Build/vermeerBoot05/DEBUG_CLANGPDB/FV/SILICIUM_UEFI.fd'
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+build = json.loads((WORK / 'build-result.json').read_text())
+assert build['exit_code'] == 0 and not build['source_changed_during_build']
+for name, digest in build['source_sha256'].items():
+    assert sha(WORK / name) == digest, 'Source changed since build: ' + name
+assert FD.stat().st_size == 0x300000
+audit_bytes = (WORK / 'fd-audit.json').read_bytes()
+audit = json.loads(audit_bytes)
+assert audit['schema'] == 'k70-boot05-fd-audit/1' and audit['success']
+assert audit['fd_sha256'] == sha(FD)
+expected_fd_sha256 = audit['fd_sha256']
+assert sha(PREVIOUS / 'payload.img') == '6a0acf7f35b41ed57eea0e3fa14a5b0fd22e14607e799459c9337c089d14b9e2'
+OUT.mkdir(parents=True, exist_ok=True)
+assert not (OUT / 'boot.img').exists(), 'Refusing to overwrite a completed candidate'
+scratch = Path(tempfile.mkdtemp(prefix='readback-', dir=OUT))
+payload = OUT / 'payload.img'
+shutil.copyfile(PREVIOUS / 'payload.img', payload)
+for member in ['unixnu.toml', 'Payloads/kernel.macho', 'Payloads/kernel.macho.adt']:
+    subprocess.run(['mcopy', '-i', str(payload), '::/EFI/UniXNU/' + member,
+                    str(scratch / Path(member).name)], check=True)
+assert sha(scratch / 'kernel.macho') == '4559b64843cab506d9d2781172143e13ddb4c546f7b73e3298d5e23ee62906bd'
+adt = scratch / 'kernel.macho.adt'
+original = adt.read_bytes()
+assert hashlib.sha256(original).hexdigest() == '2bbd5c1c93579c712d77d90ae1907df65fbda1da8bf8de6d94873f72e04c964d'
+data = bytearray(original)
+found = []
+
+def node(offset, depth=0):
+    assert depth < 64 and offset + 8 <= len(data)
+    props, children = struct.unpack_from('<II', data, offset)
+    assert props < 10000 and children < 10000
+    offset += 8
+    values = []
+    name = None
+    for unused in range(props):
+        assert offset + 36 <= len(data)
+        key = bytes(data[offset:offset+32]).split(b'\0', 1)[0].decode('ascii')
+        size = struct.unpack_from('<I', data, offset + 32)[0]
+        offset += 36
+        assert offset + size <= len(data)
+        if key == 'name':
+            name = bytes(data[offset:offset+size]).rstrip(b'\0').decode('ascii')
+        values.append((key, offset, size))
+        offset = (offset + size + 3) & ~3
+    for key, at, size in values:
+        if key == 'darwinboot-memory-size':
+            assert depth == 1 and name == 'chosen' and size == 8
+            assert struct.unpack_from('<Q', data, at)[0] == 0x20000000
+            found.append(at)
+    for unused in range(children):
+        offset = node(offset, depth + 1)
+    return offset
+
+assert node(0) == len(data) and len(found) == 1
+at = found[0]
+struct.pack_into('<Q', data, at, 0x20000000)
+assert data[:at] == original[:at] and data[at+8:] == original[at+8:]
+adt.write_bytes(data)
+config = scratch / 'unixnu.toml'
+title = 'K70 boot05r3 dynamic fix RAM512 - NO OS ROOT'
+text = config.read_text()
+assert text.count('K70 trace02 fixed-video entry - NO OS ROOT') == 1
+config.write_text(text.replace('K70 trace02 fixed-video entry - NO OS ROOT', title))
+for file, member in [(adt, 'Payloads/kernel.macho.adt'), (config, 'unixnu.toml')]:
+    subprocess.run(['mdel', '-i', str(payload), '::/EFI/UniXNU/' + member], check=True)
+    subprocess.run(['mcopy', '-i', str(payload), str(file), '::/EFI/UniXNU/' + member], check=True)
+readback = scratch / 'verify'
+readback.mkdir()
+for member in ['unixnu.toml', 'Payloads/kernel.macho', 'Payloads/kernel.macho.adt']:
+    output = readback / Path(member).name
+    subprocess.run(['mcopy', '-i', str(payload), '::/EFI/UniXNU/' + member, str(output)], check=True)
+    assert output.read_bytes() == (scratch / output.name).read_bytes()
+meta = json.loads((PREVIOUS / 'payload.json').read_text())
+entry = next(e for e in tomllib.loads((readback / 'unixnu.toml').read_text())['entry'] if e['id'] == 'xnu')
+assert entry['title'] == title and entry['args'] == meta['kernel_args']
+assert 'rd=md0' not in entry['args']
+sys.path.insert(0, str(ROOT / 'UniXNU/scripts'))
+from unixnu.cli import parser
+from unixnu.config import Context
+from unixnu import bootimg
+ctx = Context(parser().parse_args(['bootimg', '-D', str(ROOT / 'device-committed'),
+                                 '--out', str(ROOT / 'out-final')]))
+image = OUT / 'boot.img'
+bootimg.build(ctx, ROOT / 'uefi', FD, DELIVERY / 'stock-analysis/vendor_boot/dtb-002.dtb',
+              ramdisk=payload, output=image)
+boot = image.read_bytes()
+page = struct.unpack_from('<I', boot, 36)[0]
+ks = struct.unpack_from('<I', boot, 8)[0]
+rd = struct.unpack_from('<I', boot, 16)[0]
+assert boot[:8] == b'ANDROID!' and page == 4096 and struct.unpack_from('<I', boot, 40)[0] == 0
+offset = (1 + (ks + page - 1) // page) * page
+assert rd == payload.stat().st_size and boot[offset:offset+rd] == payload.read_bytes()
+decoder = zlib.decompressobj(31)
+combined = decoder.decompress(boot[page:page+ks])
+assert decoder.eof and combined.endswith(FD.read_bytes())
+dtb = decoder.unused_data
+assert dtb[:4] == b'\xd0\x0d\xfe\xed' and struct.unpack_from('>I', dtb, 4)[0] == len(dtb)
+assert sha(FD) == expected_fd_sha256
+shutil.copyfile(FD, OUT / 'SILICIUM_UEFI.fd')
+assert sha(OUT / 'SILICIUM_UEFI.fd') == expected_fd_sha256
+assert (WORK / 'fd-audit.json').read_bytes() == audit_bytes
+(OUT / 'fd-audit.json').write_bytes(audit_bytes)
+record = {
+    'diagnostic_id': 'boot-chain-05r3-dynamic-fix', 'hardware_tested': False,
+    'contains_os_root': False, 'userdata_written': False, 'menu_title': title,
+    'kernel_unchanged_from_trace02': True, 'kernel_sha256': sha(readback / 'kernel.macho'),
+    'adt_sha256': sha(adt), 'adt_only_changed_property': None,
+    'requested_window_bytes': 0x20000000,
+    'allowed_kernel_window': 'Only the new region certified from runtime FDT metadata and the current GCD NonExistent map',
+    'payload_sha256': sha(payload), 'payload_fat_readback_matches': True,
+    'firmware_audit_snapshot_sha256': hashlib.sha256(audit_bytes).hexdigest(),
+    'firmware_audit_snapshot_verified': True,
+    'firmware_sha256': sha(FD), 'firmware_bytes': FD.stat().st_size,
+    'boot_image_sha256': sha(image), 'boot_image_bytes': image.stat().st_size,
+    'boot_header_version': 0, 'firmware_and_payload_unpacked_and_compared': True,
+    'kernel_args': meta['kernel_args'],
+    'limitation': '512 MiB is mandatory. If runtime FDT has no trustworthy extra bank or no 514 MiB contiguous unclaimed range, firmware refuses without a fallback. No OS root is included.',
+}
+(OUT / 'verification.json').write_text(json.dumps(record, indent=2) + '\n')
+print(json.dumps(record, indent=2))
