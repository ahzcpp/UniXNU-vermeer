+    'r3_immutable_fd_audit_sha256':verification['firmware_audit_snapshot_sha256'],
+    'high_pa_binary_report_kernel':'storage962381; not baseline4559, not runtime or DMA proof',
+    'snapshot_files':len(preserve),
+}
+(O/'boot05r3-memory-source.patch').write_bytes(patch)
+(O/'boot05r3-memory-source.manifest.json').write_text(json.dumps(result,indent=2)+'\n')
+shutil.copyfile(W/'R3-README.md',O/'docs/boot05r3-memory-2026-11-04.md')
+print(json.dumps({k:v for k,v in result.items() if k!='files'},indent=2))
