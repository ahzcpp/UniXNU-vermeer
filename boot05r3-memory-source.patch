diff --git a/research/memory-next/next-qualified-union/FdtRamPlan.h b/research/memory-next/next-qualified-union/FdtRamPlan.h
new file mode 100644
index 0000000..fe62a25
--- /dev/null
+++ b/research/memory-next/next-qualified-union/FdtRamPlan.h
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef K70_FDT_RAM_PLAN_H
+#define K70_FDT_RAM_PLAN_H
+
+// Pure metadata planner. No physical read, MMIO, allocation, HOB publication,
+// GCD mutation, or device I/O occurs in these functions. Fdt must be an already
+// validated readable buffer, not an arbitrary physical address.
+#ifdef K70_RAM_HOST
+#include <stddef.h>
+#include <stdint.h>
+typedef uint64_t K70_U64;
+typedef size_t K70_SIZE;
+#else
+#include <Uefi.h>
+typedef UINT64 K70_U64;
+typedef UINTN K70_SIZE;
+#endif
+
+#define K70_RAM_BANKS 64
+#define K70_RAM_RESERVATIONS 256
+#define K70_RAM_PIECES 128
+typedef struct { K70_U64 Base, End; } K70_RAM_RANGE; // End is exclusive.
+typedef struct {
+  K70_RAM_RANGE Banks[K70_RAM_BANKS];
+  K70_RAM_RANGE Reserved[K70_RAM_RESERVATIONS];
+  unsigned BankCount, ReservedCount;
+  unsigned DynamicReservationUnknown;
+} K70_FDT_RAM;
+
+enum {
+  K70_RAM_OK = 0,
+  K70_RAM_NO_BANK = 1,
+  K70_RAM_DYNAMIC_UNKNOWN = 2,
+  K70_RAM_BAD_FDT = 3,
+  K70_RAM_CAPACITY = 4,
+  K70_RAM_BAD_RANGES = 5
+};
+
+int K70ReadFdtRam (const void *Fdt, K70_SIZE ReadableBytes, K70_FDT_RAM *Out);
+
+// Gaps must be the current GCD's EfiGcdMemoryTypeNonExistent ranges, not
+// guessed spaces between addresses. Exclude must contain FDT/initrd and every
+// live firmware region not represented in GCD. Never reclassifies an existing
+// Reserved, MMIO, BootServices or Runtime range. Output stays page-aligned.
+int K70PlanNewRam (
+  const K70_FDT_RAM *Info,
+  const K70_RAM_RANGE *Gaps, unsigned GapCount,
+  const K70_RAM_RANGE *Exclude, unsigned ExcludeCount,
+  unsigned PhysicalAddressBits,
+  K70_RAM_RANGE *Out, unsigned Capacity, unsigned *OutCount
+  );
+#endif
diff --git a/research/memory-next/next-qualified-union/QualifiedUnion.h b/research/memory-next/next-qualified-union/QualifiedUnion.h
new file mode 100644
index 0000000..c016077
--- /dev/null
+++ b/research/memory-next/next-qualified-union/QualifiedUnion.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef K70_QUALIFIED_UNION_H
+#define K70_QUALIFIED_UNION_H
+#include "FdtRamPlan.h"
+
+// Inputs are already FDT-bank intersect current NonExistent GCD, minus every
+// reservation and live input. Canonicalize only that exact byte set. Touching
+// pieces may join only inside ONE original GCD descriptor, preserving its
+// ownership/capability/attribute boundary for the final publication recheck.
+static int
+K70JoinQualified (K70_RAM_RANGE *Plan, unsigned *Count,
+                  const K70_RAM_RANGE *Gaps, unsigned GapCount)
+{
+  unsigned I, J, N, Gap, LastGap = 256;
+  K70_RAM_RANGE Tmp;
+  if (Plan == 0 || Count == 0 || Gaps == 0 || *Count > K70_RAM_PIECES || GapCount > 256)
+    return K70_RAM_BAD_RANGES;
+  for (I = 0; I < *Count; ++I) {
+    if (Plan[I].Base >= Plan[I].End || (Plan[I].Base & 4095) || (Plan[I].End & 4095))
+      return K70_RAM_BAD_RANGES;
+  }
+  // Validate the COMPLETE input first. Sorting must not move a malformed
+  // lower-address entry into a slot that has already passed validation.
+  for (I = 0; I < *Count; ++I) {
+    for (J = I + 1; J < *Count; ++J) {
+      if (Plan[J].Base < Plan[I].Base) { Tmp = Plan[I]; Plan[I] = Plan[J]; Plan[J] = Tmp; }
+    }
+  }
+  N = 0;
+  for (I = 0; I < *Count; ++I) {
+    Gap = 256;
+    for (J = 0; J < GapCount; ++J) {
+      if (Gaps[J].Base <= Plan[I].Base && Plan[I].End <= Gaps[J].End) {
+        if (Gap != 256) return K70_RAM_BAD_RANGES;
+        Gap = J;
+      }
+    }
+    if (Gap == 256 || (N && Plan[I].Base < Plan[N - 1].End)) return K70_RAM_BAD_RANGES;
+    if (N && Gap == LastGap && Plan[N - 1].End == Plan[I].Base) Plan[N - 1].End = Plan[I].End;
+    else { Plan[N++] = Plan[I]; LastGap = Gap; }
+  }
+  *Count = N;
+  return K70_RAM_OK;
+}
+#endif
diff --git a/research/memory-next/next-qualified-union/test-qualified-union.c b/research/memory-next/next-qualified-union/test-qualified-union.c
new file mode 100644
index 0000000..7734ace
--- /dev/null
+++ b/research/memory-next/next-qualified-union/test-qualified-union.c
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include "QualifiedUnion.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static unsigned Seed = 78129;
+static unsigned Next (void) { Seed = Seed * 1664525u + 1013904223u; return Seed; }
+static void Cover (const K70_RAM_RANGE *P, unsigned N, unsigned char Bits[256]) {
+  unsigned I, J;
+  memset(Bits,0,256);
+  for (I=0;I<N;++I) {
+    assert(P[I].Base<P[I].End && !(P[I].Base&4095) && !(P[I].End&4095));
+    for(J=(unsigned)(P[I].Base/4096);J<P[I].End/4096;++J) { assert(J<256);Bits[J]=1; }
+  }
+}
+int main(void) {
+  K70_RAM_RANGE G[3]={{0,64*4096},{64*4096,160*4096},{176*4096,256*4096}};
+  K70_RAM_RANGE P[128], T;
+  unsigned char Before[256],After[256]; unsigned Round,I,J,N,Original;
+  for(Round=0;Round<3000;++Round) {
+    N=0;
+    for(I=0;I<256;) {
+      unsigned End=I+1+Next()%8;
+      if(End>256)End=256;
+      if(Next()%3 && !((I<64&&End>64)||(I<160&&End>160)||(I<176&&End>176)) &&
+         (End<=160||I>=176)) P[N++]=(K70_RAM_RANGE){I*4096,End*4096};
+      I=End;
+    }
+    Original=N;Cover(P,N,Before);
+    for(I=0;I<N;++I){J=Next()%N;T=P[I];P[I]=P[J];P[J]=T;}
+    assert(K70JoinQualified(P,&N,G,3)==K70_RAM_OK);Cover(P,N,After);
+    assert(!memcmp(Before,After,sizeof Before)&&N<=Original);
+    for(I=1;I<N;++I) {
+      assert(P[I-1].End<=P[I].Base);
+      if(P[I-1].End==P[I].Base)
+        assert(P[I].Base==64*4096); // Only the explicit GCD boundary remains.
+    }
+  }
+  // Two 512 MiB FDT banks in one 1 GiB GCD interval become one qualified
+  // window; no memory on either side of an exclusion is ever added.
+  G[0]=(K70_RAM_RANGE){0x900000000ULL,0x940000000ULL};
+  P[0]=(K70_RAM_RANGE){0x920000000ULL,0x940000000ULL};
+  P[1]=(K70_RAM_RANGE){0x900000000ULL,0x920000000ULL};N=2;
+  assert(K70JoinQualified(P,&N,G,1)==K70_RAM_OK&&N==1&&P[0].End-P[0].Base==0x40000000);
+  G[0]=(K70_RAM_RANGE){0x900000000ULL,0x920000000ULL};
+  G[1]=(K70_RAM_RANGE){0x920000000ULL,0x940000000ULL};N=2;
+  P[0]=G[1];P[1]=G[0];assert(K70JoinQualified(P,&N,G,2)==K70_RAM_OK&&N==2);
+  G[0]=(K70_RAM_RANGE){0x900000000ULL,0x940000000ULL};
+  P[0]=(K70_RAM_RANGE){0x900000000ULL,0x91ffff000ULL};
+  P[1]=(K70_RAM_RANGE){0x920000000ULL,0x940000000ULL};N=2;
+  assert(K70JoinQualified(P,&N,G,1)==K70_RAM_OK&&N==2);
+  P[1].Base=P[0].End-4096;N=2;assert(K70JoinQualified(P,&N,G,1)==K70_RAM_BAD_RANGES);
+  // Regression: the lower-address invalid item used to be swapped into an
+  // already validated slot by the combined validate/sort loop.
+  G[0]=(K70_RAM_RANGE){0x900000000ULL,0x940000000ULL};
+  P[0]=(K70_RAM_RANGE){0x920000000ULL,0x940000000ULL};
+  P[1]=(K70_RAM_RANGE){0x900000001ULL,0x910000000ULL};N=2;
+  assert(K70JoinQualified(P,&N,G,1)==K70_RAM_BAD_RANGES);
+  P[0]=(K70_RAM_RANGE){0x920000000ULL,0x940000000ULL};
+  P[1]=(K70_RAM_RANGE){0x900000000ULL,0x910000001ULL};N=2;
+  assert(K70JoinQualified(P,&N,G,1)==K70_RAM_BAD_RANGES);
+  P[0]=(K70_RAM_RANGE){0x920000000ULL,0x940000000ULL};
+  P[1]=(K70_RAM_RANGE){0x900000000ULL,0x8fffff000ULL};N=2;
+  assert(K70JoinQualified(P,&N,G,1)==K70_RAM_BAD_RANGES);
+  P[0]=(K70_RAM_RANGE){0x920000000ULL,0x940000000ULL};
+  P[1]=(K70_RAM_RANGE){0x900000000ULL,0x900000000ULL};N=2;
+  assert(K70JoinQualified(P,&N,G,1)==K70_RAM_BAD_RANGES);
+  puts("PASS: 3000 randomized page-set equality cases; adjacent512MiB join; no GCD/region gaps crossed; out-of-order unaligned/inverted/empty controls");
+  return 0;
+}
