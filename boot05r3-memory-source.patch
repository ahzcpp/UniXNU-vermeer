+++ b/research/memory-next/run-r3-tests.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""Test actual staged parser and publisher, never physical device memory."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+M=Path(__file__).resolve().parent
+B=M.parent
+D=B/'boot-chain-05/darwinboot/DarwinBootPkg/Driver'
+L=Path('/root/k70-clean-20261104/out-firmware/feeds/mu_basecore-8f10084c/MdePkg/Library/BaseFdtLib/libfdt/libfdt')
+files=['fdt.c','fdt_ro.c','fdt_wip.c','fdt_sw.c','fdt_rw.c','fdt_strerror.c','fdt_empty_tree.c','fdt_addresses.c','fdt_check.c']
+s=(M/'test-fdt-ram.c').read_text()
+s=s.replace('#include "FdtRamPlan.h"','#include "'+str(D/'FdtRamPlan.h')+'"')
+s=s.replace('assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_OK && Info.ReservedCount == 3);',
+            'assert(K70ReadFdtRam(Blob, sizeof Blob, &Info) == K70_RAM_DYNAMIC_UNKNOWN && Info.ReservedCount == 2);')
+extra=r'''
+static int Pool (const char *Name, unsigned Debug) {
+  int N, Parent = fdt_path_offset(Blob,"/reserved-memory"), Soc, C;
+  N=fdt_add_subnode(Blob,Parent,Name);assert(N>=0);
+  assert(fdt_setprop_u64(Blob,N,"size",Debug?0x1000:0x4000000)==0);
+  Reg(N,"alloc-ranges",0,Debug?0xffffffffffffffffULL:0xffffffff);
+  if(Debug) {
+    assert(fdt_setprop(Blob,N,"no-map",0,0)==0);
+    assert(fdt_setprop_u32(Blob,N,"phandle",0xd8)==0);
+    Soc=fdt_add_subnode(Blob,0,"soc");assert(Soc>=0);
+    C=fdt_add_subnode(Blob,Soc,"google,debug-kinfo");assert(C>=0);
+    assert(fdt_setprop_string(Blob,C,"compatible","google,debug-kinfo")==0);
+    assert(fdt_setprop_u32(Blob,C,"memory-region",0xd8)==0);
+  } else {
+    assert(fdt_setprop_string(Blob,N,"compatible","shared-dma-pool")==0);
+    assert(fdt_setprop(Blob,N,"reusable",0,0)==0);
+    assert(fdt_setprop_u64(Blob,N,"alignment",0x400000)==0);
+  }
+  { char Path[128];snprintf(Path,sizeof Path,"/reserved-memory/%s",Name);return fdt_path_offset(Blob,Path); }
+}
+static void Base(void) {
+  int N;
+  Fixture();N=fdt_path_offset(Blob,"/memory@80000000");Reg(N,"reg",0x900000000ULL,0x40000000);
+}
+static void CheckDynamic(void) {
+  K70_FDT_RAM I;int N,C;
+  Base();N=Pool("qseecom_region",0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.ReservedCount==0&&I.DeferredOsDynamicCount==1);
+  assert(fdt_setprop_u64(Blob,N,"size",0x3600000)==0); // Base DT variant.
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.DeferredOsDynamicCount==1);
+  assert(fdt_setprop_u64(Blob,N,"size",0x4000000)==0); // Official DTBO54 variant.
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.DeferredOsDynamicCount==1);
+  Reg(N,"reg",0x910000000ULL,0x100000);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.ReservedCount==1&&I.DeferredOsDynamicCount==0);
+  assert(I.Reserved[0].Base==0x910000000ULL&&I.Reserved[0].End==0x910100000ULL);
+  assert(fdt_delprop(Blob,N,"reg")==0);
+  assert(fdt_setprop(Blob,N,"no-map",0,0)==0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("foreign_shared_pool",0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN&&I.ReservedCount==0);
+  Base();N=Pool("qseecom_region",0);assert(fdt_delprop(Blob,N,"reusable")==0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("qseecom_region",0);assert(fdt_setprop_u64(Blob,N,"alignment",3)==0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("qseecom_region",0);Reg(N,"alloc-ranges",0xfffffffffffff000ULL,0x2000);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("debug_kinfo_region",1);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.ReservedCount==0&&I.DeferredOsDynamicCount==1);
+  C=fdt_path_offset(Blob,"/soc/google,debug-kinfo");assert(fdt_setprop_u32(Blob,C,"memory-region",0xd9)==0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("debug_kinfo_region",1);assert(fdt_setprop_u64(Blob,N,"size",0x2000)==0);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==K70_RAM_DYNAMIC_UNKNOWN);
+  Base();N=Pool("debug_kinfo_region",1);Reg(N,"reg",0x910000000ULL,0x1000);
+  assert(K70ReadFdtRam(Blob,sizeof Blob,&I)==0&&I.ReservedCount==1&&I.DeferredOsDynamicCount==0);
+}
+'''
+s=s.replace('static void Stock(',extra+'\nstatic void Stock(')
+s=s.replace('  CheckParse(); CheckPlanner();','  CheckParse(); CheckPlanner(); CheckDynamic();')
+s=s.replace('dynamic_unknown=%u\\n", Name, Result, Info.BankCount, Info.ReservedCount, Info.DynamicReservationUnknown);',
+            'dynamic_unknown=%u defer=%u\\n", Name, Result, Info.BankCount, Info.ReservedCount, Info.DynamicReservationUnknown, Info.DeferredOsDynamicCount);')
+s=s.replace('assert(Result == K70_RAM_NO_BANK && Info.BankCount == 0);',
+            'assert(Result == K70_RAM_NO_BANK && Info.BankCount == 0 && Info.DynamicReservationUnknown == 0 && Info.DeferredOsDynamicCount == 17);')
+(M/'test-fdt-ram-r3.c').write_text(s)
+report={'success':False,'device_io':False,'no_physical_ram_probe':True,'sanitizers':['address','undefined'],'results':[]}
+flags=['/usr/lib/llvm-18/bin/clang','-DK70_RAM_HOST','-D_POSIX_C_SOURCE=200809L','-std=c11','-O1','-g',
+       '-Wall','-Wextra','-Werror','-fsanitize=address,undefined','-I',str(D),'-I',str(M),'-I',str(L)]
+with tempfile.TemporaryDirectory(prefix='k70-r3-tests-') as tmp:
+    for name,sources,defines,args in [
+        ('parser',[D/'FdtRamPlan.c',M/'test-fdt-ram-r3.c',*[L/f for f in files]],[],
+         [str(B/'stock-analysis/vendor_boot/dtb-002.dtb'),str(B/'stock-analysis/dtbo/vermeer-v2-composed.dtb')]),
+        ('publisher',[D/'FdtRamPlan.c',D/'MeasuredRam.c',M/'test-publish-r2.c',*[L/f for f in files]],['-DK70_RAM_PUBLISH_TEST'],[]),
+    ]:
+        binary=Path(tmp)/name
+        built=subprocess.run([*flags,*defines,*map(str,sources),'-o',str(binary)],capture_output=True,text=True,timeout=60)
+        if built.returncode:print(built.stderr);raise SystemExit(built.returncode)
+        result=subprocess.run([str(binary),*args],capture_output=True,text=True,timeout=30)
+        print(result.stdout,result.stderr)
+        report['results'].append({'name':name,'success':result.returncode==0,'stdout':result.stdout,'stderr':result.stderr})
+        if result.returncode:raise SystemExit(result.returncode)
+report['success']=True
+report['production_source_sha256']={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in
+    (D/'FdtRamPlan.c',D/'FdtRamPlan.h',D/'MeasuredRam.c',D/'QualifiedUnion.h')}
+(M/'r3-host-test-results.json').write_text(json.dumps(report,indent=2)+'\n')
diff --git a/research/memory-next/test-fdt-ram-r3.c b/research/memory-next/test-fdt-ram-r3.c
