+// This K70 parser is used only by direct Darwin/XNU boot. No Linux reserved
+// memory init or Android pool consumer executes in this path. alloc-ranges
+// describes acceptable placement constraints, NOT a currently occupied range.
+// Defer only the exact reviewed, still-reg-less stock OS allocation requests.
+// A reg property always takes precedence in the caller, even for these names.
+typedef struct {
+  const char *Name;
+  K70_U64 Bytes, Alignment;
+  unsigned High, Debug, DefaultCma;
+} K70_OS_REQUEST;
+static const K70_OS_REQUEST OsRequests[] = {
+  {"va_md_mem_region",       0x01000000, 0,          0, 0, 0},
+  {"sp_region",              0x01000000, 0x00400000, 0, 0, 0},
+  {"cdsp_eva_region",        0x00400000, 0x00400000, 0, 0, 0},
+  {"adsp_heap_region",       0x00C00000, 0x00400000, 0, 0, 0},
+  {"user_contig_region",     0x01000000, 0x00400000, 0, 0, 0},
+  {"qseecom_region",         0x04000000, 0x00400000, 0, 0, 0},
+  {"secure_cdsp_region",     0x04800000, 0x00400000, 0, 0, 0},
+  {"non_secure_display_region",0x0A400000,0x00400000,0, 0, 0},
+  {"demura_heap_region",     0x02800000, 0x00400000, 1, 0, 0},
+  {"qseecom_ta_region",      0x0C800000, 0x00400000, 0, 0, 0},
+  {"qmc_dma_region",         0x01000000, 0x00400000, 0, 0, 0},
+  {"audio_cma_region",       0x01C00000, 0x00400000, 0, 0, 0},
+  {"sdsp_region",            0x00800000, 0x00400000, 0, 0, 0},
+  {"linux,cma",              0x02000000, 0x00400000, 0, 0, 1},
+  {"debug_kinfo_region",     0x00001000, 0,          2, 1, 0},
+  {"mem_dump_region",        0x03400000, 0x00400000, 1, 0, 0},
+  {"cnss_wlan_region",       0x02000000, 0x00400000, 0, 0, 0},
+};
+static int Absent (const void *Fdt, int Node, const char *Name) {
+  int L; const void *P = FdtGetProp(Fdt, Node, Name, &L);
+  return P == 0 && L == -FDT_ERR_NOTFOUND;
+}
+static int BoolProperty (const void *Fdt, int Node, const char *Name, unsigned Present) {
+  int L; const void *P = FdtGetProp(Fdt, Node, Name, &L);
+  return Present ? P != 0 && L == 0 : P == 0 && L == -FDT_ERR_NOTFOUND;
+}
+static int DebugHasKnownConsumer (const void *Fdt, int Node) {
+  int Consumer, L; unsigned Handle;
+  const unsigned char *P;
+  P = FdtGetProp(Fdt,Node,"phandle",&L);
+  if (P == 0 || L != 4 || (Handle = Be32(P)) == 0 || Handle == 0xFFFFFFFFU) return 0;
+  Consumer = FdtPathOffset(Fdt,"/soc/google,debug-kinfo");
+  if (Consumer < 0) return 0;
+  P = FdtGetProp(Fdt,Consumer,"compatible",&L);
+  if (!Exact(P,L,"google,debug-kinfo")) return 0;
+  P = FdtGetProp(Fdt,Consumer,"memory-region",&L);
+  return P != 0 && L == 4 && Be32(P) == Handle;
+}
+static int DeferKnownOsRequest (const void *Fdt, int Node, int Ac, int Sc) {
+  int L, NameLength;
+  const unsigned char *P;
+  const char *Name;
+  const K70_OS_REQUEST *R = 0;
+  unsigned I, Placements = 0;
+  K70_RAM_RANGE Placement[16];
+  K70_U64 RequestBytes;
+  if (Ac != 2 || Sc != 2) return 0;
+  Name = FdtGetName(Fdt, Node, &NameLength);
+  if (Name == 0 || NameLength < 0 || NameLength > 64) return 0;
+  for (I = 0; I < sizeof(OsRequests)/sizeof(OsRequests[0]); ++I) {
+    if (Exact(Name, NameLength + 1, OsRequests[I].Name)) { R = &OsRequests[I]; break; }
+  }
+  if (R == 0 || !Absent(Fdt,Node,"reg")) return 0;
+  if (R->Debug && !DebugHasKnownConsumer(Fdt,Node)) return 0;
+  P = FdtGetProp(Fdt, Node, "status", &L);
+  if (P != 0 ? !Exact(P,L,"ok") && !Exact(P,L,"okay") : L != -FDT_ERR_NOTFOUND) return 0;
+  P = FdtGetProp(Fdt, Node, "size", &L);
+  if (P == 0 || L != 8 || (RequestBytes = Cells(P,2)) == 0) return 0;
+  if (R->Debug && RequestBytes != 0x1000) return 0;
+  P = FdtGetProp(Fdt, Node, "alignment", &L);
+  // CMA size/alignment/placement parameters do not assign physical memory.
+  // Validate their ABI rather than pinning unrelated pool sizing across DTBOs.
+  if (R->Debug) {
+    if (P != 0 || L != -FDT_ERR_NOTFOUND) return 0;
+  } else if (P != 0) {
+    K70_U64 A;
+    if (L != 8 || (A = Cells(P,2)) == 0 || (A & (A - 1)) != 0) return 0;
+  } else if (L != -FDT_ERR_NOTFOUND) return 0;
+  P = FdtGetProp(Fdt, Node, "alloc-ranges", &L);
+  if (P != 0) {
+    if (Reg(P,L,Ac,Sc,Placement,&Placements,16) != K70_RAM_OK || Placements == 0) return 0;
+  } else if (L != -FDT_ERR_NOTFOUND || R->Debug) return 0;
+  if (R->Debug && (Placements != 1 || Placement[0].Base != 0 ||
+                   Placement[0].End != 0xFFFFFFFFFFFFFFFFULL)) return 0;
+  P = FdtGetProp(Fdt, Node, "compatible", &L);
+  if (R->Debug ? P != 0 || L != -FDT_ERR_NOTFOUND : !Exact(P,L,"shared-dma-pool")) return 0;
+  if (!BoolProperty(Fdt,Node,"no-map",R->Debug) ||
+      !BoolProperty(Fdt,Node,"reusable",!R->Debug) ||
+      !BoolProperty(Fdt,Node,"linux,cma-default",R->DefaultCma) ||
+      !Absent(Fdt,Node,"linux,dma-default") || !Absent(Fdt,Node,"no-map-fixup") ||
+      !Absent(Fdt,Node,"iommu-addresses")) return 0;
+  return 1;
+}
