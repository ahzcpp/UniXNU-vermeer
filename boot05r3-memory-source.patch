         P = FdtGetProp(Fdt, Node, "size", &Length);
         if (P != 0) {
-          P = FdtGetProp(Fdt, Node, "alloc-ranges", &Length);
-          if (P == 0) Out->DynamicReservationUnknown = 1;
-          else {
-            Error = Reg(P, Length, Rac, Rsc, Out->Reserved, &Out->ReservedCount, K70_RAM_RESERVATIONS);
-            if (Error) return Error;
-          }
+          if (DeferKnownOsRequest(Fdt, Node, Rac, Rsc)) ++Out->DeferredOsDynamicCount;
+          else Out->DynamicReservationUnknown = 1;
         }
       }
     }
