diff --git a/research/memory-next/prepare-r4-handoff.py b/research/memory-next/prepare-r4-handoff.py
new file mode 100644
index 0000000..5935c5b
--- /dev/null
+++ b/research/memory-next/prepare-r4-handoff.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""Prepare bounded identity/code-coherency handoff repair and stage bands."""
+import hashlib
+from pathlib import Path
+
+W=Path(__file__).resolve().parent.parent/'boot-chain-05'
+D=W/'darwinboot/DarwinBootPkg/Driver'
+snapshot=W/'source-snapshots/r3-verified-845d1790'
+for name in ['Entry.S','DarwinBoot.c']:
+    assert (D/name).read_bytes()==(snapshot/'darwinboot/DarwinBootPkg/Driver'/name).read_bytes()
+p=D/'Entry.S';s=p.read_text().replace('ASM_FUNC(DarwinEnter)','ASM_FUNC_ALIGN(DarwinEnter, 64)')
+old='''  dsb sy
+  ic iallu
+  dsb sy
+  isb
+  // Yellow: owned-window cache maintenance completed.
+  HANDOFF_BAND 13, 0xFF00, 0xFFFF'''
+new='''  dsb sy
+  // Yellow: the entire owned window is clean, before self-code maintenance.
+  HANDOFF_BAND 13, 0xFF00, 0xFFFF
+
+  // ExitBootServices may have run callbacks since the C-side identity check.
+  // Recheck EVERY instruction page at the actual point of MMU shutdown.
+  // No candidate address is dereferenced by AT; PAR faults refuse the handoff.
+  adr x8, ASM_PFX(DarwinEnter)
+  bic x8, x8, #0xfff
+  adr x9, ASM_PFX(DarwinEnterEnd)
+  add x9, x9, #0xfff
+  bic x9, x9, #0xfff
+5:
