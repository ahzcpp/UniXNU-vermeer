+  __asm__ volatile ("msr par_el1, %0" :: "r" (SavedPar) : "memory");
+  if (!EFI_ERROR (Status)) { mSelfCodeVa = Start; mSelfCodePa = Start; }
+  Print (L"HANDOFF SELF: VA %lx PA %lx PAR %lx SIZE %lx STATUS %r\n",
+         mSelfCodeVa, mSelfCodePa, mSelfCodePar, End - Start, Status);
+  return Status;
+}
