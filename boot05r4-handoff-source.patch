+// Read current EL1 translation metadata for the complete handoff instruction
+// span. This does not read/write unknown RAM and does not alter page tables.
+STATIC EFI_STATUS
+CheckHandoffIdentity (VOID)
+{
+  UINT64 Start = (UINT64)(UINTN)DarwinEnter;
+  UINT64 End = (UINT64)(UINTN)DarwinEnterEnd;
+  UINT64 Page, Top, Par, SavedPar;
+  EFI_STATUS Status = EFI_SUCCESS;
+  mSelfCodeVa = Start; mSelfCodePa = 0; mSelfCodePar = 0;
+  if (End <= Start || End - Start > EFI_PAGE_SIZE || End > MAX_UINT64 - EFI_PAGE_MASK) {
+    return EFI_COMPROMISED_DATA;
+  }
+  __asm__ volatile ("mrs %0, par_el1" : "=r" (SavedPar));
+  Top = ALIGN_VALUE (End, EFI_PAGE_SIZE);
+  for (Page = Start & ~((UINT64)EFI_PAGE_MASK); Page < Top; Page += EFI_PAGE_SIZE) {
+    __asm__ volatile ("at s1e1r, %1\n\tisb\n\tmrs %0, par_el1"
+                      : "=r" (Par) : "r" (Page) : "memory");
+    mSelfCodeVa = Page; mSelfCodePar = Par;
+    mSelfCodePa = Par & 0x000FFFFFFFFFF000ULL;
+    if ((Par & 1) != 0 || mSelfCodePa != Page) { Status = EFI_UNSUPPORTED; break; }
+  }
+  __asm__ volatile ("msr par_el1, %0" :: "r" (SavedPar) : "memory");
+  if (!EFI_ERROR (Status)) { mSelfCodeVa = Start; mSelfCodePa = Start; }
+  Print (L"HANDOFF SELF: VA %lx PA %lx PAR %lx SIZE %lx STATUS %r\n",
+         mSelfCodeVa, mSelfCodePa, mSelfCodePar, End - Start, Status);
+  return Status;
+}
