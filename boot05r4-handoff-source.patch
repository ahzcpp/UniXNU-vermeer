@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""Freeze source-only r4 delta; do not build, flash or modify binary artifacts."""
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+W=Path(__file__).resolve().parent;B=W.parent;O=B/'device-source';A=B/'artifacts/boot-chain-05r4'
+BASES=[(O/'boot05-memory-source.patch','588a60d1f22f45ba53a16596be18d2995a953f0cd0b18e9737a297fca884bb71'),
+       (O/'boot05r2-memory-source.patch','0042eea2b2e38291ac4742c99f110a3b5e778bc1b8db16d421d75ec93ba33bec'),
+       (O/'boot05r3-memory-source.patch','5d961374fe47476d74bea5ef4b4b29aa82d768e614365ce6d36c3af3d5b8fef4')]
+def sha(data):return hashlib.sha256(data).hexdigest()
+for p,digest in BASES:assert sha(p.read_bytes())==digest
+r=json.loads((W/'build-result.json').read_text());a=json.loads((A/'fd-audit.json').read_text())
+assert r['exit_code']==0 and not r['source_changed_during_build'] and a['success']
+assert a['fd_sha256']=='2eb9d57346a7184b240d836c9cdfc25072c8f6eda80a5cc9256f3be40860732a'
+for rel,digest in r['source_sha256'].items():assert sha((W/rel).read_bytes())==digest
+snapshot=W/'source-snapshots/r4-verified-2eb9d573'
+preserve={rel:W/rel for rel in r['source_sha256']};mapping={}
+def add(target,source):
+    data=source.read_bytes();text=data.decode('utf-8-sig')
+    assert '\0' not in text and re.search(r'^-----BEGIN [A-Z ]*PRIVATE KEY-----$',text,re.M) is None
+    assert target.startswith(('research/boot-chain-05/','research/memory-next/'))
+    mapping[target]=data
+for name in ['DarwinBoot.c','Entry.S']:
+    add('research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/'+name,W/'darwinboot/DarwinBootPkg/Driver'/name)
+for name in ['incremental-ui.py','R4-README.md','export-r4-source.py']:
+    add('research/boot-chain-05/'+name,W/name);preserve[name]=W/name
+source=B/'memory-next/prepare-r4-handoff.py'
+add('research/memory-next/prepare-r4-handoff.py',source);preserve['memory-next/prepare-r4-handoff.py']=source
+for name in ['build-result.json']:
+    add('research/boot-chain-05/r4/'+name,W/name);preserve[name]=W/name
+for name in ['fd-audit.json','firmware-verification.json']:
+    add('research/boot-chain-05/r4/'+name,A/name);preserve[name]=A/name
+source=B/'storage-next/storage-r3-handoff-layout.json'
+add('research/boot-chain-05/r4/storage-r3-handoff-layout.json',source);preserve['storage-r3-handoff-layout.json']=source
+source=B/'artifacts/storage-native-03-r4/verification.json'
+storage=json.loads(source.read_text())
+assert storage['image_sha256']=='b7b24c58eadfed82450066389700ecb7806fbcc813b412fbc0a6304084a1a1a5'
+assert storage['fd_sha256']==a['fd_sha256']
+assert storage['fd_audit_sha256']==sha((A/'fd-audit.json').read_bytes())
+add('research/boot-chain-05/r4/storage-verification.json',source);preserve['storage-verification.json']=source
+for rel,source in preserve.items():
+    p=snapshot/rel;data=source.read_bytes()
+    if p.exists():assert p.read_bytes()==data,'Frozen r4 source differs: '+rel
+    else:p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(data)
+
+def init(repo):
+    subprocess.run(['git','init','-q',str(repo)],check=True)
+    subprocess.run(['git','-C',str(repo),'config','core.autocrlf','false'],check=True)
+    for patch,_ in BASES:subprocess.run(['git','-C',str(repo),'apply','--whitespace=nowarn',str(patch)],check=True)
+with tempfile.TemporaryDirectory(prefix='k70-r4-delta-') as name:
+    repo=Path(name);init(repo);subprocess.run(['git','-C',str(repo),'add','--all'],check=True)
+    subprocess.run(['git','-C',str(repo),'-c','user.name=Source Audit','-c','user.email=source-audit@localhost',
+                    'commit','-qm','Frozen r1 r2 r3 source base'],check=True)
+    before={str(p.relative_to(repo)):p.read_bytes() for p in repo.rglob('*') if p.is_file() and '.git' not in p.parts}
+    for target,data in mapping.items():
+        p=repo/target;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(data)
+    subprocess.run(['git','-C',str(repo),'add','--all'],check=True)
+    patch=subprocess.check_output(['git','-C',str(repo),'diff','--cached','--binary','--no-ext-diff'])
+with tempfile.TemporaryDirectory(prefix='k70-r4-apply-') as name:
+    repo=Path(name);init(repo);p=repo/'r4.patch';p.write_bytes(patch)
+    subprocess.run(['git','-C',str(repo),'apply','--check',str(p)],check=True)
+    subprocess.run(['git','-C',str(repo),'apply',str(p)],check=True)
+    for target,data in {**before,**mapping}.items():assert (repo/target).read_bytes()==data,'Exact readback failed: '+target
+result={'format':'source-only-git-delta','base_patch_sha256':[digest for _,digest in BASES],
+        'files':{name:{'bytes':len(data),'sha256':sha(data),'action':'modified' if name in before else 'added'} for name,data in mapping.items()},
+        'file_count':len(mapping),'patch_bytes':len(patch),'patch_sha256':sha(patch),
+        'r1_r2_r3_then_r4_clean_apply_and_all_files_exact_readback':True,
+        'contains_apple_or_oem_binaries':False,'contains_images_keys_or_private_phone_identifiers':False,
+        'fixed_local_workspace_dependency':True,'r4_runtime_result':'boot_b flashed/rebooted; stage result pending',
+        'fd_sha256':a['fd_sha256'],'immutable_audit_sha256':sha((A/'fd-audit.json').read_bytes()),
+        'fullboot_sha256':storage['image_sha256'],'userdata_rewritten_for_r4':False,'snapshot_files':len(preserve)}
+(O/'boot05r4-handoff-source.patch').write_bytes(patch)
+(O/'boot05r4-handoff-source.manifest.json').write_text(json.dumps(result,indent=2)+'\n')
+shutil.copyfile(W/'R4-README.md',O/'docs/boot05r4-handoff-2026-11-04.md')
+print(json.dumps({k:v for k,v in result.items() if k!='files'},indent=2))
