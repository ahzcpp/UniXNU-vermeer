index 8c6c0a4..e3f25df 100644
--- a/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/Entry.S
+++ b/research/boot-chain-05/darwinboot/DarwinBootPkg/Driver/Entry.S
@@ -27,7 +27,7 @@ ASM_FUNC(DarwinCurrentEl)
 9:
 .endm
 
-ASM_FUNC(DarwinEnter)
+ASM_FUNC_ALIGN(DarwinEnter, 64)
   mov x14, x4
   mov x15, x5
   msr daifset, #15
@@ -59,20 +59,70 @@ ASM_FUNC(DarwinEnter)
   cmp x4, x5
   b.lo 1b
   dsb sy
+  // Yellow: the entire owned window is clean, before self-code maintenance.
+  HANDOFF_BAND 13, 0xFF00, 0xFFFF
+
+  // ExitBootServices may have run callbacks since the C-side identity check.
+  // Recheck EVERY instruction page at the actual point of MMU shutdown.
+  // No candidate address is dereferenced by AT; PAR faults refuse the handoff.
+  adr x8, ASM_PFX(DarwinEnter)
+  bic x8, x8, #0xfff
+  adr x9, ASM_PFX(DarwinEnterEnd)
+  add x9, x9, #0xfff
+  bic x9, x9, #0xfff
+5:
+  at s1e1r, x8
+  isb
+  mrs x10, par_el1
+  tbnz x10, #0, 7f
+  and x10, x10, #0x000ffffffffff000
+  cmp x10, x8
+  b.ne 7f
+  add x8, x8, #0x1000
+  cmp x8, x9
+  b.lo 5b
+
+  // The PE loader's relocation/code writes are outside the XNU owned window.
+  // Clean our ENTIRE instruction span to PoC before switching instruction
+  // fetch from the cacheable identity mapping to MMU/cache-off physical fetch.
+  // x6=line length and x7=line mask still hold from the window loop above.
+  adr x4, ASM_PFX(DarwinEnter)
+  bic x4, x4, x7
+  adr x5, ASM_PFX(DarwinEnterEnd)
+6:
+  dc cvac, x4
+  add x4, x4, x6
+  cmp x4, x5
+  b.lo 6b
+  dsb sy
   ic iallu
   dsb sy
   isb
-  // Yellow: owned-window cache maintenance completed.
-  HANDOFF_BAND 13, 0xFF00, 0xFFFF
+  // White: self identity and instruction bytes are ready for physical fetch.
+  HANDOFF_BAND 12, 0xFFFF, 0xFFFF
+  // Red: next system-register transition is SCTLR_EL1.
+  HANDOFF_BAND 11, 0x0000, 0xFFFF
   mrs x4, sctlr_el1
   bic x4, x4, #1
   bic x4, x4, #4
   bic x4, x4, #0x1000
   msr sctlr_el1, x4
   isb
+  // Magenta: actual instruction fetch survived the SCTLR write + ISB.
+  HANDOFF_BAND 15, 0x00FF, 0xFFFF
   tlbi vmalle1
   dsb sy
   isb
   // Cyan: MMU disabled and TLB invalidation completed.
   HANDOFF_BAND 14, 0xFFFF, 0xFF00
   br x1
+
+  // No stack, boot services, exception-vector dependency, or guessed PA.
+  // Orange means code identity changed after ExitBootServices; MMU stays on.
+7:
+  HANDOFF_BAND 10, 0x8000, 0xFFFF
+8:
+  wfe
+  b 8b
+.global ASM_PFX(DarwinEnterEnd)
+ASM_PFX(DarwinEnterEnd):
